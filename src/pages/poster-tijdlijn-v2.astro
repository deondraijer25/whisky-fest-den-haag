  <script is:inline>
    (function() {
      var poster = document.getElementById('a3-poster');
      var canvas = document.getElementById('timeline-canvas');
      var linesGroup = document.getElementById('pointer-lines-group');
      var editBtn = document.getElementById('toggle-edit-btn');
      var styleBtn = document.getElementById('toggle-photo-style-btn');
      var textureBtn = document.getElementById('toggle-texture-btn');
      var frameBtn = document.getElementById('toggle-frame-btn');
      var bakedPrintImg = document.getElementById('baked-paper-print');
      var editing = false;
      var softBlend = false;
      var textureModes = ['cotton', 'laid', 'clean'];
      var textureIndex = 0;
      var showFrame = true;

      /* =====================================================================
         AUTHENTIC HANDMADE COTTON & LAID PARCHMENT PAPER GENERATOR
         Uses multi-scale smoothstep value noise + organic cellulose cotton
         fibers + subtle laid wire lines + natural botanical specks.
         ===================================================================== */
      var cachedMasterPaper = {};

      function generateMasterPaperCanvas(mode) {
        if (cachedMasterPaper[mode]) return cachedMasterPaper[mode];

        var w = 1000;
        var h = 1414;
        var c = document.createElement('canvas');
        c.width = w;
        c.height = h;
        var ctx = c.getContext('2d');

        var seed = mode === 'laid' ? 73921 : mode === 'clean' ? 19403 : 42857;
        function rand() {
          seed |= 0;
          seed = (seed + 0x6D2B79F5) | 0;
          var t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        }

        function makeGrid(gw, gh) {
          var g = new Float32Array(gw * gh);
          for (var i = 0; i < gw * gh; i++) {
            g[i] = rand() * 2 - 1;
          }
          var out = new Float32Array(gw * gh);
          for (var y = 0; y < gh; y++) {
            for (var x = 0; x < gw; x++) {
              var sum = 0;
              var cnt = 0;
              for (var dy = -1; dy <= 1; dy++) {
                for (var dx = -1; dx <= 1; dx++) {
                  var nx = Math.min(gw - 1, Math.max(0, x + dx));
                  var ny = Math.min(gh - 1, Math.max(0, y + dy));
                  sum += g[ny * gw + nx];
                  cnt++;
                }
              }
              out[y * gw + x] = sum / cnt;
            }
          }
          return { data: out, gw: gw, gh: gh };
        }

        function sampleGrid(grid, u, v) {
          var gx = u * (grid.gw - 1);
          var gy = v * (grid.gh - 1);
          var x0 = Math.floor(gx);
          var y0 = Math.floor(gy);
          var x1 = Math.min(grid.gw - 1, x0 + 1);
          var y1 = Math.min(grid.gh - 1, y0 + 1);
          var fx = gx - x0;
          var fy = gy - y0;
          var sx = fx * fx * (3 - 2 * fx);
          var sy = fy * fy * (3 - 2 * fy);
          var d = grid.data;
          var gw = grid.gw;
          var n00 = d[y0 * gw + x0];
          var n10 = d[y0 * gw + x1];
          var n01 = d[y1 * gw + x0];
          var n11 = d[y1 * gw + x1];
          var nx0 = n00 + sx * (n10 - n00);
          var nx1 = n01 + sx * (n11 - n01);
          return nx0 + sy * (nx1 - nx0);
        }

        var gMacro = makeGrid(14, 20);
        var gMed   = makeGrid(38, 54);
        var gFine  = makeGrid(110, 155);
        var gMicro = makeGrid(300, 424);

        var intensity = mode === 'clean' ? 0.38 : mode === 'laid' ? 0.92 : 1.0;

        var imgData = ctx.createImageData(w, h);
        var d = imgData.data;

        for (var y = 0; y < h; y++) {
          var v = y / h;
          var dyEdge = (v - 0.5) * 2;
          for (var x = 0; x < w; x++) {
            var u = x / w;
            var dxEdge = (u - 0.5) * 2;

            var n1 = sampleGrid(gMacro, u, v);
            var n2 = sampleGrid(gMed, u, v);
            var n3 = sampleGrid(gFine, u, v);
            var n4 = sampleGrid(gMicro, u, v);

            var ridge = (1 - Math.abs(n2 + n3 * 0.35)) - 0.65;
            var cloudDelta = (n1 * 5.2 + n2 * 3.4 + n3 * 2.1 + n4 * 1.4 + ridge * 2.4) * intensity;

            var laidDelta = 0;
            if (mode === 'laid') {
              var wireH = Math.sin(y * 1.85 + n2 * 1.6) * 1.45;
              var chainV = Math.cos(x * (Math.PI * 2 / 78) + n1 * 0.5) > 0.92 ? 0.9 : 0;
              laidDelta = (wireH + chainV) * intensity;
            } else if (mode === 'cotton') {
              laidDelta = Math.sin(y * 1.9 + n2 * 2.2) * 0.45 * intensity;
            }

            var distSq = dxEdge * dxEdge * 0.85 + dyEdge * dyEdge * 0.85;
            var vignette = Math.max(0, distSq - 0.28) * 10.5 * intensity;

            var tooth = (rand() - 0.5) * 2.2 * intensity;
            var delta = cloudDelta + laidDelta + tooth - vignette;

            var r = 249.5 + delta * 0.95 - vignette * 0.25;
            var g = 246.0 + delta * 1.08 - vignette * 0.45;
            var b = 240.0 + delta * 1.28 - vignette * 0.75;

            var idx = (y * w + x) * 4;
            d[idx]     = Math.min(255, Math.max(0, Math.round(r)));
            d[idx + 1] = Math.min(255, Math.max(0, Math.round(g)));
            d[idx + 2] = Math.min(255, Math.max(0, Math.round(b)));
            d[idx + 3] = 255;
          }
        }

        ctx.putImageData(imgData, 0, 0);

        if (mode !== 'clean') {
          ctx.save();
          var fiberCount = mode === 'cotton' ? 4200 : 2800;
          for (var f = 0; f < fiberCount; f++) {
            var fx = rand() * w;
            var fy = rand() * h;
            var len = 3 + rand() * 14;
            var angle = (rand() - 0.5) * Math.PI * 2;
            var curve = (rand() - 0.5) * 4;
            var isLight = rand() > 0.62;

            ctx.beginPath();
            ctx.moveTo(fx, fy);
            var mx = fx + Math.cos(angle) * (len * 0.5) - Math.sin(angle) * curve;
            var my = fy + Math.sin(angle) * (len * 0.5) + Math.cos(angle) * curve;
            var ex = fx + Math.cos(angle) * len;
            var ey = fy + Math.sin(angle) * len;
            ctx.quadraticCurveTo(mx, my, ex, ey);

            if (isLight) {
              ctx.strokeStyle = 'rgba(255, 253, 249, ' + (0.18 + rand() * 0.22) + ')';
            } else {
              ctx.strokeStyle = 'rgba(186, 166, 138, ' + (0.07 + rand() * 0.11) + ')';
            }
            ctx.lineWidth = 0.45 + rand() * 0.55;
            ctx.lineCap = 'round';
            ctx.stroke();
          }

          var speckCount = mode === 'cotton' ? 650 : 350;
          for (var s = 0; s < speckCount; s++) {
            var sx = rand() * w;
            var sy = rand() * h;
            var sr = 0.35 + rand() * 0.75;
            ctx.fillStyle = 'rgba(168, 145, 114, ' + (0.06 + rand() * 0.12) + ')';
            ctx.beginPath();
            ctx.arc(sx, sy, sr, 0, Math.PI * 2);
            ctx.fill();
          }
          ctx.restore();
        }

        cachedMasterPaper[mode] = c;
        return c;
      }

      function bakePaperTextureForPrint(mode) {
        if (!bakedPrintImg) return;
        var master = generateMasterPaperCanvas(mode);
        bakedPrintImg.src = master.toDataURL('image/jpeg', 0.88);
      }

      bakePaperTextureForPrint('cotton');

      function updatePointerLines() {
        if (!canvas || !linesGroup) return;
        while (linesGroup.firstChild) {
          linesGroup.removeChild(linesGroup.firstChild);
        }

        var nodes = canvas.querySelectorAll('.milestone-node[data-anchor-x]');
        nodes.forEach(function(node) {
          var ax = parseFloat(node.getAttribute('data-anchor-x') || '0');
          var ay = parseFloat(node.getAttribute('data-anchor-y') || '0');
          var isJubilee = node.classList.contains('milestone-jubilee-card');

          var left = node.offsetLeft;
          var top = node.offsetTop;
          var width = node.offsetWidth;
          var height = node.offsetHeight;

          var tx = Math.max(left + 12, Math.min(ax, left + width - 12));
          var ty = Math.max(top + 4, Math.min(ay, top + height - 4));

          var svgNS = 'http://www.w3.org/2000/svg';

          var line = document.createElementNS(svgNS, 'line');
          line.setAttribute('x1', String(ax));
          line.setAttribute('y1', String(ay));
          line.setAttribute('x2', String(tx));
          line.setAttribute('y2', String(ty));
          line.setAttribute('stroke', isJubilee ? '#006448' : '#1D1C1A');
          line.setAttribute('stroke-width', isJubilee ? '2.5' : '1.75');
          line.setAttribute('stroke-dasharray', isJubilee ? 'none' : '3 3');
          linesGroup.appendChild(line);

          var endDot = document.createElementNS(svgNS, 'circle');
          endDot.setAttribute('cx', String(tx));
          endDot.setAttribute('cy', String(ty));
          endDot.setAttribute('r', '3.5');
          endDot.setAttribute('fill', '#006448');
          linesGroup.appendChild(endDot);

          var outerRing = document.createElementNS(svgNS, 'circle');
          outerRing.setAttribute('cx', String(ax));
          outerRing.setAttribute('cy', String(ay));
          outerRing.setAttribute('r', isJubilee ? '11' : '7.5');
          outerRing.setAttribute('fill', '#FAF7F2');
          outerRing.setAttribute('stroke', '#006448');
          outerRing.setAttribute('stroke-width', isJubilee ? '3.5' : '2.5');
          linesGroup.appendChild(outerRing);

          var innerDot = document.createElementNS(svgNS, 'circle');
          innerDot.setAttribute('cx', String(ax));
          innerDot.setAttribute('cy', String(ay));
          innerDot.setAttribute('r', isJubilee ? '5' : '3.2');
          innerDot.setAttribute('fill', '#006448');
          linesGroup.appendChild(innerDot);
        });
      }

      updatePointerLines();
      window.addEventListener('load', updatePointerLines);
      if (document.fonts && document.fonts.ready) {
        document.fonts.ready.then(updatePointerLines);
      }

      /* Bake warm retro sepia + contrast + vignette directly into the 4 photo <img> tags
         so zero CSS filter / mix-blend-mode GPU layers are created on the page! */
      function bakeRetroPhotoElement(img) {
        if (img.dataset.retroBaked === 'true') return;
        var nw = img.naturalWidth;
        var nh = img.naturalHeight;
        if (!nw || !nh) return;
        img.dataset.retroBaked = 'true';

        var cw = 528;
        var ch = 330;
        var c = document.createElement('canvas');
        c.width = cw;
        c.height = ch;
        var ctx = c.getContext('2d');

        var scale = Math.max(cw / nw, ch / nh);
        var dw = nw * scale;
        var dh = nh * scale;
        var dx = (cw - dw) * 0.5;
        var dy = (ch - dh) * 0.5;

        ctx.drawImage(img, dx, dy, dw, dh);

        var id = ctx.getImageData(0, 0, cw, ch);
        var data = id.data;
        for (var y = 0; y < ch; y++) {
          var ny = (y / ch - 0.5) * 2;
          for (var x = 0; x < cw; x++) {
            var nx = (x / cw - 0.5) * 2;
            var i = (y * cw + x) * 4;
            var r = data[i];
            var g = data[i + 1];
            var b = data[i + 2];

            var sr = r * 0.393 + g * 0.769 + b * 0.189;
            var sg = r * 0.349 + g * 0.686 + b * 0.168;
            var sb = r * 0.272 + g * 0.534 + b * 0.131;

            r = r * 0.76 + sr * 0.24;
            g = g * 0.76 + sg * 0.24;
            b = b * 0.76 + sb * 0.24;

            r = (r - 128) * 1.06 + 126;
            g = (g - 128) * 1.06 + 125;
            b = (b - 128) * 1.06 + 122;

            var distSq = nx * nx * 0.55 + ny * ny * 0.55;
            var vig = Math.max(0.76, 1 - Math.max(0, distSq - 0.18) * 0.38);

            data[i]     = Math.min(255, Math.max(0, Math.round(r * vig)));
            data[i + 1] = Math.min(255, Math.max(0, Math.round(g * vig)));
            data[i + 2] = Math.min(255, Math.max(0, Math.round(b * vig)));
          }
        }
        ctx.putImageData(id, 0, 0);
        img.src = c.toDataURL('image/jpeg', 0.92);
      }

      document.querySelectorAll('img.retro-photo-img').forEach(function(img) {
        if (img.complete && img.naturalWidth > 0) {
          bakeRetroPhotoElement(img);
        } else {
          img.addEventListener('load', function() {
            bakeRetroPhotoElement(img);
          }, { once: true });
        }
      });

      if (textureBtn && poster) {
        textureBtn.addEventListener('click', function() {
          textureIndex = (textureIndex + 1) % textureModes.length;
          var mode = textureModes[textureIndex];
          poster.classList.remove('texture-cotton', 'texture-laid', 'texture-clean');
          poster.classList.add('texture-' + mode);
          bakePaperTextureForPrint(mode);
          var span = textureBtn.querySelector('span');
          if (span) {
            if (mode === 'cotton') span.textContent = 'Papiertextuur: Handgeschept Katoen';
            if (mode === 'laid') span.textContent = 'Papiertextuur: Fijn Vergé & Linnen';
            if (mode === 'clean') span.textContent = 'Papiertextuur: Zacht Effen Perkament';
          }
        });
      }

      if (frameBtn && poster) {
        frameBtn.addEventListener('click', function() {
          showFrame = !showFrame;
          poster.classList.toggle('frame-none', !showFrame);
          var span = frameBtn.querySelector('span');
          if (span) {
            span.textContent = showFrame ? 'Kader: Fijne Enkele Lijn' : 'Kader: Geen Kader';
          }
        });
      }

      if (styleBtn && poster) {
        styleBtn.addEventListener('click', function() {
          softBlend = !softBlend;
          poster.classList.toggle('photo-style-blend', softBlend);
          var span = styleBtn.querySelector('span');
          if (span) {
            span.textContent = softBlend ? 'Fotostijl: Perkament Blend' : 'Fotostijl: Vintage Kader';
          }
        });
      }

      if (editBtn && poster) {
        editBtn.addEventListener('click', function() {
          editing = !editing;
          var editNodes = poster.querySelectorAll('.editable-node');
          editNodes.forEach(function(el) {
            el.setAttribute('contenteditable', editing ? 'true' : 'false');
          });
          poster.classList.toggle('is-editing', editing);
          var span = editBtn.querySelector('span');
          if (span) {
            span.textContent = editing
              ? 'Verslepen & Tekst Bewerken: AAN'
              : 'Verslepen & Tekst Bewerken: UIT';
          }
          updatePointerLines();
        });
      }

      var activeDrag = null;
      var startX = 0;
      var startY = 0;
      var initialLeft = 0;
      var initialTop = 0;

      if (poster) {
        poster.addEventListener('mousedown', function(e) {
          if (!editing) return;
          var target = e.target;
          if (!target || typeof target.closest !== 'function') return;
          if (target.isContentEditable && document.activeElement === target) return;

          var item = target.closest('.draggable-item');
          if (!item) return;

          activeDrag = item;
          activeDrag.classList.add('is-dragging');
          startX = e.clientX;
          startY = e.clientY;
          initialLeft = activeDrag.offsetLeft;
          initialTop = activeDrag.offsetTop;
          e.preventDefault();
        });

        window.addEventListener('mousemove', function(e) {
          if (!activeDrag) return;
          var dx = e.clientX - startX;
          var dy = e.clientY - startY;
          activeDrag.style.left = Math.round(initialLeft + dx) + 'px';
          activeDrag.style.top = Math.round(initialTop + dy) + 'px';
          updatePointerLines();
        });

        window.addEventListener('mouseup', function() {
          if (activeDrag) {
            activeDrag.classList.remove('is-dragging');
            activeDrag = null;
            updatePointerLines();
          }
        });

        poster.addEventListener('input', function() {
          updatePointerLines();
        });
      }
    })();
  </script>
</Layout>
