---
// src/pages/poster-tijdlijn-v2.astro
// V2: Subtiele gekreukeld-papier achtergrond, vernieuwde redactionele kop & voettekst zonder dubbelingen,
// 100% knikvrije vintage gravure S-curve met ruit-medaillons, en geredigeerde teksten op alle 13 kaartjes.
import Layout from '../layouts/Layout.astro';
import LogoSvg from '../assets/Logo/Logo.svg?raw';
---

<Layout
  title="A3 Poster Tijdlijn (V2 Vintage Papier & Gravure Lijn) — International Whisky Festival Den Haag"
  description="Printklare A3 verticale tijdlijn poster (Versie 2 met subtiele gekreukeld-papier achtergrond, knikvrije vintage gravure-lijn en geredigeerde teksten) van 25 jaar International Whisky Festival Den Haag."
>
  <!-- Floating Screen Controls (Hidden when printing to A3 PDF) -->
  <div class="poster-toolbar no-print">
    <div class="toolbar-inner">
      <div class="toolbar-left">
        <a href="/poster-drukker" class="toolbar-back-link" style="background: #006448; border: 1.5px solid #caac8e; color: #FFFFFF;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="2" width="16" height="20" rx="2"></rect><line x1="8" y1="6" x2="16" y2="6"></line><line x1="8" y1="10" x2="16" y2="10"></line><line x1="8" y1="14" x2="12" y2="14"></line></svg>
          Drukker-Versie (Voor + Achter onder elkaar) &rarr;
        </a>
        <a href="/poster-voorkant" class="toolbar-back-link">
          &larr; Bekijk Voorkant
        </a>
        <span class="toolbar-badge">ACHTERKANT (V2) &bull; TIJDLIJN</span>
      </div>
      <div class="toolbar-actions">
        <button type="button" id="toggle-texture-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline></svg>
          <span>Papiertextuur: Handgeschept Katoen</span>
        </button>
        <button type="button" id="toggle-frame-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"></rect></svg>
          <span>Kader: Fijne Enkele Lijn</span>
        </button>
        <button type="button" id="toggle-photo-style-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
          <span>Fotostijl: Vintage Kader</span>
        </button>
        <button type="button" id="toggle-edit-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
          <span>Verslepen &amp; Tekst Bewerken: UIT</span>
        </button>
        <button type="button" onclick="window.print()" class="toolbar-btn toolbar-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          Print / Opslaan als A3 PDF (~1 MB)
        </button>
      </div>
    </div>
  </div>

  <!-- A3 STAGE WRAPPER -->
  <main class="poster-stage-wrapper">
    <!-- A3 SHEET: Exact 1400 x 1980 coordinate space (= 297mm x 420mm ratio 1 : 1.41428) -->
    <article class="a3-poster-sheet texture-cotton frame-single" id="a3-poster">
      
      <!-- 0A. AUTHENTIC HANDMADE COTTON & LAID PARCHMENT PAPER BACKGROUND (Unified on Screen & Print) -->
      <div class="v2-crumpled-paper-bg" aria-hidden="true">
        <img id="baked-paper-print" class="v2-paper-texture-img v2-baked-paper-print" alt="" />
      </div>

      <!-- 0B. CLEAN, UNDERSTATED SINGLE HAIRLINE FRAME (Inset safely inside 3mm print bleed + trim margin) -->
      <div class="v2-clean-frame" aria-hidden="true"></div>

      <!-- PRINT SAFE ZONE WRAPPER (3mm Bleed + ~16mm Print Safe Margin Around All 4 Sides) -->
      <div class="v2-print-safe-zone">

      <!-- 1. REFINED, CALM V2 HEADER (Left Logo, Center Title + Short Subtitle, Right Clean 2-Line Jubilee Block) -->
      <header class="v2-poster-header">
        <div class="v2-header-grid">
          <!-- Left: Official Full-Color Festival Logo -->
          <div class="v2-header-logo">
            <Fragment set:html={LogoSvg} />
          </div>

          <!-- Center: Clean Title + Concise Subtitle with Grote Kerk Den Haag -->
          <div class="v2-header-titles">
            <h1 class="v2-poster-main-title editable-node">Het Ontstaan van het Festival</h1>
            <p class="v2-poster-subtitle editable-node">
              Een kwart eeuw passie voor whisky in de Grote Kerk Den Haag
            </p>
          </div>

          <!-- Right: Clean 2-Line Jubilee Block (No Busy Box/Dividers) -->
          <div class="v2-header-crest">
            <div class="v2-crest-clean">
              <div class="v2-crest-years editable-node">2000 &ndash; 2026</div>
              <div class="v2-crest-edition editable-node">25 JAAR HISTORIE</div>
            </div>
          </div>
        </div>
      </header>

      <!-- 2. 100% KINK-FREE CLEAN S-CURVE TIMELINE CANVAS (Exact 1:1 Integer Pixels: 1238 x 1589) -->
      <div class="poster-timeline-canvas" id="timeline-canvas">
        
        <svg class="timeline-svg-layer" id="timeline-svg" viewBox="0 0 1238 1589" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path
            d="M 237 219
               L 928 219
               A 192.5 192.5 0 0 1 928 604
               L 320 604
               A 193 193 0 0 0 320 990
               L 928 990
               A 190.5 190.5 0 0 1 928 1371
               L 313 1371"
            stroke="#caac8e"
            stroke-width="8.5"
            stroke-linecap="round"
            stroke-opacity="0.35"
          />

          <path
            id="s-curve-main"
            d="M 237 219
               L 928 219
               A 192.5 192.5 0 0 1 928 604
               L 320 604
               A 193 193 0 0 0 320 990
               L 928 990
               A 190.5 190.5 0 0 1 928 1371
               L 313 1371"
            stroke="#006448"
            stroke-width="3.5"
            stroke-linecap="round"
          />

          <g id="pointer-lines-group"></g>
        </svg>

        <!-- 4 UNIFORM FESTIVAL PHOTOS (Exact 1:1 Integer Pixels) -->
        <figure class="poster-photo-card draggable-item" style="left: 24px; top: 310px; width: 264px;">
          <div class="photo-inner" style="height: 165px;">
            <img class="retro-photo-img" src="/Afbeeldingen/2025/InternationalWhiskyFestival-MilouvanderWillPhotography-196.jpg" alt="Proeven van bijzondere whisky's" />
          </div>
          <figcaption class="editable-node">Proeven van bijzondere whisky's</figcaption>
        </figure>

        <figure class="poster-photo-card draggable-item" style="left: 954px; top: 4px; width: 264px;">
          <div class="photo-inner" style="height: 165px;">
            <img class="retro-photo-img" src="/timeline_2002_drams.jpg" alt="De Dram als betaalmiddel" />
          </div>
          <figcaption class="editable-node">De Dram als betaalmiddel</figcaption>
        </figure>

        <figure class="poster-photo-card draggable-item" style="left: 954px; top: 696px; width: 264px;">
          <div class="photo-inner" style="height: 165px;">
            <img class="retro-photo-img" src="/Afbeeldingen/2025/InternationalWhiskyFestival-MilouvanderWillPhotography-132.jpg" alt="De beursvloer in de Grote Kerk" />
          </div>
          <figcaption class="editable-node">De beursvloer in de Grote Kerk</figcaption>
        </figure>

        <figure class="poster-photo-card draggable-item" style="left: 24px; top: 1079px; width: 264px;">
          <div class="photo-inner" style="height: 165px;">
            <img class="retro-photo-img" src="/Afbeeldingen/2025/IWF2025-MilouvanderWillPhotography-265.jpg" alt="De Haagsche Whisky Tram" />
          </div>
          <figcaption class="editable-node">De Haagsche Whisky Tram</figcaption>
        </figure>

        <!-- 13 MILESTONES (Exact 1:1 Integer Pixels) -->
        <div
          class="milestone-node milestone-top-row draggable-item"
          data-anchor-x="237"
          data-anchor-y="219"
          style="left: 24px; top: 41px; width: 428px;"
        >
          <div class="ms-header">
            <span class="ms-year">2000</span>
            <h2 class="ms-title editable-node">Het Eerste Whisky Festival</h2>
          </div>
          <p class="ms-desc editable-node">
            Het eerste whiskyfestival van Nederland en Europa &mdash; en <strong>één van de eerste drie ter wereld</strong>, naast San Francisco en Tokyo (nu <em>Whisky Live Japan</em>).
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="494"
          data-anchor-y="219"
          style="left: 324px; top: 269px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2001</span>
            <h2 class="ms-title editable-node">Verhuizing Grote Kerk</h2>
          </div>
          <p class="ms-desc editable-node">
            Het festival krijgt zijn iconische thuisbasis in de <strong>Grote Kerk in Den Haag</strong> en de <em>International Malt Whisky Society</em> wordt opgericht.
          </p>
        </div>

        <div
          class="milestone-node milestone-top-row draggable-item"
          data-anchor-x="703"
          data-anchor-y="219"
          style="left: 489px; top: 41px; width: 428px;"
        >
          <div class="ms-header">
            <span class="ms-year">2002</span>
            <h2 class="ms-title editable-node">De Dram als Betaalmiddel</h2>
          </div>
          <p class="ms-desc editable-node">
            Invoering van de <strong>Dram</strong> als eigen festivalmunt op de beursvloer voor het proeven van bijzondere en exclusieve whisky's.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="1121"
          data-anchor-y="412"
          style="left: 700px; top: 360px; width: 343px;"
        >
          <div class="ms-header">
            <span class="ms-year">2003</span>
            <h2 class="ms-title editable-node">Naamwijziging &amp; Leiden</h2>
          </div>
          <p class="ms-desc editable-node">
            De toevoeging <em>'Malt'</em> vervalt omdat er steeds meer wereldwhisky's worden geschonken. Het festival wijkt tijdelijk uit naar de Pieterskerk in Leiden.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="766"
          data-anchor-y="604"
          style="left: 597px; top: 654px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2004</span>
            <h2 class="ms-title editable-node">Gent &amp; Masterclasses</h2>
          </div>
          <p class="ms-desc editable-node">
            Oprichting van het <strong>Gents Whisky Festival</strong> in België én de start van verdiepende <strong>Masterclasses</strong> in Den Haag.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="494"
          data-anchor-y="604"
          style="left: 324px; top: 451px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2009</span>
            <h2 class="ms-title editable-node">Introductie Whisky Awards</h2>
          </div>
          <p class="ms-desc editable-node">
            Eerste uitreiking van de jaarlijkse <strong>Whisky Awards</strong> voor de meest gewaardeerde bottelingen en standhouders.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="127"
          data-anchor-y="797"
          style="left: 193px; top: 743px; width: 367px;"
        >
          <div class="ms-header">
            <span class="ms-year">2011</span>
            <h2 class="ms-title editable-node">Terugkeer &amp; Whisky Tram</h2>
          </div>
          <p class="ms-desc editable-node">
            Terug naar de vertrouwde <strong>Grote Kerk in Den Haag</strong> én de eerste rit van <strong>Dram in de Tram</strong>: proeven tijdens een stadsrit per historische tram.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="494"
          data-anchor-y="990"
          style="left: 324px; top: 1038px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2015</span>
            <h2 class="ms-title editable-node">De Eigen Festivalslijterij</h2>
          </div>
          <p class="ms-desc editable-node">
            Opening van een eigen slijterij op de kerkvloer, zodat bezoekers hun favoriete geproefde fles direct mee naar huis kunnen nemen.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="766"
          data-anchor-y="990"
          style="left: 597px; top: 835px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2017</span>
            <h2 class="ms-title editable-node">Tasting For Women Only</h2>
          </div>
          <p class="ms-desc editable-node">
            Een primeur op het programma: de allereerste speciale whiskyproeverij exclusief voor <strong>vrouwelijke liefhebbers</strong>.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="1119"
          data-anchor-y="1180"
          style="left: 700px; top: 1126px; width: 343px;"
        >
          <div class="ms-header">
            <span class="ms-year">2022</span>
            <h2 class="ms-title editable-node">Proeven in de Haagse Toren</h2>
          </div>
          <p class="ms-desc editable-node">
            Lancering van de <strong>Toren-tasting</strong>: een beklimming met gids, een dram op grote hoogte en aansluitend een bijzondere proeverij.
          </p>
        </div>

        <div
          class="milestone-node milestone-bottom-row draggable-item"
          data-anchor-x="928"
          data-anchor-y="1371"
          style="left: 639px; top: 1416px; width: 579px;"
        >
          <div class="ms-header">
            <span class="ms-year">2023</span>
            <h2 class="ms-title editable-node">Het Buitenterrein</h2>
          </div>
          <p class="ms-desc editable-node">
            Een sfeervol <strong>buitenplein</strong> naast de Grote Kerk met ambachtelijke foodtrucks, gezellige zitplekken en extra ruimte voor bezoekers.
          </p>
        </div>

        <div
          class="milestone-node draggable-item"
          data-anchor-x="494"
          data-anchor-y="1371"
          style="left: 324px; top: 1215px; width: 338px;"
        >
          <div class="ms-header">
            <span class="ms-year">2025</span>
            <h2 class="ms-title editable-node">Amsterdam &amp; Vatenmaken</h2>
          </div>
          <p class="ms-desc editable-node">
            Oprichting van <strong>WhiskyFest Amsterdam</strong> én introductie van de kuipersworkshop over de invloed van eikenhout op whisky.
          </p>
        </div>

        <div
          class="milestone-node milestone-jubilee-card milestone-bottom-row draggable-item"
          data-anchor-x="313"
          data-anchor-y="1371"
          style="left: 24px; top: 1416px; width: 578px;"
        >
          <div class="jubilee-card-header">
            <span class="ms-year jubilee-year">2026</span>
            <span class="jubilee-tag editable-node">13, 14 &amp; 15 NOVEMBER 2026 &bull; GROTE KERK DEN HAAG</span>
          </div>
          <h2 class="ms-title editable-node">25e Editie International Whisky Festival</h2>
          <p class="ms-desc editable-node">
            Een kwart eeuw passie, vakmanschap en gastvrijheid onder de monumentale gewelven van de Grote Kerk.
          </p>
        </div>

      </div>

      <!-- 3. 100% UNIFORM POSTER FOOTER -->
      <footer class="poster-footer">
        <div class="footer-item footer-left editable-node">
          INTERNATIONAL WHISKY FESTIVAL
        </div>
        <div class="footer-item footer-center editable-node">
          25E JUBILEUMEDITIE
        </div>
        <div class="footer-item footer-right editable-node">
          WHISKYFESTIVAL.NL
        </div>
      </footer>

      </div><!-- /.v2-print-safe-zone -->

    </article>
  </main>

  <!-- Inline stylesheet guarantees zero Vite HMR cache mismatch -->
  <style is:inline>
    /* ----------------------------------------------------
       SCREEN TOOLBAR & STAGE
       ---------------------------------------------------- */
    .poster-toolbar {
      position: sticky;
      top: 0;
      z-index: 200;
      background: #1D1C1A;
      color: #FAF7F2;
      border-bottom: 2px solid #006448;
      padding: 0.75rem 1.5rem;
      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.25);
    }

    .toolbar-inner {
      max-width: 1400px;
      margin: 0 auto;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      flex-wrap: wrap;
    }

    .toolbar-left {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .toolbar-back-link {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      color: #FAF7F2;
      text-decoration: none;
      font-family: var(--font-sans);
      font-size: 0.85rem;
      font-weight: 700;
      padding: 0.4rem 0.75rem;
      border-radius: 4px;
      background: rgba(255, 255, 255, 0.08);
      transition: background 0.2s ease;
    }

    .toolbar-back-link:hover {
      background: rgba(255, 255, 255, 0.16);
    }

    .toolbar-badge {
      font-family: var(--font-sans);
      font-size: 0.75rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      color: #caac8e;
      border: 1px solid rgba(202, 172, 142, 0.4);
      padding: 0.25rem 0.6rem;
      border-radius: 4px;
    }

    .toolbar-actions {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .toolbar-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--font-sans);
      font-size: 0.82rem;
      font-weight: 800;
      padding: 0.5rem 0.95rem;
      border-radius: 5px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .toolbar-btn-outline {
      background: transparent;
      color: #FAF7F2;
      border: 1.5px solid rgba(250, 247, 242, 0.35);
    }

    .toolbar-btn-outline:hover {
      border-color: #caac8e;
      color: #caac8e;
    }

    .toolbar-btn-primary {
      background: #006448;
      color: #FFFFFF;
      border: 1.5px solid #caac8e;
      box-shadow: 2px 2px 0px #000000;
    }

    .toolbar-btn-primary:hover {
      background: #004D37;
    }

    .poster-stage-wrapper {
      background: #2A2927;
      min-height: calc(100vh - 60px);
      padding: 2.5rem 1.5rem 4rem;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      overflow-x: auto;
    }

    /* ----------------------------------------------------
       A3 SHEET: Exact 1400px x 1980px (= 297mm x 420mm ratio)
       ---------------------------------------------------- */
    .a3-poster-sheet {
      position: relative !important;
      width: 1400px !important;
      height: 1980px !important;
      min-width: 1400px !important;
      min-height: 1980px !important;
      background-color: #FAF7F2 !important;
      color: #1D1C1A !important;
      box-shadow: 0 25px 75px rgba(0, 0, 0, 0.6);
      padding: 88px 81px 82px !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      overflow: hidden !important;
      box-sizing: border-box !important;
    }

    /* ----------------------------------------------------
       0A. AUTHENTIC HANDMADE COTTON & LAID PARCHMENT PAPER
       ---------------------------------------------------- */
    .v2-crumpled-paper-bg {
      position: absolute !important;
      inset: 0 !important;
      width: 1400px !important;
      height: 1980px !important;
      pointer-events: none !important;
      z-index: 1 !important;
      overflow: hidden !important;
      background-color: #FAF7F2 !important;
    }

    .v2-paper-texture-img,
    .v2-baked-paper-print {
      position: absolute !important;
      inset: 0 !important;
      width: 1400px !important;
      height: 1980px !important;
      object-fit: cover !important;
      display: block !important;
      z-index: 1 !important;
    }

    /* ----------------------------------------------------
       0B. CLEAN SINGLE HAIRLINE FRAME & PRINT SAFE ZONE
       100% Native 1:1 Integer Pixels (zoom: 1, transform: none)
       ---------------------------------------------------- */
    .v2-clean-frame {
      position: absolute !important;
      inset: 44px !important;
      border: 1px solid rgba(0, 100, 72, 0.28) !important;
      border-radius: 2px !important;
      pointer-events: none !important;
      z-index: 20 !important;
    }

    .a3-poster-sheet.frame-none .v2-clean-frame {
      display: none !important;
    }

    .v2-print-safe-zone {
      position: relative !important;
      z-index: 5 !important;
      width: 1238px !important;
      height: 1810px !important;
      display: flex !important;
      flex-direction: column !important;
      justify-content: space-between !important;
      transform: none !important;
      zoom: 1 !important;
      box-sizing: border-box !important;
    }

    /* ----------------------------------------------------
       1. REDESIGNED V2 HEADER (Exact 1194px Width)
       ---------------------------------------------------- */
    .v2-poster-header {
      position: relative !important;
      z-index: 15 !important;
      width: 1194px !important;
      margin-left: 24px !important;
      margin-right: 20px !important;
      display: flex !important;
      flex-direction: column !important;
      box-sizing: border-box !important;
    }

    .v2-header-grid {
      display: grid !important;
      grid-template-columns: 150px 1fr 150px !important;
      align-items: center !important;
      gap: 22px !important;
      width: 100% !important;
      padding-bottom: 11px !important;
    }

    .v2-header-logo {
      width: 117px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: flex-start !important;
    }

