    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    box-shadow: 0 10px 30px rgba(0,0,0,0.35);
    border: 1.5px solid #C58B39;
    z-index: 999999;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transform: translateY(20px);
    opacity: 0;
    transition: all 0.3s cubic-bezier(0.16,1,0.3,1);
