    timeLabel: '19:00 - 23:00 uur',
    items: buildSessionItems('zaterdag', false)
  },
  {
    id: 'zondag-middag',
    name: 'Zondagmiddag',
    dayLabel: 'Zondag 14 Nov',
    timeLabel: '13:00 - 17:00 uur',
    items: buildSessionItems('zondag', true)
  }
];

const BOTTELLINGS = liveTickets
  .filter(t => t.category === 'botteling')
  .map(t => ({
    id: t.id,
    title: t.title,
    spec: `Single Cask Edition • Gelimiteerde Oplage (${t.capacity || 125} flessen)`,
    description: t.description || 'Exclusieve festivalbotteling voor International Whisky Festival Den Haag 2027.',
    price: Number(t.price) || 79.00
  }));

function formatSpeaker(host: string) {
  if (!host) return { name: '—', role: '' };
  
  const match = host.match(/^(.*?)\s*\((.*?)\)$/);
  if (match) {
    return { name: match[1].trim(), role: match[2].trim() };
  }
  
  if (host.includes('•')) {
    const parts = host.split('•');
    return { name: parts[0].trim(), role: parts.slice(1).join(' • ').trim() };
  }

  return { name: host, role: '' };
}
---

<Layout 
  title="Programma & Tijdschema 2027 - Whisky Fest Den Haag" 
  description="Volledig tijdschema van alle masterclasses, tramritten en tastings tijdens Whisky Fest Den Haag."
>
  <Header />

  <main class="programma-page-main">
    
    <!-- 1. FULL-WIDTH AUTHENTIC FESTIVAL HERO (100% SCHOON & RUSTIG) -->
    <header class="programma-full-hero">
      <div class="hero-photo-layer" aria-hidden="true"></div>
      <div class="hero-tint-overlay" aria-hidden="true"></div>
      
      <div class="hero-barrel-art" aria-hidden="true">
        <img src="/barrels line.svg" alt="" width="360" height="420" loading="eager" />
      </div>

      <div class="hero-content-wrapper animate-fade-in">
        <h1 class="hero-main-title">
          Festival Programma &amp; Tijdschema
        </h1>
        <div class="hero-gold-line"></div>
        <p class="hero-lead-paragraph">
          Stel uw persoonlijke festivalbezoek samen. Bekijk alle masterclasses in het Nutshuis, historische tramritten, tastings en rondleidingen met onze gidsen.
        </p>
      </div>
    </header>

    <!-- 2. MAIN CONTAINER ON PARCHMENT BACKGROUND -->
    <div class="agenda-parchment-container">
      
      <!-- 7-CARD SESSION SELECTOR STRIP -->
      <nav class="session-selector-strip" aria-label="Kies een festival sessie of activiteit">
        {SESSIONS.map((s, idx) => (
          <button 
            type="button" 
            class={`session-btn-card ${idx === 0 ? 'active' : ''}`}
            data-target-tab={s.id}
          >
            <span class="btn-card-day">{s.dayLabel}</span>
            <span class="btn-card-name">{s.name}</span>
            <span class="btn-card-time">{s.timeLabel}</span>
          </button>
        ))}
        
        <button 
          type="button" 
          class="session-btn-card"
          data-target-tab="bottelingen"
        >
          <span class="btn-card-day">Exclusief</span>
          <span class="btn-card-name">Festival Bottelingen</span>
          <span class="btn-card-time">Afhalen Slijterij</span>
        </button>

        <button 
          type="button" 
          class="session-btn-card btn-gidsen-special"
          data-target-tab="gidsen"
        >
          <span class="btn-card-day">Rondleiding</span>
          <span class="btn-card-name">Whisky Gidsen</span>
          <span class="btn-card-time">Planning &amp; Trails</span>
        </button>
      </nav>

      <!-- PANES LIST -->
      <div class="agenda-panes-list">
        
        <!-- 1-5: The 5 Day Sessions -->
        {SESSIONS.map((s, idx) => (
          <section 
            class={`session-agenda-pane ${idx === 0 ? 'active' : ''}`}
            id={`pane-${s.id}`}
          >
            <!-- Pane Header -->
            <div class="pane-header-bar">
              <h2 class="pane-title">{s.name}</h2>
              <span class="pane-badge-time">{s.dayLabel} &bull; {s.timeLabel}</span>
            </div>

            <!-- Masterclasses & Tastings Rows -->
            <div class="pane-rows-list">
              <!-- Column Titles Header -->
              <div class="agenda-table-head">
                <span class="th-cell th-time">Tijd</span>
                <span class="th-cell th-title">Programma</span>
                <span class="th-cell th-type-loc">Type &amp; Locatie</span>
                <span class="th-cell th-speaker">Spreker / Gids</span>
                <span class="th-cell th-action">Prijs &amp; Bestellen</span>
              </div>

              <!-- Rows in 5 Clean Columns -->
              {s.items.map((item) => (
                <article class="agenda-row-item" data-ticket-id={item.id}>
                  <!-- 1. Tijd (Begin- en Eindtijd) -->
                  <div class="col-time">
                    <span class="item-time-val">{item.time}</span>
                  </div>

                  <!-- 2. Programma Titel (1 regel) -->
                  <div class="col-title">
                    <h3 class="item-name">{item.title}</h3>
                  </div>

                  <!-- 3. Type & Locatie -->
                  <div class="col-type-loc">
                    <span class={`cat-pill cat-${item.category}`}>{item.categoryLabel}</span>
                    <span class="item-loc-tag">
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                      {item.location}
                    </span>
                  </div>

                  <!-- 4. Spreker / Gids (Naam bovenaan, rol/titel eronder) -->
                  <div class="col-speaker">
                    {(() => {
                      const spk = formatSpeaker(item.host);
                      return (
                        <div class="speaker-block">
                          <strong class="speaker-name">{spk.name}</strong>
                          {spk.role && <span class="speaker-role">{spk.role}</span>}
                        </div>
                      );
                    })()}
                  </div>

                  <!-- 5. Prijs & Details / Bestelknop -->
                  <div class="col-action">
                    <strong class="item-price">€ {item.price.toFixed(2).replace('.', ',')}</strong>
                    <div class="action-buttons-group">
                      <button 
                        type="button" 
                        class="btn-trigger-details"
                        data-title={item.title}
                        data-loc={item.location}
                        data-time={item.time}
                        data-host={item.host}
                        data-desc={item.description}
                        data-price={`€ ${item.price.toFixed(2).replace('.', ',')}`}
                      >
                        Details
                      </button>
                      <button 
                        type="button" 
                        class="btn btn-gold btn-table-buy"
                        data-ticket-id={item.id}
                        data-title={item.title}
                      >
                        + Bestel
                      </button>
                    </div>
                  </div>
                </article>
              ))}
            </div>

            <!-- DIRECT IN-PANE TRAIL MATRIX (Als er trails zijn in deze sessie) -->
            {SESSION_TRAIL_MAP[s.id] && (
              <div class="session-trail-matrix-box">
                <div class="stmb-header">
                  <div class="stmb-title-box">
                    <span class="stmb-kicker">30 MIN RONDLEIDING &bull; € 5,00 INCL. 5 PROEFDRAMS</span>
                    <h3 class="stmb-title">Whisky Gidsen Planning &bull; {s.name}</h3>
                  </div>
                  <span class="stmb-badge">Start bij Infostand Grote Kerk</span>
                </div>

                <div class="matrix-table-container">
                  <table class="whisky-matrix-table">
                    <thead>
                      <tr>
                        <th class="col-time-head">Tijdslot</th>
                        {GUIDE_COLUMNS.map((g) => (
                          <th class="col-guide-head">
                            <div class="gh-box">
                              <strong class="gh-name">{g.name}</strong>
                              <span class="gh-spec">{g.specialty}</span>
                            </div>
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {SESSION_TRAIL_MAP[s.id]!.rows.map((row) => (
                        <tr>
                          <td class="td-time-cell">
                            <span class="matrix-time-val">{row.time}</span>
                            <span class="matrix-time-sub">Start Infostand</span>
                          </td>
                          {GUIDE_COLUMNS.map((g) => {
                            const slot = row.slots[g.key];
                            return (
                              <td class={`td-guide-cell ${slot ? 'cell-active' : 'cell-empty'}`}>
                                {slot ? (() => {
                                  const slotInfo = getSlotTicketInfo(slot.ticketId, g.key, row.time, s.id);
                                  return (
                                    <div class="slot-book-cell">
                                      {slotInfo.isSoldOut ? (
                                        <span class="avail-indicator sold-out">Volgeboekt (0 plekken)</span>
                                        <button 
                                          type="button" 
                                          class="btn-matrix-action sold-out"
                                          disabled
                                        >
                                          Uitverkocht
                                        </button>
                                      ) : (
                                        <span class="avail-indicator">{slotInfo.freeSpots} {slotInfo.freeSpots === 1 ? 'plek' : 'plekken'} vrij</span>
                                        <button 
                                          type="button" 
                                          class="btn-matrix-action"
                                          data-ticket-id={slotInfo.ticketId}
                                          data-title={`Whisky Trail (Gids ${g.name} - ${row.time} uur)`}
                                        >
                                          + Boek € {slotInfo.price},-
                                        </button>
                                      )}
                                    </div>
                                  );
                                })() : (
                                  <span class="dash-empty">—</span>
                                )}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

          </section>
        ))}

        <!-- 6: Bottelingen Pane -->
        <section class="session-agenda-pane" id="pane-bottelingen">
          <div class="pane-header-bar">
            <h2 class="pane-title">Exclusieve Festival Bottelingen 2027</h2>
            <span class="pane-badge-time">Afhalen bij Festivalslijterij (Grote Kerk)</span>
          </div>

          <div class="pane-rows-list">
            {BOTTELLINGS.map((b) => (
              <article class="agenda-row-item">
                <!-- Left: Status & Location -->
                <div class="col-time-loc">
                  <span class="item-time-val">Single Cask</span>
                  <span class="item-loc-tag">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    Festivalslijterij
                  </span>
                </div>

                <!-- Center: Title & Specs -->
                <div class="col-info">
                  <div class="info-line-top">
                    <h3 class="item-name">{b.title}</h3>
                    <span class="cat-pill cat-warehouse">Gelimiteerd</span>
                  </div>
                  <div class="info-line-sub">
                    <span class="speaker-name">{b.spec}</span>
                  </div>
                </div>

                <!-- Right: Price & Actions -->
                <div class="col-action">
                  <strong class="item-price">€ {b.price.toFixed(2).replace('.', ',')}</strong>
                  <div class="action-buttons-group">
                    <button 
                      type="button" 
                      class="btn-trigger-details"
                      data-title={b.title}
                      data-loc="Festivalslijterij (Grote Kerk)"
                      data-time="Tijdens festival afhalen"
                      data-host={b.spec}
                      data-desc={b.description}
                      data-price={`€ ${b.price.toFixed(2).replace('.', ',')}`}
                    >
                      Details
                    </button>
                    <button 
                      type="button" 
                      class="btn btn-gold btn-table-buy"
                      data-ticket-id={b.id}
                      data-title={b.title}
                    >
                      + Reserveer
                    </button>
                  </div>
                </div>
              </article>
            ))}
          </div>
        </section>

        <!-- 7: Whisky Gidsen Planning Matrix Pane -->
        <section class="session-agenda-pane" id="pane-gidsen">
          
          <div class="pane-header-bar">
            <div class="phb-left">
              <h2 class="pane-title">Whisky Gidsen &amp; Trail Planning</h2>
              <p class="phb-subtitle">Persoonlijke rondleiding van 30 min langs bijzondere stands in de Grote Kerk &bull; <strong>€ 5,00 inclusief 5 gratis proefdrams</strong></p>
            </div>
            <span class="pane-badge-time">Kies een Sessie Hieronder</span>
          </div>

          <!-- Sessie Schakelaar voor Trails -->
          <div class="trail-inner-session-strip">
            {MATRIX_SESSIONS.map((ms, idx) => (
              <button 
                type="button" 
                class={`trail-inner-btn ${idx === 0 ? 'active' : ''}`}
                data-target-trail-matrix={ms.id}
              >
                <span class="tib-day">{ms.dayLabel}</span>
                <span class="tib-name">{ms.title}</span>
