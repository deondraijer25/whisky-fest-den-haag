import Footer from '../components/Footer.astro';
import { getTickets } from '../lib/ghl';

const liveTickets = await getTickets('den_haag');

function getSlotTicketInfo(slotTicketId: string, guideKey: string, timeStr: string, sessionDay: string) {
  const expectedDay = sessionDay.includes('fri') || sessionDay.includes('vrijdag')
    ? 'vrijdag'
    : sessionDay.includes('sat') || sessionDay.includes('zaterdag')
    ? 'zaterdag'
    : 'zondag';
  const expectedDaypart = sessionDay.includes('evening') || sessionDay.includes('avond') ? 'avond' : 'middag';

  const t = liveTickets.find(ticket => ticket.id === slotTicketId) ||
            liveTickets.find(ticket => {
              if (ticket.category !== 'trail') return false;
              const gLower = guideKey.toLowerCase();
              const titleLower = (ticket.title || '').toLowerCase();
              const ambLower = (ticket.ambassadorName || '').toLowerCase();
              const matchesGuide = titleLower.includes(gLower) || ambLower.includes(gLower) ||
                (gLower === 'marlie' && (titleLower.includes('marly') || ambLower.includes('marly')));
              const matchesTime = ticket.time?.includes(timeStr.split(' - ')[0]) || ticket.time === timeStr;
              const matchesDay = !ticket.day || ticket.day === expectedDay;
              const matchesPart = !ticket.daypart || ticket.daypart === expectedDaypart;
              return matchesGuide && matchesTime && matchesDay && matchesPart;
            });

  const capacity = t?.capacity || 6;
  const sold = t?.sold || 0;
  const freeSpots = Math.max(0, capacity - sold);
  const isSoldOut = Boolean(t?.isSoldOut || (capacity > 0 && sold >= capacity) || freeSpots === 0);

  return {
    ticketId: t?.id || slotTicketId,
    capacity,
    sold,
    freeSpots,
    isSoldOut,
    price: t?.price || 5
  };
}

interface ProgramRow {
  id: string;
  time: string;
  location: string;
  title: string;
  category: 'masterclass' | 'tram' | 'trail' | 'warehouse' | 'workshop' | 'botteling';
  categoryLabel: string;
  host: string;
  description: string;
  price: number;
}

interface SessionData {
