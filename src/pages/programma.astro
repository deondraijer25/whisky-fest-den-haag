                  </div>
                  <span class="stmb-badge">Start bij Infostand Grote Kerk</span>
                </div>

                <div class="matrix-table-container">
                  <table class="whisky-matrix-table">
                    <thead>
                      <tr>
                        <th class="col-time-head">Tijdslot</th>
                        {GUIDE_COLUMNS.map((g) => (
                          <th class="col-guide-head">
                            <div class="gh-box">
                              <strong class="gh-name">{g.name}</strong>
                              <span class="gh-spec">{g.specialty}</span>
                            </div>
                          </th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {SESSION_TRAIL_MAP[s.id]!.rows.map((row) => (
                        <tr>
                          <td class="td-time-cell">
                            <span class="matrix-time-val">{row.time}</span>
                            <span class="matrix-time-sub">Start Infostand</span>
                          </td>
                          {GUIDE_COLUMNS.map((g) => {
                            const slot = row.slots[g.key];
                            return (
                              <td class={`td-guide-cell ${slot ? 'cell-active' : 'cell-empty'}`}>
                                {slot ? (() => {
                                  const slotInfo = getSlotTicketInfo(slot.ticketId, g.key, row.time, s.id);
                                  return (
                                    <div class="slot-book-cell">
                                      {slotInfo.isSoldOut ? (
                                        <span class="avail-indicator sold-out">Volgeboekt (0 plekken)</span>
                                        <button 
                                          type="button" 
                                          class="btn-matrix-action sold-out"
                                          disabled
                                        >
                                          Uitverkocht
                                        </button>
                                      ) : (
                                        <span class="avail-indicator">{slotInfo.freeSpots} {slotInfo.freeSpots === 1 ? 'plek' : 'plekken'} vrij</span>
                                        <button 
                                          type="button" 
                                          class="btn-matrix-action"
                                          data-ticket-id={slotInfo.ticketId}
                                          data-title={`Whisky Trail (Gids ${g.name} - ${row.time} uur)`}
                                        >
                                          + Boek € {slotInfo.price},-
                                        </button>
                                      )}
                                    </div>
                                  );
                                })() : (
                                  <span class="dash-empty">—</span>
                                )}
                              </td>
                            );
                          })}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}

          </section>
        ))}

        <!-- 6: Bottelingen Pane -->
