// Map session ID to matrix session
const SESSION_TRAIL_MAP: Record<string, TrailMatrixSession | undefined> = {
  'vrijdag-avond': MATRIX_SESSIONS[0],
  'zaterdag-middag': MATRIX_SESSIONS[1],
  'zaterdag-avond': MATRIX_SESSIONS[2],
  'zondag-middag': MATRIX_SESSIONS[3]
};

function mapTicketToProgramRow(t: any): ProgramRow {
  const rawCat = (t.category || 'masterclass').toLowerCase();
  const mappedCat: ProgramRow['category'] =
    rawCat === 'vatenmaken' ? 'workshop' :
    rawCat === 'tram' ? 'tram' :
    rawCat === 'warehouse' ? 'warehouse' :
    rawCat === 'trail' ? 'trail' :
    rawCat === 'botteling' ? 'botteling' : 'masterclass';

  const catLabel =
    mappedCat === 'workshop' ? 'Cooperclass' :
    mappedCat === 'tram' ? 'Whiskytram' :
    mappedCat === 'warehouse' ? 'Warehouse Tasting' :
    t.title?.toLowerCase().includes('torentasting') ? 'Torentasting' :
    t.title?.toLowerCase().includes('introductie') ? 'Introductie' : 'Masterclass';

  const cleanTimeStr = (t.time || '')
    .replace(/\s*uur/gi, '')
    .replace(/\s*-\s*/g, ' – ')
    .trim();

  const hostStr = t.ambassadorName
    ? (t.ambassadorTitle ? `${t.ambassadorName} (${t.ambassadorTitle})` : t.ambassadorName)
    : 'Festival Specialist';

  return {
    id: t.id,
    time: cleanTimeStr,
    location: t.location || 'Grote Kerk Den Haag',
    title: t.title,
    category: mappedCat,
    categoryLabel: catLabel,
    host: hostStr,
    description: t.description || '',
    price: Number(t.price) || 0
  };
}

function buildSessionItems(day: string, isAfternoon: boolean): ProgramRow[] {
  return liveTickets
    .filter(t => {
      if (t.category === 'entree' || t.category === 'botteling' || t.category === 'trail') return false;
      if (t.day !== day) return false;
      const dp = t.daypart || 'middag';
      if (isAfternoon) return dp === 'ochtend' || dp === 'middag';
      return dp === 'avond';
    })
    .map(mapTicketToProgramRow)
    .sort((a, b) => a.time.localeCompare(b.time));
}

const SESSIONS: SessionData[] = [
  {
    id: 'vrijdag-middag',
    name: 'Vrijdag VIP',
    dayLabel: 'Vrijdag 12 Nov',
    timeLabel: '13:00 - 17:00 uur',
    items: buildSessionItems('vrijdag', true)
  },
  {
    id: 'vrijdag-avond',
    name: 'Vrijdagavond',
    dayLabel: 'Vrijdag 12 Nov',
    timeLabel: '19:00 - 23:00 uur',
    items: buildSessionItems('vrijdag', false)
  },
  {
    id: 'zaterdag-middag',
    name: 'Zaterdagmiddag',
    dayLabel: 'Zaterdag 13 Nov',
    timeLabel: '13:00 - 17:00 uur',
