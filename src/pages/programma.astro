const liveTickets = await getTickets('den_haag');

function getSlotTicketInfo(slotTicketId: string, guideKey: string, timeStr: string, sessionDay: string) {
  const t = liveTickets.find(ticket => ticket.id === slotTicketId) ||
            liveTickets.find(ticket => {
              if (ticket.category !== 'trail') return false;
              const matchesGuide = ticket.title?.toLowerCase().includes(guideKey.toLowerCase()) ||
                                   ticket.ambassadorName?.toLowerCase().includes(guideKey.toLowerCase());
              const matchesTime = ticket.time?.includes(timeStr.split(' - ')[0]) || ticket.time === timeStr;
              return matchesGuide && matchesTime;
            });

  const capacity = t?.capacity || 6;
  const sold = t?.sold || 0;
  const freeSpots = Math.max(0, capacity - sold);
  const isSoldOut = Boolean(t?.isSoldOut || (capacity > 0 && sold >= capacity) || freeSpots === 0);

  return {
    ticketId: t?.id || slotTicketId,
    capacity,
    sold,
    freeSpots,
    isSoldOut,
    price: t?.price || 5
  };
}

