</style>

<script define:vars={{ liveTicketsData: liveTickets }}>
  let ticketsList = Array.isArray(liveTicketsData) ? liveTicketsData : [];

  function updateProgrammaTicketsData(records) {
    if (!Array.isArray(records) || records.length === 0) return;
    records.forEach(r => {
      const p = r.properties || r;
      const cleanTitle = (p.title || '').replace(/\s*(?:1[0-9]|2[0-3]):[0-5][0-9]\s*[-–—]\s*(?:1[0-9]|2[0-3]):[0-5][0-9]\s*(?:uur)?/gi, '').trim();
      const priceNum = typeof p.price === 'number' ? p.price : (parseFloat(p.price) || parseFloat(p.ticket_price) || 0);
      const isSoldOut = p.is_sold_out === true || p.is_sold_out === 'true' || p.is_sold_out === '1' || p.is_sold_out === 'ja' || p.is_sold_out === 'yes';

      let target = ticketsList.find(t => t.id === r.id);
      if (!target) {
        target = ticketsList.find(t =>
          t.title && cleanTitle && (
            t.title.toLowerCase().replace(/[^a-z0-9]/g, '').includes(cleanTitle.toLowerCase().replace(/[^a-z0-9]/g, '')) ||
            cleanTitle.toLowerCase().replace(/[^a-z0-9]/g, '').includes(t.title.toLowerCase().replace(/[^a-z0-9]/g, ''))
          )
        );
      }
      if (target) {
        target.id = r.id;
        target.title = cleanTitle;
        target.price = priceNum;
        if (p.day) target.day = p.day;
        if (p.daypart) target.daypart = p.daypart;
        if (p.date_label) target.date = p.date_label;
        if (p.time_label) target.time = p.time_label;
        if (p.category) target.category = p.category;
        target.isSoldOut = isSoldOut;
      }
    });
  }

  window.addEventListener('ghl:tickets-updated', (e) => {
    if (e.detail) updateProgrammaTicketsData(e.detail);
  });

  if (Array.isArray(window.__LIVE_GHL_TICKETS__)) {
    updateProgrammaTicketsData(window.__LIVE_GHL_TICKETS__);
  }

  function initProgramma() {
    // 1. Session Tab Switching (All 7 Cards)
    const navTabs = document.querySelectorAll('.session-btn-card');
    const panes = document.querySelectorAll('.session-agenda-pane');

    function switchTab(targetId, shouldScroll) {
      if (!targetId) return;
      const cleanId = targetId.replace('pane-', '').toLowerCase();
      const targetTab = Array.from(navTabs).find(t => (t.getAttribute('data-target-tab') || '').toLowerCase() === cleanId);
      if (!targetTab) return;

      navTabs.forEach(t => t.classList.remove('active'));
      targetTab.classList.add('active');

      panes.forEach(p => {
        if (p.id === `pane-${cleanId}`) {
          p.classList.add('active');
          if (shouldScroll) {
            setTimeout(() => {
              const yOffset = -90;
              const y = p.getBoundingClientRect().top + window.pageYOffset + yOffset;
              window.scrollTo({ top: y, behavior: 'smooth' });
            }, 150);
          }
        } else {
          p.classList.remove('active');
        }
      });
    }

    navTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-target-tab');
        if (targetId) switchTab(targetId, false);
      });
    });

    // Handle URL query parameters and hash on load (e.g. ?view=gidsen or #pane-gidsen)
    function handleUrlTarget(shouldScroll) {
      const urlParams = new URLSearchParams(window.location.search);
      const viewParam = urlParams.get('view') || urlParams.get('tab');
      const hashParam = window.location.hash.replace('#pane-', '').replace('#', '');
      const target = viewParam || hashParam;
      if (target) {
        switchTab(target, shouldScroll);
      }
    }

    // Run on initial load
    handleUrlTarget(true);

    // Run on hash changes or popstate navigation
    window.addEventListener('hashchange', () => handleUrlTarget(true));
    window.addEventListener('popstate', () => handleUrlTarget(false));


    // 2. Trail Inner Matrix Session Switcher
    const trailTabs = document.querySelectorAll('.trail-inner-btn');
    const trailPanes = document.querySelectorAll('.trail-matrix-subpane');

    trailTabs.forEach(tab => {
      tab.addEventListener('click', () => {
        trailTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const targetId = tab.getAttribute('data-target-trail-matrix');
        trailPanes.forEach(p => {
          if (p.id === `tmatrix-${targetId}`) {
            p.classList.add('active');
          } else {
            p.classList.remove('active');
          }
        });
      });
    });

    // 3. Toast Helper
    function showToast(message) {
      const toast = document.getElementById('spacious-toast');
      if (!toast) return;
      toast.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#F8E3B6" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg> <span>${message}</span>`;
      toast.style.display = 'flex';
      toast.style.opacity = '1';
      toast.style.transform = 'translateY(0)';
      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(20px)';
        setTimeout(() => { toast.style.display = 'none'; }, 300);
      }, 3200);
    }

    function getProgrammaCart() {
      try {
        const stored = localStorage.getItem('whiskyfest_cart');
        if (!stored) return {};
        const parsed = JSON.parse(stored);
        if (!parsed || typeof parsed !== 'object') return {};

        const result = {};
        if (parsed.cartRaw && typeof parsed.cartRaw === 'object') {
          Object.keys(parsed.cartRaw).forEach(k => {
            if (k === 'subtotal' || k === 'totalItems' || k === 'items' || k === 'cartRaw') return;
            const item = parsed.cartRaw[k];
            if (item && ((typeof item === 'number' && item > 0) || (item.qty && item.qty > 0))) {
              result[k] = typeof item === 'object' ? { ...item, id: k } : { id: k, qty: item };
            }
          });
          return result;
        }

        if (Array.isArray(parsed.items)) {
          parsed.items.forEach(item => {
            if (item && item.id && item.qty > 0) {
              result[item.id] = { ...item };
            }
          });
          return result;
        }

        Object.keys(parsed).forEach(k => {
          if (k === 'subtotal' || k === 'totalItems' || k === 'items' || k === 'cartRaw') return;
          const item = parsed[k];
          if (item && ((typeof item === 'number' && item > 0) || (item.qty && item.qty > 0))) {
            result[k] = typeof item === 'object' ? { ...item, id: k } : { id: k, qty: item };
          }
        });
        return result;
      } catch (e) {
        return {};
      }
    }

    function saveProgrammaCart(cart) {
      try {
        const cleaned = {};
        const itemsArr = [];
        let totalQty = 0;
        let subtotal = 0;

        Object.keys(cart).forEach(k => {
          if (k === 'subtotal' || k === 'totalItems' || k === 'items' || k === 'cartRaw') return;
          const it = cart[k];
          if (!it) return;
          const qty = typeof it === 'number' ? it : it.qty;
          if (qty > 0) {
            const rawObj = (ticketsList || []).find(t => t.id === k);
            const price = (typeof it === 'object' && it.price !== undefined) ? it.price : (rawObj?.price || 20);
            const title = (typeof it === 'object' && it.title) ? it.title : (rawObj?.title || k);
            const category = (typeof it === 'object' && it.category) ? it.category : (rawObj?.category || 'masterclass');
            const date = (typeof it === 'object' && it.date) ? it.date : (rawObj?.date || '');
            const time = (typeof it === 'object' && it.time) ? it.time : (rawObj?.time || '');

            const cleanItem = {
              id: k,
              title: title,
              price: price,
              qty: qty,
              category: category,
              date: date,
              time: time,
              timeslot: (typeof it === 'object' && it.timeslot) ? it.timeslot : time,
              guide: (typeof it === 'object' && it.guide) ? it.guide : '',
              delivery: (typeof it === 'object' && it.delivery) ? it.delivery : ''
            };
            cleaned[k] = cleanItem;
            itemsArr.push(cleanItem);
            totalQty += qty;
            subtotal += price * qty;
          }
        });

        localStorage.setItem('whiskyfest_cart', JSON.stringify({
          subtotal: subtotal,
          totalItems: totalQty,
          items: itemsArr,
          cartRaw: cleaned
        }));

        window.dispatchEvent(new Event('storage'));
        window.dispatchEvent(new CustomEvent('cart-updated', { detail: { count: totalQty, subtotal: subtotal } }));
      } catch (e) {
        console.error('saveProgrammaCart error:', e);
      }
    }

    // 4. Add to Cart (Standard Items)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-table-buy');
      if (!btn) return;

      e.preventDefault();
      const ticketId = btn.getAttribute('data-ticket-id') || '';
      const title = btn.getAttribute('data-title') || 'Ticket';
      const priceStr = btn.getAttribute('data-price') || '20';
      const parsedPrice = parseFloat(priceStr.replace(/[^0-9.]/g, '')) || 20;

      try {
        const cart = getProgrammaCart();
        const itemObj = (ticketsList || []).find(t => t.id === ticketId);

        if (!cart[ticketId]) {
          cart[ticketId] = {
            id: ticketId,
            title: title,
            price: itemObj ? itemObj.price : parsedPrice,
            qty: 1,
            category: itemObj ? itemObj.category : 'masterclass',
            date: itemObj ? itemObj.date : '',
            time: itemObj ? itemObj.time : ''
          };
        } else {
          const currentQty = typeof cart[ticketId] === 'number' ? cart[ticketId] : (cart[ticketId].qty || 0);
          const currentPrice = typeof cart[ticketId] === 'object' ? cart[ticketId].price : (itemObj ? itemObj.price : parsedPrice);
          cart[ticketId] = {
            id: ticketId,
            title: title,
            price: currentPrice,
            qty: Math.min(10, currentQty + 1),
            category: itemObj ? itemObj.category : 'masterclass',
            date: itemObj ? itemObj.date : '',
            time: itemObj ? itemObj.time : ''
          };
        }
        saveProgrammaCart(cart);
        showToast(`Toegevoegd aan winkelwagen: ${title}`);

        // Open mobile bottom sheet cart drawer immediately on mobile screens
        if (window.innerWidth <= 990) {
          window.dispatchEvent(new CustomEvent('open-mobile-cart-drawer', { detail: { view: 'cart' } }));
        }
      } catch (err) {
        showToast(`Toegevoegd: ${title}`);
      }
    });

    // 5. Book Matrix Slot (Trail Schedule)
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-matrix-action');
      if (!btn) return;

      e.preventDefault();
      const ticketId = btn.getAttribute('data-ticket-id') || '';
      const title = btn.getAttribute('data-title') || 'Whisky Trail';

      try {
        const cart = getProgrammaCart();
        const itemObj = (ticketsList || []).find(t => t.id === ticketId);

        if (!cart[ticketId]) {
          cart[ticketId] = {
            id: ticketId,
            title: title,
            price: itemObj ? itemObj.price : 5.00,
            qty: 1,
            category: 'trail',
            date: itemObj ? itemObj.date : '',
            time: itemObj ? itemObj.time : ''
          };
        } else {
          const currentQty = typeof cart[ticketId] === 'number' ? cart[ticketId] : (cart[ticketId].qty || 0);
          const currentPrice = typeof cart[ticketId] === 'object' ? cart[ticketId].price : (itemObj ? itemObj.price : 5.00);
          cart[ticketId] = {
            id: ticketId,
            title: title,
            price: currentPrice,
            qty: Math.min(10, currentQty + 1),
            category: 'trail',
            date: itemObj ? itemObj.date : '',
            time: itemObj ? itemObj.time : ''
          };
        }
        saveProgrammaCart(cart);
        showToast(`Toegevoegd aan winkelwagen: ${title}`);

        // Open mobile bottom sheet cart drawer immediately on mobile screens
        if (window.innerWidth <= 990) {
          window.dispatchEvent(new CustomEvent('open-mobile-cart-drawer', { detail: { view: 'cart' } }));
        }
      } catch (err) {
        showToast(`Toegevoegd: ${title}`);
      }
    });

    // 6. Modal
    const modal = document.getElementById('spacious-modal');
    const modalClose = document.getElementById('modal-close-trigger');
    let currentModalTicketId = '';
    let currentModalTitle = '';
    let currentModalPrice = 20;

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.btn-trigger-details');
      if (!btn) return;

      e.preventDefault();
      const title = btn.getAttribute('data-title') || '';
      const loc = btn.getAttribute('data-loc') || 'Nutshuis';
      const time = btn.getAttribute('data-time') || '';
      const host = btn.getAttribute('data-host') || '';
      const desc = btn.getAttribute('data-desc') || '';
      const price = btn.getAttribute('data-price') || '';
      const ticketId = btn.getAttribute('data-ticket-id') || '';

      currentModalTicketId = ticketId;
      currentModalTitle = title;
      currentModalPrice = parseFloat((price || '20').replace(/[^0-9.]/g, '')) || 20;

      const titleEl = document.getElementById('m-title');
      const locEl = document.getElementById('m-loc');
      const timeEl = document.getElementById('m-time');
      const descEl = document.getElementById('m-desc');
      const hostEl = document.getElementById('m-host');
      const priceEl = document.getElementById('m-price');

      if (titleEl) titleEl.textContent = title;
      if (locEl) locEl.textContent = loc;
      if (descEl) {
        descEl.textContent = desc;
        descEl.style.display = desc ? 'block' : 'none';
      }
      const speakerBox = hostEl ? hostEl.closest('.m-speaker-card') : null;
      if (speakerBox) {
        if (host && host.trim()) {
          speakerBox.style.display = 'block';
          if (hostEl) hostEl.textContent = `Spreker: ${host}`;
        } else {
          speakerBox.style.display = 'none';
        }
      }
      if (priceEl) priceEl.textContent = price || '€ 20,00';

      if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
      }
    });

    if (modalClose) {
      modalClose.addEventListener('click', () => {
        if (modal) modal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) {
          modal.style.display = 'none';
          document.body.style.overflow = '';
        }
      });
    }

    // Buy from Modal
    const mBuy = document.getElementById('m-buy');
    if (mBuy) {
      mBuy.addEventListener('click', () => {
        const title = currentModalTitle || document.getElementById('m-title')?.textContent || 'Ticket';
        const ticketId = currentModalTicketId || 'masterclass-item';

        try {
          const cart = getProgrammaCart();
          const itemObj = (ticketsList || []).find(t => t.id === ticketId);

          if (!cart[ticketId]) {
            cart[ticketId] = {
              id: ticketId,
              title: title,
              price: itemObj ? itemObj.price : currentModalPrice,
              qty: 1,
              category: 'masterclass',
              date: itemObj ? itemObj.date : '',
              time: itemObj ? itemObj.time : ''
            };
          } else {
            const currentQty = typeof cart[ticketId] === 'number' ? cart[ticketId] : (cart[ticketId].qty || 0);
            const currentPrice = typeof cart[ticketId] === 'object' ? cart[ticketId].price : (itemObj ? itemObj.price : currentModalPrice);
            cart[ticketId] = {
              id: ticketId,
              title: title,
              price: currentPrice,
              qty: Math.min(10, currentQty + 1),
              category: 'masterclass',
              date: itemObj ? itemObj.date : '',
              time: itemObj ? itemObj.time : ''
            };
          }
          saveProgrammaCart(cart);
          showToast(`Toegevoegd aan winkelwagen: ${title}`);

          // Open mobile bottom sheet cart drawer immediately on mobile screens
          if (window.innerWidth <= 990) {
            window.dispatchEvent(new CustomEvent('open-mobile-cart-drawer', { detail: { view: 'cart' } }));
          }
        } catch (err) {
          showToast(`Toegevoegd: ${title}`);
        }

        if (modal) modal.style.display = 'none';
        document.body.style.overflow = '';
      });
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProgramma);
  } else {
    initProgramma();
  }
</script>
