---
// src/pages/enquete.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SURVEY_ID = 'fpXncK5MNTF8AGcFTSp0';
const SURVEY_BASE_URL = `https://link.leadfabriek.io/widget/survey/${SURVEY_ID}`;
---

<Layout
  title="Hoe was het festival? + Win Lindores Abbey 2027 | International Whisky Festival Den Haag"
  description="Deel je indruk in 5 snelle stappen en maak kans op een exclusieve fles Lindores Abbey Festival Botteling 2027 (Vat A of Vat B)."
>
  <Header />

  <main class="enquete-page">
    <!-- 1. HERO LANDINGSSECTIE -->
    <section class="enquete-hero">
      <div class="enquete-container">
        <div class="hero-kicker">KORT ONDERZOEK &bull; 2 MIN.</div>
        <h1 class="hero-title">HOE WAS HET FESTIVAL?</h1>
        <p class="hero-subtitle">
          Deel je indruk in 5 snelle stappen en help ons 2027 nog mooier te maken.
        </p>

        <!-- WINACTIE STRIP: 2X LINDORES ABBEY 2027 -->
        <div class="prize-card">
          <div class="prize-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 3h6" />
              <path d="M10 3v5l-4 7a3 3 0 0 0 2.6 4.5h6.8A3 3 0 0 0 18 15l-4-7V3" />
              <path d="M7.5 14h9" />
            </svg>
          </div>
          <div class="prize-copy">
            <h2>Win een Lindores Abbey 2027 fles</h2>
            <p>
              We verloten <strong class="no-break">1x Vat A</strong> en <strong class="no-break">1x Vat B</strong> onder alle inzendingen.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. NATIVE GHL SURVEY EMBED -->
    <section class="enquete-wizard-section">
      <div class="enquete-container">
        <div class="wizard-card">
          <iframe
            src={SURVEY_BASE_URL}
            style="border:none;width:100%;min-height:560px;"
            scrolling="no"
            id={SURVEY_ID}
            title="IWF Den Haag Bezoekersonderzoek 2026"
            loading="eager"
          ></iframe>
        </div>
      </div>
    </section>
  </main>

  <Footer />
  <script is:inline src="https://link.leadfabriek.io/js/form_embed.js"></script>
</Layout>

<script is:inline define:vars={{ SURVEY_ID, SURVEY_BASE_URL }}>
  (function () {
    const params = new URLSearchParams(window.location.search);
    const email = params.get('email');
    const firstName = params.get('first_name') || params.get('name');
    if (!email && !firstName) return;

    const iframe = document.getElementById(SURVEY_ID);
    if (!iframe) return;

    const forward = new URLSearchParams();
    if (email) forward.set('email', email);
    if (firstName) forward.set('first_name', firstName);
    iframe.setAttribute('src', `${SURVEY_BASE_URL}?${forward.toString()}`);
  })();
</script>

<style>
  .enquete-page {
    background: #FAF7F2;
    min-height: 100vh;
    padding-top: 7.5rem;
    padding-bottom: 5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif);
    color: #111111;
  }

  .enquete-container {
    width: 100%;
    max-width: 780px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* HERO */
  .enquete-hero {
    text-align: center;
    padding-bottom: 1.75rem;
  }

  .hero-kicker {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #006448;
    background: rgba(0, 100, 72, 0.08);
    border: 1px solid rgba(0, 100, 72, 0.18);
    padding: 0.35rem 0.9rem;
    border-radius: 999px;
    margin-bottom: 0.95rem;
  }

  .hero-title {
    font-family: var(--font-display, 'bourbon-rough', sans-serif);
    font-weight: 400;
    font-synthesis: none;
    font-size: clamp(2.1rem, 4.6vw, 3.1rem);
    line-height: 1.05;
    letter-spacing: 0.04em;
    color: #006448;
    margin: 0 0 0.75rem 0;
  }

  .hero-subtitle {
    font-size: 1rem;
    line-height: 1.6;
    color: #444444;
    max-width: 560px;
    margin: 0 auto 1.5rem auto;
  }

  /* WINACTIE STRIP */
  .prize-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-align: left;
    background: #006448;
    color: #FFFFFF;
    border-radius: 12px;
    padding: 1rem 1.35rem;
    border-bottom: 3px solid #CAAC8E;
    box-shadow: 0 8px 24px rgba(0, 100, 72, 0.14);
  }

  .prize-icon {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(202, 172, 142, 0.16);
    border: 1px solid rgba(202, 172, 142, 0.45);
    color: #CAAC8E;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .prize-copy h2 {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    color: #FFFFFF;
    margin: 0 0 0.2rem 0;
    line-height: 1.3;
  }

  .prize-copy p {
    font-size: 0.88rem;
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.88);
    margin: 0;
  }

  .prize-copy strong {
    color: #CAAC8E;
    font-weight: 700;
  }

  .no-break {
    white-space: nowrap;
  }

  /* SURVEY CONTAINER CARD */
  .wizard-card {
    background: #FFFFFF;
    border: 1px solid #E5DFD5;
    border-top: 4px solid #006448;
    border-radius: 14px;
    padding: 1.5rem 1.75rem;
    box-shadow: 0 12px 32px rgba(17, 17, 17, 0.05);
    overflow: hidden;
  }

  .wizard-card iframe {
    display: block;
    width: 100%;
    border: none;
  }

  @media (max-width: 640px) {
    .enquete-page {
      padding-top: 7.5rem;
      padding-bottom: 3.5rem;
    }

    .prize-card {
      padding: 0.9rem 1rem;
      gap: 0.8rem;
    }

    .wizard-card {
      padding: 1rem 0.75rem;
      border-radius: 12px;
    }
  }
</style>
