              </g>

              <!-- Organisatie block: O (top-left), 16 (bottom-left), 17 (top-right), 18 (bottom-right) -->
              <g class="svg-stand" data-stand="O">
                <rect x="395" y="285" width="45" height="34" rx="3" class="stand-box organisation" />
                <text x="417" y="307" class="stand-num text-small">O</text>
              </g>
              <g class="svg-stand" data-stand="16">
                <rect x="395" y="322" width="45" height="34" rx="3" class="stand-box" />
                <text x="417" y="343" class="stand-num text-small">16</text>
              </g>
              <g class="svg-stand" data-stand="17">
                <rect x="443" y="285" width="45" height="34" rx="3" class="stand-box" />
                <text x="465" y="307" class="stand-num text-small">17</text>
              </g>
              <g class="svg-stand" data-stand="18">
