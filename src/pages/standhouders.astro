<script define:vars={{ exhibitors }}>
  // Initialize elements
  const searchInput = document.getElementById('exhibitor-search');
  const filterTabs = document.querySelectorAll('.filter-tab');
  const directoryGrid = document.getElementById('directory-grid');
  const directoryCards = document.querySelectorAll('.directory-item-card');
  const resultsCount = document.getElementById('results-count');
  
  // Detail card states
  const defaultInfoState = document.getElementById('default-info-state');
  const activeInfoState = document.getElementById('active-info-state');
  const detailNumber = document.getElementById('detail-number');
  const detailCategory = document.getElementById('detail-category-badge');
  const detailName = document.getElementById('detail-name');
  const detailDesc = document.getElementById('detail-description');
  const detailBrands = document.getElementById('detail-brands');

  // SVG Elements
  const svgMap = document.getElementById('church-map');
  const svgStands = document.querySelectorAll('.svg-stand');
  const zoomTarget = document.getElementById('svg-zoom-target');

  let activeFilter = 'all';
  let activeSearch = '';
  let selectedStandId = null;

  // Zoom variables
  let scale = 1;
  const zoomStep = 0.15;
  const maxScale = 2.5;
  const minScale = 0.7;

  // Map Category Mapping Helper
  const categoryLabels = {
    scotch: 'Schots',
    dutch: 'Nederlands',
    independent: 'Onafhankelijk',
    world: 'Wereld',
    catering: 'Catering',
    organisation: 'Organisatie'
  };

  // --- Zoom Controls ---
  document.getElementById('zoom-in').addEventListener('click', () => {
    if (scale < maxScale) {
      scale += zoomStep;
      applyZoom();
    }
  });

  document.getElementById('zoom-out').addEventListener('click', () => {
    if (scale > minScale) {
      scale -= zoomStep;
      applyZoom();
    }
  });

  document.getElementById('zoom-reset').addEventListener('click', () => {
    scale = 1;
    applyZoom();
  });

  function applyZoom() {
    zoomTarget.style.transform = `scale(${scale})`;
  }

  // --- Update Details Card ---
  function showStandDetails(exh) {
    if (!exh) {
      activeInfoState.style.display = 'none';
      defaultInfoState.style.display = 'flex';
      return;
    }

    // Set stand numbers & titles
    detailNumber.textContent = exh.isNotOnMap ? "Niet op plattegrond" : "Stand " + exh.id;
    detailName.textContent = exh.name;
    detailDesc.textContent = exh.description;
    
    // Category mapping
    detailCategory.textContent = categoryLabels[exh.category] || 'Overig';
    detailCategory.className = `status-badge category-tag tag-${exh.category}`;

    // Clear and fill brands
    detailBrands.innerHTML = '';
    exh.brands.forEach(brand => {
      const tag = document.createElement('span');
      tag.className = 'brand-tag';
      tag.textContent = brand;
      detailBrands.appendChild(tag);
    });

    defaultInfoState.style.display = 'none';
    activeInfoState.style.display = 'flex';
  }

  // --- Search & Filter Logic ---
  function filterAndSearch() {
    let count = 0;
    
    directoryCards.forEach(card => {
      const name = card.getAttribute('data-name');
      const brands = card.getAttribute('data-brands');
      const cat = card.getAttribute('data-cat');
      const matchesSearch = name.includes(activeSearch) || brands.includes(activeSearch);
      const matchesFilter = activeFilter === 'all' || cat === activeFilter;

      if (matchesSearch && matchesFilter) {
        card.style.display = 'flex';
        count++;
      } else {
        card.style.display = 'none';
      }
    });

    resultsCount.textContent = `${count} standhouders gevonden`;

    // Also update SVG map visuals (dim non-matching stands)
    svgStands.forEach(group => {
      const standId = group.getAttribute('data-stand');
      const standExhibitors = exhibitors.filter(e => e.id === standId);

      // Check if any exhibitor on this stand matches
      let matches = false;
      if (standExhibitors.length > 0) {
        matches = standExhibitors.some(e => {
          const nameMatches = e.name.toLowerCase().includes(activeSearch);
          const brandsMatches = e.brands.join(' ').toLowerCase().includes(activeSearch);
          const matchesSearch = nameMatches || brandsMatches;
          const matchesFilter = activeFilter === 'all' || e.category === activeFilter;
          return matchesSearch && matchesFilter;
        });
      }

      if (activeSearch !== '' || activeFilter !== 'all') {
        if (matches) {
          group.classList.remove('dimmed-stand');
          group.classList.add('highlighted-search-stand');
        } else {
          group.classList.add('dimmed-stand');
          group.classList.remove('highlighted-search-stand');
        }
      } else {
        group.classList.remove('dimmed-stand');
        group.classList.remove('highlighted-search-stand');
      }
    });
  }

  // Search Input Listener
  searchInput.addEventListener('input', (e) => {
    activeSearch = e.target.value.toLowerCase().trim();
    filterAndSearch();
  });

  // Category Tabs Listeners
  filterTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      filterTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeFilter = tab.getAttribute('data-filter');
      filterAndSearch();
    });
  });

  // --- Selection Syncing ---
  function selectStand(standId) {
    selectedStandId = standId;

    // 1. Highlight in SVG
    svgStands.forEach(group => {
      if (group.getAttribute('data-stand') === standId) {
        group.classList.add('selected-stand');
      } else {
        group.classList.remove('selected-stand');
      }
    });

    // 2. Update Details Panel
    const selectedExhibitor = exhibitors.find(e => e.id === standId);
    showStandDetails(selectedExhibitor);

    // 3. Highlight in Directory List
    directoryCards.forEach(card => {
      if (card.getAttribute('data-id') === standId) {
        card.classList.add('selected-card');
      } else {
        card.classList.remove('selected-card');
      }
    });
  }

  // --- SVG click listeners ---
  svgStands.forEach(group => {
    group.addEventListener('click', () => {
      const standId = group.getAttribute('data-stand');
      selectStand(standId);
    });
  });

  // --- List card click & locate listeners ---
  directoryCards.forEach(card => {
    card.addEventListener('click', (e) => {
      // Don't trigger if clicking the button (handled separately)
      if (e.target.classList.contains('btn-locate-stand')) return;
      
      const id = card.getAttribute('data-id');
      selectStand(id);
    });
  });

  // Locate buttons scroll to SVG map and highlight
  const locateButtons = document.querySelectorAll('.btn-locate-stand');
  locateButtons.forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = btn.getAttribute('data-target');
      selectStand(targetId);
      
      // Scroll to SVG map
      document.querySelector('.map-visual-container').scrollIntoView({ behavior: 'smooth', block: 'center' });
    });
  });
</script>
