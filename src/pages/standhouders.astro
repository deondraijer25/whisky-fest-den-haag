                <text x="590" y="107" class="stand-num text-small">6</text>
              </g>

              <!-- Main Nave: Middle-Left (Stands 12, 14, 14A, 19, 18, 17) -->
              <g class="svg-stand" data-stand="12">
                <rect x="250" y="170" width="130" height="60" rx="3" class="stand-box" />
                <text x="315" y="205" class="stand-num">12</text>
              </g>

              <g class="svg-stand" data-stand="14">
                <rect x="250" y="285" width="65" height="35" rx="3" class="stand-box" />
                <text x="282" y="307" class="stand-num">14</text>
              </g>
              <g class="svg-stand" data-stand="15">
                <rect x="315" y="285" width="65" height="35" rx="3" class="stand-box" />
                <text x="347" y="307" class="stand-num">15</text>
              </g>

              <g class="svg-stand" data-stand="22">
                <rect x="250" y="325" width="40" height="30" rx="3" class="stand-box" />
                <text x="270" y="345" class="stand-num text-small">22</text>
              </g>
              <g class="svg-stand" data-stand="21">
                <rect x="290" y="325" width="40" height="30" rx="3" class="stand-box" />
                <text x="310" y="345" class="stand-num text-small">21</text>
              </g>
              <g class="svg-stand" data-stand="20">
                <rect x="330" y="325" width="50" height="30" rx="3" class="stand-box" />
                <text x="355" y="345" class="stand-num text-small">20</text>
              </g>

              <!-- Main Nave: Middle-Center (Stands 11, 8, 9, 10, O, 16, 15) -->
              <g class="svg-stand" data-stand="11">
                <rect x="440" y="170" width="80" height="70" rx="3" class="stand-box" />
