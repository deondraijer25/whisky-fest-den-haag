---
// src/pages/standhouders.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getStandhouders } from '../lib/ghl';

const exhibitors = await getStandhouders('den_haag');
---

<Layout 
  title="Interactieve Plattegrond & Standhouders" 
  description="Navigeer door de Grote Kerk Den Haag met onze interactieve plattegrond. Zoek direct waar uw favoriete whiskymerken en standhouders zich bevinden op het International Whisky Festival."
>
  <!-- Navigation Header -->
  <Header />

  <main class="standhouders-page-wrapper">
    <!-- Page Header -->
    <div class="page-title-section animate-fade-in">
      <span class="page-tag">Festival Gids 2026</span>
      <h1 class="page-title">Plattegrond & Stands</h1>
      <div class="vintage-line"></div>
      <p class="page-subtitle">Verken de Grote Kerk, zoek uw favoriete merken en zie direct welke standhouder zich waar bevindt.</p>
    </div>

    <!-- Horizontal Search & Filters Bar -->
    <div class="search-filter-horizontal-bar vintage-frame animate-fade-in" style="animation-delay: 0.1s;">
      <div class="vintage-frame-inner horizontal-bar-inner">
        
        <div class="search-input-wrapper">
          <input type="text" id="exhibitor-search" class="form-control" placeholder="Zoek op standhouder of merk..." />
          <span class="search-icon-inside">
            <svg class="search-icon-svg" viewBox="0 0 24 24" width="16" height="16" stroke="var(--text-charcoal)" stroke-width="2.5" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </span>
        </div>
        
        <div class="filter-buttons-row">
          <button type="button" class="filter-tab active" data-filter="all">Alle</button>
          <button type="button" class="filter-tab" data-filter="scotch">Schots</button>
          <button type="button" class="filter-tab" data-filter="dutch">Nederlands</button>
          <button type="button" class="filter-tab" data-filter="independent">Onafhankelijk</button>
          <button type="button" class="filter-tab" data-filter="world">Wereld</button>
          <button type="button" class="filter-tab" data-filter="catering">Food & Catering</button>
        </div>

      </div>
    </div>

    <!-- Interactive Map & Detail Layout -->
    <div class="map-detail-layout animate-fade-in" style="animation-delay: 0.15s;">
      
      <!-- LEFT COLUMN: The Interactive Floor Plan Map -->
      <div class="map-visual-container vintage-frame">
        <div class="vintage-frame-inner map-scroll-area">
          <div class="map-toolbar">
            <span class="toolbar-title">Plattegrond Grote Kerk Den Haag</span>
            <div class="zoom-controls">
              <button type="button" class="zoom-btn" id="zoom-in" title="Inzoomen">＋</button>
              <button type="button" class="zoom-btn" id="zoom-out" title="Uitzoomen">－</button>
              <button type="button" class="zoom-btn" id="zoom-reset" title="Herstellen">Herstel</button>
            </div>
          </div>
          
          <div class="svg-zoom-wrapper" id="svg-zoom-target">
            <!-- Dynamic Vector SVG Map of Grote Kerk -->
            <svg viewBox="0 0 980 500" class="church-svg-map" id="church-map">
              <defs>
                <pattern id="pillar-pattern" width="10" height="10" patternUnits="userSpaceOnUse">
                  <circle cx="5" cy="5" r="3" fill="var(--border-color)" />
                </pattern>
              </defs>
              
              <!-- Subtle blueprint lines / grid background -->
              <rect width="980" height="500" fill="transparent" />
              
              <!-- Church Outer Walls Silhouette (gothic outline) -->
              <path d="M 140 150 
                       L 140 80 Q 140 70 150 70 L 640 70 L 640 20 Q 640 10 650 10 L 760 10 Q 770 10 770 20 L 770 70 L 820 70 
                       L 860 90 L 900 130 L 920 180 L 930 250 L 920 320 L 900 370 L 860 410 L 820 430 L 770 430 L 770 480 Q 770 490 760 490 L 650 490 Q 640 490 640 480 L 640 430 L 250 430 L 250 480 Q 250 490 240 490 L 150 490 Q 140 490 140 480 L 140 430 L 140 350
                       L 90 350 L 50 310 L 30 250 L 50 190 L 90 150 Z" 
                    fill="var(--bg-sand)" stroke="var(--border-color-dark)" stroke-width="2" stroke-linejoin="round" class="church-outline" />

              <!-- Interior Architecture Zones -->
              <!-- Hoogkoor (High Choir) Area -->
              <rect x="670" y="150" width="180" height="200" fill="#EBE4D5" stroke="var(--border-color)" stroke-width="1.5" stroke-dasharray="4 4" />
              <text x="760" y="255" class="map-zone-label">Hoogkoor</text>
              
              <!-- Kooromgang (Ambulatory) Arch Guide -->
              <path d="M 670 80 A 170 170 0 0 1 890 250 A 170 170 0 0 1 670 420" fill="none" stroke="var(--border-color)" stroke-width="1" stroke-dasharray="6 6" />

              <!-- Structural Pillars (Gothic columns) -->
              <g class="pillars">
                <!-- Row Top -->
                <circle cx="200" cy="140" r="10" class="pillar" />
                <circle cx="280" cy="140" r="10" class="pillar" />
                <circle cx="360" cy="140" r="10" class="pillar" />
                <circle cx="440" cy="140" r="10" class="pillar" />
                <circle cx="520" cy="140" r="10" class="pillar" />
                <circle cx="600" cy="140" r="10" class="pillar" />
                
                <!-- Row Bottom -->
                <circle cx="200" cy="360" r="10" class="pillar" />
                <circle cx="280" cy="360" r="10" class="pillar" />
                <circle cx="360" cy="360" r="10" class="pillar" />
                <circle cx="440" cy="360" r="10" class="pillar" />
                <circle cx="520" cy="360" r="10" class="pillar" />
                <circle cx="600" cy="360" r="10" class="pillar" />

                <!-- Choir pillars -->
                <circle cx="670" cy="150" r="8" class="pillar" />
                <circle cx="720" cy="115" r="8" class="pillar" />
                <circle cx="780" cy="100" r="8" class="pillar" />
                <circle cx="840" cy="115" r="8" class="pillar" />
                <circle cx="890" cy="150" r="8" class="pillar" />
                
                <circle cx="670" cy="350" r="8" class="pillar" />
                <circle cx="720" cy="385" r="8" class="pillar" />
                <circle cx="780" cy="400" r="8" class="pillar" />
                <circle cx="840" cy="385" r="8" class="pillar" />
                <circle cx="890" cy="350" r="8" class="pillar" />
              </g>

              <!-- EXTERNAL ANNOTATIONS & ZONES -->
              <!-- Top-Right: Buitenruimte / Food Trucks / Vaten-Maker -->
              <g class="map-annotation-zone">
                <path d="M 770 40 Q 810 25 840 20 M 840 20 L 825 18 M 840 20 L 836 32" stroke="#006448" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                <text x="850" y="22" font-family="var(--font-sans)" font-size="11" font-weight="800" fill="#006448">Workshop ruimte "Vaten-Maker"</text>
                <text x="850" y="36" font-family="var(--font-sans)" font-size="11" font-weight="800" fill="#006448">Food trucks</text>
                <text x="850" y="50" font-family="var(--font-sans)" font-size="12" font-weight="900" fill="#b57402">Buitenterrein ↗</text>
              </g>

              <!-- Top-Left: Garderobe en uitgang (Clean text label) -->
              <g class="map-annotation-zone">
                <text x="15" y="30" font-family="var(--font-sans)" font-size="13" font-weight="800" fill="var(--text-charcoal)">Garderobe en uitgang</text>
              </g>

              <!-- Bottom-Left: Nutshuis (Clean text label block) -->
              <g class="map-annotation-zone">
                <text x="15" y="425" font-family="var(--font-sans)" font-size="13" font-weight="900" fill="var(--text-charcoal)">Nutshuis</text>
                <text x="15" y="440" font-family="var(--font-sans)" font-size="11" font-weight="800" fill="var(--text-charcoal)">ALLE masterclasses</text>
                <text x="15" y="453" font-family="var(--font-sans)" font-size="9.5" font-weight="600" fill="var(--text-muted)">m.u.v. de Toren-tastings</text>
              </g>

              <!-- ============================================== -->
              <!-- STANDS GRAPHICAL BLOCKS (SVG Interactive elements) -->
              <!-- ============================================== -->
              
              <!-- LEFT AREA (Main Entrance & Stand U) -->
              <g class="svg-stand" data-stand="U">
                <rect x="50" y="210" width="60" height="80" rx="4" class="stand-box" />
                <text x="80" y="255" class="stand-num">U</text>
              </g>

              <!-- Entrance Text Labels (Above and Below Corridor) -->
              <text x="80" y="195" font-family="var(--font-sans)" font-size="11" font-weight="900" fill="var(--text-charcoal)" text-anchor="middle">Uitgifte glazen +</text>
              <text x="80" y="308" font-family="var(--font-sans)" font-size="11" font-weight="900" fill="var(--text-charcoal)" text-anchor="middle">Festival botteling</text>

              <!-- Entrance Corridor Arrow pointing into the Schip -->
              <g class="entrance-arrow">
                <path d="M 120 250 L 138 250 M 132 245 L 138 250 L 132 255" stroke="var(--text-charcoal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </g>

              <!-- Entrance Corridor Arrow pointing into the Schip -->
              <g class="entrance-arrow">
                <path d="M 125 250 L 140 250 M 135 245 L 140 250 L 135 255" stroke="var(--text-charcoal)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
              </g>

              <!-- Stands 1 & 2 (Left wall above entrance passage) -->
              <g class="svg-stand" data-stand="2">
                <rect x="155" y="155" width="22" height="28" rx="2" class="stand-box" />
                <text x="166" y="173" class="stand-num text-small">2</text>
              </g>
              <g class="svg-stand" data-stand="1">
