                <text x="465" y="343" class="stand-num text-small">18</text>
              </g>
              
              <!-- Two central tasting island blocks: Stand 15 (Moët Hennessy) and Stand 19 (Helvetia Spirits) -->
              <g class="svg-stand" data-stand="15">
                <rect x="500" y="285" width="60" height="71" rx="3" class="stand-box" />
                <text x="530" y="325" class="stand-num">15</text>
              </g>
              <g class="svg-stand" data-stand="19">
                <rect x="570" y="285" width="60" height="71" rx="3" class="stand-box" />
                <text x="600" y="325" class="stand-num">19</text>
              </g>

              <!-- Main Nave: Bottom Row (Stands 23, 24, S, 25, 26, 27, 28) -->
              <g class="svg-stand" data-stand="23">
                <rect x="250" y="375" width="75" height="35" rx="3" class="stand-box" />
