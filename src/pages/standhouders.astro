              </g>

              <g class="svg-stand" data-stand="S">
                <rect x="260" y="420" width="110" height="60" rx="4" class="stand-box shop" />
                <text x="315" y="455" class="stand-num">S</text>
              </g>

              <g class="svg-stand" data-stand="25">
                <rect x="400" y="375" width="45" height="35" rx="3" class="stand-box" />
                <text x="422" y="397" class="stand-num text-small">25</text>
              </g>
              <g class="svg-stand" data-stand="26">
                <rect x="450" y="375" width="45" height="35" rx="3" class="stand-box" />
                <text x="472" y="397" class="stand-num text-small">26</text>
              </g>
              <g class="svg-stand" data-stand="27">
                <rect x="500" y="375" width="45" height="35" rx="3" class="stand-box" />
                <text x="522" y="397" class="stand-num text-small">27</text>
              </g>
              <g class="svg-stand" data-stand="28">
                <rect x="550" y="375" width="45" height="35" rx="3" class="stand-box" />
                <text x="572" y="397" class="stand-num text-small">28</text>
              </g>

              <!-- EAST AREA: Chapels & Ambulatory (Choir area) -->
              <!-- Kapel Noord (Stand 42) -->
              <g class="svg-stand" data-stand="42">
                <rect x="645" y="20" width="90" height="60" rx="4" class="stand-box chapel" />
                <text x="690" y="55" class="stand-num">42</text>
