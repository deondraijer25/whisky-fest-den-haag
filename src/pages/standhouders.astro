                <text x="435" y="107" class="stand-num">5</text>
              </g>

              <!-- Stand 6 is split into three table modules -->
              <g class="svg-stand" data-stand="6">
                <rect x="525" y="85" width="22" height="35" rx="2" class="stand-box" />
                <text x="536" y="107" class="stand-num text-small">6</text>
              </g>
              <g class="svg-stand" data-stand="6">
                <rect x="552" y="85" width="22" height="35" rx="2" class="stand-box" />
                <text x="563" y="107" class="stand-num text-small">6</text>
              </g>
              <g class="svg-stand" data-stand="6">
