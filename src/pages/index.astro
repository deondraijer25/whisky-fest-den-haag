    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.01, rootMargin: '100px 0px 100px 0px' });
    
    fadeGroups.forEach(g => {
      const rect = g.getBoundingClientRect();
      if (rect.top < window.innerHeight + 200 && rect.bottom > -200) {
        g.classList.add('is-visible');
      }
      observer.observe(g);
    });
  }

  // 11. Interactive Horizontal Timeline
  const timelineSection = document.querySelector('.timeline-scroll-section') as HTMLElement;
  const timelineTrack = document.getElementById('timeline-track') as HTMLElement;
  const timelineViewport = document.querySelector('.timeline-track-viewport') as HTMLElement;
  const timelineCards = document.querySelectorAll('.timeline-card');
  const axisProgress = document.getElementById('axis-progress') as HTMLElement;
  const axisTicks = document.querySelectorAll('.axis-tick');
  const eraItems = document.querySelectorAll('.era-item');

  let activeIndex = 0;
  let isDesktop = window.innerWidth > 1024;
  let currentScrollTranslate = 0;
  let isDragging = false;
  let startX = 0;
  let dragStartTranslate = 0;

  window.addEventListener('resize', () => {
    isDesktop = window.innerWidth > 1024;
    if (!isDesktop && timelineTrack) {
      timelineTrack.style.transform = 'none';
    }
  });

  function getTimelineScrollData() {
    if (!timelineTrack) return { maxTranslate: 0, trackWidth: 0, viewportWidth: 0 };
    const trackWidth = timelineTrack.scrollWidth;
    const viewportWidth = timelineTrack.parentElement?.clientWidth || window.innerWidth;
    const maxTranslate = Math.max(0, trackWidth - viewportWidth + 60);
    return { maxTranslate, trackWidth, viewportWidth };
  }

  function setTimelinePosition(fraction: number, smooth: boolean = false) {
    if (!timelineTrack) return;
    const { maxTranslate } = getTimelineScrollData();
    const clampedFraction = Math.max(0, Math.min(1, fraction));
    currentScrollTranslate = clampedFraction * maxTranslate;

    if (smooth) {
      timelineTrack.style.transition = 'transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)';
      setTimeout(() => {
        if (timelineTrack) timelineTrack.style.transition = 'none';
      }, 450);
    } else {
      timelineTrack.style.transition = 'none';
    }

    timelineTrack.style.transform = `translateX(-${currentScrollTranslate}px)`;

    if (axisProgress) {
      axisProgress.style.width = `${clampedFraction * 100}%`;
    }

    const cardCount = timelineCards.length;
    const activeIdx = Math.min(cardCount - 1, Math.round(clampedFraction * (cardCount - 1)));
    updateActiveStates(activeIdx);
  }

  function updateTimelineScroll() {
    if (!timelineSection || !timelineTrack || !isDesktop || isDragging) return;

    const rect = timelineSection.getBoundingClientRect();
    const sectionHeight = timelineSection.scrollHeight;
    const viewHeight = window.innerHeight;
    const scrollDistance = sectionHeight - viewHeight;
    const scrolledAmount = -rect.top;
    const fraction = scrolledAmount / scrollDistance;

    setTimelinePosition(fraction, false);
  }

  function updateActiveStates(index: number) {
    if (index === activeIndex) return;
    activeIndex = index;

    timelineCards.forEach((card, idx) => {
      if (idx === index) card.classList.add('active');
      else card.classList.remove('active');
    });

    axisTicks.forEach((tick, idx) => {
      if (idx === index) tick.classList.add('active');
      else tick.classList.remove('active');
    });

    const targets = Array.from(eraItems).map(e => parseInt(e.getAttribute('data-target') || '0', 10)).sort((a, b) => a - b);
    let activeEra = 0;
    for (const t of targets) {
      if (index >= t) activeEra = t;
    }

    eraItems.forEach((era) => {
      const targetIdx = parseInt(era.getAttribute('data-target') || '0', 10);
      if (targetIdx === activeEra) era.classList.add('active');
      else era.classList.remove('active');
    });
  }

  window.addEventListener('scroll', updateTimelineScroll, { passive: true });
  window.addEventListener('load', updateTimelineScroll);

  axisTicks.forEach((tick, tickIdx) => {
    tick.addEventListener('click', () => {
      const targetIndex = parseInt(tick.getAttribute('data-index') || String(tickIdx), 10);
      const cardCount = timelineCards.length;
      const targetFraction = targetIndex / (cardCount - 1);

      if (isDesktop && timelineSection) {
        const sectionTop = timelineSection.offsetTop;
        const sectionHeight = timelineSection.scrollHeight;
        const viewHeight = window.innerHeight;
        const scrollDistance = sectionHeight - viewHeight;
        const scrollTarget = sectionTop + (targetFraction * scrollDistance);

        window.scrollTo({ top: scrollTarget, behavior: 'smooth' });
        setTimelinePosition(targetFraction, true);
      } else {
        const card = timelineCards[targetIndex] as HTMLElement;
        if (timelineViewport && card) {
          timelineViewport.scrollTo({
            left: card.offsetLeft - 20,
            behavior: 'smooth'
          });
          updateActiveStates(targetIndex);
        }
      }
    });
  });

  eraItems.forEach(era => {
    era.addEventListener('click', () => {
      const targetIndex = parseInt(era.getAttribute('data-target') || '0', 10);
      const tickBtn = document.querySelector(`.axis-tick[data-index="${targetIndex}"]`) as HTMLButtonElement;
      if (tickBtn) tickBtn.click();
    });
  });

  if (timelineViewport && timelineTrack) {
    timelineViewport.addEventListener('mousedown', (e) => {
      if (!isDesktop) return;
      isDragging = true;
      startX = e.pageX;
      dragStartTranslate = currentScrollTranslate;
      timelineTrack.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
      if (!isDragging) return;
      e.preventDefault();
      const dx = e.pageX - startX;
      const { maxTranslate } = getTimelineScrollData();
      const newTranslate = Math.max(0, Math.min(maxTranslate, dragStartTranslate - dx));
      const fraction = maxTranslate > 0 ? newTranslate / maxTranslate : 0;
      setTimelinePosition(fraction, false);
    });

    window.addEventListener('mouseup', () => {
      if (isDragging) {
        isDragging = false;
        if (timelineTrack) timelineTrack.style.cursor = 'grab';
      }
    });

    timelineViewport.addEventListener('wheel', (e) => {
      if (!isDesktop) return;
      const delta = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (Math.abs(delta) > 5) {
        const { maxTranslate } = getTimelineScrollData();
        const newTranslate = Math.max(0, Math.min(maxTranslate, currentScrollTranslate + delta * 1.5));
        const fraction = maxTranslate > 0 ? newTranslate / maxTranslate : 0;
        setTimelinePosition(fraction, false);
      }
    }, { passive: true });
  }

