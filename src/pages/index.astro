<style>
  /* --- 2.5-SECOND COIN-FLIP PRELOADER --- */
  .hp-preloader-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background-color: var(--bg-parchment);
    display: flex;
    justify-content: center;
    align-items: center;
    overflow: hidden;
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1), transform 0.4s ease, filter 0.4s ease;
  }

  .hp-preloader-overlay.fade-out {
    opacity: 0;
    filter: blur(12px);
    transform: scale(1.04);
    pointer-events: none;
  }

  .preloader-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2.25rem;
    perspective: 1200px;
  }

  /* Butter-smooth 3D Coin Toss */
  .coin-3d-stage {
    position: relative;
    width: 140px;
    height: 170px;
    display: flex;
    justify-content: center;
    align-items: center;
    perspective: 1000px;
  }

  .coin-flipper-core {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 14px 28px rgba(45, 42, 38, 0.25));
    will-change: transform;
    animation: coinTossSmooth 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .coin-flipper-core svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @keyframes coinTossSmooth {
    0% {
      transform: translateY(0) rotateY(0deg) scale(0.85);
    }
    40% {
      transform: translateY(-40px) rotateY(360deg) scale(1.15);
    }
    80% {
      transform: translateY(0) rotateY(720deg) scale(0.98);
    }
    92% {
      transform: translateY(-6px) rotateY(720deg) scale(1.02);
    }
    100% {
      transform: translateY(0) rotateY(720deg) scale(1);
    }
  }

  /* Pulsing Floor Shadow */
  .coin-glow-shadow {
    position: absolute;
    bottom: -18px;
    left: 50%;
    transform: translateX(-50%);
    width: 110px;
    height: 18px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(197, 139, 57, 0.55) 0%, transparent 75%);
    animation: coinShadowPulse 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  @keyframes coinShadowPulse {
    0% { transform: translateX(-50%) scale(0.5); opacity: 0.3; }
    40% { transform: translateX(-50%) scale(1.35); opacity: 0.85; }
    80% { transform: translateX(-50%) scale(0.95); opacity: 0.5; }
    100% { transform: translateX(-50%) scale(1); opacity: 0.65; }
  }

  /* Preloader Text & Progress Bar */
  .preloader-text-group {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.65rem;
  }

  .preloader-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: var(--text-charcoal);
    text-transform: uppercase;
  }

  .preloader-progress-track {
    width: 220px;
    height: 4px;
    background-color: rgba(45, 42, 38, 0.12);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
  }

  .preloader-progress-bar {
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, var(--whisky-gold-dark), var(--whisky-gold), var(--whisky-gold-light));
    border-radius: 4px;
    animation: fillLoader 2.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  @keyframes fillLoader {
    0% { width: 0%; }
    40% { width: 45%; }
    75% { width: 85%; }
    100% { width: 100%; }
  }

  .preloader-subtitle {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    color: var(--whisky-gold-dark);
