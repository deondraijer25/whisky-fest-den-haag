    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-decoration: none !important;
  }
  .btn-beige:hover {
    background-color: var(--whisky-gold, #D5C28A) !important;
    color: var(--text-charcoal, #1D1C1A) !important;
    transform: translate(-2px, -2px) !important;
    box-shadow: 6px 6px 0px rgba(29, 28, 26, 0.9) !important;
  }
  .btn-beige:active {
    transform: translate(2px, 2px) !important;
    box-shadow: 0px 0px 0px rgba(29, 28, 26, 0.9) !important;
  }
  .tt-text-link {
    color: #FFFFFF !important;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.75) !important;
    text-decoration: none;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.02rem;
    padding-bottom: 2px;
    transition: all 0.2s ease;
    white-space: nowrap;
  }
  .tt-text-link:hover {
    color: #FFFFFF !important;
    border-bottom-color: #FFFFFF !important;
    opacity: 0.8;
  }
  .reviews-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: #FFFFFF !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    margin-bottom: 1.25rem;
  }
  .reviews-grid {
    display: flex;
    gap: 3rem;
  }
  .review-item {
    display: flex;
    flex-direction: column;
  }
  .review-item .stars {
    color: #E4C765 !important;
    font-size: 1.25rem;
    letter-spacing: 2px;
    margin-bottom: 0.35rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .review-item .review-source {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85) !important;
  }

  /* --- FULL-BLEED SEAMLESS HERO VIDEO BANNER --- */
  .hero-video-full-right {
    position: absolute;
    inset: 0; /* Spans 100% width and height of hero section */
    z-index: 1;
    overflow: hidden;
    /* Alpha Mask: Completely transparent on left 35%, smooth transition to solid on right 72% */
    mask-image: linear-gradient(to right, transparent 0%, transparent 35%, black 72%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 35%, black 72%, black 100%);
  }

  .hero-video-element {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 75% center;
    display: block;
  }

  /* Multi-stop Haags Green Blend & Vignette Overlay */
  .hero-video-blend-gradient {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: 
      linear-gradient(
        to right, 
        #061A10 0%, 
        #061A10 30%, 
        rgba(6, 26, 16, 0.85) 45%, 
        rgba(6, 26, 16, 0.3) 65%, 
        transparent 85%
      ),
      linear-gradient(
        to bottom, 
        #061A10 0%, 
        rgba(6, 26, 16, 0.6) 12%, 
        transparent 28%, 
        transparent 78%, 
        #061A10 100%
      ) !important;
  }

  /* Subtle Deep Emerald & Gold Tint Overlay */
  .hero-video-tint-overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      circle at 70% 50%,
      rgba(22, 86, 54, 0.15) 0%,
      rgba(6, 26, 16, 0.45) 100%
    ) !important;
  }

  /* Center Right Whisky Glass Artwork (Middel 15.svg) */
  .tt-hero-visual-right {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 5;
    pointer-events: none;
    height: 100%;
  }

  .hero-glass-art-card {
    width: 100%;
    max-width: 320px;
    display: flex;
    justify-content: center;
    align-items: center;
    filter: drop-shadow(0 15px 35px rgba(0, 0, 0, 0.45));
    opacity: 0.95;
    margin-bottom: 5.5rem; /* Lift logo higher independently */
    /* No animation - clean static artwork */
  }

  .hero-glass-art-card svg {
    width: 100%;
    height: auto;
    max-height: 420px;
    display: block;
  }

  /* floatingGlass removed */

  .hero-video-badge {
    position: absolute;
    bottom: 6.5rem;
    right: 2rem;
    display: flex;
    align-items: center;
    gap: 8px;
    background-color: rgba(29, 28, 26, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--whisky-gold);
    color: var(--whisky-gold-light);
    padding: 0.45rem 1rem;
    border-radius: 20px;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.35);
    z-index: 5;
  }

  .hero-video-badge .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--whisky-gold);
    box-shadow: 0 0 8px var(--whisky-gold);
    animation: pulseGlow 1.5s infinite;
  }

  /* --- HORIZONTAL 2-ROW INFINITE MARQUEE SECTION --- */
  .horizontal-photo-gallery-section {
    padding: 4rem 0 5rem;
    background-color: transparent;
    border-top: none;
    border-bottom: none;
    overflow: hidden;
    position: relative;
  }

  .horizontal-marquee-container {
    width: 100%;
    overflow: hidden;
    padding: 3rem 0;
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
  }

  .marquee-row-wrapper {
    width: 100%;
    overflow: visible;
    display: flex;
    padding: 1rem 0;
  }

  .marquee-row {
    display: flex;
    gap: 2.5rem;
    width: max-content;
    will-change: transform;
  }

  .marquee-row-left {
    animation: scrollMarqueeLeft 50s linear infinite;
  }

  .marquee-row-right {
    animation: scrollMarqueeRight 55s linear infinite;
  }

  .horizontal-marquee-container:hover .marquee-row {
    animation-play-state: paused;
  }

  @keyframes scrollMarqueeLeft {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @keyframes scrollMarqueeRight {
    0% { transform: translateX(-50%); }
    100% { transform: translateX(0); }
  }

  .marquee-photo-card {
    flex-shrink: 0;
    width: 400px;
    height: 280px;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    cursor: pointer;
    padding: 10px;
  }

  .marquee-photo-card.rotate-neg-1 { transform: rotate(-1.8deg); }
  .marquee-photo-card.rotate-pos-2 { transform: rotate(2.2deg); }
  .marquee-photo-card.rotate-neg-2 { transform: rotate(-2.2deg); }
  .marquee-photo-card.rotate-pos-1 { transform: rotate(1.8deg); }

  .marquee-photo-card:hover {
    transform: scale(1.08) rotate(0deg) !important;
    z-index: 10;
  }

  .photo-mask-frame {
    width: 100%;
    height: 100%;
    -webkit-mask-image: url('/torn-mask.svg');
    mask-image: url('/torn-mask.svg');
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    filter: drop-shadow(0 10px 20px rgba(45, 42, 38, 0.2));
  }

  .photo-mask-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .marquee-photo-card:hover .photo-mask-frame img {
    transform: scale(1.08);
  }

  /* Hero Text Highlights & Reviews */
  .highlight-text {
    display: inline;
    line-height: 1.1;
  }

  .tt-hero-reviews {
    margin-top: 4rem;
    position: relative;
    max-width: 500px;
  }
  .reviews-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    color: #FFFFFF !important;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
    margin-bottom: 1.25rem;
  }
  .reviews-grid {
    display: flex;
    gap: 3rem;
  }
  .review-item {
    display: flex;
    flex-direction: column;
  }
  .review-item .stars {
    color: #E4C765 !important;
    font-size: 1.25rem;
    letter-spacing: 2px;
    margin-bottom: 0.35rem;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.5);
  }
  .review-item .review-source {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.85) !important;
  }
  .trophy-icon {
    position: absolute;
    right: -20px;
    bottom: -10px;
    font-size: 4rem;
    transform: rotate(15deg);
    opacity: 0.9;
  }

  /* Trust Logos text mock */
  .trust-text-logo {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text-charcoal);
    opacity: 0.4;
    transition: opacity 0.3s;
    letter-spacing: 0.1em;
  }
  .trust-text-logo:hover {
    opacity: 1;
  }

  /* ====== TEAR SECTION ====== */
  .tear-section {
    position: relative;
    background-color: var(--bg-parchment);
  }

  .tear-header-area {
    padding-top: 6rem;
    padding-bottom: 3rem;
    background-color: var(--bg-parchment);
  }

  /* Torn edge images */
  .torn-edge-wrap {
    position: relative;
    z-index: 20;
    line-height: 0;
    filter: drop-shadow(0px 18px 18px rgba(0,0,0,0.55));
  }

  .torn-edge-img {
    display: block;
    width: 100%;
    height: 60px;
  }

  /* Top edge: shadow only visible BELOW (into dark gap), clipped above */
  .torn-edge-wrap:not(.torn-edge-bottom) {
    margin-bottom: -30px;
    clip-path: inset(0 -50px -50px -50px);
  }

  /* Bottom edge: shadow only visible ABOVE (into dark gap), clipped below */
  .torn-edge-bottom {
    margin-top: -30px;
    margin-bottom: 0;
    filter: drop-shadow(0px -18px 18px rgba(0,0,0,0.55));
    clip-path: inset(-50px -50px 0px -50px);
  }

  /* Dark ticket area — sits BEHIND the torn edges */
  .dark-gap {
    padding: 3rem 0;
    padding-top: 3.5rem; /* Reduced to pull content closer to torn edge overlap */
    background-color: var(--success-green); /* Rich brand dark green (#006448) */
    position: relative;
    z-index: 1;
  }

  :global(.ticket-stub.hidden-by-filter),
  :global(.ticket-stub.hidden-by-limit) {
    display: none !important;
  }

  .shop-filters-container {
    background: transparent;
    border: none;
    padding: 0;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    box-shadow: none;
  }
  .filter-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }
  .filter-label {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: rgba(250, 247, 242, 0.6);
    width: 60px;
    flex-shrink: 0;
  }
  .filter-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .filter-tab-btn {
    background-color: rgba(250, 247, 242, 0.05);
    border: 1px solid rgba(250, 247, 242, 0.18);
    color: #FAF7F2;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.4rem 1rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter-tab-btn:hover {
    border-color: #d5c28a;
    background-color: rgba(213, 194, 138, 0.1);
  }
  .filter-tab-btn.active {
    background-color: #d5c28a;
    border-color: #d5c28a;
    color: var(--text-charcoal);
    font-weight: 700;
  }

  /* Fade-in animation for tickets on scroll */
  .fade-in-group :global(.ticket-stub) {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.6s ease-out, transform 0.6s ease-out;
  }
  .fade-in-group.is-visible :global(.ticket-stub) {
    opacity: 1;
    transform: translateY(0);
  }
  .fade-in-group.is-visible :global(.ticket-stub):nth-child(2) { transition-delay: 0.1s; }
  .fade-in-group.is-visible :global(.ticket-stub):nth-child(3) { transition-delay: 0.2s; }
  .fade-in-group.is-visible :global(.ticket-stub):nth-child(4) { transition-delay: 0.3s; }

  /* Drams banner — light theme matching hero */
  .banner-drams {
    background-color: var(--bg-parchment); /* Match parchment background */
    color: var(--text-charcoal);
    padding: 5rem 2rem;
    text-align: center;
  }

  .tt-section-header {
    max-width: 650px;
    margin: 0 auto 3rem;
  }
  .tt-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.85rem, 3.2vw, 2.45rem);
    line-height: 1.15;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .tt-section-subtitle {
    font-family: var(--font-sans);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--text-muted);
  }
  .shop-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 5rem;
    /* align-items: stretch by default allows the sidebar to fill the height, enabling position: sticky to work */
  }
  .tickets-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  /* TT Split Layout specifics */
  .split-features-section {
    padding: 8rem 0 2rem;
    background-color: var(--bg-parchment);
  }
  .tt-tag {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--whisky-gold-dark);
    margin-bottom: 1rem;
  }
  .tt-split-title {
    font-family: var(--font-sans);
    font-size: 1.35rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-charcoal);
    letter-spacing: -0.01em;
    margin-bottom: 0.85rem;
  }
  .tt-split-desc {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }
  .tt-feature-list {
    list-style: none;
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--text-charcoal);
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
  }
  .tt-text-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--whisky-gold-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--whisky-gold);
    padding-bottom: 2px;
    transition: all 0.2s;
  }
  .tt-text-link:hover {
    color: var(--text-charcoal);
    border-color: var(--text-charcoal);
  }

  /* Tab Accordion Section */
  .tab-section {
    padding: 5rem 0 8rem;
    background-color: var(--bg-parchment);
  }

  /* Heritage Stats Bar */
  .heritage-bar {
    background-color: var(--bg-paper);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 4rem 0;
  }
  .heritage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: center;
    gap: 2rem;
  }
  .heritage-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .stat-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background-color: rgba(140, 110, 70, 0.07);
    border: 1px solid rgba(140, 110, 70, 0.25);
    margin-bottom: 0.25rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .heritage-stat:hover .stat-icon-wrapper {
    transform: translateY(-3px);
    border-color: var(--whisky-gold-dark);
  }
  .stat-val {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--text-charcoal);
    line-height: 1;
  }
  .stat-label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--whisky-gold-dark);
  }

  /* Testimonials Section */
  .testimonials-section {
    padding: 8rem 0;
    background-color: var(--bg-parchment);
  }
  .play-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--whisky-gold);
    color: #FFF;
    font-size: 2rem;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(197, 139, 57, 0.4);
    transition: transform 0.2s;
  }
  .play-button:hover {
    transform: scale(1.1);
  }
  .testimonial-quote {
    font-size: 2.25rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
    color: var(--text-charcoal);
  }
  .testimonial-author {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .review-stars {
    color: var(--whisky-gold);
    font-size: 1.5rem;
  }

  /* Responsive fixes */
  @media (max-width: 1024px) {
    .tt-hero-grid, .shop-grid, .split-layout, .tab-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .split-layout.reverse > * {
      direction: ltr; /* reset */
    }
    .tt-hero-visual {
      height: 400px;
    }
    .float-1 {
      position: static;
      width: 100%;
      margin-bottom: 2rem;
    }
    .float-2 {
      position: static;
    }
    .checkout-sidebar-container {
      position: static;
    }
    .heritage-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .split-text {
      max-width: 100%;
    }
  }



  /* Modal Overlay CSS duplicated from before */
  .checkout-modal-overlay { 
    position: fixed; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    background-color: rgba(29, 28, 26, 0.75); 
    backdrop-filter: blur(5px); 
    z-index: 1000; 
    display: flex; 
    align-items: flex-start; 
    justify-content: center; 
    padding: 2rem 1rem; 
    overflow-y: auto; 
    animation: fadeIn 0.3s ease-out; 
  }
  .checkout-modal-card { 
    background-color: var(--bg-paper-card); 
    border: 2px solid var(--text-charcoal); 
    border-radius: 12px; 
    width: 100%; 
    max-width: 860px; 
    padding: 2rem; 
    position: relative; 
    box-shadow: 0 30px 70px rgba(0,0,0,0.5); 
    transition: max-width 0.3s; 
    margin: auto;
  }
  
  /* 2-Column Modal Layout */
  .modal-two-columns {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  .modal-form-side {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .modal-summary-side {
    flex: 1;
    background-color: rgba(0, 100, 72, 0.03);
    border: 1px solid rgba(140, 110, 70, 0.25);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }
  .modal-summary-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--success-green);
    margin-bottom: 0.5rem;
    border-bottom: 1px dashed rgba(140, 110, 70, 0.25);
    padding-bottom: 0.25rem;
  }
  .modal-summary-items-list {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-charcoal);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-height: 120px;
    overflow-y: auto;
    margin-bottom: 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 100, 72, 0.2) transparent;
  }
  .modal-summary-items-list::-webkit-scrollbar {
    width: 4px;
  }
  .modal-summary-items-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .modal-summary-items-list::-webkit-scrollbar-thumb {
    background-color: rgba(0, 100, 72, 0.2);
    border-radius: 2px;
  }
  .modal-summary-item-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .modal-summary-calc {
    border-top: 1px solid rgba(140, 110, 70, 0.2);
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }
  .modal-summary-total-row {
    display: flex;
    justify-content: space-between;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--text-charcoal);
    border-top: 1px dashed rgba(140, 110, 70, 0.25);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    margin-bottom: 1rem;
  }
  .modal-summary-total-row span {
    color: var(--success-green);
  }

  @media (max-width: 800px) {
    .checkout-modal-card {
      max-width: 520px;
      padding: 1.25rem;
    }
    .modal-two-columns {
      flex-direction: column;
      gap: 1.25rem;
