    align-items: center;
    justify-content: center;
    filter: drop-shadow(0 14px 28px rgba(45, 42, 38, 0.25));
    will-change: transform;
    animation: coinTossSmooth 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }

  .coin-flipper-core svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @keyframes coinTossSmooth {
    0% {
      transform: translateY(0) rotateY(0deg) scale(0.85);
    }
    40% {
      transform: translateY(-40px) rotateY(360deg) scale(1.15);
    }
    80% {
      transform: translateY(0) rotateY(720deg) scale(0.98);
    }
    92% {
      transform: translateY(-6px) rotateY(720deg) scale(1.02);
