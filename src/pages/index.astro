<script>
  // FAQ Exclusive Accordion: Close other items when opening an item
  const faqDetailsList = document.querySelectorAll<HTMLDetailsElement>('.faq-item');
  faqDetailsList.forEach((detail) => {
    detail.addEventListener('toggle', () => {
      if (detail.open) {
        faqDetailsList.forEach((other) => {
          if (other !== detail && other.open) {
            other.removeAttribute('open');
          }
        });
      }
    });
  });

  // 1. Enforce 100% reliable background video autoplay
  const heroBgVideo = document.getElementById("hero-bg-video") as HTMLVideoElement;
  if (heroBgVideo) {
    heroBgVideo.muted = true;
    heroBgVideo.defaultMuted = true;
    heroBgVideo.playsInline = true;
    const tryPlay = () => {
      heroBgVideo.play().catch(() => {
        document.addEventListener('click', () => heroBgVideo.play(), { once: true });
        document.addEventListener('touchstart', () => heroBgVideo.play(), { once: true });
        document.addEventListener('scroll', () => heroBgVideo.play(), { once: true });
      });
    };
    tryPlay();
    window.addEventListener('load', tryPlay);
  }

  // 2. Safe Preloader Dismiss
  (function() {
    const pl = document.getElementById('hp-preloader');
    if (pl) {
      setTimeout(() => {
        pl.classList.add('fade-out');
        document.body.style.overflow = '';
      }, 1800);
      setTimeout(() => {
        pl.style.display = 'none';
      }, 2300);
    }
  })();

  // 3. Tab Triggers (Alles wat u moet weten)
  const tabTriggers = document.querySelectorAll('.tab-trigger-card');
  tabTriggers.forEach(tab => {
    tab.addEventListener('click', () => {
      tabTriggers.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
    });
  });

  // 4. Cart & Shop State
  const cart: Record<string, { title: string; price: number; qty: number; category: string; timeslot?: string; delivery?: string; guide?: string }> = {};
  const serviceFee = 4.50;
  const cartItemsContainer = document.getElementById("cart-items");
  const subtotalEl = document.getElementById("receipt-subtotal");
  const feeEl = document.getElementById("receipt-fee");
  const shippingRow = document.getElementById("shipping-row");
  const shippingEl = document.getElementById("receipt-shipping");
  const totalEl = document.getElementById("receipt-total");
  const checkoutBtn = document.getElementById("checkout-trigger-btn") as HTMLButtonElement;

  function updateShop() {
    let subtotal = 0;
    let totalItems = 0;
    let shippingActive = false;

    Object.keys(cart).forEach(id => {
      const item = cart[id];
      if (item && item.qty > 0) {
        subtotal += item.price * item.qty;
        totalItems += item.qty;
        if (item.category === "botteling" && item.delivery === "shipping") {
          shippingActive = true;
        }
      }
    });

    const activeShipping = shippingActive ? 12.50 : 0;
    const activeFee = totalItems > 0 ? serviceFee : 0;
    const finalTotal = subtotal + activeFee + activeShipping;

    if (cartItemsContainer) {
      if (totalItems === 0) {
        cartItemsContainer.innerHTML = '<p class="empty-cart-msg">Selecteer hiernaast uw ticket(s) om de bestelling te starten.</p>';
      } else {
        let listHtml = "";
        const entries = Object.keys(cart).filter(id => cart[id] && cart[id].qty > 0);
        
        entries.forEach((id, index) => {
          const item = cart[id];
          let displayTitle = item.title;
          
          if (item.category === "tram" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "masterclass" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "trail" && item.timeslot) {
            const guideSuffix = item.guide ? ` - Gids: ${item.guide}` : '';
            displayTitle = `${item.title} (${item.timeslot}${guideSuffix})`;
          } else if (item.category === "vatenmaken" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "botteling" && item.delivery) {
            const methodText = item.delivery === "shipping" ? "Verzenden" : "Ophalen";
            displayTitle = `${item.title} [${methodText}]`;
          }

          const isLast = index === entries.length - 1;
          listHtml += `
            <div class="cart-item-row" ${isLast ? 'style="border-bottom:none;"' : ''}>
              <div class="cart-item-info">
                <span class="cart-item-name">${displayTitle}</span>
                <span class="cart-item-meta">${item.qty} × €${item.price.toFixed(2)}</span>
              </div>
              <span class="cart-item-price">€${(item.price * item.qty).toFixed(2)}</span>
            </div>
          `;
        });
        
        cartItemsContainer.innerHTML = listHtml;
      }
    }
    
    if (subtotalEl) subtotalEl.innerHTML = `&euro;${subtotal.toFixed(2)}`;
    if (feeEl) feeEl.innerHTML = `&euro;${activeFee.toFixed(2)}`;
    if (shippingRow && shippingEl) {
      if (shippingActive) {
        shippingRow.style.display = "flex";
        shippingEl.innerHTML = `&euro;12.50`;
      } else {
        shippingRow.style.display = "none";
      }
    }
    if (totalEl) totalEl.innerHTML = `&euro;${finalTotal.toFixed(2)}`;
    if (checkoutBtn) checkoutBtn.disabled = totalItems === 0;

    saveCartToLocalStorage(subtotal, totalItems);
  }

  function saveCartToLocalStorage(subtotalVal: number, totalItemsVal: number) {
    try {
      const activeItems = Object.keys(cart)
        .filter(id => cart[id] && cart[id].qty > 0)
        .map(id => {
          const item = cart[id];
          let displayTitle = item.title;
          if (item.category === "tram" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "masterclass" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "trail" && item.timeslot) {
            const guideSuffix = item.guide ? ` - Gids: ${item.guide}` : '';
            displayTitle = `${item.title} (${item.timeslot}${guideSuffix})`;
          } else if (item.category === "vatenmaken" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "botteling" && item.delivery) {
            const methodText = item.delivery === "shipping" ? "Verzenden" : "Ophalen";
            displayTitle = `${item.title} [${methodText}]`;
          }
          return {
            id,
            title: displayTitle,
            price: item.price,
            qty: item.qty,
            category: item.category || 'entree',
            date: item.date || '',
            time: item.time || ''
          };
        });

      localStorage.setItem("whiskyfest_cart", JSON.stringify({
        subtotal: subtotalVal,
        totalItems: totalItemsVal,
        items: activeItems,
        cartRaw: cart
      }));

      // Notify Header Cart and other components immediately
      window.dispatchEvent(new Event('cart-updated'));
    } catch(e) {}
  }

  function restoreCartFromLocalStorage() {
    try {
      const raw = localStorage.getItem("whiskyfest_cart");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed.cartRaw) {
          Object.assign(cart, parsed.cartRaw);
          Object.keys(cart).forEach(id => {
            const card = document.querySelector(`.ticket-stub[data-ticket-id="${id}"]`);
            if (card) {
              const qtyDisplay = card.querySelector(".qty-val");
              if (qtyDisplay) qtyDisplay.textContent = String(cart[id].qty || 0);
              if (cart[id].qty > 0) card.classList.add("selected");
              else card.classList.remove("selected");
            }
          });
          updateShop();
        }
      }
    } catch(e) {}
  }

  // 5. Ticket Filtering Logic
  const dayButtons = document.querySelectorAll('#day-filter-buttons .filter-tab-btn');
  const catButtons = document.querySelectorAll('#cat-filter-buttons .filter-tab-btn');
  const timeButtons = document.querySelectorAll('#time-filter-buttons .filter-tab-btn');
  const timeFilterRow = document.getElementById('time-filter-row');
  
  let activeDay = 'all';
  let activeCat = 'all';
  let activeTime = 'all';
  let visibleCount = 10;

  const showMoreContainer = document.getElementById('show-more-container');
  const showMoreBtn = document.getElementById('show-more-btn');

  function applyFilters() {
    if (timeFilterRow) {
      if (activeCat === 'botteling') {
        timeFilterRow.style.display = 'none';
        activeTime = 'all';
        timeButtons.forEach(b => {
          if (b.getAttribute('data-filter-time') === 'all') b.classList.add('active');
          else b.classList.remove('active');
        });
      } else {
        timeFilterRow.style.display = 'flex';
      }
    }

    const cards = document.querySelectorAll(".ticket-stub");
    const matchingCards: HTMLElement[] = [];

    cards.forEach(card => {
      const cardDay = card.getAttribute('data-day') || 'all';
      const cardCat = card.getAttribute('data-category') || 'entree';
      const cardTime = card.getAttribute('data-daypart') || 'all';

      const matchDay = (activeDay === 'all') || (cardDay === 'all') || (cardDay === activeDay);
      const matchCat = (activeCat === 'all') || (cardCat === activeCat);
      const matchTime = (activeTime === 'all') || (cardTime === 'all') || (cardTime === activeTime);

      if (matchDay && matchCat && matchTime) {
        card.classList.remove('hidden-by-filter');
        matchingCards.push(card as HTMLElement);
      } else {
        card.classList.add('hidden-by-filter');
        card.classList.remove('hidden-by-limit');
      }
    });

    const totalMatching = matchingCards.length;
    matchingCards.forEach((card, idx) => {
      if (idx < visibleCount) {
        card.classList.remove('hidden-by-limit');
      } else {
        card.classList.add('hidden-by-limit');
      }
    });

    if (totalMatching > visibleCount) {
      if (showMoreContainer) showMoreContainer.style.display = 'block';
      const remaining = totalMatching - visibleCount;
      const nextBatch = Math.min(10, remaining);
      if (showMoreBtn) showMoreBtn.textContent = `Laad 10 meer (${remaining} over) ↓`;
    } else {
      if (showMoreContainer) showMoreContainer.style.display = 'none';
    }
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', () => {
      visibleCount += 10;
      applyFilters();
    });
  }

  dayButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      dayButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDay = btn.getAttribute('data-filter-day') || 'all';
      visibleCount = 10;
      applyFilters();
    });
  });

  catButtons.forEach(btn => {
