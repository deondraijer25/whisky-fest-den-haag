    let location = (item && item.location) || 'Grote Kerk Den Haag';
    let duration = '45 minuten';
    let description = (item && item.extra) || 'Ervaar een uniek festivalonderdeel tijdens het International Whisky Festival Den Haag.';
    let ambName = 'International Whisky Festival';
    let ambTitle = 'Expert & Begeleider';
    let ambBio = 'Ervaren team met passie voor whiskycultuur, vakmanschap en historische tradities.';
    let lineupHeading = 'Officiële Proeflijst (Inbegrepen Drams)';
    let lineup = [
      'Exclusieve Single Malt Proefdram #1',
      'Zeldzame Cask Strength Proefdram #2'
    ];

    if (mcId.includes('vip') || (item && item.title && item.title.toLowerCase().includes('vip'))) {
      tag = 'VIP FESTIVAL SESSIE';
      title = item?.title || 'VIP Sessie - Vrijdagmiddag';
      subtitle = `${item?.date || 'Vrijdag 13 Nov 2026'} • ${item?.time || '13:00 – 17:00 uur'}`;
      location = 'Grote Kerk Den Haag';
      duration = '4 uur exclusieve festivaltoegang';
      description = 'De ultieme festivalbeleving voor de echte whiskyliefhebber. Geniet van 4 uur lang ongestoord proeven, vroege toegang vóór de reguliere opening, toegang tot exclusieve VIP masterclasses en verwennerij met luxe hapjes.';
      ambName = 'Festival Organisatie & VIP Concierge';
      ambTitle = 'VIP Host & Begeleiding';
      ambBio = 'Persoonlijke ontvangst en exclusieve service tijdens de officiële opening van het festivalweekend in Den Haag.';
      lineupHeading = 'Wat is inbegrepen bij uw VIP ticket:';
      lineup = [
        '12 gratis festival proefdrams (t.w.v. € 12,00)',
        'Officieel Glencairn festival proefglas',
        'Toegang tot alle exclusieve VIP Masterclasses in de kerk',
        'Luxe hapjes-vouchers (worsten- & bitterballenplateau)',
        'Officieel festivalboekje met beursplattegrond en alle standhouders'
      ];
    } else if (domCategory === 'entree' || mcId.startsWith('session-')) {
      tag = 'REGULIERE FESTIVAL SESSIE';
      title = item?.title || 'Reguliere Festival Entree';
      subtitle = `${item?.date || 'Festivaldag 2026'} • ${item?.time || '4 uur toegang'}`;
      location = 'Grote Kerk Den Haag';
      duration = '4 uur festivaltoegang';
      description = 'Beleef de magie van het meest toonaangevende whiskyfestival van Nederland in de historische Grote Kerk van Den Haag. Ontdek meer dan 40 standhouders en honderden verschillende Schotse single malts, wereldwhisky’s en Nederlandse distilleerderijen.';
      ambName = 'International Whisky Festival Team';
      ambTitle = 'Festival Host';
      ambBio = 'Het officiële festivalteam staat klaar om u te verwelkomen in de historische ambiance van de Grote Kerk.';
      lineupHeading = 'Wat is inbegrepen bij uw entree:';
      lineup = [
        'Officieel Glencairn festival proefglas',
        'Talloze gratis te proeven drams op de beursvloer',
        'Compleet festivalboekje met alle standhouders en plattegrond',
        '4 uur onbeperkt toegang tot alle beurseilanden en stands'
      ];
    } else if (domCategory === 'warehouse') {
      tag = 'WAREHOUSE TASTING';
      subtitle = `${item?.date || ''} • Kapel (Grote Kerk)`;
      location = 'Kapel (Grote Kerk Den Haag)';
      duration = '30 minuten';
      description = `Exclusieve Warehouse Tasting: ${item?.title || ''}. Proef unieke vatmonsters rechtstreeks uit de opslag onder deskundige toelichting.`;
      ambName = (item?.title && item.title.includes('Cadenhead')) ? 'Cadenhead Brand Ambassador' : 'Bresser & Timmer Specialist';
      ambTitle = 'Cask Warehouse Keeper';
      ambBio = 'Directe vatselecties en eeuwenoude warehouse tradities.';
      lineupHeading = 'Inbegrepen Vatmonsters:';
      lineup = [
        'Vatmonster #1: Warehouse Cask Special',
        'Vatmonster #2: Unchillfiltered Cask Strength',
        'Vatmonster #3: Rare Single Cask Finish'
      ];
    } else if (domCategory === 'tram') {
      tag = 'HISTORISCHE TRAMRIT';
      subtitle = `${item?.date || ''} • Vertrek: ${item?.time || ''}`;
      location = 'Opstelplaats Tram direct buiten de kerk';
      duration = '60 minuten rondrit';
      description = `Geniet van een sfeervolle rit door historisch Den Haag in een gerestaureerde klassieke HTM-tram onder begeleiding van deskundige gidsen en topdrams van ${item?.extra || 'Schotse distilleerderijen'}.`;
      ambName = item?.extra ? `${item.extra} Ambassador` : 'Gids & Tramconducteur';
      ambTitle = 'Historisch Gastheer';
      ambBio = 'Gepassioneerd kenner van zowel de Haagse stadsgeschiedenis als ambachtelijke whiskyproductie.';
      lineupHeading = 'Proefdrams tijdens de rit:';
      lineup = [
        'Welkomstdram: Speyside Classic',
        'Stadsrit Special: Cask Strength Single Malt',
        'Finish Dram: Peated Single Malt'
      ];
    } else if (domCategory === 'trail') {
      tag = 'FESTIVAL WHISKY TRAIL';
      subtitle = `${item?.date || ''} • ${item?.time || ''}`;
      location = 'Informatie-stand (Centraal in de kerk)';
      duration = '30 minuten';
      description = `Wandel mee met onze officiële festivalgids langs 5 toonaangevende standhouders. Kost € 5,00 en je krijgt er 5 gratis geselecteerde drams voor terug!`;
      ambName = item?.title ? item.title.replace('Trail ', 'Gids ') : 'Festival Trail Guide';
      ambTitle = 'Gecertificeerd Whisky Sommelier';
      ambBio = 'Leidt u langs de absolute hoogtepunten van het festival en deelt deskundige proefnotities.';
      lineupHeading = 'Wat krijgt u bij de trail:';
      lineup = [
        '5 Geselecteerde Topdrams op de beursvloer',
        'Persoonlijke uitleg van de standhouders',
        'Begeleiding in kleine groepen (max 6 personen)'
      ];
    } else if (domCategory === 'vatenmaken') {
      tag = 'COOPER WORKSHOP';
      subtitle = `${item?.date || ''} • ${item?.time || ''}`;
      location = 'Buitenterrein (Festival Kuiperij)';
      duration = '45 minuten';
      description = `Cooperclass: workshop vatenmaken met mini-tasting. Leer de eeuwenoude kunst van het vatenmaken en ervaar het branden en toasten van eikenhouten duigen.`;
      ambName = 'Meesterkuiper & Houtspecialist';
      ambTitle = 'Master Cooper';
      ambBio = 'Vakman met decennia ervaring in het bouwen en herstellen van eikenhouten whiskyvaten.';
      lineupHeading = 'Inbegrepen in de workshop:';
      lineup = [
        'Workshop vatenmaken & houtbewerking',
        'Mini-tasting van vatenrijping profielen',
        'Uitleg over first-fill en refill eikenhout'
      ];
    } else if (domCategory === 'botteling') {
      tag = 'FESTIVAL BOTTELING';
      subtitle = 'Gelimiteerde Cask Strength Single Cask';
      location = 'Ophalen op het festival of thuisbezorgd';
      duration = 'Festival Cask Exclusive';
      description = `Officiële exclusieve botteling voor het International Whisky Festival Den Haag 2026. ${item?.title || ''}`;
      ambName = 'Festival Bottling Panel';
      ambTitle = 'Cask Selection Committee';
      ambBio = 'Persoonlijk geselecteerd uit de beste vaten op vatsterkte.';
      lineupHeading = 'Details van de botteling:';
      lineup = [
        '70cl Volledige Fles (Cask Strength)',
        'Officieel genummerd herkomstcertificaat'
      ];
    } else if (domCategory === 'masterclass') {
      tag = 'SPECIAL MASTERCLASS';
      subtitle = `${item?.date || ''} • ${item?.time || ''}`;
      location = item?.location || 'Nutshuis (Spaarkamer)';
      duration = '45 minuten';
      description = `Exclusieve masterclass: ${item?.title || ''}. ${item?.extra ? 'Extra toelichting: ' + item.extra : ''}`;
      ambName = (item?.title && item.title.includes('Macallan')) ? 'Gerard Spaans' : 'Brand Ambassador';
      ambTitle = (item?.title && item.title.includes('Macallan')) ? 'Senior Brand Ambassador & Master of Malt' : 'Senior Brand Ambassador';
      ambBio = 'Internationaal expert met diepgaande kennis over distillatietechnieken, vatselecties en de unieke smaakprofielen van deze distilleerderij.';
      lineupHeading = 'Officiële Proeflijst (Inbegrepen Drams):';
      lineup = [
        'Proefdram #1: Distillery Signature Expressie (12 Y.O.)',
        'Proefdram #2: Cask Strength Single Cask Sample',
        'Proefdram #3: Exclusieve Vintage Editie'
      ];
    }

    // Populate modal fields
    const tagEl = document.querySelector('#masterclass-info-modal span[style*="font-family: var(--font-sans)"]');
    const titleEl = document.getElementById('mc-modal-title');
    const subtitleEl = document.getElementById('mc-modal-subtitle');
    const locationEl = document.getElementById('mc-modal-location');
    const durationEl = document.getElementById('mc-modal-duration');
    const descEl = document.getElementById('mc-modal-description');
    const lineupList = document.getElementById('mc-modal-lineup');
    const lineupHeadingEl = document.querySelector('#masterclass-info-modal h4:nth-of-type(2)');
    const ambNameEl = document.getElementById('mc-modal-ambassador-name');
    const ambTitleEl = document.getElementById('mc-modal-ambassador-title');
    const ambBioEl = document.getElementById('mc-modal-ambassador-bio');

    if (tagEl) tagEl.textContent = tag;
    if (titleEl) titleEl.textContent = title;
    if (subtitleEl) subtitleEl.textContent = subtitle;
    if (locationEl) locationEl.textContent = location;
    if (durationEl) durationEl.textContent = duration;
    if (descEl) descEl.textContent = description;

    if (lineupHeadingEl) lineupHeadingEl.textContent = lineupHeading;

    if (ambNameEl) ambNameEl.textContent = ambName;
    if (ambTitleEl) ambTitleEl.textContent = ambTitle;
    if (ambBioEl) ambBioEl.textContent = ambBio;

    if (lineupList) {
      lineupList.innerHTML = lineup.map(dram => `
        <li style="display: flex; align-items: center; gap: 0.75rem; padding: 0.6rem 0.9rem; background: #FFFFFF; border: 1px solid #E6DDD0; border-radius: 6px; font-size: 0.9rem; color: var(--text-charcoal, #171614);">
          <span style="color: #006448; font-size: 0.75rem; line-height: 1;">◆</span>
          <span style="font-weight: 600;">${dram}</span>
        </li>
      `).join('');
    }

    // Format Price correctly
    const priceSplit = numericPrice.toFixed(2).split('.');
    const priceValEl = document.getElementById('mc-modal-price-val');
    const priceCentsEl = document.getElementById('mc-modal-price-cents');
    if (priceValEl) priceValEl.textContent = priceSplit[0];
    if (priceCentsEl) priceCentsEl.textContent = ',' + priceSplit[1];

    if (mcModal) {
      mcModal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
    }
  }

  // Global delegation for opening info modal (Clicking info link or ticket title)
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    if (target.closest('.qty-selector, .qty-btn, .minus-btn, .plus-btn')) return;

    const infoBtn = target.closest('.btn-mc-info-trigger');
    if (infoBtn) {
      e.preventDefault();
      const mcId = infoBtn.getAttribute('data-mc-id');
      if (mcId) openMasterclassModal(mcId);
      return;
    }

    const titleClick = target.closest('.ticket-title');
    if (titleClick) {
      const stubEl = titleClick.closest('.ticket-stub');
      const mcId = stubEl?.getAttribute('data-ticket-id');
      if (mcId) openMasterclassModal(mcId);
    }
  });

  // Close MC Modal
  if (mcModalClose) mcModalClose.addEventListener('click', () => {
    if (mcModal) mcModal.style.display = 'none';
    document.body.style.overflow = '';
  });
  if (mcModal) mcModal.addEventListener('click', (e) => {
    if (e.target === mcModal) {
      mcModal.style.display = 'none';
      document.body.style.overflow = '';
    }
  });

  // Add MC to Cart from Modal
  if (mcModalAddBtn) {
    mcModalAddBtn.addEventListener('click', () => {
      if (activeMcId) {
        let stub = document.querySelector(`.ticket-stub[data-ticket-id="${activeMcId}"]`);
        if (!stub) {
          // fallback search
          const allStubs = Array.from(document.querySelectorAll('.ticket-stub[data-category="masterclass"]'));
          if (allStubs.length > 0) stub = allStubs[0];
        }
        if (stub) {
          const plusBtn = stub.querySelector('.plus-btn') as HTMLButtonElement;
          if (plusBtn) plusBtn.click();
        }
      }
      if (mcModal) mcModal.style.display = 'none';
      document.body.style.overflow = '';
    });
  }

  </script>
