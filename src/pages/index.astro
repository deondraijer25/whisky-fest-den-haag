    font-size: 1.1rem;
    margin-bottom: 2rem;
  }
  .tt-feature-list {
    list-style: none;
    font-family: var(--font-serif);
    font-size: 1.05rem;
    color: var(--text-charcoal);
    font-weight: 500;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .tt-text-link {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--whisky-gold-dark);
    text-decoration: none;
    border-bottom: 1px solid var(--whisky-gold);
    padding-bottom: 2px;
    transition: all 0.2s;
  }
  .tt-text-link:hover {
    color: var(--text-charcoal);
    border-color: var(--text-charcoal);
  }

  /* Tab Accordion Section */
  .tab-section {
    padding: 5rem 0 8rem;
    background-color: var(--bg-parchment);
  }

  /* Heritage Stats Bar */
  .heritage-bar {
    background-color: var(--bg-paper);
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    padding: 4rem 0;
  }
  .heritage-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    text-align: center;
    gap: 2rem;
  }
  .heritage-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }
  .stat-icon-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background-color: rgba(140, 110, 70, 0.07);
    border: 1px solid rgba(140, 110, 70, 0.25);
    margin-bottom: 0.25rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .heritage-stat:hover .stat-icon-wrapper {
    transform: translateY(-3px);
    border-color: var(--whisky-gold-dark);
  }
  .stat-val {
    font-family: var(--font-display);
    font-size: 2.5rem;
    color: var(--text-charcoal);
    line-height: 1;
  }
  .stat-label {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--whisky-gold-dark);
  }

  /* Testimonials Section */
  .testimonials-section {
    padding: 8rem 0;
    background-color: var(--bg-parchment);
  }
  .play-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: var(--whisky-gold);
    color: #FFF;
    font-size: 2rem;
    cursor: pointer;
    box-shadow: 0 10px 20px rgba(197, 139, 57, 0.4);
    transition: transform 0.2s;
  }
  .play-button:hover {
    transform: scale(1.1);
  }
  .testimonial-quote {
    font-size: 2.25rem;
    line-height: 1.4;
    text-transform: none;
    letter-spacing: 0;
    margin-bottom: 1.5rem;
    color: var(--text-charcoal);
  }
  .testimonial-author {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .review-stars {
    color: var(--whisky-gold);
    font-size: 1.5rem;
  }

  /* Responsive fixes */
  @media (max-width: 1024px) {
    .tt-hero-grid, .shop-grid, .split-layout, .tab-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .split-layout.reverse > * {
      direction: ltr; /* reset */
    }
    .tt-hero-visual {
      height: 400px;
    }
    .float-1 {
      position: static;
      width: 100%;
      margin-bottom: 2rem;
    }
    .float-2 {
      position: static;
    }
    .checkout-sidebar-container {
      position: static;
    }
    .heritage-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .split-text {
      max-width: 100%;
    }
  }



  /* Modal Overlay CSS duplicated from before */
  .checkout-modal-overlay { 
    position: fixed; 
    top: 0; 
    left: 0; 
    width: 100%; 
    height: 100%; 
    background-color: rgba(29, 28, 26, 0.75); 
    backdrop-filter: blur(5px); 
    z-index: 1000; 
    display: flex; 
    align-items: flex-start; 
    justify-content: center; 
    padding: 2rem 1rem; 
    overflow-y: auto; 
    animation: fadeIn 0.3s ease-out; 
  }
  .checkout-modal-card { 
    background-color: var(--bg-paper-card); 
    border: 2px solid var(--text-charcoal); 
    border-radius: 12px; 
    width: 100%; 
    max-width: 860px; 
    padding: 2rem; 
    position: relative; 
    box-shadow: 0 30px 70px rgba(0,0,0,0.5); 
    transition: max-width 0.3s; 
    margin: auto;
  }
  
  /* 2-Column Modal Layout */
  .modal-two-columns {
    display: flex;
    gap: 1.5rem;
    margin-top: 1.25rem;
  }
  .modal-form-side {
    flex: 1.2;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .modal-summary-side {
    flex: 1;
    background-color: rgba(0, 100, 72, 0.03);
    border: 1px solid rgba(140, 110, 70, 0.25);
    border-radius: 8px;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }
  .modal-summary-title {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--success-green);
    margin-bottom: 0.5rem;
    border-bottom: 1px dashed rgba(140, 110, 70, 0.25);
    padding-bottom: 0.25rem;
  }
  .modal-summary-items-list {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-charcoal);
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    max-height: 120px;
    overflow-y: auto;
    margin-bottom: 0.75rem;
    scrollbar-width: thin;
    scrollbar-color: rgba(0, 100, 72, 0.2) transparent;
  }
  .modal-summary-items-list::-webkit-scrollbar {
    width: 4px;
  }
  .modal-summary-items-list::-webkit-scrollbar-track {
    background: transparent;
  }
  .modal-summary-items-list::-webkit-scrollbar-thumb {
    background-color: rgba(0, 100, 72, 0.2);
    border-radius: 2px;
  }
  .modal-summary-item-row {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  .modal-summary-calc {
    border-top: 1px solid rgba(140, 110, 70, 0.2);
    padding-top: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
  }
  .modal-summary-total-row {
    display: flex;
    justify-content: space-between;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--text-charcoal);
    border-top: 1px dashed rgba(140, 110, 70, 0.25);
    padding-top: 0.5rem;
    margin-top: 0.25rem;
    margin-bottom: 1rem;
  }
  .modal-summary-total-row span {
    color: var(--success-green);
  }

  @media (max-width: 800px) {
    .checkout-modal-card {
      max-width: 520px;
      padding: 1.25rem;
    }
    .modal-two-columns {
      flex-direction: column;
      gap: 1.25rem;
    }
  }

  .modal-close-btn { position: absolute; top: 1rem; right: 1rem; font-size: 1.5rem; background: transparent; border: none; cursor: pointer; color: var(--text-muted); transition: color 0.2s; }
  .modal-close-btn:hover { color: var(--text-charcoal); }
  .modal-title { font-size: 1.5rem; color: var(--text-charcoal); text-align: center; margin-bottom: 0.25rem; }
  .modal-subtitle { font-family: var(--font-sans); font-size: 0.8rem; color: var(--text-muted); text-align: center; margin-bottom: 1rem; }
  .form-group { margin-bottom: 0.85rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .form-label { font-family: var(--font-sans); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-charcoal); }
  .form-control { background-color: var(--bg-parchment); border: 1px solid var(--border-color-dark); padding: 0.6rem 0.85rem; border-radius: 6px; font-family: var(--font-sans); font-size: 0.9rem; color: var(--text-charcoal); transition: all 0.3s; }
  .form-control:focus { outline: none; border-color: var(--whisky-gold-dark); box-shadow: 0 0 8px rgba(197, 139, 57, 0.15); }
  .payment-method-section { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px dashed var(--border-color); }
  .payment-method-title { display: block; font-family: var(--font-sans); font-weight: 700; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--text-charcoal); margin-bottom: 0.5rem; }
  .payment-grids { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; margin-bottom: 1rem; }
  .pay-method-card { border: 1px solid var(--border-color-dark); padding: 0.6rem; border-radius: 6px; display: flex; align-items: center; justify-content: center; cursor: pointer; background-color: var(--bg-parchment); transition: all 0.2s; }
  .pay-method-card input[type="radio"] { display: none; }
  .pay-logo { font-family: var(--font-sans); font-weight: 800; font-size: 0.95rem; color: var(--text-muted); }
  .pay-method-card.active { border-color: var(--whisky-gold-dark); background-color: var(--whisky-gold-trans); }
  .pay-method-card.active .pay-logo { color: var(--whisky-gold-dark); }
  .modal-amount-row { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-sans); font-size: 1.05rem; margin-top: 2rem; padding: 1rem 0; border-top: 1px solid var(--border-color-dark); border-bottom: 1px solid var(--border-color-dark); margin-bottom: 1.5rem; }
  .modal-amount-row strong { font-size: 1.45rem; color: var(--whisky-gold-dark); }
  .btn-block { width: 100%; padding: 1rem; }
  .spinner { width: 50px; height: 50px; border: 4px solid var(--bg-sand); border-top: 4px solid var(--whisky-gold); border-radius: 50%; margin: 0 auto 1.5rem; animation: spin 1s linear infinite; }
  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }
  .processing-title { font-size: 1.35rem; color: var(--text-charcoal); margin-bottom: 0.5rem; }
  .processing-desc { font-size: 0.95rem; color: var(--text-muted); }
  .success-ticket-stub { display: flex; flex-direction: column; }
  .success-header { text-align: center; padding: 0.5rem 0 0.5rem; }
  .success-icon { display: inline-flex; width: 48px; height: 48px; border-radius: 50%; background-color: rgba(0, 100, 72, 0.08); color: var(--success-green); align-items: center; justify-content: center; margin-bottom: 0.75rem; border: 2px solid var(--success-green); }
  .success-title { font-size: 1.5rem; color: var(--text-charcoal); margin-bottom: 0.1rem; }
  .success-subtitle { font-size: 0.85rem; color: var(--text-muted); }
  .success-body { padding-top: 0.75rem; }
  .ticket-summary-box { background-color: #FAF7F2; border: 1.5px solid #d5c28a; border-radius: 8px; padding: 1rem; margin-bottom: 0.75rem; display: flex; flex-direction: column; gap: 0.5rem; box-shadow: inset 0 2px 4px rgba(0,0,0,0.01); }
  .summary-item { display: flex; justify-content: space-between; font-family: var(--font-sans); font-size: 0.85rem; }
  .summary-item span { color: var(--text-muted); font-weight: 600; }
  .summary-item strong { color: var(--text-charcoal); font-weight: 700; }
  .summary-divider { border-top: 1px dashed rgba(140, 110, 70, 0.25); margin: 0.4rem 0; }
  .summary-items-header { font-family: var(--font-sans); font-size: 0.75rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--success-green); margin-bottom: 0.25rem; text-align: left; }
  .receipt-tickets-ul { font-family: var(--font-sans); font-size: 0.82rem; color: var(--text-charcoal); display: flex; flex-direction: column; gap: 0.35rem; text-align: left; }
  .receipt-ticket-li { display: flex; justify-content: space-between; padding-left: 0.75rem; position: relative; }
  .receipt-ticket-li::before { content: "•"; color: var(--whisky-gold-dark); position: absolute; left: 0; font-weight: bold; }
  .ticket-delivery-notice { font-size: 0.8rem; color: var(--text-muted); line-height: 1.5; text-align: center; margin-bottom: 1rem; }

  /* ====================================================
     VINTAGE HORIZONTAL TIMELINE STYLING
     ==================================================== */
  .timeline-scroll-section {
    position: relative;
    background-color: var(--bg-parchment);
    /* On desktop, we want a taller section to map vertical scroll to horizontal scroll */
    height: 300vh;
  }

  .timeline-sticky-viewport {
    position: sticky;
    top: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
    padding: 2rem 0;
  }

  .timeline-container {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 4rem;
    display: grid;
    grid-template-columns: 380px 1fr;
    gap: 4rem;
    align-items: center;
    height: calc(100vh - 180px);
    width: 100%;
  }

  .timeline-left-header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    z-index: 10;
  }

  .timeline-title {
    font-size: 3rem;
    color: var(--text-charcoal);
    line-height: 1.1;
    margin-bottom: 0.5rem;
  }

  .timeline-intro-text {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  /* Left Era List styling */
  .timeline-era-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    margin-top: 1rem;
    border-left: 2px solid var(--border-color);
    padding-left: 1.5rem;
  }

  .era-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.3s ease;
    position: relative;
    left: -25px; /* overlay the dot on the border line */
  }

  .era-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--border-color-dark);
    border: 2px solid var(--bg-parchment);
    transition: all 0.3s ease;
    box-sizing: content-box;
  }

  .era-text {
    transition: transform 0.3s ease;
  }

  .era-item.active {
    color: var(--whisky-gold-dark);
  }

  .era-item.active .era-dot {
    background-color: var(--whisky-gold);
    transform: scale(1.5);
    box-shadow: 0 0 0 4px var(--whisky-gold-trans);
  }

  .era-item.active .era-text {
    transform: translateX(4px);
  }

  /* Right Side Scrolling Track */
  .timeline-track-viewport {
    overflow: hidden;
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
  }

  .timeline-track {
    display: flex;
    gap: 3rem;
    padding: 2rem 0;
    will-change: transform;
    /* On desktop, translate is controlled by JS. We add a smooth transition for tick-button clicks */
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .timeline-card {
    width: 400px;
    flex-shrink: 0;
    background-color: var(--bg-paper-card);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 2.25rem;
    box-shadow: var(--shadow-paper);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    height: fit-content;
  }

  .timeline-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow-hover);
    border-color: var(--border-color-dark);
  }

  .timeline-card.active {
    border-color: var(--whisky-gold);
    box-shadow: 0 15px 40px rgba(197, 139, 57, 0.1), var(--shadow-paper);
  }

  /* Special Highlighted Card for Jubilee */
  .timeline-card.highlighted-jubilee {
    background: linear-gradient(145deg, #1d1c1a 0%, #2f2a24 100%);
    border: 2px solid var(--whisky-gold);
    color: #fff;
  }

  .timeline-card.highlighted-jubilee:hover {
    box-shadow: 0 25px 55px rgba(197, 139, 57, 0.25), 0 10px 30px rgba(0,0,0,0.5);
  }

  .timeline-card.highlighted-jubilee .card-title {
    color: var(--whisky-gold-light);
  }

  .text-white-muted {
    color: rgba(250, 247, 242, 0.6) !important;
  }

  .card-year-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.75rem;
  }

  .timeline-card.highlighted-jubilee .card-year-row {
    border-color: rgba(222, 214, 201, 0.2);
  }

  .card-year {
    font-family: var(--font-display);
    font-size: 2.25rem;
    color: var(--whisky-gold-dark);
    line-height: 1;
  }

  .card-num {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.9rem;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .card-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.4rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--text-charcoal);
  }

  .card-desc {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
    min-height: 90px;
  }

  .card-img-frame {
    width: 100%;
    height: 180px;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--border-color);
    position: relative;
    /* Sepia vintage mask / look */
    filter: sepia(0.35) contrast(1.05) brightness(0.95);
    transition: filter 0.3s ease;
  }

  .timeline-card:hover .card-img-frame {
    filter: sepia(0) contrast(1) brightness(1);
  }

  .card-img-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Bottom Axis Wrap */
  .timeline-axis-wrap {
    width: 100%;
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 4rem;
    margin-top: 1.5rem;
    position: relative;
    z-index: 10;
  }

  .timeline-axis-line {
    width: 100%;
    height: 2px;
    background-color: var(--border-color);
    position: relative;
  }

  .timeline-axis-progress {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 0%;
    background-color: var(--whisky-gold);
    transition: width 0.3s ease-out;
  }

  .timeline-axis-ticks {
    display: flex;
    justify-content: space-between;
    margin-top: 0.75rem;
  }

  .axis-tick {
    background: transparent;
    border: none;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--text-muted);
    position: relative;
    padding: 0.25rem 0.5rem;
    transition: all 0.3s ease;
  }

  .axis-tick::before {
    content: '';
    position: absolute;
    top: -11px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--border-color-dark);
    transition: all 0.3s ease;
  }

  .axis-tick:hover {
    color: var(--text-charcoal);
  }

  .axis-tick.active {
    color: var(--whisky-gold-dark);
    font-weight: 800;
  }

  .axis-tick.active::before {
    background-color: var(--whisky-gold);
    transform: translateX(-50%) scale(1.5);
    box-shadow: 0 0 0 3px var(--whisky-gold-trans);
  }

  /* ====================================================
     RESPONSIVE TIMELINE (MOBILE DEGRADATION)
     ==================================================== */
  @media (max-width: 1024px) {
    .timeline-scroll-section {
      height: auto !important; /* Disables the sticky scroll track depth */
      padding: 6rem 0;
    }

    .timeline-sticky-viewport {
      position: relative !important;
      height: auto !important;
      top: auto !important;
      padding: 0 !important;
    }

    .timeline-container {
      grid-template-columns: 1fr;
      gap: 3rem;
      height: auto !important;
      padding: 0 2rem;
    }

    .timeline-left-header {
      text-align: center;
      align-items: center;
    }

    .timeline-intro-text {
      max-width: 600px;
    }

    .timeline-era-list {
      display: none; /* Hide era list on mobile to save vertical space */
    }

    .timeline-track-viewport {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 1.5rem;
      scrollbar-width: none; /* Hide standard scrollbar on Firefox */
    }

    .timeline-track-viewport::-webkit-scrollbar {
      display: none; /* Hide standard scrollbar on Chrome/Safari */
    }

    .timeline-track {
      padding: 1rem 0;
      gap: 1.5rem;
      /* On mobile we want natural touch swipe, no JS transform override */
      transform: none !important; 
      transition: none !important;
    }

    .timeline-card {
      width: 290px;
      scroll-snap-align: center;
      padding: 1.75rem;
    }

    .card-desc {
      min-height: auto;
    }

    .timeline-axis-wrap {
      padding: 0 2rem;
      margin-top: 1rem;
    }

    .axis-tick span {
      font-size: 0.75rem;
    }
  }

  /* Interactive Timetable Styles */
  .timetable-section {
    background: var(--bg-parchment);
    padding: 5rem 0;
    border-top: 1px solid rgba(140, 110, 70, 0.15);
  }
  .timetable-tabs {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 3rem;
  }
  .timetable-tab-btn {
    background-color: transparent;
    border: 2px solid rgba(140, 110, 70, 0.3);
    color: var(--text-charcoal);
    font-family: var(--font-sans);
    font-size: 1rem;
    font-weight: 700;
    padding: 0.6rem 1.5rem;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .timetable-tab-btn:hover {
    border-color: var(--success-green);
    background-color: rgba(0, 100, 72, 0.05);
  }
  .timetable-tab-btn.active {
    background-color: var(--success-green);
    border-color: var(--success-green);
    color: #FAF7F2;
  }
  .timetable-time-filter {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    justify-content: center;
    background: rgba(140, 110, 70, 0.08);
