    // 9. Enhanced Interactive Timetable Logic (Day, Timepart & Category Type)
  let activeTtTab = 'vrijdag';
  let activeTtTime = 'all';
  let activeTtType = 'all';

  function determineCardCategory(card: HTMLElement) {
    const infoBtn = card.querySelector('[data-mc-id]');
    const bookBtn = card.querySelector('[data-target-stub]');
    const stubId = (infoBtn && infoBtn.getAttribute('data-mc-id')) || (bookBtn && bookBtn.getAttribute('data-target-stub')) || '';
    const titleText = (card.querySelector('.tt-card-title') && card.querySelector('.tt-card-title').textContent.toLowerCase()) || '';

    if (stubId.includes('session') || stubId.includes('vip') || titleText.includes('sessie') || titleText.includes('vip')) return 'entree';
    if (stubId.includes('tram') || titleText.includes('tram')) return 'tram';
    if (stubId.includes('trail') || titleText.includes('trail')) return 'trail';
    if (stubId.includes('vatenmaken') || stubId.includes('workshop') || titleText.includes('vatenmaken') || titleText.includes('workshop')) return 'vatenmaken';
    if (stubId.includes('botteling') || titleText.includes('botteling')) return 'botteling';
    return 'masterclass';
  }

  function filterTimetableCards() {
