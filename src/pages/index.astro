---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import TicketStub from '../components/TicketStub.astro';
import { TICKETS_DEN_HAAG } from '../data/ticketsDenHaag';
import LogoSvg from '../assets/Logo/Logo.svg?raw';
import GlasswareSvg15 from '../assets/Logo/Logo wit svg/Middel 15.svg?raw';
---

<Layout 
  title="Home - Premium Vintage-Modern Ontwerp" 
  description="Bezoek het meest sfeervolle en bekende whiskyfestival van Nederland in de Grote Kerk Den Haag. 13, 14 en 15 november 2026. Bestel hier direct uw entreekaarten via onze mock ticketshop."
>
  <!-- 0. HOMEPAGE 2.5-SECOND COIN-FLIP PRELOADER -->
  <div id="hp-preloader" class="hp-preloader-overlay">
    <div class="preloader-content">
      <!-- 3D Flipping Gold Coin Container -->
      <div class="coin-3d-stage">
        <div class="coin-flipper-core">
          <Fragment set:html={LogoSvg} />
        </div>
        <div class="coin-glow-shadow"></div>
      </div>

      <!-- Loading Text & Progress Bar -->
      <div class="preloader-text-group">
        <p class="preloader-title">INTERNATIONAL WHISKY FESTIVAL</p>
        <div class="preloader-progress-track">
          <div class="preloader-progress-bar"></div>
        </div>
        <p class="preloader-subtitle">EST. 2000 &bull; DEN HAAG</p>
      </div>
    </div>
  </div>

  <!-- 1. Navigation Header -->
  <Header />

  <main>
    <!-- 2. TT HERO SECTION (Left Text, Right Full-Height Video Banner with Gradient Fade) -->
    <section class="tt-hero-section" style="background: linear-gradient(135deg, #061A10 0%, #0E3823 35%, #165636 65%, #082114 100%) !important; color: #FFFFFF !important;">
      <div class="hero-vintage-overlay"></div>

      <!-- Full-Height Right Side Video Banner -->
      <div class="hero-video-full-right">
        <video 
          id="hero-bg-video"
          class="hero-video-element"
          autoplay 
          muted 
          loop 
          playsinline
          preload="auto"
          poster="/aftermovie_poster.jpg"
        >
          <source src="/Video/hero_loop.mp4" type="video/mp4" />
          Uw browser ondersteunt geen HTML5 video.
        </video>

        <!-- Seamless Blend Overlays: Left Fade & Warm Vintage Vignette -->
        <div class="hero-video-blend-gradient"></div>
        <div class="hero-video-tint-overlay"></div>
      </div>

      <div class="section-container tt-hero-grid">
        
        <div class="tt-hero-text">
          <!-- Decorative barrel line-art -->
          <div class="hero-barrel-art" aria-hidden="true">
            <img src="/barrels line.svg" alt="" width="320" height="380" loading="eager" />
          </div>

          <h1 class="tt-hero-title">
            Hét weekend<br>
            waar elke whisky-<br>
            liefhebber naar uitkijkt.
          </h1>

          <div class="hero-date-line">
            <span class="date-text">13, 14 &amp; 15 November 2026</span>
            <span class="date-sep">◆</span>
            <span class="loc-text">Grote Kerk Den Haag</span>
          </div>

          <p class="tt-hero-subtitle">
            Van rokerige Islay malts tot intieme masterclasses in het Nutshuis. Drie dagen lang verandert Den Haag in de whiskyhoofdstad van Nederland voor de legendarische 25e editie.
          </p>
          <div class="hero-actions" style="align-items: center;">
            <a href="#sessies" class="btn btn-beige">Bestel Tickets</a>
            <a href="/programma" class="tt-text-link" style="margin-left: 1rem;">Bekijk Programma</a>
          </div>

          <div class="tt-hero-reviews">
            <p class="reviews-title">Geprezen door duizenden liefhebbers!</p>
            <div class="reviews-grid">
              <div class="review-item">
                <span class="stars">★★★★★</span>
                <span class="review-source">4.9/5 op Trustpilot</span>
              </div>
            </div>

          </div>
        </div>

        <!-- Right Column: Glassware SVG Artwork (Middel 15.svg 1-op-1 overgenomen) -->
        <div class="tt-hero-visual-right" aria-hidden="true">
          <div class="hero-glass-art-card">
            <Fragment set:html={GlasswareSvg15} />
          </div>
        </div>

      </div>
    </section>

                    <!-- 3. CONTINUOUS MOVING PARTNER & DISTILLERY MARQUEE SLIDER -->
    <section class="trust-marquee-section" aria-label="Aanwezige Partner Distilleerderijen">
      <div class="trust-marquee-wrapper">
        <div class="trust-marquee-track">
          
          <span class="trust-text-logo">The Macallan</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Highland Park</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Glenfiddich</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">The Balvenie</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Laphroaig</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Ardbeg</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Springbank</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Bowmore</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Teeling Whiskey</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">SMWS</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">House of Suntory</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Glengoyne</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Talisker</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Lagavulin</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Dalmore</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Arran Single Malt</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Oban</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Nc'nean</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          
          <span class="trust-text-logo">The Macallan</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Highland Park</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Glenfiddich</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">The Balvenie</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Laphroaig</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Ardbeg</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Springbank</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Bowmore</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Teeling Whiskey</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">SMWS</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">House of Suntory</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Glengoyne</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Talisker</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Lagavulin</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Dalmore</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Arran Single Malt</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Oban</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
          <span class="trust-text-logo">Nc'nean</span>
          <span class="partner-sep" style="color: #C58B39; font-size: 0.9rem; opacity: 0.85; user-select: none;">◆</span>
        </div>
      </div>
    </section>

    <!-- 4. TORN PAPER TICKET SECTION -->
    <section id="sessies" class="tear-section">
      
      <!-- Section header on light paper -->
      <div class="tear-header-area">
        <div class="section-container">
          <div class="tt-section-header text-center">
            <h2 class="tt-section-title">Kies uw Sessie & Extras</h2>
            <p class="tt-section-subtitle">Selecteer uw favoriete dag. De capaciteit is gelimiteerd om een exclusieve, rustige proefervaring te garanderen.</p>
          </div>
        </div>
      </div>

      <!-- Top torn edge (light paper over dark) -->
      <div class="torn-edge-wrap">
        <img src="/torn-top.svg?v=2" alt="" class="torn-edge-img" />
      </div>

      <!-- Dark ticket area -->
      <div class="dark-gap" id="ticket-gap">
        <div class="section-container">
          
          <!-- Shop Filters -->
          <div class="shop-filters-container">
            <div class="filter-row">
              <span class="filter-label">Dag:</span>
              <div class="filter-buttons" id="day-filter-buttons">
                <button type="button" class="filter-tab-btn active" data-filter-day="all">Alle Dagen</button>
                <button type="button" class="filter-tab-btn" data-filter-day="vrijdag">Vrijdag 13 Nov</button>
                <button type="button" class="filter-tab-btn" data-filter-day="zaterdag">Zaterdag 14 Nov</button>
                <button type="button" class="filter-tab-btn" data-filter-day="zondag">Zondag 15 Nov</button>
              </div>
            </div>
            <div class="filter-row" style="margin-top: 0.5rem;">
              <span class="filter-label">Type:</span>
              <div class="filter-buttons" id="cat-filter-buttons">
                <button type="button" class="filter-tab-btn active" data-filter-cat="all">Alles</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="entree">Sessie Entree</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="warehouse">Warehouse Tastings</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="masterclass">Masterclasses</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="tram">Whiskytram</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="trail">Whiskytrail</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="vatenmaken">Workshops</button>
                <button type="button" class="filter-tab-btn" data-filter-cat="botteling">Botteling</button>
              </div>
            </div>
            <div class="filter-row" id="time-filter-row" style="margin-top: 0.5rem; display: flex;">
              <span class="filter-label">Tijd:</span>
              <div class="filter-buttons" id="time-filter-buttons">
                <button type="button" class="filter-tab-btn active" data-filter-time="all">Alles</button>
                <button type="button" class="filter-tab-btn" data-filter-time="ochtend">Ochtend (tot 13u)</button>
                <button type="button" class="filter-tab-btn" data-filter-time="middag">Middag (13u - 18u)</button>
                <button type="button" class="filter-tab-btn" data-filter-time="avond">Avond (vanaf 18u)</button>
              </div>
            </div>
          </div>

          <div class="shop-grid">
            <!-- Left side: Organized Ticket List -->
            <div class="tickets-list fade-in-group" id="shop-tickets-list">
              {TICKETS_DEN_HAAG.map((ticket) => (
                <TicketStub
                  id={ticket.id}
                  title={ticket.title}
                  price={ticket.price}
                  date={ticket.date}
                  time={ticket.time}
                  category={ticket.category}
                  daypart={ticket.daypart}
                  location={ticket.location}
                  bookingType={ticket.bookingType}
                  status={ticket.status}
                  statusText={ticket.statusText}
                  isSoldOut={ticket.isSoldOut}
                  extraMeta={ticket.extra}
                  included={ticket.category === 'entree' ? (
                    ticket.title.toLowerCase().includes('vip') 
                      ? ["12 gratis drams (€12)", "Glencairn tastingglas", "Hapjes-vouchers & Boekje", "VIP masterclasses"]
                      : ["Glencairn tastingglas", "Talloze gratis drams", "Festivalboekje", "Toegang 4 uur"]
                  ) : undefined}
                />
              ))}

              <!-- Show More Tickets Button -->
              <div id="show-more-container" style="display: none; text-align: center; margin-top: 3rem; margin-bottom: 2rem; width: 100%;">
                <button type="button" id="show-more-btn" style="padding: 1rem 3rem; font-family: var(--font-sans); font-weight: 800; font-size: 0.95rem; text-transform: uppercase; letter-spacing: 0.05em; border-radius: 8px; border: 2px solid var(--whisky-gold); background-color: var(--whisky-gold); color: #1c1917; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.25); display: inline-flex; align-items: center; gap: 0.5rem; justify-content: center;">
                  Toon alle tickets (0 extra) ↓
                </button>
              </div>

              <style>
                #show-more-btn:hover {
                  background-color: var(--whisky-gold-light) !important;
                  border-color: var(--whisky-gold-light) !important;
                  transform: translateY(-2px);
                  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.3) !important;
                }
                #show-more-btn:active {
                  transform: translateY(1px);
                  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2) !important;
                }
              
  /* ==========================================
     UNIVERSAL MODAL OVERLAY & POPUP STYLING
     ========================================== */
  .modal-overlay {
    position: fixed !important;
    inset: 0 !important;
    top: 0 !important;
    left: 0 !important;
    width: 100vw !important;
    height: 100vh !important;
    background-color: rgba(15, 14, 12, 0.78) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    z-index: 999999 !important;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    overflow-y: auto;
    box-sizing: border-box;
  }

  .vintage-modal-card {
    background-color: #FAF7F2 !important;
    border: 1.5px solid #D8CFC0 !important;
    border-radius: 12px !important;
    width: 100% !important;
    max-width: 680px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5) !important;
    position: relative;
    overflow: hidden;
    margin: auto;
    color: #171614 !important;
    animation: modalFadeIn 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes modalFadeIn {
    from {
      opacity: 0;
      transform: scale(0.95) translateY(10px);
    }
    to {
      opacity: 1;
      transform: scale(1) translateY(0);
    }
  }

  .modal-header {
    padding: 1.5rem 2rem 1.25rem;
    background-color: #F4EFE6;
    border-bottom: 1px solid #E6DEC8;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    position: relative;
  }

  .modal-step-tag {
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--whisky-gold-dark, #8b5a1b);
    display: block;
    margin-bottom: 0.25rem;
  }

  .modal-title {
    font-family: var(--font-display, serif);
    font-size: 1.6rem;
    color: #171614;
    margin: 0;
    line-height: 1.2;
  }

  .modal-subtitle {
    font-size: 0.88rem;
    color: #63584E;
    margin: 0.25rem 0 0;
  }

  .modal-close-btn {
    background: none;
    border: none;
    font-size: 1.75rem;
    line-height: 1;
    color: #8C827A;
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 4px;
    transition: color 0.2s;
  }

  .modal-close-btn:hover {
    color: #171614;
  }


  /* Timetable Type Filter Buttons */
  .timetable-type-filter {
    background: rgba(197, 139, 57, 0.08);
    padding: 0.35rem 0.75rem;
    border-radius: 30px;
    border: 1px solid rgba(140, 110, 70, 0.25);
  }
  .tt-type-btn {
    border: none;
    background: transparent;
    padding: 0.4rem 0.85rem;
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--text-charcoal);
    border-radius: 20px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tt-type-btn.active, .tt-type-btn:hover {
    background-color: var(--whisky-gold-dark, #006448);
    color: #FAF7F2;
  }
  .tt-card-info-btn:hover {
    color: var(--text-charcoal, #171614) !important;
    text-decoration: underline !important;
  }

  /* Compact, Elegant Timetable Boeken Button */
  .tt-card-action-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 1rem;
    width: 100%;
    gap: 0.5rem;
  }
  .tt-book-btn {
    height: 32px !important;
    min-height: 32px !important;
    max-height: 32px !important;
    padding: 0 0.85rem !important;
    font-family: var(--font-sans, sans-serif) !important;
    font-size: 0.76rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    border-radius: 4px !important;
    border: 1.5px solid var(--text-charcoal, #171614) !important;
    box-shadow: 2px 2px 0px rgba(23, 22, 20, 0.75) !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    white-space: nowrap !important;
    cursor: pointer !important;
    transition: all 0.15s ease !important;
  }
  .tt-book-btn:hover {
    transform: translateY(-1px) !important;
    box-shadow: 2px 3px 0px rgba(23, 22, 20, 0.9) !important;
  }
  .tt-book-btn:active {
    transform: translate(1px, 1px) !important;
    box-shadow: 1px 1px 0px rgba(23, 22, 20, 0.9) !important;
  }


  /* Strict Global SVG Bounds */
  :global(.hero-glass-art-card svg) {
    width: 100% !important;
    max-width: 320px !important;
    height: auto !important;
    max-height: 420px !important;
    display: block !important;
    margin: 0 auto !important;
  }
  :global(.coin-flipper-core svg) {
    width: 100% !important;
    max-width: 120px !important;
    height: auto !important;
    display: block !important;
    margin: 0 auto !important;
  }
  :global(.freestanding-svg-wrapper svg) {
    width: 100% !important;
    max-width: 140px !important;
    height: 100% !important;
    max-height: 190px !important;
    display: block !important;
    margin: 0 auto !important;
  }
  .hero-glass-art-card {
    width: 100% !important;
    max-width: 320px !important;
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
  }

  /* ====================================================
     PREMIUM INFINITE PARTNER & DISTILLERY MARQUEE SLIDER
     ==================================================== */
  .trust-marquee-section {
    background-color: var(--bg-sand, #FAF7F2) !important;
    border-top: 1.5px solid var(--border-color, #E6DDD0) !important;
    border-bottom: 1.5px solid var(--border-color, #E6DDD0) !important;
    padding: 1.6rem 0 !important;
    overflow: hidden !important;
    position: relative !important;
    width: 100% !important;
    box-sizing: border-box !important;
    mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 6%, black 94%, transparent 100%);
    z-index: 10;
  }

  .trust-marquee-wrapper {
    width: 100% !important;
    overflow: hidden !important;
    display: flex !important;
  }

  .trust-marquee-track {
    display: flex !important;
    align-items: center !important;
