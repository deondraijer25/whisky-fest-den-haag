      const cardEl = card as HTMLElement;
      const cardTimepart = cardEl.getAttribute('data-timepart') || 'all';
      const category = cardEl.getAttribute('data-category') || determineCardCategory(cardEl);
      cardEl.setAttribute('data-category', category);

      const matchesTime = (activeTtTime === 'all' || cardTimepart === activeTtTime);
      const matchesType = (activeTtType === 'all' || category === activeTtType);

      if (matchesTime && matchesType) {
        cardEl.style.display = 'flex';
      } else {
        cardEl.style.display = 'none';
      }
    });
  }

