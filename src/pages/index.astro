    font-weight: 700;
    border-radius: 20px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-charcoal);
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .tt-time-btn:hover {
    color: var(--success-green);
    background-color: rgba(0, 100, 72, 0.08);
  }
  .tt-time-btn.active {
    background-color: var(--success-green);
    border-color: var(--success-green);
    color: #FAF7F2;
    box-shadow: 0 2px 8px rgba(0, 100, 72, 0.25);
  }
  .timetable-pane {
    display: none;
    animation: fadeIn 0.4s ease-out;
  }
  .timetable-pane.active {
    display: block;
  }
  .timetable-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .tt-card {
    background: var(--bg-paper-card);
    border: 1px solid rgba(140, 110, 70, 0.2);
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.02);
    position: relative;
    overflow: hidden;
  }
  .tt-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    border-color: var(--success-green);
  }
  .tt-card-time {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--success-green);
    margin-bottom: 0.25rem;
  }
  .tt-card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .tt-loc {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
  }
  .tt-price {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--success-green);
  }
  .tt-card-title {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--text-charcoal);
    margin-bottom: 0.5rem;
    line-height: 1.2;
  }
  .tt-card-desc {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.45;
    margin-bottom: 1.5rem;
    flex-grow: 1;
  }
  .tt-book-btn {
    align-self: flex-start;
    padding: 0.5rem 1rem !important;
    font-size: 0.85rem !important;
  }
</style>

<script>
  // safe-preloader-dismiss: Guaranteed preloader fade-out
  (function() {
    const pl = document.getElementById('hp-preloader');
    if (pl) {
      setTimeout(() => {
        pl.classList.add('fade-out');
        document.body.style.overflow = '';
      }, 1800);
      setTimeout(() => {
        pl.style.display = 'none';
      }, 2300);
    }
  })();

  // Tabs Interactive Logic
  const tabTriggers = document.querySelectorAll('.tab-trigger-card');
  tabTriggers.forEach(tab => {
    tab.addEventListener('click', () => {
      tabTriggers.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      // In a real build, we swap the image in .tab-visual here.
    });
  });

  // Ticket Filtering Logic
  const dayButtons = document.querySelectorAll('#day-filter-buttons .filter-tab-btn');
  const catButtons = document.querySelectorAll('#cat-filter-buttons .filter-tab-btn');
  const timeButtons = document.querySelectorAll('#time-filter-buttons .filter-tab-btn');
  const timeFilterRow = document.getElementById('time-filter-row');
  const ticketCards = document.querySelectorAll(".ticket-stub");
  
  let activeDay = 'all';
  let activeCat = 'entree';
  let activeTime = 'all';
  let showAllTickets = false;

  const showMoreContainer = document.getElementById('show-more-container');
  const showMoreBtn = document.getElementById('show-more-btn');

  function applyFilters() {
    // Show/hide time filter row depending on selected category
    if (timeFilterRow) {
      if (activeCat === 'tram' || activeCat === 'botteling' || activeCat === 'trail' || activeCat === 'vatenmaken') {
        timeFilterRow.style.display = 'none';
        activeTime = 'all'; // reset time filter
        timeButtons.forEach(b => {
          if (b.getAttribute('data-filter-time') === 'all') b.classList.add('active');
          else b.classList.remove('active');
        });
      } else {
        timeFilterRow.style.display = 'flex';
      }
    }

    const matchingCards: HTMLElement[] = [];

    ticketCards.forEach(card => {
      const cardDay = card.getAttribute('data-day') || 'all';
      const cardCat = card.getAttribute('data-category') || 'entree';
      const cardTime = card.getAttribute('data-daypart') || 'all';

      const matchDay = (activeDay === 'all') || (cardDay === 'all') || (cardDay === activeDay);
      const matchCat = (activeCat === 'all') || (cardCat === activeCat);
      const matchTime = (activeTime === 'all') || (cardTime === 'all') || (cardTime === activeTime);

      if (matchDay && matchCat && matchTime) {
        card.classList.remove('hidden-by-filter');
        matchingCards.push(card as HTMLElement);
      } else {
        card.classList.add('hidden-by-filter');
        card.classList.remove('hidden-by-limit');
      }
    });

    // Handle Limit / Show More
    const limit = 6;
    if (matchingCards.length > limit && !showAllTickets) {
      matchingCards.forEach((card, idx) => {
        if (idx >= limit) {
          card.classList.add('hidden-by-limit');
        } else {
          card.classList.remove('hidden-by-limit');
        }
      });
      if (showMoreContainer) showMoreContainer.style.display = 'block';
      if (showMoreBtn) showMoreBtn.textContent = `Toon alle tickets (${matchingCards.length - limit} extra) ↓`;
    } else {
      matchingCards.forEach(card => card.classList.remove('hidden-by-limit'));
      if (showMoreContainer) showMoreContainer.style.display = 'none';
    }
  }

  if (showMoreBtn) {
    showMoreBtn.addEventListener('click', () => {
      showAllTickets = true;
      applyFilters();
    });
  }

  dayButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      dayButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeDay = btn.getAttribute('data-filter-day') || 'all';
      showAllTickets = false; // Reset limit view
      applyFilters();
    });
  });

  catButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      catButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeCat = btn.getAttribute('data-filter-cat') || 'all';
      showAllTickets = false; // Reset limit view
      applyFilters();
    });
  });

  timeButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      timeButtons.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTime = btn.getAttribute('data-filter-time') || 'all';
      showAllTickets = false; // Reset limit view
      applyFilters();
    });
  });

  // Execute initial filter pass on load so tickets display immediately matching active filters
  applyFilters();
  restoreCartFromLocalStorage();
  updateShop();

  // Shop Cart Logic (Preserved and expanded)
  const cart: Record<string, { title: string; price: number; qty: number; category: string; timeslot?: string; delivery?: string }> = {};
  const serviceFee = 4.50;
  const cartItemsContainer = document.getElementById("cart-items");
  const subtotalEl = document.getElementById("receipt-subtotal");
  const feeEl = document.getElementById("receipt-fee");
  const shippingRow = document.getElementById("shipping-row");
  const shippingEl = document.getElementById("receipt-shipping");
  const totalEl = document.getElementById("receipt-total");
  const checkoutBtn = document.getElementById("checkout-trigger-btn") as HTMLButtonElement;
  


  
  // LocalStorage Cart Sync & Dispatcher
  function saveCartToLocalStorage(subtotalVal: number, totalItemsVal: number) {
    const itemsList: any[] = [];
    Object.keys(cart).forEach(id => {
      const item = cart[id];
      if (item && item.qty > 0) {
        let variantTxt = "";
        if (item.category === "tram") variantTxt = item.timeslot || "";
        else if (item.category === "masterclass") variantTxt = item.timeslot || "";
        else if (item.category === "trail") variantTxt = `${item.timeslot || ""} (${item.guide || ""})`;
        else if (item.category === "vatenmaken") variantTxt = item.timeslot || "";
        else if (item.category === "botteling") variantTxt = item.delivery === "shipping" ? "Verzenden (+ €12.50)" : "Ophalen";

        itemsList.push({
          id,
          title: item.title,
          price: item.price,
          qty: item.qty,
          category: item.category,
          variant: variantTxt
        });
      }
    });

    try {
      localStorage.setItem("whiskyfest_cart", JSON.stringify({
        items: itemsList,
        subtotal: subtotalVal,
        totalItems: totalItemsVal,
        cartRaw: cart
      }));
      window.dispatchEvent(new CustomEvent("cart-updated"));
    } catch(e) {
      console.error("Cart save error:", e);
    }
  }

  function restoreCartFromLocalStorage() {
    try {
      const raw = localStorage.getItem("whiskyfest_cart");
      if (raw) {
        const parsed = JSON.parse(raw);
        if (parsed.cartRaw) {
          Object.assign(cart, parsed.cartRaw);
          Object.keys(cart).forEach(id => {
            const card = document.querySelector(`.ticket-stub[data-ticket-id="${id}"]`);
            if (card) {
              const qtyDisplay = card.querySelector(".qty-val");
              if (qtyDisplay) qtyDisplay.textContent = String(cart[id].qty || 0);
              if (cart[id].qty > 0) card.classList.add("selected");
              else card.classList.remove("selected");
            }
          });
        }
      }
    } catch(e) {}
  }


  function updateShop() {
    let subtotal = 0;
    let totalItems = 0;
    let entryTicketsCount = 0;
    let selectedSessionId = "";
    let shippingActive = false;

    // 1. Calculate quantities and scan cart
    Object.keys(cart).forEach(id => {
      const item = cart[id];
      if (item.qty > 0) {
        subtotal += item.price * item.qty;
        totalItems += item.qty;

        if (item.category === "entree") {
          entryTicketsCount += item.qty;
          selectedSessionId = id;
        }

        if (item.category === "botteling" && item.delivery === "shipping") {
          shippingActive = true;
        }
      }
    });

    // Shipping calculations
    const shippingFee = 12.50;
    const activeShipping = shippingActive ? shippingFee : 0;
    if (shippingRow && shippingEl) {
      if (shippingActive) {
        shippingRow.style.display = "flex";
        shippingEl.innerHTML = `&euro;${shippingFee.toFixed(2)}`;
      } else {
        shippingRow.style.display = "none";
      }
    }

    const activeFee = totalItems > 0 ? serviceFee : 0;
    const finalTotal = subtotal + activeFee + activeShipping;

    // Render Cart HTML
    if (cartItemsContainer) {
      if (totalItems === 0) {
        cartItemsContainer.innerHTML = '<p class="empty-cart-msg">Selecteer hiernaast uw ticket(s) om de bestelling te starten.</p>';
      } else {
        let listHtml = "";
        const entries = Object.keys(cart).filter(id => cart[id].qty > 0);
        
        entries.forEach((id, index) => {
          const item = cart[id];
          let displayTitle = item.title;
          
          if (item.category === "tram" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "masterclass" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "trail" && item.timeslot) {
            const guideSuffix = item.guide ? ` - Gids: ${item.guide}` : '';
            displayTitle = `${item.title} (${item.timeslot}${guideSuffix})`;
          } else if (item.category === "vatenmaken" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "botteling" && item.delivery) {
            const methodText = item.delivery === "shipping" ? "Verzenden" : "Ophalen";
            displayTitle = `${item.title} [${methodText}]`;
          }

          const isLast = index === entries.length - 1;
          
          listHtml += `
            <div class="cart-item-row" ${isLast ? 'style="border-bottom:none;"' : ''}>
              <div class="cart-item-info">
                <span class="cart-item-name">${displayTitle}</span>
                <span class="cart-item-meta">${item.qty} × €${item.price.toFixed(2)}</span>
              </div>
              <span class="cart-item-price">€${(item.price * item.qty).toFixed(2)}</span>
            </div>
          `;
        });
        
        cartItemsContainer.innerHTML = listHtml;
      }
    }
    
    if (subtotalEl) subtotalEl.innerHTML = `&euro;${subtotal.toFixed(2)}`;
    if (feeEl) feeEl.innerHTML = `&euro;${activeFee.toFixed(2)}`;
    if (totalEl) totalEl.innerHTML = `&euro;${finalTotal.toFixed(2)}`;
    if (checkoutBtn) checkoutBtn.disabled = totalItems === 0;
  }

  ticketCards.forEach(card => {
    const id = card.getAttribute("data-ticket-id") || "";
    const price = parseFloat(card.getAttribute("data-price") || "0");
    const title = card.getAttribute("data-title") || "";
    const category = card.getAttribute("data-category") || "entree";
    const minusBtn = card.querySelector('[data-action="minus"]');
    const plusBtn = card.querySelector('[data-action="plus"]');
    const qtyVal = card.querySelector(".qty-val");

    const tramSelect = card.querySelector(".tram-select") as HTMLSelectElement;
    const bottlingSelect = card.querySelector(".bottling-select") as HTMLSelectElement;
    const introSelect = card.querySelector(".intro-select") as HTMLSelectElement;
    const trailTimeSelect = card.querySelector(".trail-time-select") as HTMLSelectElement;
    const trailGuideSelect = card.querySelector(".trail-guide-select") as HTMLSelectElement;
    const vatenmakenTimeSelect = card.querySelector(".vatenmaken-time-select") as HTMLSelectElement;

    // Availability maps
    const trailAvailability = {
      "Vrijdag 20:00": ["Klaas", "Stanley"],
      "Vrijdag 20:30": ["Ernst", "Marlie", "Sebastiaan"],
      "Vrijdag 21:00": ["Klaas", "Stanley"],
      "Vrijdag 21:30": ["Ernst", "Marlie", "Sebastiaan"],
      "Zaterdag 14:00": ["Ernst", "Sebastiaan"],
      "Zaterdag 14:30": ["Klaas", "Stanley"],
      "Zaterdag 15:00": ["Ernst", "Marlie", "Sebastiaan"],
      "Zaterdag 15:30": ["Klaas", "Stanley"],
      "Zaterdag 20:00": ["Stanley"],
      "Zaterdag 20:30": ["Ernst", "Sebastiaan"],
      "Zaterdag 21:00": ["Klaas", "Stanley"],
      "Zaterdag 21:30": ["Ernst", "Marlie", "Sebastiaan"],
      "Zondag 14:00": ["Marlie"],
      "Zondag 14:30": ["Klaas", "Stanley"],
      "Zondag 15:00": ["Ernst", "Marlie"],
      "Zondag 15:30": ["Klaas"]
    };

    const vatenAvailability = {
      "Vrijdag 14:30": 12,
      "Vrijdag 15:30": 8,
      "Vrijdag 20:30": 15,
      "Vrijdag 21:30": 2,
      "Zaterdag 14:30": 4,
      "Zaterdag 15:30": 0,
      "Zaterdag 20:30": 18,
      "Zaterdag 21:30": 9,
      "Zondag 14:30": 1,
      "Zondag 15:30": 0
    };

    if (tramSelect) {
      tramSelect.addEventListener("change", () => {
        if (cart[id]) {
          cart[id].timeslot = tramSelect.value;
          updateShop();
        }
      });
    }

    if (introSelect) {
      introSelect.addEventListener("change", () => {
        if (cart[id]) {
          cart[id].timeslot = introSelect.value;
          updateShop();
        }
      });
    }

    if (bottlingSelect) {
      bottlingSelect.addEventListener("change", () => {
        if (cart[id]) {
          cart[id].delivery = bottlingSelect.value;
          updateShop();
        }
      });
    }

    if (trailTimeSelect && trailGuideSelect) {
      const updateGuides = () => {
        const timeVal = trailTimeSelect.value;
        const allowedGuides = trailAvailability[timeVal] || [];
        let firstAvailable = "";

        Array.from(trailGuideSelect.options).forEach(opt => {
          const guideName = opt.value;
          if (allowedGuides.includes(guideName)) {
            opt.disabled = false;
            opt.text = guideName;
            if (!firstAvailable) firstAvailable = guideName;
          } else {
            opt.disabled = true;
            opt.text = `${guideName} (VOL)`;
          }
        });

        const currentSelectedOpt = trailGuideSelect.options[trailGuideSelect.selectedIndex];
        if (currentSelectedOpt && currentSelectedOpt.disabled) {
          trailGuideSelect.value = firstAvailable;
        }

        if (cart[id]) {
          cart[id].timeslot = timeVal;
          cart[id].guide = trailGuideSelect.value;
          updateShop();
        }
      };

      trailTimeSelect.addEventListener("change", updateGuides);
      trailGuideSelect.addEventListener("change", () => {
        if (cart[id]) {
          cart[id].guide = trailGuideSelect.value;
          updateShop();
        }
      });

      updateGuides(); // Run once initially
    }

    if (vatenmakenTimeSelect) {
      const updateVatenCapacity = () => {
        const timeVal = vatenmakenTimeSelect.value;
        const capacity = vatenAvailability[timeVal] ?? 0;
        
        if (capacity === 0) {
          if (plusBtn) (plusBtn as HTMLButtonElement).disabled = true;
          if (cart[id]) {
            cart[id].qty = 0;
            if (qtyVal) qtyVal.textContent = "0";
            delete cart[id];
            updateShop();
          }
        } else {
          if (plusBtn) (plusBtn as HTMLButtonElement).disabled = false;
        }

        if (cart[id]) {
          cart[id].timeslot = timeVal;
          if (cart[id].qty > capacity) {
            cart[id].qty = capacity;
            if (qtyVal) qtyVal.textContent = String(capacity);
          }
          updateShop();
        }
      };

      vatenmakenTimeSelect.addEventListener("change", updateVatenCapacity);
      updateVatenCapacity();
    }

    if (plusBtn && qtyVal) {
      plusBtn.addEventListener("click", () => {
        if (!cart[id]) {
          cart[id] = { title, price, qty: 0, category };
        }
        if (tramSelect) cart[id].timeslot = tramSelect.value;
        if (introSelect) cart[id].timeslot = introSelect.value;
        if (bottlingSelect) cart[id].delivery = bottlingSelect.value;
        if (trailTimeSelect) cart[id].timeslot = trailTimeSelect.value;
        if (trailGuideSelect) cart[id].guide = trailGuideSelect.value;
        if (vatenmakenTimeSelect) cart[id].timeslot = vatenmakenTimeSelect.value;

        // Capacity checks
        if (vatenmakenTimeSelect) {
          const timeVal = vatenmakenTimeSelect.value;
          const capacity = vatenAvailability[timeVal] ?? 0;
          if (cart[id].qty >= capacity) {
            alert(`Sorry, er zijn nog maar ${capacity} plaatsen beschikbaar voor dit tijdslot.`);
            return;
          }
        }

        cart[id].qty += 1;
        if (cart[id].qty > 10) cart[id].qty = 10;
        qtyVal.textContent = String(cart[id].qty);
        updateShop();
      });
    }
    if (minusBtn && qtyVal) {
      minusBtn.addEventListener("click", () => {
        if (cart[id] && cart[id].qty > 0) {
          cart[id].qty -= 1;
          qtyVal.textContent = String(cart[id].qty);
          updateShop();
        }
      });
    }
  });

  // Cleanup old addon checks

  // Mock Checkout Flow JS
  const modalOverlay = document.getElementById("checkout-modal");
  const modalCloseX = document.getElementById("modal-close-x");
  const modalSuccessClose = document.getElementById("modal-success-close");
  const mockPaymentForm = document.getElementById("mock-payment-form");
  const modalStep1 = document.getElementById("modal-step-1");
  const modalStep2 = document.getElementById("modal-step-2");
  const modalStep3 = document.getElementById("modal-step-3");
  const modalTotalAmt = document.getElementById("modal-total-amt");
  const receiptSentEmail = document.getElementById("receipt-sent-email");
  const receiptTicketsList = document.getElementById("receipt-tickets-list");

  let promoDiscount = 0;
  let activePromoCode = "";

  function recalcModalTotal() {
    let subtotal = 0;
    let totalItems = 0;
    let entryTicketsCount = 0;
    let shippingActive = false;

    Object.keys(cart).forEach(id => {
      const item = cart[id];
      if (item.qty > 0) {
        subtotal += item.price * item.qty;
        totalItems += item.qty;
        if (item.category === "entree") {
          entryTicketsCount += item.qty;
        }
        if (item.category === "botteling" && item.delivery === "shipping") {
          shippingActive = true;
        }
      }
    });

    const activeShipping = shippingActive ? 12.50 : 0;
    const activeFee = totalItems > 0 ? serviceFee : 0;
    
    const totalBeforeDiscount = subtotal + activeFee + activeShipping;
    const finalTotal = Math.max(0, totalBeforeDiscount - promoDiscount);

    if (modalTotalAmt) {
      modalTotalAmt.innerHTML = `&euro;${finalTotal.toFixed(2)}`;
    }

    // Populate dynamic summary items breakdown in popup
    const modalSummaryItems = document.getElementById("modal-summary-items");
    if (modalSummaryItems) {
      modalSummaryItems.innerHTML = "";
      Object.keys(cart).forEach(id => {
        const item = cart[id];
        if (item.qty > 0) {
          let displayTitle = item.title;
          if (item.category === "tram" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "masterclass" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "trail" && item.timeslot) {
            const guideSuffix = item.guide ? ` - Gids: ${item.guide}` : '';
            displayTitle = `${item.title} (${item.timeslot}${guideSuffix})`;
          } else if (item.category === "vatenmaken" && item.timeslot) {
            displayTitle = `${item.title} (${item.timeslot})`;
          } else if (item.category === "botteling" && item.delivery) {
            const methodText = item.delivery === "shipping" ? "Verzenden" : "Ophalen";
            displayTitle = `${item.title} [${methodText}]`;
          }

          const row = document.createElement("div");
          row.className = "modal-summary-item-row";
          row.innerHTML = `
            <span>${item.qty}x ${displayTitle}</span>
            <span>&euro;${(item.price * item.qty).toFixed(2)}</span>
          `;
          modalSummaryItems.appendChild(row);
        }
      });
    }

    const modalSummarySub = document.getElementById("modal-summary-subtotal");
    if (modalSummarySub) modalSummarySub.innerHTML = `&euro;${subtotal.toFixed(2)}`;

    const modalSummaryFee = document.getElementById("modal-summary-fee");
    if (modalSummaryFee) modalSummaryFee.innerHTML = `&euro;${activeFee.toFixed(2)}`;

    const modalSummaryShipping = document.getElementById("modal-summary-shipping");
    const modalSummaryShippingRow = document.getElementById("modal-summary-shipping-row");
    if (modalSummaryShippingRow && modalSummaryShipping) {
      if (shippingActive) {
        modalSummaryShippingRow.style.display = "flex";
        modalSummaryShipping.innerHTML = `&euro;12.50`;
      } else {
        modalSummaryShippingRow.style.display = "none";
      }
    }

    const modalSummaryDiscount = document.getElementById("modal-summary-discount");
    const modalSummaryDiscountRow = document.getElementById("modal-summary-discount-row");
    if (modalSummaryDiscountRow && modalSummaryDiscount) {
      if (promoDiscount > 0) {
        modalSummaryDiscountRow.style.display = "flex";
        modalSummaryDiscount.innerHTML = `- &euro;${promoDiscount.toFixed(2)}`;
      } else {
        modalSummaryDiscountRow.style.display = "none";
      }
    }

    return finalTotal;
  }

  const promoInput = document.getElementById("checkout-promo-code") as HTMLInputElement;
  const promoMsg = document.getElementById("promo-status-msg");
  const applyPromoBtn = document.getElementById("apply-promo-btn");

  if (applyPromoBtn && promoInput && promoMsg) {
    applyPromoBtn.addEventListener("click", () => {
      const code = promoInput.value.trim().toUpperCase();
      if (!code) {
        promoDiscount = 0;
        activePromoCode = "";
        promoMsg.style.display = "none";
        recalcModalTotal();
        return;
      }

      if (code.startsWith("WS-") || code === "IWS") {
        promoDiscount = 55.00;
        activePromoCode = code;
        promoMsg.style.display = "block";
        promoMsg.style.color = "var(--success-green)";
        promoMsg.textContent = "✓ Lidmaatschap gevalideerd: €55,00 korting toegepast.";
      } else if (code === "GIFT-50" || code === "CADEAU-50") {
        promoDiscount = 50.00;
        activePromoCode = code;
        promoMsg.style.display = "block";
        promoMsg.style.color = "var(--success-green)";
        promoMsg.textContent = "✓ Cadeaubon toegepast: €50,00 korting verwerkt.";
      } else {
        promoDiscount = 0;
        activePromoCode = "";
        promoMsg.style.display = "block";
        promoMsg.style.color = "#d9534f";
        promoMsg.textContent = "✗ Ongeldige code. Probeer het opnieuw.";
      }
      recalcModalTotal();
    });
  }

  if (checkoutBtn) {
    checkoutBtn.addEventListener("click", () => {
      // Reset promo state upon opening checkout
      promoDiscount = 0;
      activePromoCode = "";
      if (promoInput) promoInput.value = "";
      if (promoMsg) promoMsg.style.display = "none";
      
      recalcModalTotal();
      if (modalStep1) modalStep1.style.display = "block";
      if (modalStep2) modalStep2.style.display = "none";
      if (modalStep3) modalStep3.style.display = "none";
      if (modalOverlay) modalOverlay.style.display = "flex";
    });
  }

  if (modalCloseX) {
    modalCloseX.addEventListener("click", () => {
      if (modalOverlay) modalOverlay.style.display = "none";
    });
  }

  if (modalSuccessClose) {
    modalSuccessClose.addEventListener("click", () => {
      if (modalOverlay) modalOverlay.style.display = "none";
      if (modalStep3) modalStep3.style.display = "none";
      if (modalStep1) modalStep1.style.display = "block";
      Object.keys(cart).forEach(id => {
        cart[id].qty = 0;
        const qEl = document.getElementById(`qty-${id}`);
        if (qEl) qEl.textContent = "0";
      });
      updateShop();
    });
  }

  // Close modal when clicking backdrop
  if (modalOverlay) {
    modalOverlay.addEventListener("click", (e) => {
      if (e.target === modalOverlay) {
        modalOverlay.style.display = "none";
      }
    });
  }

  const payCards = document.querySelectorAll(".pay-method-card");
  const bankGroup = document.getElementById("bank-group");
  payCards.forEach(card => {
    const radio = card.querySelector('input[type="radio"]') as HTMLInputElement;
    card.addEventListener("click", () => {
      payCards.forEach(c => c.classList.remove("active"));
      card.classList.add("active");
      if (radio) {
        radio.checked = true;
        if (bankGroup) {
          bankGroup.style.display = radio.value === "ideal" ? "flex" : "none";
        }
      }
    });
  });

  if (mockPaymentForm) {
    mockPaymentForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const emailInput = document.getElementById("cust-email") as HTMLInputElement;
      const email = emailInput ? emailInput.value : "info@whiskyfestival.nl";
      const nameInput = document.getElementById("cust-name") as HTMLInputElement;
      const name = nameInput ? nameInput.value : "Bezoeker";
      const phoneInput = document.getElementById("cust-phone") as HTMLInputElement;
      const phone = phoneInput ? phoneInput.value : "+31 6 12345678";
      
      if (modalStep1) modalStep1.style.display = "none";
      if (modalStep2) modalStep2.style.display = "block";
      
      setTimeout(() => {
        try {
          if (modalStep2) modalStep2.style.display = "none";
          
          let orderList: string[] = [];
          let itemsOrdered: any[] = [];
          let primaryTicket: any = null;
          let resPrefix = "WF";

          if (activePromoCode.startsWith("WS-") || activePromoCode === "IWS") {
            resPrefix = "WS";
          }
          
          Object.keys(cart).forEach(id => {
            const item = cart[id];
            if (item.qty > 0) {
              let itemDisplayTitle = item.title;
              if (item.category === "tram" && item.timeslot) {
                itemDisplayTitle = `${item.title} (${item.timeslot.split(' - ')[1] || item.timeslot})`;
              } else if (item.category === "botteling" && item.delivery) {
                const method = item.delivery === "shipping" ? "Verzenden" : "Ophalen";
                itemDisplayTitle = `${item.title} [${method}]`;
              }
              
              orderList.push(`${itemDisplayTitle} (${item.qty}x)`);
              itemsOrdered.push({
                id: id,
                title: item.title,
                qty: item.qty,
                price: item.price,
                category: item.category,
                timeslot: item.timeslot || "",
                delivery: item.delivery || ""
              });

              if (!primaryTicket && item.category === "entree") {
                primaryTicket = item;
              }
            }
          });
          
          const finalResNumber = `#${resPrefix}-2026-${Math.floor(10000 + Math.random() * 90000)}`;

          // Save order to localStorage for dynamic account environment
          const orderData = {
            name: name,
            email: email,
            phone: phone,
            items: itemsOrdered,
            isMember: resPrefix === "WS",
            resNumber: finalResNumber,
            discountApplied: promoDiscount,
            totalPrice: recalcModalTotal()
          };
          localStorage.setItem('wf_last_order', JSON.stringify(orderData));

          const successResNumEl = document.querySelector("#modal-step-3 .ticket-summary-box strong");
          if (successResNumEl) successResNumEl.textContent = finalResNumber;
          
          if (receiptSentEmail) receiptSentEmail.textContent = email;
          if (receiptTicketsList) {
            receiptTicketsList.innerHTML = "";
            orderList.forEach(txt => {
              const div = document.createElement("div");
              div.className = "receipt-ticket-li";
              div.innerHTML = `<span>${txt}</span>`;
              receiptTicketsList.appendChild(div);
            });
          }
        } catch (err) {
          console.error("Order processing error:", err);
        } finally {
          if (modalStep1) modalStep1.style.display = "none";
          if (modalStep2) modalStep2.style.display = "none";
          if (modalStep3) modalStep3.style.display = "block";
        }
      }, 2500);
    });
  }

  // ====== INTERACTIVE TIMETABLE LOGIC ======
  const ttTabs = document.querySelectorAll('.timetable-tab-btn');
  const ttPanes = document.querySelectorAll('.timetable-pane');
  const ttTimeBtns = document.querySelectorAll('.tt-time-btn');
  let activeTtTime = 'all';

  function filterTimetableCards() {
    const activePane = document.querySelector('.timetable-pane.active');
    if (!activePane) return;
    const cards = activePane.querySelectorAll('.tt-card');

    cards.forEach(card => {
      const cardTimepart = card.getAttribute('data-timepart') || 'all';
      if (activeTtTime === 'all' || cardTimepart === activeTtTime) {
        (card as HTMLElement).style.display = 'flex';
      } else {
        (card as HTMLElement).style.display = 'none';
      }
    });
  }

  ttTabs.forEach(tab => {
    tab.addEventListener('click', () => {
      ttTabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      const targetPane = tab.getAttribute('data-tt-tab');
      ttPanes.forEach(pane => {
        if (pane.id === `tt-pane-${targetPane}`) {
          pane.classList.add('active');
        } else {
          pane.classList.remove('active');
        }
      });
      filterTimetableCards();
    });
  });

  ttTimeBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      ttTimeBtns.forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      activeTtTime = btn.getAttribute('data-tt-time') || 'all';
      filterTimetableCards();
    });
  });

  const ttBookBtns = document.querySelectorAll('.tt-book-btn');
  ttBookBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetStubId = btn.getAttribute('data-target-stub') || "";
      const targetSelectVal = btn.getAttribute('data-target-select') || "";
      
      // If it's an addon checkbox
      if (targetStubId.startsWith('addon-')) {
        const checkbox = document.getElementById(targetStubId) as HTMLInputElement;
        if (checkbox) {
          // If disabled, warn the user
          if (checkbox.disabled) {
            alert("U moet eerst een entreeticket in uw winkelwagen leggen om deze add-on te boeken!");
            document.getElementById('ticket-gap')?.scrollIntoView({ behavior: 'smooth' });
            return;
          }
          checkbox.checked = true;
          // Trigger change event to run updateShop()
          checkbox.dispatchEvent(new Event('change'));
          // Set dropdown value for vaten workshop if needed
          if (targetStubId === "addon-vaten" && targetSelectVal && vatenTimeSelect) {
            vatenTimeSelect.value = targetSelectVal;
            vatenTimeSelect.dispatchEvent(new Event('change'));
          }
          // Alert and scroll to cart
          alert(`Toegevoegd aan winkelwagen: ${checkbox.getAttribute('data-title')}!`);
          document.getElementById('ticket-gap')?.scrollIntoView({ behavior: 'smooth' });
        }
      } else {
        // It's a ticket stub card in the shop
        const ticketStub = document.querySelector(`.ticket-stub[data-ticket-id="${targetStubId}"]`);
        if (ticketStub) {
          // If there's a select field and target select val
          if (targetSelectVal) {
            const select = ticketStub.querySelector('select') as HTMLSelectElement;
            if (select) {
              select.value = targetSelectVal;
              // Trigger change event on select to ensure timeslot is updated in cart
              select.dispatchEvent(new Event('change'));
            }
          }
          // Find plus button and click it
          const plusBtn = ticketStub.querySelector('[data-action="plus"]') as HTMLButtonElement;
          if (plusBtn) {
            plusBtn.click();
            alert(`Toegevoegd aan winkelwagen: ${ticketStub.getAttribute('data-title')}!`);
            document.getElementById('ticket-gap')?.scrollIntoView({ behavior: 'smooth' });
          }
        }
      }
    });
  });

  // ====== SCROLL FADE-IN FOR TICKETS ======
  const fadeGroups = document.querySelectorAll('.fade-in-group');
  if (fadeGroups.length > 0) {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { threshold: 0.01, rootMargin: '100px 0px 100px 0px' });
    
    fadeGroups.forEach(g => {
      const rect = g.getBoundingClientRect();
      if (rect.top < window.innerHeight + 200 && rect.bottom > -200) {
        g.classList.add('is-visible');
      }
      observer.observe(g);
    });
  }

  // ====== VINTAGE HORIZONTAL TIMELINE LOGIC ======
  const timelineSection = document.querySelector('.timeline-scroll-section') as HTMLElement;
  const timelineTrack = document.getElementById('timeline-track') as HTMLElement;
  const timelineCards = document.querySelectorAll('.timeline-card');
  const axisProgress = document.getElementById('axis-progress') as HTMLElement;
  const axisTicks = document.querySelectorAll('.axis-tick');
  const eraItems = document.querySelectorAll('.era-item');

  let activeIndex = 0;
  let isDesktop = window.innerWidth > 1024;

  // Track resizing to update layout mode
  window.addEventListener('resize', () => {
    isDesktop = window.innerWidth > 1024;
    if (!isDesktop && timelineTrack) {
      timelineTrack.style.transform = 'none';
    }
  });

  // Calculate card bounds and positions for scroll translation
  function getTimelineScrollData() {
    if (!timelineTrack) return { maxTranslate: 0, trackWidth: 0, viewportWidth: 0 };
    const trackWidth = timelineTrack.scrollWidth;
    const viewportWidth = timelineTrack.parentElement?.clientWidth || window.innerWidth;
    const maxTranslate = Math.max(0, trackWidth - viewportWidth);
    return { maxTranslate, trackWidth, viewportWidth };
  }

  // Set initial scroll bar width and listen to scroll
  function updateTimelineScroll() {
    if (!timelineSection || !timelineTrack || !isDesktop) return;

    const rect = timelineSection.getBoundingClientRect();
    const sectionHeight = timelineSection.scrollHeight;
    const viewHeight = window.innerHeight;
    
    // Calculate progress fraction [0, 1] through the timeline section
    const scrollDistance = sectionHeight - viewHeight;
    const scrolledAmount = -rect.top;
    let fraction = scrolledAmount / scrollDistance;
    fraction = Math.max(0, Math.min(1, fraction));

    const { maxTranslate } = getTimelineScrollData();
    
    // Apply horizontal translation to track
    const currentTranslate = fraction * maxTranslate;
    timelineTrack.style.transform = `translateX(-${currentTranslate}px)`;

    // Update bottom progress bar width
    if (axisProgress) {
      axisProgress.style.width = `${fraction * 100}%`;
    }

    // Determine which card is currently active (closest to the viewport center or index-based)
    const cardCount = timelineCards.length;
    const currentActive = Math.min(
      cardCount - 1,
      Math.floor(fraction * cardCount)
    );

    updateActiveStates(currentActive);
  }

  function updateActiveStates(index: number) {
    if (index === activeIndex) return;
    activeIndex = index;

    // Update cards active state
    timelineCards.forEach((card, idx) => {
      if (idx === index) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }
    });

    // Update axis ticks active state
    axisTicks.forEach((tick, idx) => {
      if (idx === index) {
        tick.classList.add('active');
      } else {
        tick.classList.remove('active');
      }
    });

    // Update left era list active state
    eraItems.forEach((era) => {
      const targetIdx = parseInt(era.getAttribute('data-target') || '0', 10);
      // Map index range to nearest era list item
      let activeEra = 0;
      if (index >= 5) activeEra = 5;
      else if (index >= 3) activeEra = 3;
      else if (index >= 1) activeEra = 1;
      else activeEra = 0;

      if (targetIdx === activeEra) {
        era.classList.add('active');
      } else {
        era.classList.remove('active');
      }
    });
  }

  // Desktop scroll listener
  window.addEventListener('scroll', updateTimelineScroll);
  window.addEventListener('load', updateTimelineScroll);

  // Click handler for axis ticks (Desktop & Mobile)
  axisTicks.forEach(tick => {
    tick.addEventListener('click', (e) => {
      const targetIndex = parseInt(tick.getAttribute('data-index') || '0', 10);
      
      if (isDesktop) {
        // Smoothly scroll the window to the corresponding position in the timeline section
        const sectionTop = timelineSection.offsetTop;
        const sectionHeight = timelineSection.scrollHeight;
        const viewHeight = window.innerHeight;
        const scrollDistance = sectionHeight - viewHeight;
        
        // Calculate scroll destination representing the target index fraction
        const cardCount = timelineCards.length;
        const targetFraction = targetIndex / (cardCount - 1);
        const scrollTarget = sectionTop + (targetFraction * scrollDistance);

        window.scrollTo({
          top: scrollTarget,
          behavior: 'smooth'
        });
      } else {
        // Mobile snap scroll
        const viewport = timelineTrack.parentElement;
        const card = timelineCards[targetIndex] as HTMLElement;
        if (viewport && card) {
          viewport.scrollTo({
            left: card.offsetLeft - (viewport.clientWidth - card.clientWidth) / 2,
            behavior: 'smooth'
          });
          updateActiveStates(targetIndex);
          if (axisProgress) {
            axisProgress.style.width = `${(targetIndex / (timelineCards.length - 1)) * 100}%`;
          }
        }
      }
    });
  });

  // Era list item clicks
  eraItems.forEach(era => {
    era.addEventListener('click', () => {
      const targetIndex = parseInt(era.getAttribute('data-target') || '0', 10);
      const tickBtn = document.querySelector(`.axis-tick[data-index="${targetIndex}"]`) as HTMLButtonElement;
      if (tickBtn) tickBtn.click();
    });
  });

  // Mobile Swipe event observer to sync bottom axis progress
  const viewport = timelineTrack?.parentElement;
  if (viewport) {
    viewport.addEventListener('scroll', () => {
      if (isDesktop) return; // Only process on mobile touch scroll
      
      const scrollLeft = viewport.scrollLeft;
      const scrollWidth = viewport.scrollWidth - viewport.clientWidth;
      const fraction = scrollWidth > 0 ? scrollLeft / scrollWidth : 0;
      
      if (axisProgress) {
        axisProgress.style.width = `${fraction * 100}%`;
      }
      
      // Map scroll progress to active card
      const cardCount = timelineCards.length;
      const index = Math.max(0, Math.min(cardCount - 1, Math.round(fraction * (cardCount - 1))));
      
      updateActiveStates(index);
    });
  }

  // Aftermovie 2025 Performance Video Player Logic
  const aftermovieVideo = document.getElementById('aftermovie-video') as HTMLVideoElement;
  const videoOverlay = document.getElementById('video-overlay') as HTMLElement;

  if (aftermovieVideo && videoOverlay) {
    videoOverlay.addEventListener('click', () => {
      videoOverlay.style.opacity = '0';
      videoOverlay.style.pointerEvents = 'none';
      aftermovieVideo.setAttribute('controls', 'true');
      aftermovieVideo.play();
    });

    aftermovieVideo.addEventListener('pause', () => {
      if (aftermovieVideo.currentTime === 0 || aftermovieVideo.ended) {
        aftermovieVideo.removeAttribute('controls');
        videoOverlay.style.opacity = '1';
        videoOverlay.style.pointerEvents = 'auto';
      }
    });

    aftermovieVideo.addEventListener('ended', () => {
      aftermovieVideo.removeAttribute('controls');
      videoOverlay.style.opacity = '1';
      videoOverlay.style.pointerEvents = 'auto';
    });
  }

  // ====== HORIZONTAL PHOTO CAROUSEL NAVIGATION ======
  const carouselWrapper = document.querySelector('.horizontal-carousel-wrapper');
  const carouselPrevBtn = document.getElementById('carousel-prev-btn');
  const carouselNextBtn = document.getElementById('carousel-next-btn');

  if (carouselWrapper && carouselPrevBtn && carouselNextBtn) {
    carouselPrevBtn.addEventListener('click', () => {
      carouselWrapper.scrollBy({ left: -380, behavior: 'smooth' });
    });

    carouselNextBtn.addEventListener('click', () => {
      carouselWrapper.scrollBy({ left: 380, behavior: 'smooth' });
    });
  }

  // ====== HERO VIDEO TIMESTAMP LOOP (00:09 - 00:45) ======
  const heroVideo = document.getElementById('hero-bg-video') as HTMLVideoElement;
  if (heroVideo) {
    const START_TIME = 9;
    const END_TIME = 45;

    // Set initial timestamp to 9 seconds
    heroVideo.currentTime = START_TIME;

    heroVideo.addEventListener('timeupdate', () => {
      if (heroVideo.currentTime >= END_TIME || heroVideo.currentTime < START_TIME - 0.5) {
        heroVideo.currentTime = START_TIME;
      }
    });

    heroVideo.play().catch(() => {
      // Autoplay fallback
    });
  }
  // ====== HOMEPAGE 2.5-SECOND COIN-FLIP PRELOADER SCRIPT ======
  const preloader = document.getElementById('hp-preloader');
  if (preloader) {
    document.body.style.overflow = 'hidden';

    setTimeout(() => {
      preloader.classList.add('fade-out');
      document.body.style.overflow = '';
    }, 2200);

    setTimeout(() => {
      preloader.style.display = 'none';
    }, 2500);
  }
</script>
