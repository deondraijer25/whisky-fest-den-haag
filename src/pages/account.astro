      const existingOrder = (existingSession?.resNumber || '').replace(/^#+/, '').trim().toLowerCase();
      if (!existingSession || existingOrder !== cleanParamOrder) {
        loginForm.dispatchEvent(new Event('submit', { cancelable: true }));
      }
    }

