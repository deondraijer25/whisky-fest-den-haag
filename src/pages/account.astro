<script>
  // ====== MY ACCOUNT TABS & DYNAMIC DATA LOADING ======
  document.addEventListener('DOMContentLoaded', () => {
    // toggle-share-menu-handler: Click to toggle share popup
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('.btn-share-trigger');
      const allMenus = document.querySelectorAll('.ticket-share-menu');
      
      if (trigger) {
        e.stopPropagation();
        const wrapper = trigger.closest('.ticket-share-wrapper');
        const menu = wrapper ? wrapper.querySelector('.ticket-share-menu') : null;
        
        allMenus.forEach(m => {
          if (m !== menu) m.classList.remove('active');
        });
        
        if (menu) {
          menu.classList.toggle('active');
        }
      } else if (!e.target.closest('.ticket-share-menu')) {
        allMenus.forEach(m => m.classList.remove('active'));
      }
    });
