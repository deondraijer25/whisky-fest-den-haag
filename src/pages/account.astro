  /* --- Receipt Table styling --- */
  .receipt-table-wrapper {
    overflow-x: auto;
    width: 100%;
  }

  .receipt-table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    text-align: left;
  }

  .receipt-table th {
    border-bottom: 2px solid var(--text-charcoal);
    padding: 0.85rem 0.65rem;
    font-weight: 800;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .receipt-table td {
    padding: 1.1rem 0.65rem;
    border-bottom: 1px dotted var(--border-color-dark);
  }

  .status-badge {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
    display: inline-block;
  }

  .status-badge.paid {
    background-color: rgba(0, 100, 72, 0.08);
    color: var(--whisky-gold-dark);
    border: 1px solid rgba(0, 100, 72, 0.25);
  }

  /* --- Event booklet layout --- */
  .program-guide-booklet {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .booklet-chapter-title {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--whisky-gold-dark);
    margin: 0;
  }

  .booklet-list {
    margin: 0.65rem 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .booklet-list li {
    font-family: var(--font-serif);
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-charcoal);
    position: relative;
    padding-left: 1.25rem;
  }

  .booklet-list li::before {
    content: "◆";
    position: absolute;
    left: 0;
    top: 0;
    font-size: 0.65rem;
    color: var(--whisky-gold-dark);
  }

  .rules-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .rule-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .rule-item h5 {
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    margin: 0;
  }

  /* --- Keyframes --- */
  @keyframes fade-in-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* --- Responsive Styles --- */
  @media (max-width: 1024px) {
    .portal-container {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }

  @media (max-width: 768px) {
    .account-page-wrapper {
      padding-top: 8rem;
    }

    .ticket-stub-large {
      grid-template-columns: 1fr;
    }
    
    .ticket-right-stub {
      border-right: none;
      border-bottom: 2px dashed var(--border-color-dark);
      padding: 1.5rem;
    }

    .ticket-left-stub {
      padding: 1.5rem;
    }

    .portal-title {
      font-size: 2.25rem;
    }
  }

  /* Print styling for 1-page A4 PDF output */
  @media print {
    body {
      background: white !important;
      color: black !important;
    }
    header, footer, .portal-tabs-container, .portal-header, .demo-banner, .portal-sidebar-grid, .btn-sidebar-action, .btn-ticket-download {
      display: none !important;
    }
    .account-page-wrapper {
      padding: 0 !important;
      margin: 0 !important;
    }
    .portal-tab-pane {
      display: block !important;
      padding: 0 !important;
    }
    .portal-container {
      display: block !important;
      max-width: 100% !important;
      padding: 0 !important;
    }
    .ticket-envelope {
      border: none !important;
      box-shadow: none !important;
      margin: 0 0 2cm 0 !important;
      page-break-after: always;
    }
    .ticket-stub-large {
      border: 1.5px solid #1D1C1A !important;
      box-shadow: none !important;
      background: white !important;
      color: black !important;
      page-break-inside: avoid;
    }
    .ticket-left-stub, .ticket-right-stub {
      background: white !important;
      color: black !important;
    }
    .ticket-watermark {
      color: rgba(29, 28, 26, 0.04) !important;
    }
  }

  /* TICKET ACTION BUTTONS & ROWS */
  .ticket-action-buttons-row {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 0.85rem !important;
    margin-top: 1.35rem !important;
    flex-wrap: wrap !important;
  }

  .btn-ticket-action {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif !important;
    font-size: 0.82rem !important;
    font-weight: 800 !important;
    letter-spacing: 0.04em !important;
    text-transform: uppercase !important;
    padding: 0.65rem 1.25rem !important;
    border-radius: 4px !important;
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 0.55rem !important;
    cursor: pointer !important;
    text-decoration: none !important;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-shadow: 3px 3px 0px var(--text-charcoal) !important;
