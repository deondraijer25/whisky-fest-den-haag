    const catEl = document.getElementById('account-stand-category');
    const descEl = document.getElementById('account-stand-desc');
    const brandsEl = document.getElementById('account-stand-brands-list');

    accountStands.forEach(standNode => {
      standNode.addEventListener('click', () => {
        const sId = standNode.getAttribute('data-stand');
        const match = exhibitorsData.find(e => e.id === sId);

        accountStands.forEach(s => s.classList.remove('selected-stand'));
        standNode.classList.add('selected-stand');

        if (match && defaultState && activeState) {
          defaultState.style.display = 'none';
          activeState.style.display = 'block';

          if (badgeEl) badgeEl.textContent = `STAND ${match.id}`;
          if (titleEl) titleEl.textContent = match.name;
          if (catEl) catEl.textContent = match.category.toUpperCase();
          if (descEl) descEl.textContent = match.description || "";

          if (brandsEl && match.brands) {
            brandsEl.innerHTML = match.brands.map(b => `<span class="addon-badge">${b}</span>`).join(' ');
          }
