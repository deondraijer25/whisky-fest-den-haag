---
// src/pages/account.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Mijn Account Portaal" description="Beheer uw tickets, bestellingen en gegevens voor International Whisky Festival.">
  <!-- 1. Global Navigation Header -->
  <Header />

  <main class="account-page-wrapper">
    <!-- Login / Access View (shown when logged out) -->
    <div id="portal-login-area" class="login-view-wrapper animate-fade-in" style="display: none;">
      <div class="login-card-box">
        <div class="login-card-header">
          <span class="portal-tag">BEZOEKERS PORTAAL</span>
          <h2 class="login-card-title">Inloggen Portaal</h2>
          <p class="login-card-subtitle">Vul uw e-mailadres en ordernummer in om direct toegang te krijgen tot uw e-tickets en bestelgegevens.</p>
        </div>

        <div id="auth-error-box" class="auth-error-alert" style="display: none;">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
          <span id="auth-error-text">Ongeldige inloggegevens. Controleer uw e-mailadres en ordernummer.</span>
        </div>

        <form id="portal-login-form" class="login-form-body">
          <div class="form-group">
            <label class="form-label" for="login-email">E-mailadres</label>
            <input 
              type="email" 
              id="login-email" 
              class="form-input" 
              placeholder="bijv. deondraijer@gmail.com" 
              required 
            />
            <span class="form-subtext">Het e-mailadres waarmee de tickets zijn besteld.</span>
          </div>

          <div class="form-group">
            <label class="form-label" for="login-res-no">Ordernummer of Reservering (Optioneel)</label>
            <input 
              type="text" 
              id="login-res-no" 
              class="form-input" 
              placeholder="bijv. #WF-2026-84387" 
            />
            <span class="form-subtext">U vindt uw ordernummer in de bevestigingsmail.</span>
          </div>

          <button type="submit" class="btn btn-gold btn-login-submit">
            Toegang tot Mijn Portaal &rarr;
          </button>
        </form>

        <div class="login-card-footer">
          <p class="login-footer-help">
            Nog geen tickets? <a href="/#sessies" class="tt-text-link" style="color: var(--whisky-gold-dark); font-weight: 800;">Bestel uw tickets hier</a>
          </p>
          <button type="button" id="btn-quick-demo-login" class="btn-demo-quick">
            Direct bekijken als voorbeeldaccount (Deon Draijer)
          </button>
        </div>
      </div>
    </div>

    <!-- Authenticated Portal Area -->
    <div id="portal-authenticated-area">
      <!-- Top Welcome Header -->
      <div class="portal-header animate-fade-in">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; max-width: 1300px; margin: 0 auto; flex-wrap: wrap; gap: 1rem;">
          <div>
            <span class="portal-tag">Bezoekers Portaal</span>
            <h1 class="portal-title" id="portal-title-name">Portaal van Deon Draijer</h1>
            <p class="portal-subtitle" id="portal-welcome-email">Welkom in uw bezoeker omgeving · deondraijer@gmail.com</p>
          </div>
          <button type="button" id="portal-page-logout-btn" class="btn-clean-logout" style="margin-top: 0.5rem;" title="Uitloggen uit dit account">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
            <span>Uitloggen</span>
          </button>
        </div>
        <div class="vintage-line"></div>
      </div>

    <!-- Demonstration Banner (shown if demo account is active) -->
    <div class="demo-banner animate-fade-in portal-authenticated-block" id="demo-banner" style="display: none;">
      <div class="demo-banner-inner">
        <div class="demo-text">
          <strong>Demonstratie Account Actief</strong>
          <span>U bekijkt een voorbeeld account. Bestel uw tickets op de homepage om uw eigen bestelling hier live te bekijken.</span>
        </div>
      </div>
    </div>

    <!-- Vintage Portal Tab Menu (Restored Original Design Structure) -->
    <div class="portal-tabs-container animate-fade-in portal-authenticated-block">
      <div class="portal-tabs-inner">
        <button class="portal-tab-trigger active" data-tab="tab-tickets">
          Mijn Tickets
        </button>
        <button class="portal-tab-trigger" data-tab="tab-profile">
          Persoonsgegevens
        </button>
        <button class="portal-tab-trigger" data-tab="tab-info">
          Event Informatie
        </button>
      </div>
    </div>

    <!-- TAB 1: TICKETS PANEL -->
    <div class="portal-tab-pane active" id="tab-tickets">
      <div class="portal-container">
        <!-- Dynamic Tickets List (Rendered via JS) -->
        <div id="tickets-container" class="tickets-main-column">
          <!-- Balanced 3-Layer Ticket Card (SSR) -->
          <div class="ticket-envelope">
            <div class="ticket-stub-large">
              <!-- Scanner Stub -->
              <div class="ticket-right-stub">
                <span class="scan-label">CONTROLE STUB</span>
                
                <div class="qr-code-holder">
                  <svg width="105" height="105" viewBox="0 0 100 100" style="shape-rendering: crispedges; display:block;">
                    <path d="M0,0 h30 v10 h-20 v20 h-10 z" fill="#1D1C1A"/>
                    <path d="M10,10 h10 v10 h-10 z" fill="#1D1C1A"/>
                    <path d="M70,0 h30 v30 h-10 v-20 h-20 z" fill="#1D1C1A"/>
                    <path d="M80,10 h10 v10 h-10 z" fill="#1D1C1A"/>
                    <path d="M0,70 h10 v20 h20 v10 h-30 z" fill="#1D1C1A"/>
                    <path d="M10,80 h10 v10 h-10 z" fill="#1D1C1A"/>
                    <path d="M45,45 h10 v10 h-10 z" fill="var(--whisky-gold-dark)"/>
                    <path d="M30,30 h10 v5 h-10 z M35,40 h15 v5 h-15 z M55,30 h10 v10 h-5 v-5 h-5 z" fill="#1D1C1A"/>
                    <path d="M70,70 h30 v10 h-10 v10 h-20 z M80,80 h10 v10 h-10 z" fill="#1D1C1A"/>
                    <path d="M40,65 h10 v10 h-10 z M55,60 h10 v5 h-10 z M60,75 h5 v15 h-5 z" fill="#1D1C1A"/>
                    <path d="M65,45 h10 v5 h-10 z M30,55 h5 v15 h-5 z M45,85 h10 v5 h-10 z" fill="#1D1C1A"/>
                  </svg>
                </div>

                <span class="scan-instructions">SCAN BIJ DE DEUR</span>
                <span class="scan-res-hash">#WF-2026-84387-1</span>
              </div>

              <!-- Clean Main Body -->
              <div class="ticket-left-stub">
                <div class="ticket-watermark">WF</div>
                
                <!-- 1. Header Row -->
                <div class="ticket-header-row">
                  <div class="ticket-title-block">
                    <h2 class="ticket-session-title">VIP Sessie - Vrijdag</h2>
                    <p class="ticket-schedule-text">Vrijdag 13 november 2026 &bull; 13:00 – 17:00 UUR</p>
                  </div>
                  <div class="ticket-badges-block">
                    <span class="ticket-status-tag">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      Geldig Toegangsbewijs
                    </span>
                  </div>
                </div>

                <!-- 2. Middle Row: 3-Column Meta Grid -->
                <div class="ticket-meta-trio">
                  <div class="meta-col">
                    <span class="meta-col-label">Kaarthouder</span>
                    <strong class="meta-col-val">Deon Draijer</strong>
                  </div>
                  <div class="meta-col">
                    <span class="meta-col-label">Locatie</span>
                    <strong class="meta-col-val">Grote Kerk, Den Haag</strong>
                  </div>
                  <div class="meta-col">
                    <span class="meta-col-label">Ticket Code</span>
                    <strong class="meta-col-val font-mono">#WF-2026-84387-1</strong>
                  </div>
                </div>

                <!-- 3. Bottom Row: Action Buttons -->
                <div class="ticket-actions-row">
                  <button type="button" class="btn-ticket-download-gold" onclick="window.open('/ticket?id=WF-2026-84387-1&title=VIP%20Sessie%20-%20Vrijdag&name=Deon%20Draijer&time=13:00%20-%2017:00%20UUR', '_blank')">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    <span>Download E-Ticket (PDF)</span>
                  </button>

                  <div class="ticket-share-wrapper">
                    <button type="button" class="btn-ticket-share-white btn-share-trigger">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                      <span>Deel Ticket</span>
                    </button>
                    <div class="ticket-share-menu">
                      <a href="https://api.whatsapp.com/send?text=*Whisky%20Fest%20Den%20Haag%202026*%0AE-ticket%3A%20VIP%20Sessie%20-%20Vrijdag%0A%0AKaarthouder%3A%20Deon%20Draijer%0ATijdslot%3A%2013%3A00%20-%2017%3A00%20UUR%0ATicket%20Code%3A%20%23WF-2026-84387-1%0ALocatie%3A%20Grote%20Kerk%2C%20Den%20Haag" target="_blank" rel="noopener noreferrer" class="share-option-link">
                        <span>Deel via WhatsApp</span>
                      </a>
                      <a href="mailto:?subject=E-ticket%20voor%20Whisky%20Fest%20Den%20Haag%3A%20VIP%20Sessie%20-%20Vrijdag" class="share-option-link">
                        <span>Deel via E-mail</span>
                      </a>
                      <button type="button" class="share-option-link" onclick="navigator.clipboard.writeText(window.location.origin + '/ticket?id=WF-2026-84387-1&title=VIP%20Sessie%20-%20Vrijdag&name=Deon%20Draijer&time=13:00%20-%2017:00%20UUR'); alert('✓ Directe ticket link gekopieerd!');">
                        <span>Kopieer Ticket Link</span>
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Sidebar Actions & Venue Info -->
        <div class="portal-sidebar-grid">
          <!-- Printable Action Card -->
          <div class="sidebar-card">
            <div class="card-padded">
              <h3 class="card-inner-title">Ticket Acties</h3>
              <div class="vintage-line" style="margin: 0;"></div>
              
              <div class="sidebar-actions-list">
                <button class="btn btn-gold btn-sidebar-action" onclick="window.print()">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="display:inline-block; vertical-align:middle; margin-right: 6px;">
                    <polyline points="6 9 6 2 18 2 18 9"/>
                    <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/>
                    <rect x="6" y="14" width="12" height="8"/>
                  </svg>
                  Print Alle E-Tickets (PDF)
                </button>
                <p class="action-note-text">
                  Tip: U kunt uw e-ticket ook digitaal op uw smartphone laten scannen bij de ingang van Grote Kerk, Den Haag.
                </p>
              </div>
            </div>
          </div>

          <!-- Venue & Interactive Map Link Card -->
          <div class="sidebar-card">
            <div class="card-padded">
              <h3 class="card-inner-title">Locatie & Info</h3>
              <div class="vintage-line" style="margin: 0;"></div>
              <p class="sidebar-card-text">
                <strong>Grote Kerk, Den Haag</strong><br/>
                Gedempt Hamerkanaal 231,<br/>
                1021 KP Amsterdam
              </p>

              <div class="sidebar-links-group">
                <a href="/standhouders" class="btn btn-outline btn-sidebar-action" style="text-align: center; text-decoration: none; border-color: var(--whisky-gold-dark); color: var(--whisky-gold-dark);">
                  Bekijk Standhouders & Plattegrond
                </a>
                <a href="https://maps.google.com/?q=De+Kromhouthal+Amsterdam" target="_blank" rel="noopener noreferrer" class="btn btn-gold btn-sidebar-action" style="text-align: center; text-decoration: none;">
                  Open Routeplanner
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 2: PROFILE & HISTORY PANEL -->
    <div class="portal-tab-pane" id="tab-profile" style="display: none;">
      <div class="portal-container" style="grid-template-columns: 1fr 1fr;">
        <!-- Details Card -->
        <div class="sidebar-card">
          <div class="card-padded">
            <h3 class="card-inner-title">Persoonlijke Gegevens</h3>
            <div class="vintage-line" style="margin: 0;"></div>
            
            <form id="profile-edit-form" class="vintage-form">
              <div class="form-group">
                <label class="form-label" for="profile-input-name">Volledige Naam (Kaarthouder)</label>
                <input type="text" id="profile-input-name" class="form-control" value="Deon Draijer" required />
              </div>
              
              <div class="form-group">
                <label class="form-label" for="profile-input-email">E-mailadres</label>
                <input type="email" id="profile-input-email" class="form-control" value="deondraijer@gmail.com" required />
              </div>

              <div class="form-group">
                <label class="form-label" for="profile-input-phone">Telefoonnummer</label>
                <input type="tel" id="profile-input-phone" class="form-control" value="+31 6 12345678" />
              </div>

              <div class="form-group">
                <label class="form-label" for="profile-input-whisky">Favoriete Whisky Stijl</label>
                <select id="profile-input-whisky" class="form-control" style="background-color: var(--bg-sand);">
                  <option value="Single Malt Scotch">Single Malt Scotch</option>
                  <option value="Bourbon & Rye">Bourbon & Rye</option>
                  <option value="Peated / Islay">Peated / Islay (Rokerig)</option>
                  <option value="Irish Whiskey">Irish Whiskey</option>
                  <option value="Nederlandse Craft Whisky">Nederlandse Craft Whisky</option>
                  <option value="Blended Scotch">Blended Scotch</option>
                </select>
              </div>

              <button type="submit" class="btn btn-gold btn-block btn-sidebar-action" style="margin-top: 1rem;">
                Wijzigingen Opslaan
              </button>
            </form>

            <div class="demo-banner" id="profile-success-banner" style="display: none; border-color: #006448; background-color: rgba(0, 100, 72, 0.08); margin-top: 1rem; padding: 0.75rem 1rem;">
              <span style="color: #006448; font-family: var(--font-sans); font-weight: 700; font-size: 0.9rem;">Gegevens succesvol opgeslagen! De naam op uw e-tickets is bijgewerkt.</span>
            </div>
          </div>
        </div>

        <!-- Order History Card -->
        <div class="sidebar-card">
          <div class="card-padded" style="justify-content: flex-start; gap: 1.5rem;">
            <h3 class="card-inner-title">Bestelgeschiedenis</h3>
            <div class="vintage-line" style="margin: 0;"></div>
            
            <div class="receipt-table-wrapper">
              <table class="receipt-table">
                <thead>
                  <tr>
                    <th>Reservering</th>
                    <th>Datum</th>
                    <th>Totaal</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td><strong id="receipt-res-no">#WF-2026-84387</strong></td>
                    <td>26 Mei 2026</td>
                    <td><strong id="receipt-total" style="color: var(--whisky-gold-dark);">€ 79,50</strong></td>
                    <td><span class="status-badge paid">Betaald</span></td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="receipt-billing-note" style="border-top: 1px dotted var(--border-color-dark); padding-top: 1.25rem;">
              <p class="sidebar-card-subtext">
                Heeft u vragen over uw factuur of wilt u uw bestelling annuleren? Neem direct contact op via <a href="mailto:tickets@amsterdamwhiskyfestival.nl" class="text-gold" style="font-weight: 700;">tickets@amsterdamwhiskyfestival.nl</a>.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB 3: EVENT GUIDE PANEL -->
    <div class="portal-tab-pane" id="tab-info" style="display: none;">
      <div class="event-info-wrapper">
        
        <!-- HERO CARD: OFFICIAL INTERACTIVE DE KROMHOUTHAL FLOOR PLAN (1-ON-1 MATCH WITH STANDHOUDERS) -->
        <div class="sidebar-card event-hero-card">
          <div class="card-padded">
            <div class="event-hero-header">
              <div>
                <h3 class="card-inner-title">Interactieve Plattegrond Grote Kerk, Den Haag</h3>
                <p class="sidebar-card-subtext" style="margin-top: 4px;">
                  Klik op een standnummer om direct de gegevens en merken van de standhouder te bekijken.
                </p>
              </div>
              <a href="/standhouders" class="btn btn-gold btn-sidebar-action" style="text-align: center; text-decoration: none; width: auto; padding: 0.75rem 1.25rem;">
                Bekijk Volledige Standhouderslijst →
              </a>
            </div>

            <div class="vintage-line" style="margin: 0.75rem 0 1.25rem;"></div>

            <!-- 1-to-1 Interactive Map Layout (Map + Detail Panel) -->
            <div class="portal-map-interactive-grid">
              
              <!-- SVG Church Map Container -->
              <div class="official-map-container">
                <svg viewBox="0 0 980 500" class="church-svg-map" id="account-church-map" style="width: 100%; height: auto; display: block;">
                  <!-- Church Outer Walls Silhouette -->
                  <path d="M 140 150 
                           L 140 80 Q 140 70 150 70 L 640 70 L 640 20 Q 640 10 650 10 L 760 10 Q 770 10 770 20 L 770 70 L 820 70 
                           L 860 90 L 900 130 L 920 180 L 930 250 L 920 320 L 900 370 L 860 410 L 820 430 L 770 430 L 770 480 Q 770 490 760 490 L 650 490 Q 640 490 640 480 L 640 430 L 250 430 L 250 480 Q 250 490 240 490 L 150 490 Q 140 490 140 480 L 140 430 L 140 350
                           L 90 350 L 50 310 L 30 250 L 50 190 L 90 150 Z" 
                        fill="var(--bg-sand)" stroke="var(--text-charcoal)" stroke-width="2.5" stroke-linejoin="round" class="church-outline" />

                  <!-- Interior Architecture Zones -->
                  <rect x="670" y="150" width="180" height="200" fill="#EBE4D5" stroke="var(--border-color-dark)" stroke-width="1.5" stroke-dasharray="4 4" />
                  <text x="760" y="255" class="map-zone-label" style="font-family: var(--font-sans); font-size: 11px; fill: var(--text-muted); text-anchor: middle;">Kade Zaal</text>
                  
                  <path d="M 670 80 A 170 170 0 0 1 890 250 A 170 170 0 0 1 670 420" fill="none" stroke="var(--border-color-dark)" stroke-width="1" stroke-dasharray="6 6" />

                  <!-- Pillars -->
                  <g class="pillars">
                    <circle cx="200" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="280" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="360" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="440" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="520" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="600" cy="140" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    
                    <circle cx="200" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="280" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="360" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="440" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="520" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="600" cy="360" r="10" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />

                    <circle cx="670" cy="150" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="720" cy="115" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="780" cy="100" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="840" cy="115" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="890" cy="150" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    
                    <circle cx="670" cy="350" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="720" cy="385" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="780" cy="400" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="840" cy="385" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                    <circle cx="890" cy="350" r="8" class="pillar" fill="var(--border-color-dark)" stroke="var(--text-charcoal)" />
                  </g>

                  <!-- 1-to-1 Interactive Stands -->
                  <g class="svg-stand" data-stand="U">
                    <rect x="50" y="210" width="60" height="80" rx="4" class="stand-box" />
                    <text x="80" y="255" class="stand-num">U</text>
                  </g>

                  <g class="svg-stand" data-stand="C">
                    <rect x="145" y="300" width="45" height="45" rx="4" class="stand-box catering" />
                    <text x="167" y="327" class="stand-num text-small">C</text>
                  </g>

                  <g class="svg-stand" data-stand="3">
                    <rect x="155" y="85" width="85" height="45" rx="3" class="stand-box" />
                    <text x="197" y="112" class="stand-num">3</text>
                  </g>
                  <g class="svg-stand" data-stand="4">
                    <rect x="250" y="85" width="130" height="35" rx="3" class="stand-box" />
                    <text x="315" y="107" class="stand-num">4</text>
                  </g>

