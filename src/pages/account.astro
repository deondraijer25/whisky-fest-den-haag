    position: relative;
  }

  .ticket-stub-large {
    display: grid;
    grid-template-columns: 185px 1fr;
    min-height: 240px;
    background: #FFFFFF;
  }

  @media (max-width: 768px) {
    .ticket-stub-large {
      grid-template-columns: 1fr;
    }
