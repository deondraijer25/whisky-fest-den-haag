  }

  /* 3. Bottom Row: Action Buttons */
  .ticket-actions-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-ticket-download-gold {
    background-color: var(--whisky-gold, #C58B39) !important;
    color: #171614 !important;
    border: 2px solid var(--text-charcoal) !important;
    padding: 0.75rem 1.4rem !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.04em !important;
    border-radius: 3px !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.5rem !important;
    box-shadow: 3px 3px 0px var(--text-charcoal) !important;
    transition: all 0.2s ease !important;
    text-decoration: none !important;
  }

  .btn-ticket-download-gold:hover {
    transform: translate(-1px, -1px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
    background-color: var(--whisky-gold-light, #DFC598) !important;
  }

  .btn-ticket-share-white {
    background-color: #FFFFFF !important;
    color: var(--text-charcoal) !important;
    border: 2px solid var(--text-charcoal) !important;
    padding: 0.75rem 1.25rem !important;
    font-family: var(--font-sans) !important;
    font-size: 0.85rem !important;
    font-weight: 800 !important;
    border-radius: 3px !important;
    cursor: pointer !important;
    display: inline-flex !important;
    align-items: center !important;
    gap: 0.45rem !important;
    box-shadow: 3px 3px 0px var(--text-charcoal) !important;
    transition: all 0.2s ease !important;
  }

  .btn-ticket-share-white:hover {
    transform: translate(-1px, -1px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
    background-color: var(--bg-sand) !important;
  }

  .ticket-share-wrapper {
    position: relative;
  }

  .ticket-share-menu {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 0;
    background: #FFFFFF;
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 4px 4px 0px var(--text-charcoal);
    padding: 0.5rem;
