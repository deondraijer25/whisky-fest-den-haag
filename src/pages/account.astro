    const authArea = document.getElementById('portal-authenticated-area');
    const loginArea = document.getElementById('portal-login-area');
    const loginForm = document.getElementById('portal-login-form');
    const loginEmailInput = document.getElementById('login-email') as HTMLInputElement;
    const loginResInput = document.getElementById('login-res-no') as HTMLInputElement;
    const loginSubmitBtn = document.getElementById('btn-login-submit') as HTMLButtonElement;
    const demoLoginBtn = document.getElementById('btn-quick-demo-login');
    const portalPageLogoutBtn = document.getElementById('portal-page-logout-btn');
    const authErrorBox = document.getElementById('auth-error-box');
    const authErrorText = document.getElementById('auth-error-text');

    const SESSION_TTL = 7 * 24 * 60 * 60 * 1000; // 7 dagen in ms

    function showError(msg: string) {
      if (authErrorBox && authErrorText) {
        authErrorText.textContent = msg;
        authErrorBox.style.display = 'flex';
      }
    }

    function hideError() {
      if (authErrorBox) {
        authErrorBox.style.display = 'none';
      }
    }

    function getValidSession() {
      try {
        const raw = localStorage.getItem('wf_auth_session') || sessionStorage.getItem('wf_auth_session');
        if (!raw) return null;
        const s = JSON.parse(raw);
        if (s && s.email && s.expiresAt && Date.now() <= s.expiresAt) {
          return s;
        } else if (s && s.expiresAt && Date.now() > s.expiresAt) {
          localStorage.removeItem('wf_auth_session');
          sessionStorage.removeItem('wf_auth_session');
        }
      } catch (e) {}
      return null;
    }

    // Populate input fields if query params are provided
    const urlParams = new URLSearchParams(window.location.search);
    const paramEmail = urlParams.get('email');
    const paramOrder = urlParams.get('order') || urlParams.get('orderNumber');
    if (paramEmail && loginEmailInput && !loginEmailInput.value) {
      loginEmailInput.value = paramEmail.trim();
    }
    if (paramOrder && loginResInput && !loginResInput.value) {
      loginResInput.value = paramOrder.trim();
    }

    function checkAuthAndRender() {
      const session = getValidSession();
      const currentParams = new URLSearchParams(window.location.search);
      const isExplicitLoginView = currentParams.get('view') === 'login';

      if (!session || isExplicitLoginView) {
        if (authArea) authArea.style.display = 'none';
        if (loginArea) loginArea.style.display = 'flex';
        document.documentElement.classList.remove('wf-authenticated');
        document.documentElement.classList.add('wf-unauthenticated');
      } else {
        if (authArea) authArea.style.display = 'block';
        if (loginArea) loginArea.style.display = 'none';
        document.documentElement.classList.remove('wf-unauthenticated');
        document.documentElement.classList.add('wf-authenticated');

        // STRICT GUARD: If stored order is cancelled or not paid, terminate session immediately
        const isPaidOrder = orderData && (orderData.status === 'paid' || orderData.isPaid === true);
        if (orderData && !isPaidOrder) {
          sessionStorage.removeItem('wf_auth_session');
          localStorage.removeItem('wf_auth_session');
          localStorage.removeItem('wf_last_order');
          orderData = null;
          checkAuthAndRender();
          showError("U heeft geen voltooide bestelling. Het accountportaal is alleen toegankelijk na een voltooide betaling.");
          return;
        }

        // Verify orderData matches session user
        if (!orderData || (session.email && orderData.email && orderData.email.toLowerCase() !== session.email.toLowerCase())) {
          try {
            const rawStored = localStorage.getItem('wf_last_order');
            if (rawStored) {
              const p = normalizeOrderObject(JSON.parse(rawStored));
              if (p && p.email && p.email.toLowerCase() === session.email.toLowerCase()) {
                orderData = p;
              }
            }
          } catch(e) {}

          if (!orderData || (orderData.email && orderData.email.toLowerCase() !== session.email.toLowerCase())) {
            orderData = {
              name: session.name || (session.email ? session.email.split('@')[0] : 'Bezoeker'),
              email: session.email,
              resNumber: session.resNumber || '',
              phone: '',
              whiskyStyle: 'Single Malt Scotch',
              items: [],
              tickets: [],
              activeTickets: [],
              isMember: (session.resNumber || '').includes('WS'),
              totalPrice: 0
            };
          }
        }

        updatePortalUI();

        // 3. LIVE WHISKYTIX SYNC: Always re-fetch latest order & tickets from Whiskytix
        const activeResNo = session.resNumber || (orderData && (orderData.resNumber || orderData.orderNumber));
        if (activeResNo) {
          const cleanCode = activeResNo.replace(/^#/, '').trim();
          const apiBase = (window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1')
            ? 'http://localhost:4000'
            : 'https://whiskytix-r1qq.vercel.app';
          fetch(`${apiBase}/api/checkout/order/${encodeURIComponent(cleanCode)}`)
            .then((res) => (res.ok ? res.json() : null))
            .then((data) => {
              if (data && data.order) {
                const vOrder = data.order;
                if (vOrder.status !== 'paid' && vOrder.isPaid !== true) {
                  console.warn('Toegang ontzegd: order is niet betaald of geannuleerd:', vOrder.orderNumber);
                  sessionStorage.removeItem('wf_auth_session');
                  localStorage.removeItem('wf_auth_session');
                  localStorage.removeItem('wf_last_order');
                  orderData = null;
                  checkAuthAndRender();
                  showError(`Bestelling ${activeResNo} is niet voltooid of geannuleerd. Het portaal is alleen toegankelijk voor bezoekers met een voltooide ticketbestelling.`);
                  return;
                }
                orderData = normalizeOrderObject({
                  ...orderData,
                  ...vOrder,
                });
                localStorage.setItem('wf_last_order', JSON.stringify(orderData));
                updatePortalUI();
              }
            })
            .catch((err) => {
              console.warn('Whiskytix achtergrond sync:', err);
            });
        }
      }
    }

    // Live re-render when GHL tickets sync completes in background
    window.addEventListener('ghl:tickets-updated', () => {
      updatePortalUI();
    });

    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        hideError();

        const email = loginEmailInput ? loginEmailInput.value.trim().toLowerCase() : '';
        const rawResNo = loginResInput ? loginResInput.value.trim() : '';

        if (!email) {
          showError('Vul een geldig e-mailadres in.');
          return;
        }

        const originalBtnText = loginSubmitBtn ? loginSubmitBtn.innerHTML : '';
        if (loginSubmitBtn) {
          loginSubmitBtn.disabled = true;
          loginSubmitBtn.innerHTML = '<span>Gegevens verifiëren...</span>';
        }

        try {
          let verifiedOrder: any = null;

          // 1. If order number entered, check Whiskytix API
          if (rawResNo) {
            const cleanCode = rawResNo.replace(/^#/, '').trim();
            const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';
            const bases = isLocal
              ? ['http://localhost:4000', 'https://whiskytix-r1qq.vercel.app']
              : ['https://whiskytix-r1qq.vercel.app'];
            for (const b of bases) {
              try {
                const res = await fetch(`${b}/api/checkout/order/${encodeURIComponent(cleanCode)}`);
                if (res.ok) {
                  const data = await res.json();
                  if (data && data.order) {
                    verifiedOrder = normalizeOrderObject(data.order);
                    break;
                  }
                }
              } catch (err) {
                // Try next base
              }
            }
          }

          // 2. Check local order storage fallback
          if (!verifiedOrder) {
            try {
              const localRaw = localStorage.getItem('wf_last_order');
              if (localRaw) {
                const localData = normalizeOrderObject(JSON.parse(localRaw));
                if (localData) {
                  const localOrderNum = (localData.resNumber || localData.orderNumber || '').replace(/^#/, '').trim().toLowerCase();
                  const searchOrderNum = rawResNo.replace(/^#/, '').trim().toLowerCase();
                  const localEmail = (localData.email || localData.customerEmail || '').trim().toLowerCase();

                  if (searchOrderNum && (localOrderNum === searchOrderNum || localOrderNum.endsWith(searchOrderNum))) {
                    verifiedOrder = localData;
                  } else if (!searchOrderNum && localEmail === email) {
                    verifiedOrder = localData;
                  }
                }
              }
            } catch (e) {}
          }

          // 3. Validation Logic
          if (verifiedOrder) {
            const isOrderPaid = verifiedOrder.status === 'paid' || verifiedOrder.isPaid === true;
            if (!isOrderPaid) {
              showError(`Bestelling ${rawResNo || verifiedOrder.orderNumber || ''} is niet voltooid of geannuleerd. Toegang tot het portaal is uitsluitend beschikbaar voor voltooide bestellingen.`);
              if (loginSubmitBtn) {
                loginSubmitBtn.disabled = false;
                loginSubmitBtn.innerHTML = originalBtnText;
              }
              return;
            }

            const orderEmail = (verifiedOrder.customerEmail || verifiedOrder.email || '').trim().toLowerCase();
            if (orderEmail && orderEmail !== email) {
              showError(`Het e-mailadres komt niet overeen met ordernummer ${rawResNo}.`);
              if (loginSubmitBtn) {
                loginSubmitBtn.disabled = false;
                loginSubmitBtn.innerHTML = originalBtnText;
              }
              return;
            }

            // Successfully matched order!
            const custName = verifiedOrder.customerName || verifiedOrder.name || (email.split('@')[0].charAt(0).toUpperCase() + email.split('@')[0].slice(1));
            const finalOrderNum = verifiedOrder.orderNumber || verifiedOrder.resNumber || rawResNo;
            const fullResNumber = finalOrderNum.startsWith('#') ? finalOrderNum : `#${finalOrderNum}`;

            const sessionData = {
              email: email,
              resNumber: fullResNumber,
              name: custName,
              timestamp: Date.now(),
              expiresAt: Date.now() + SESSION_TTL
            };

            localStorage.setItem('wf_auth_session', JSON.stringify(sessionData));
            sessionStorage.setItem('wf_auth_session', JSON.stringify(sessionData));
            localStorage.removeItem('wf_user_logged_out');

            orderData = normalizeOrderObject({
              ...verifiedOrder,
              name: custName,
              email: email,
              resNumber: fullResNumber,
              orderNumber: fullResNumber,
            });

            localStorage.setItem('wf_last_order', JSON.stringify(orderData));

            // Clean URL query (remove ?view=login)
            const cleanUrl = window.location.pathname;
            window.history.replaceState({}, '', cleanUrl);

            checkAuthAndRender();
            window.dispatchEvent(new Event('storage'));
            return;
          }

          // If no order was verified:
          // Demo backdoor eliminated

          if (rawResNo) {
            showError(`Geen bestelling gevonden voor ordernummer "${rawResNo}". Controleer uw e-mailadres en ordernummer.`);
          } else {
            showError(`Geen actieve bestellingen gevonden voor "${email}". Vul ook uw ordernummer in.`);
          }
        } catch (submitErr) {
          console.error('Inloggen fout:', submitErr);
          showError('Er is een onverwachte fout opgetreden bij het inloggen. Probeer het opnieuw.');
        } finally {
          if (loginSubmitBtn) {
            loginSubmitBtn.disabled = false;
            loginSubmitBtn.innerHTML = originalBtnText;
          }
        }
      });
    }

    // Demo login button eliminated

    function performLogout() {
      localStorage.setItem('wf_user_logged_out', 'true');
      sessionStorage.removeItem('wf_auth_session');
      localStorage.removeItem('wf_auth_session');
      
      const newUrl = window.location.pathname + '?view=login';
      window.history.replaceState({}, '', newUrl);

      checkAuthAndRender();
      window.dispatchEvent(new Event('storage'));
    }

    if (portalPageLogoutBtn) {
      portalPageLogoutBtn.addEventListener('click', performLogout);
    }

    checkAuthAndRender();
    window.addEventListener('load', checkAuthAndRender);
    window.addEventListener('storage', checkAuthAndRender);

    // Auto-authenticate if ?email=...&order=... are passed in the URL (e.g. from the post-checkout confirmation link)
    if (paramEmail && paramOrder && loginForm) {
      const existingSession = getValidSession();
