  .btn-ticket-download {
    background-color: var(--brand-red, #E30613) !important;
    color: #FFFFFF !important;
  }

  .btn-ticket-download:hover {
    transform: translateY(-2px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
    filter: brightness(1.1) !important;
  }

  .btn-ticket-share {
    background-color: #FFFFFF !important;
    color: var(--text-charcoal) !important;
  }

  .btn-ticket-share:hover {
    background-color: var(--bg-parchment) !important;
    transform: translateY(-2px) !important;
    box-shadow: 4px 4px 0px var(--text-charcoal) !important;
  }

  /* LUXURY VECTOR SHARE POPUP MENU */
  .ticket-share-wrapper {
    position: relative !important;
    display: inline-block !important;
  }

  .ticket-share-menu {
    position: absolute !important;
    bottom: calc(100% + 8px) !important;
    left: 0 !important;
    background-color: var(--bg-paper-card) !important;
    border: 2px solid var(--border-color-dark) !important;
    border-radius: 6px !important;
    box-shadow: 0 12px 30px rgba(29, 28, 26, 0.22), 4px 4px 0px var(--text-charcoal) !important;
    padding: 0.45rem !important;
    display: none !important;
    flex-direction: column !important;
    gap: 0.25rem !important;
    z-index: 100 !important;
    min-width: 225px !important;
    animation: popupFade 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
  }

  /* Invisible hover bridge to keep menu open while moving cursor between button and popup */
  .ticket-share-menu::after {
    content: '' !important;
    position: absolute !important;
    top: 100% !important;
    left: 0 !important;
    width: 100% !important;
    height: 16px !important;
    background: transparent !important;
  }

  @keyframes popupFade {
    from { opacity: 0; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ticket-share-wrapper:hover .ticket-share-menu,
  .ticket-share-wrapper:focus-within .ticket-share-menu,
  .ticket-share-menu.active {
    display: flex !important;
  }

