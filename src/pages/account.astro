    const CAT_LABELS_ACCOUNT: Record<string, string> = {
      scotch: 'Schots',
      dutch: 'Nederlands',
      world: 'Wereld / Iers',
      independent: 'Bottelaar',
      catering: 'Catering & Lifestyle',
      organisation: 'Organisatie'
    };

    const accountStands = document.querySelectorAll('#account-church-map .svg-stand');
    const defaultState = document.getElementById('account-default-info-state');
    const activeState = document.getElementById('account-active-info-state');

    const badgeEl = document.getElementById('account-stand-badge');
    const titleEl = document.getElementById('account-stand-title');
    const catEl = document.getElementById('account-stand-category');
    const descEl = document.getElementById('account-stand-desc');
    const brandsEl = document.getElementById('account-stand-brands-list');

    accountStands.forEach(standNode => {
      standNode.addEventListener('click', () => {
        const sId = standNode.getAttribute('data-stand');
        const sSlot = standNode.getAttribute('data-map-slot');
        const match = exhibitorsData.find(e => e.id === sId || (sSlot && e.mapSlot === sSlot));

        accountStands.forEach(s => s.classList.remove('selected-stand'));
        standNode.classList.add('selected-stand');

        if (match && defaultState && activeState) {
          defaultState.style.display = 'none';
          activeState.style.display = 'block';

          if (badgeEl) badgeEl.textContent = `STAND ${match.id}`;
          if (titleEl) titleEl.textContent = match.name;
          if (catEl) {
            const cats = Array.isArray(match.categories) && match.categories.length > 0 ? match.categories : [match.category];
            catEl.textContent = cats.map(c => CAT_LABELS_ACCOUNT[c] || c).join(' • ').toUpperCase();
          }
          if (descEl) descEl.textContent = match.description || "";

          if (brandsEl && match.brands) {
            brandsEl.innerHTML = match.brands.map(b => `<span class="addon-badge">${b}</span>`).join(' ');
          }
        }
      });
    });

    window.addEventListener('ghl:stands-updated', (e: any) => {
      const liveStands = e.detail;
      if (!Array.isArray(liveStands)) return;
      liveStands.forEach((r: any) => {
        const p = r.properties || r;
        const standId = String(p.stand_id || r.id || '').trim();
        const slotKey = String(p.map_slot || p.mapSlot || (standId === '19' ? 'X' : standId) || '').trim();
        if (!standId) return;

        const svgGroup = document.querySelector(`#account-church-map .svg-stand[data-stand="${standId}"], #account-church-map .svg-stand[data-map-slot="${slotKey}"]`);
        if (svgGroup) {
          svgGroup.setAttribute('data-stand', standId);
          const labelEl = svgGroup.querySelector('.svg-stand-id-label, text');
          if (labelEl) labelEl.textContent = standId;
        }

        const brandsArr = Array.isArray(p.brands)
          ? p.brands
          : (typeof p.brands === 'string' && p.brands.trim() !== ''
              ? p.brands.split(',').map((b: string) => b.trim()).filter(Boolean)
              : null);
        const descText = p.stand_description !== undefined ? p.stand_description : p.description;

        let existing = exhibitorsData.find(ex => ex.id === standId || (slotKey && ex.mapSlot === slotKey));
        if (existing) {
          existing.id = standId;
          if (p.exhibitor_name || p.name) existing.name = p.exhibitor_name || p.name;
          if (p.category) {
            existing.category = p.category;
            existing.categories = [p.category];
          }
          if (brandsArr) existing.brands = brandsArr;
          if (descText !== undefined) existing.description = descText;
        } else {
          exhibitorsData.push({
            id: standId,
            mapSlot: slotKey,
            name: p.exhibitor_name || p.name || 'Standhouder',
            category: p.category || 'world',
            categories: [p.category || 'world'],
            brands: brandsArr || [],
            description: descText || '',
            isNotOnMap: false
          });
        }
      });
    });
  });
