    if (stored) {
      try {
        orderData = JSON.parse(stored);
      } catch (e) {
        console.error("Failed to parse stored order:", e);
      }
    }

    // Fallback default order data (Demo Mode)
    if (!orderData) {
      orderData = {
        name: "Deon Draijer",
        email: "deondraijer@gmail.com",
        items: [
          {
            id: "vip-session",
            title: "VIP Sessie - Vrijdag",
            qty: 1,
            price: 79.50,
            category: "entree"
          }
        ],
        resNumber: "#WF-2026-84387",
        phone: "+31 6 12345678",
        whiskyStyle: "Single Malt Scotch",
        isMember: true,
        isDemo: true,
        totalPrice: 79.50
      };
      if (demoBanner) demoBanner.style.display = "block";
    } else {
      if (demoBanner) demoBanner.style.display = "none";
    }

    if (!orderData.items || orderData.items.length === 0) {
      orderData.items = [
        {
          id: "vip-session",
          title: "VIP Sessie - Vrijdag",
          qty: 1,
          price: 79.50,
          category: "entree"
        }
