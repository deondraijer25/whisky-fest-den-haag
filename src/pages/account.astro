    const profileSuccessBanner = document.getElementById('profile-success-banner');

    if (profileEditForm) {
      profileEditForm.addEventListener('submit', (e) => {
        e.preventDefault();

        orderData.name = profileInputName.value;
        orderData.email = profileInputEmail.value;
        orderData.phone = profileInputPhone.value;
        orderData.whiskyStyle = profileInputWhisky.value;
        
        if (orderData.isDemo) {
          delete orderData.isDemo;
          if (demoBanner) demoBanner.style.display = "none";
        }

        localStorage.setItem('wf_last_order', JSON.stringify(orderData));
        updatePortalUI();

        if (profileSuccessBanner) {
          profileSuccessBanner.style.display = "block";
          setTimeout(() => {
            profileSuccessBanner.style.display = "none";
          }, 4000);
