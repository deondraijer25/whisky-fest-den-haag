---
// src/pages/festivalboekje-den-haag.astro
// Drukklare 8-Pagina Wikkelvouwfolder (HelloPrint A5 Roll Fold Portrait: 589mm x 216mm incl. 3mm bleed, netto 583mm x 210mm)
// Behoudt Pagina 1, 8, 7 (op Vel 1) en Pagina 2 (op Vel 2) 1-op-1 uit de geüploade Canva PDF (/images/boekje/canva-basis-boekje.pdf)
// En vult Pagina 3 (Liggend Standhouders in 3 kolommen), Pagina 4 & 5 (Masterclasses + Amsterdam 2027) en Pagina 6 (Activiteiten + Lindores Abbey 2027) in.
import Layout from '../layouts/Layout.astro';
import rawLogoAmsterdamWit from '../assets/LogosAll/logo-wit-amsterdam.svg?raw';
import {
  STANDHOUDERS_BOEKJE_2026,
  FACILITEITEN_BOEKJE_2026,
  MASTERCLASSES_PAGINA_6,
  MASTERCLASSES_PAGINA_7,
} from '../data/boekjeDenHaagData';

// Verdeel de 45 genummerde stands (01 t/m 48, incl. 17 = Rampur Indian Single Malt) in 3 gelijke kolommen van 15 stands
const col1Stands = STANDHOUDERS_BOEKJE_2026.slice(0, 15);
const col2Stands = STANDHOUDERS_BOEKJE_2026.slice(15, 30);
const col3Stands = STANDHOUDERS_BOEKJE_2026.slice(30, 45);

// Exacte 11-assige Smaakpalet-Radar SVG generator (voor VAT A op licht vlak en VAT B op donkergroen vlak)
const FLAVOR_LABELS = [
  'Apple', 'Citrus', 'Floral', 'Dried fruits', 'Oily', 'Malty', 'Toffee', 'Woody', 'Spicy', 'Nutty', 'Peaty'
];
const VAT_A_VALUES = [0.54, 0.39, 0.33, 1.0, 0.54, 0.54, 0.90, 0.35, 1.0, 0.50, 0.14];
const VAT_B_VALUES = [0.89, 0.72, 0.89, 0.50, 0.69, 0.90, 0.37, 0.87, 0.50, 0.69, 0.51];

function buildFlavorRadarSvg(values: number[], theme: 'light' | 'dark'): string {
  const cx = 165;
  const cy = 152;
  const R = 104;
  const N = FLAVOR_LABELS.length;
  const ringStroke = theme === 'light' ? 'rgba(23, 22, 20, 0.28)' : 'rgba(250, 247, 242, 0.38)';
  const spokeStroke = theme === 'light' ? 'rgba(23, 22, 20, 0.75)' : 'rgba(250, 247, 242, 0.8)';
  const polyFill = theme === 'light' ? 'rgba(235, 162, 122, 0.72)' : 'rgba(235, 162, 122, 0.82)';
  const polyStroke = theme === 'light' ? '#171614' : '#FAF7F2';
  const labelColor = theme === 'light' ? '#171614' : '#FAF7F2';

  let rings = '';
  for (let r = 1; r <= 5; r++) {
    const rad = (R * r) / 5;
    rings += `<circle cx="${cx}" cy="${cy}" r="${rad.toFixed(1)}" fill="none" stroke="${ringStroke}" stroke-width="1" stroke-dasharray="2 2" />`;
  }

  let spokes = '';
  let labels = '';
  const pts: string[] = [];

  for (let i = 0; i < N; i++) {
    const angle = -Math.PI / 2 + (i * 2 * Math.PI) / N;
    const xEnd = cx + R * Math.cos(angle);
    const yEnd = cy + R * Math.sin(angle);
    spokes += `<line x1="${cx}" y1="${cy}" x2="${xEnd.toFixed(1)}" y2="${yEnd.toFixed(1)}" stroke="${spokeStroke}" stroke-width="1.3" />`;

    const val = values[i] ?? 0.5;
    const px = cx + R * val * Math.cos(angle);
    const py = cy + R * val * Math.sin(angle);
    pts.push(`${px.toFixed(1)},${py.toFixed(1)}`);

    const labelDist = R + 14;
    const lx = cx + labelDist * Math.cos(angle);
    const ly = cy + labelDist * Math.sin(angle);
    let anchor = 'middle';
    if (Math.cos(angle) > 0.25) anchor = 'start';
    else if (Math.cos(angle) < -0.25) anchor = 'end';

    const dy = Math.sin(angle) > 0.7 ? 6 : Math.sin(angle) < -0.7 ? -2 : 3.5;
    labels += `<text x="${lx.toFixed(1)}" y="${(ly + dy).toFixed(1)}" text-anchor="${anchor}" fill="${labelColor}" font-family="'Plus Jakarta Sans', 'Inter', sans-serif" font-size="11.5" font-weight="800">${FLAVOR_LABELS[i]}</text>`;
  }

  return `<svg viewBox="0 0 345 305" width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
    ${rings}
    ${spokes}
    <polygon points="${pts.join(' ')}" fill="${polyFill}" stroke="${polyStroke}" stroke-width="1.8" stroke-linejoin="round" />
    ${labels}
  </svg>`;
}

const radarSvgVatA = buildFlavorRadarSvg(VAT_A_VALUES, 'light');
const radarSvgVatB = buildFlavorRadarSvg(VAT_B_VALUES, 'dark');
---

<Layout
  title="Drukklare 8-Pagina Wikkelvouwfolder A5 (HelloPrint 589x216mm) | International Whisky Festival Den Haag 2026"
  description="Drukklare A5 Roll Fold Portrait wikkelvouwfolder (8 pagina's op 2 drukvellen: 589x216mm incl. 3mm afloop) voor HelloPrint."
>
  <!-- Top Screen-Only Control Bar (Verborgen bij Print / PDF Export) -->
  <div class="boekje-toolbar no-print">
    <div class="toolbar-inner">
      <div class="toolbar-left">
        <a href="#vel-2-binnenzijde" class="toolbar-nav-pill">Vel 2: Binnenzijde (P2 &bull; P3 &bull; P4 &bull; P5)</a>
        <a href="#vel-1-buitenzijde" class="toolbar-nav-pill">Vel 1: Buitenzijde (P6 &bull; P7 &bull; P8 &bull; P1)</a>
        <span class="toolbar-spec-badge">HELLOPRINT 589 &times; 216 MM &bull; P3 LIGGEND (3 KOLOMMEN) + P4/P5 MASTERCLASSES + P6 ACTIVITEITEN</span>
      </div>

      <div class="toolbar-actions">
        <button type="button" id="toggle-p3-theme-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line>
            <line x1="12" y1="21" x2="12" y2="23"></line>
          </svg>
          <span id="p3-theme-label">P3 Thema: Licht (Passend bij Plattegrond)</span>
        </button>

        <button type="button" id="toggle-guides-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect x="3" y="3" width="18" height="18" rx="2"></rect>
            <line x1="9" y1="3" x2="9" y2="21"></line>
            <line x1="15" y1="3" x2="15" y2="21"></line>
          </svg>
          <span id="guides-label">Hulplijnen: AAN</span>
        </button>

        <button type="button" id="toggle-edit-btn" class="toolbar-btn toolbar-btn-outline">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M12 20h9"></path>
            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
          </svg>
          <span id="edit-label">Tekst Bewerken: UIT</span>
        </button>

        <a href="/images/boekje/canva-pagina-3-standhouders-liggend.png" download class="toolbar-btn toolbar-btn-outline">
          <span>Download P3 PNG</span>
        </a>
        <a href="/images/boekje/canva-pagina-4-masterclasses-deel1.png" download class="toolbar-btn toolbar-btn-outline">
          <span>Download P4 PNG</span>
        </a>
        <a href="/images/boekje/canva-pagina-5-masterclasses-deel2.png" download class="toolbar-btn toolbar-btn-outline">
          <span>Download P5 PNG</span>
        </a>
        <a href="/images/boekje/canva-pagina-6-activiteiten-2027.png" download class="toolbar-btn toolbar-btn-outline">
          <span>Download P6 PNG</span>
        </a>

        <button type="button" onclick="window.print()" class="toolbar-btn toolbar-btn-primary">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
            <polyline points="6 9 6 2 18 2 18 9"></polyline>
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
            <rect x="6" y="14" width="12" height="8"></rect>
          </svg>
          <span>Exporteer Complete PDF (589 &times; 216 mm)</span>
        </button>
      </div>
    </div>
  </div>

  <main class="boekje-stage-wrapper show-guides" id="boekje-stage">

    <!-- =========================================================================
         DRUKVEL 1 (BUITENZIJDE): PAGINA 6 (142mm) | PAGINA 7 (145mm) | PAGINA 8 (148mm) | PAGINA 1 / COVER (148mm)
         Pagina 7, 8 en 1 komen 1-op-1 uit de geüploade PDF (/images/boekje/canva-basis-boekje.pdf);
         Pagina 6 (links: 0 t/m 145mm) is nieuw opgemaakt met Overige Activiteiten 2026 + Lindores Abbey 2027.
         ========================================================================= -->
    <div class="sheet-caption no-print" id="vel-1-buitenzijde">
      <span>DRUKVEL 1 VAN 2 (BUITENZIJDE) &mdash; LINKS: PAGINA 6 (NIEUW: ACTIVITEITEN + LINDORES 2027) &bull; RECHTS: PAGINA 7, 8 &amp; 1 (BEHOUDEN UIT PDF)</span>
      <span>BRUTO: 589 &times; 216 MM (LIJNEN OP: 3 &bull; 145 &bull; 290 &bull; 438 &bull; 586 MM)</span>
    </div>

    <section class="helloprint-sheet sheet-outside" id="sheet-vel-1" aria-label="Drukvel 1: Buitenzijde">
      <!-- 0. Originele Geüploade PDF Pagina 1 (Vel 1 met P7, P8 en P1) -->
      <div class="pdf-sheet-bg" aria-hidden="true">
        <canvas class="pdf-canvas" id="pdf-canvas-page1" width="2226" height="816"></canvas>
        <img class="pdf-print-img" id="pdf-img-page1" alt="" />
      </div>

      <!-- HelloPrint Overlay Guides (3 - 145 - 290 - 438 - 586 mm) -->
      <div class="hp-guides-overlay no-print" aria-hidden="true">
        <div class="hp-trim-box"></div>
        <div class="hp-fold-line" style="left: 145mm;"><span>VOUW 1 (145 mm)</span></div>
        <div class="hp-fold-line" style="left: 290mm;"><span>VOUW 2 (290 mm)</span></div>
        <div class="hp-fold-line" style="left: 438mm;"><span>VOUW 3 (438 mm)</span></div>
        <div class="hp-panel-badge" style="left: 74mm;">PAGINA 6 &bull; 142 mm (NIEUW)</div>
        <div class="hp-panel-badge" style="left: 217.5mm;">PAGINA 7 &bull; 145 mm (BEHOUDEN)</div>
        <div class="hp-panel-badge" style="left: 364mm;">PAGINA 8 &bull; 148 mm (BEHOUDEN)</div>
        <div class="hp-panel-badge" style="left: 512mm;">PAGINA 1 &bull; 148 mm (BEHOUDEN)</div>
      </div>

      <!-- =====================================================================
           PAGINA 6 (x: 0mm t/m 145mm = 3mm bleed links + 142mm netto):
           BOVENSTE HELFT (0–100mm, licht): OVERIGE ACTIVITEITEN TIJDENS HET FESTIVAL 2026 (5 ITEMS)
           ONDERSTE HELFT (100–216mm, donkergroen uitgelijnd met VAT B): FESTIVAL BOTTELING 2027 (LINDORES ABBEY)
           ===================================================================== -->
      <div class="overlay-panel panel-p6-new" id="panel-pagina-6">
        <!-- Bovenste helft (0 t/m 100mm): Licht vlak aansluitend op VAT A ernaast -->
        <div class="p6-top-half">
          <div class="p6-top-header">
            <h2 class="p6-heading-green editable-node">OVERIGE ACTIVITEITEN</h2>
          </div>

          <ul class="p6-activities-stack">
            <li class="p6-act-card">
              <span class="p6-act-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <ellipse cx="12" cy="5" rx="7" ry="2.5"></ellipse>
                  <path d="M5 5v14c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5V5"></path>
                  <path d="M5 12c0 1.4 3.1 2.5 7 2.5s7-1.1 7-2.5"></path>
                </svg>
              </span>
              <div class="p6-act-body">
                <div class="p6-act-top-row">
                  <strong class="editable-node">Vatenmaker-workshops</strong>
                  <span class="p6-act-loc-tag editable-node">BUITENTERREIN B</span>
                </div>
                <span class="editable-node">Sluit aan bij &eacute;&eacute;n van de ambachtelijke Cooperclasses met mini-tasting.</span>
              </div>
            </li>

            <li class="p6-act-card">
              <span class="p6-act-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M8 2h8l1.5 7.5a5.5 5.5 0 0 1-11 0L8 2z"></path>
                  <line x1="12" y1="15" x2="12" y2="21"></line>
                  <line x1="8" y1="21" x2="16" y2="21"></line>
                </svg>
              </span>
              <div class="p6-act-body">
                <div class="p6-act-top-row">
                  <strong class="editable-node">Warehouse-tasting bij Cley</strong>
                  <span class="p6-act-loc-tag editable-node">STAND 5</span>
                </div>
                <span class="editable-node">Proef exclusieve expressies rechtstreeks uit het vat in de Grote Kerk.</span>
              </div>
            </li>

            <li class="p6-act-card">
              <span class="p6-act-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <rect x="4" y="3" width="16" height="15" rx="2"></rect>
                  <path d="M4 11h16"></path>
                  <path d="M8 15h.01"></path>
                  <path d="M16 15h.01"></path>
                  <path d="M6 18l-2 3"></path>
                  <path d="M18 18l2 3"></path>
                </svg>
              </span>
              <div class="p6-act-body">
                <div class="p6-act-top-row">
                  <strong class="editable-node">Haagsche Whiskytram</strong>
                  <span class="p6-act-loc-tag editable-node">10 RITTEN</span>
                </div>
                <span class="editable-node">Rij mee door de Haagse binnenstad onder het genot van bijzondere drams.</span>
              </div>
            </li>

            <li class="p6-act-card">
              <span class="p6-act-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <circle cx="12" cy="12" r="9"></circle>
                  <polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"></polygon>
                </svg>
              </span>
              <div class="p6-act-body">
                <div class="p6-act-top-row">
                  <strong class="editable-node">Whisky Trail &amp; Rondleiding</strong>
                  <span class="p6-act-loc-tag editable-node">INFO O</span>
                </div>
                <span class="editable-node">Boek een begeleide route langs geselecteerde stands bij onze kenners.</span>
              </div>
            </li>

            <li class="p6-act-card">
              <span class="p6-act-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <path d="M10 2h4v4l3 4v10a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V10l3-4V2z"></path>
                  <line x1="7" y1="14" x2="17" y2="14"></line>
                </svg>
              </span>
              <div class="p6-act-body">
                <div class="p6-act-top-row">
                  <strong class="editable-node">Festival Slijterij</strong>
                  <span class="p6-act-loc-tag editable-node">STAND S</span>
                </div>
                <span class="editable-node">Proef en reserveer uw favoriete festival botteling of andere exclusieve flessen.</span>
              </div>
            </li>
          </ul>
        </div>

        <!-- Onderste helft (100 t/m 216mm): Donkergroen blok exact uitgelijnd met VAT B ernaast -->
        <div class="p6-bottom-half">
          <img src="/images/boekje/barrels-arch-bg.jpg" alt="" class="p6-barrels-bg" />
          <div class="p6-green-overlay"></div>

          <div class="p6-bottom-inner">
            <div class="p6-lindores-top">
              <div class="p6-lindores-title-row">
                <h2 class="p6-heading-white editable-node">FESTIVAL BOTTELING 2027</h2>
              </div>

              <p class="p6-lindores-desc editable-node">
                In 2027 worden er <strong>2 vaten van de Lindores Abbey Distilleerderij</strong> gebotteld, speciaal voor het International Whisky Festival. Het zijn 2 totaal verschillende vaten:
              </p>
            </div>

            <!-- 2 Flessen (HQ) staand achter de 2 naar beneden gehaalde bannertjes -->
            <div class="p6-casks-duo">
              <div class="p6-cask-bottle-col">
                <div class="p6-bottle-stage">
                  <img src="/images/boekje/amrut-vat-a-9318-hq.png" alt="Fles Vat A" class="p6-bottle-img" />
                </div>
                <div class="p6-cask-pill">
                  <span class="p6-cask-tag editable-node">VAT A &bull; SINGLE CASK</span>
                  <strong class="p6-cask-title editable-node">Lindores Abbey Woodford Reserve ASB</strong>
                </div>
              </div>

              <div class="p6-cask-bottle-col">
                <div class="p6-bottle-stage">
                  <img src="/images/boekje/amrut-vat-b-3464-hq.png" alt="Fles Vat B" class="p6-bottle-img" />
                </div>
                <div class="p6-cask-pill">
                  <span class="p6-cask-tag editable-node">VAT B &bull; SINGLE CASK</span>
                  <strong class="p6-cask-title editable-node">Lindores Abbey PX STR</strong>
                </div>
              </div>
            </div>

            <!-- Gouden Actie-Kaart (rustiger opgemaakt, conform tekst uit Google Sheet) -->
            <div class="p6-gold-offset-card">
              <p class="p6-gift-copy editable-node">
                Bij aankoop van <strong>2 flessen</strong> krijgt u een overheerlijk cadeautje waarin de Lindores Abbey is verwerkt <strong>t.w.v. &euro; 10,00</strong>!
              </p>
              <span class="p6-gift-subline editable-node">Reserveer de fles snel in de Slijterij (S) &bull; Zeer beperkte oplage per vat</span>
            </div>
          </div>
        </div>
      </div>

      <!-- =====================================================================
           PAGINA 7 (x: 145mm t/m 290mm = 145mm breed x 216mm hoog):
           FESTIVAL BOTTELING OP 1 HELE PAGINA (1 FLES + GROOT GECENTREERD SMAAKPALET PER HELFT)
           BOVENSTE HELFT (0–108.26mm, licht): VAT A (#9318 - First Fill Bourbon Barrel - 116 flessen)
           ONDERSTE HELFT (108.26–216mm, donkergroen): VAT B (#3464 - Refill Bourbon Barrel - 118 flessen)
           ===================================================================== -->
      <div class="overlay-panel panel-p7-new" id="panel-pagina-7">
        <!-- BOVENSTE HELFT: VAT A (#9318 - First Fill Bourbon Barrel - 116 flessen) -->
        <div class="p7-half p7-top-half">
          <div class="p7-top-content">
            <!-- Linkerzijde: Titel VAT A + 116 flessen -->
            <div class="p7-title-group p7-title-left">
              <h2 class="p7-vat-heading p7-heading-green editable-node">VAT A</h2>
              <p class="p7-avail-sub p7-sub-dark editable-node">116 flessen beschikbaar</p>
              <span class="p7-cask-spec p7-spec-light editable-node">First Fill Bourbon &bull; 60% ABV</span>
            </div>

            <!-- Midden: Groot Gecentreerd Smaakpalet Vat A -->
            <div class="p7-radar-box p7-radar-vat-a" set:html={radarSvgVatA} />

            <!-- Rechterzijde: Haarscherpe Donkere Fles (#9318) achter de gouden kaart -->
            <div class="p7-bottle-wrap p7-bottle-right">
              <img src="/images/boekje/amrut-vat-a-9318-hq.png" alt="Amrut Single Malt Vat A #9318" class="p7-hq-bottle" />
            </div>
          </div>

          <!-- Gouden Banner onderaan bovenste helft met strakke luxe GELIMITEERD badge -->
          <div class="p7-banner-wrap">
            <div class="p7-gold-card p7-card-vat-a">
              <div class="p7-card-header-row">
                <div class="p7-lim-stamp">
                  <span class="editable-node">GELIMITEERD (116 FLESSEN)</span>
                </div>
                <div class="p7-card-top-right">
                  <strong class="p7-card-brand editable-node">AMRUT SINGLE MALT</strong>
                  <span class="p7-card-cask editable-node">Single Cask #9318 &bull; Whisky Live The Hague 2026</span>
                </div>
              </div>
              <div class="p7-card-bottom-row">
                <span class="p7-card-price editable-node">&euro; 85,00</span>
                <span class="p7-card-loc">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                    <circle cx="12" cy="10" r="3"></circle>
                  </svg>
                  <span class="editable-node">Slijterij (S) / Informatiestand</span>
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- ONDERSTE HELFT: VAT B (#3464 - Refill / Second Fill Bourbon Barrel - 118 flessen) -->
        <div class="p7-half p7-bottom-half">
          <img src="/images/boekje/barrels-arch-bg.jpg" alt="" class="p7-barrels-bg" />
          <div class="p7-green-overlay"></div>

          <div class="p7-top-content p7-bottom-content">
            <!-- Linkerzijde: Haarscherpe Lichtere Fles (#3464) achter de gouden kaart -->
            <div class="p7-bottle-wrap p7-bottle-left">
              <img src="/images/boekje/amrut-vat-b-3464-hq.png" alt="Amrut Single Malt Vat B #3464" class="p7-hq-bottle" />
            </div>

            <!-- Midden: Groot Gecentreerd Smaakpalet Vat B -->
            <div class="p7-radar-box p7-radar-vat-b" set:html={radarSvgVatB} />

            <!-- Rechterzijde: Titel VAT B + 118 flessen -->
            <div class="p7-title-group p7-title-right">
              <h2 class="p7-vat-heading p7-heading-white editable-node">VAT B</h2>
              <p class="p7-avail-sub p7-sub-white editable-node">118 flessen beschikbaar</p>
              <span class="p7-cask-spec p7-spec-dark editable-node">Refill Bourbon &bull; 60% ABV</span>
            </div>
          </div>

          <!-- Gouden Banner onderaan onderste helft (exact op de 8.5mm onderlijn i.v.m. 3mm snijverlies) -->
          <div class="p7-banner-wrap">
            <div class="p7-gold-card p7-card-vat-b">
              <div class="p7-card-header-row">
                <div class="p7-card-top-left">
                  <strong class="p7-card-brand editable-node">AMRUT SINGLE MALT</strong>
                  <span class="p7-card-cask editable-node">Single Cask #3464 &bull; Whisky Live The Hague 2026</span>
                </div>
                <div class="p7-lim-stamp">
                  <span class="editable-node">GELIMITEERD (118 FLESSEN)</span>
                </div>
              </div>
              <div class="p7-card-bottom-row">
                <span class="p7-card-loc">
