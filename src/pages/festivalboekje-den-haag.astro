<script type="module" is:inline>
  import * as pdfjsLib from '/pdfjs/pdf.min.mjs';
  pdfjsLib.GlobalWorkerOptions.workerSrc = '/pdfjs/pdf.worker.min.mjs';

  // 1. Render beide pagina's van de geüploade Canva PDF (/images/boekje/canva-basis-boekje.pdf) op hoge resolutie
  async function renderCanvaBasisPdf() {
    try {
      const loadingTask = pdfjsLib.getDocument('/images/boekje/canva-basis-boekje.pdf');
      const pdf = await loadingTask.promise;

      const pagesConfig = [
        { pageNum: 1, canvasId: 'pdf-canvas-page1', imgId: 'pdf-img-page1' },
        { pageNum: 2, canvasId: 'pdf-canvas-page2', imgId: 'pdf-img-page2' },
      ];

      for (const cfg of pagesConfig) {
        const page = await pdf.getPage(cfg.pageNum);
        const unscaledVp = page.getViewport({ scale: 1 });
        const targetW = 2226 * 2;
        const targetH = 816 * 2;

        const offCanvas = document.createElement('canvas');
        offCanvas.width = targetW;
        offCanvas.height = targetH;
        const offCtx = offCanvas.getContext('2d');

        const scaleX = targetW / unscaledVp.width;
        const scaleY = targetH / unscaledVp.height;
        const viewport = page.getViewport({ scale: Math.max(scaleX, scaleY) });

        await page.render({
          canvasContext: offCtx,
          viewport,
        }).promise;

        // Geef Pagina 2 (de plattegrond op Vel 2) direct dezelfde warme #FAF7F2 achtergrondkleur als alle andere pagina's
        if (cfg.pageNum === 2) {
          offCtx.save();
          offCtx.globalCompositeOperation = 'multiply';
          offCtx.fillStyle = '#FAF7F2';
          offCtx.fillRect(0, 0, targetW, targetH);
          offCtx.restore();
        }

        const canvasEl = document.getElementById(cfg.canvasId);
        if (canvasEl) {
          canvasEl.width = 2226;
          canvasEl.height = 816;
          const ctx = canvasEl.getContext('2d');
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(offCanvas, 0, 0, 2226, 816);
        }

        const imgEl = document.getElementById(cfg.imgId);
        if (imgEl) {
          imgEl.src = offCanvas.toDataURL('image/jpeg', 0.96);
        }
      }
    } catch (err) {
      console.error('Fout bij laden van /images/boekje/canva-basis-boekje.pdf:', err);
    }
  }

  renderCanvaBasisPdf();

  // 2. Toggle P3 Thema (Licht vs Donkergroen)
  const p3Btn = document.getElementById('toggle-p3-theme-btn');
  const p3Label = document.getElementById('p3-theme-label');
  const p3Panel = document.getElementById('panel-pagina-3');

  if (p3Btn && p3Label && p3Panel) {
    p3Btn.addEventListener('click', () => {
      const isDark = p3Panel.classList.toggle('p3-dark-mode');
      p3Panel.classList.toggle('p3-light-mode', !isDark);
      p3Label.textContent = isDark
        ? 'P3 Thema: Donkergroen (Passend bij Masterclasses)'
        : 'P3 Thema: Licht (Passend bij Plattegrond)';
    });
  }

  // 3. Toggle HelloPrint Hulplijnen
  const stage = document.getElementById('boekje-stage');
  const guidesBtn = document.getElementById('toggle-guides-btn');
  const guidesLabel = document.getElementById('guides-label');

  if (guidesBtn && stage && guidesLabel) {
    guidesBtn.addEventListener('click', () => {
      const active = stage.classList.toggle('show-guides');
      guidesLabel.textContent = active ? 'Hulplijnen: AAN' : 'Hulplijnen: UIT';
    });
  }

  // 4. Toggle Tekst Bewerken
  const editBtn = document.getElementById('toggle-edit-btn');
  const editLabel = document.getElementById('edit-label');
  let isEditing = false;

  if (editBtn && editLabel) {
    editBtn.addEventListener('click', () => {
      isEditing = !isEditing;
      document.querySelectorAll('.editable-node').forEach((el) => {
        if (isEditing) {
          el.setAttribute('contenteditable', 'true');
        } else {
          el.removeAttribute('contenteditable');
        }
      });
      editLabel.textContent = isEditing ? 'Tekst Bewerken: AAN' : 'Tekst Bewerken: UIT';
    });
  }
</script>
