---
// src/layouts/Layout.astro
import '../styles/global.css';
import MobileCartDrawer from '../components/MobileCartDrawer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  type?: string;
}

const { 
  title, 
  description, 
  image = "/assets/whisky-fest-og.jpg", 
  canonicalUrl = Astro.url.href, 
  type = "website" 
} = Astro.props;

// Dynamic JSON-LD Structured Data Schema for search engine rich results
const eventSchema = {
  "@context": "https://schema.org",
  "@type": "Festival",
  "name": "International Whisky Festival Den Haag 2026",
  "description": "Het bekendste en meest premium whisky festival van Nederland. Proef honderden whisky's, volg exclusieve masterclasses en geniet van de sfeer in de Grote Kerk Den Haag.",
  "startDate": "2026-11-13T13:00:00+01:00",
  "endDate": "2026-11-15T17:00:00+01:00",
  "eventStatus": "https://schema.org/EventScheduled",
  "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
  "location": {
    "@type": "Place",
    "name": "Grote Kerk Den Haag",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Rond de Grote Kerk 12",
      "addressLocality": "Den Haag",
      "postalCode": "2513 AM",
      "addressCountry": "NL"
    }
  },
  "image": [
    "https://www.whiskyfestival.nl/assets/whisky-fest-og.jpg"
  ],
  "offers": {
    "@type": "AggregateOffer",
    "url": "https://www.whiskyfestival.nl/bestellen",
    "priceCurrency": "EUR",
    "lowPrice": "55.00",
    "highPrice": "79.50",
    "offerCount": "2",
    "availability": "https://schema.org/InStock",
    "validFrom": "2026-05-01"
  },
  "organizer": {
    "@type": "Organization",
    "name": "Highland Consultancy",
    "url": "https://www.whiskyfestival.nl",
    "email": "info@whiskyfestival.nl"
  }
};

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "International Whisky Festival",
  "alternateName": "Whisky Fest",
  "url": "https://www.whiskyfestival.nl",
  "logo": "https://www.whiskyfestival.nl/assets/logo.png",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "",
    "contactType": "customer service",
    "email": "info@whiskyfestival.nl",
    "availableLanguage": ["Dutch", "English"]
  },
  "sameAs": [
    "https://www.facebook.com/whiskyfestivalnl",
    "https://www.instagram.com/whiskyfestivalnl"
  ]
};
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary Meta Tags -->
    <title>{title} | International Whisky Festival</title>
    <meta name="title" content={`${title} | International Whisky Festival`} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={`${title} | International Whisky Festival`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content={`${title} | International Whisky Festival`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Load Google Fonts (Plus Jakarta Sans and Rye as fallback display) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,700&family=Rye&display=swap" rel="stylesheet" />

    <!-- Adobe Fonts integration -->
    <link rel="stylesheet" href="https://use.typekit.net/ppq2zvf.css">

    <!-- SEO Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(eventSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <slot />

    <!-- FLOATING SOCIAL MEDIA DOCK (Compact) -->
    <aside class="floating-social-dock" aria-label="Social Media Links">
      <div class="dock-inner">
        <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="social-dock-link" aria-label="Volg ons op Instagram">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
          <span class="dock-tooltip">Instagram</span>
        </a>

        <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="social-dock-link" aria-label="Volg ons op Facebook">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
          </svg>
          <span class="dock-tooltip">Facebook</span>
        </a>

        <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="social-dock-link" aria-label="Bekijk ons YouTube kanaal">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"></path>
            <polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon>
          </svg>
          <span class="dock-tooltip">YouTube</span>
        </a>
      </div>
    </aside>

    <style is:global>
      /* FLOATING SOCIAL DOCK (COMPACT HORIZONTAL BOTTOM RIGHT) */
      .floating-social-dock {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 990;
        pointer-events: auto;
      }

      .dock-inner {
        display: flex;
        flex-direction: row;
        align-items: center;
        gap: 0.45rem;
        padding: 0.35rem 0.55rem;
        background: #FAF7F2;
        border: 2px solid #1E1C1A;
        outline: 1.5px solid #caac8e;
        outline-offset: -3.5px;
        border-radius: 40px;
        box-shadow: 
          0 6px 18px rgba(30, 28, 26, 0.22),
          0 2px 10px rgba(0, 0, 0, 0.12);
        transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      }

      .dock-inner:hover {
        outline-color: #1e6b48;
        box-shadow: 
          0 8px 24px rgba(30, 28, 26, 0.28),
          0 0 14px rgba(213, 194, 138, 0.3);
      }

      .social-dock-link {
        position: relative;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #1E1C1A;
        background: #ffffff;
        box-shadow: 0 1.5px 5px rgba(30, 28, 26, 0.12);
        transition: all 0.2s ease;
        text-decoration: none;
      }

      .social-dock-link:hover {
        color: #ffffff;
        background: #1e6b48;
        transform: translateY(-2px) scale(1.1);
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
      }

      .dock-tooltip {
        position: absolute;
        bottom: 42px;
        left: 50%;
        transform: translateX(-50%) translateY(-3px);
        background: #1E1C1A;
        color: #FAF7F2;
        font-family: var(--font-sans, system-ui, sans-serif);
        font-weight: 700;
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        padding: 0.25rem 0.55rem;
        border-radius: 4px;
        border: 1px solid #caac8e;
        white-space: nowrap;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: all 0.15s ease;
        box-shadow: 0 3px 10px rgba(0, 0, 0, 0.25);
      }

      .social-dock-link:hover .dock-tooltip {
        opacity: 1;
        visibility: visible;
        transform: translateX(-50%) translateY(0);
      }

      @media (max-width: 990px) {
        .floating-social-dock {
          display: none !important;
        }
      }
    </style>

    <!-- Global Mobile Bottom Sheet Cart Drawer -->
    <MobileCartDrawer />

    <!-- Real-time Live GHL Ticket & Standhouder Sync (Instant Realtime Updates from Leadfabriek CRM) -->
    <script is:inline>
      (function initRealtimeGhlSync() {
        var GHL_API_BASE = 'https://services.leadconnectorhq.com';
        var GHL_API_KEY = 'pit-150d6114-ac2c-4cf7-9d5c-ffc20499c790';
        var GHL_LOCATION_ID = '1OZ9uxIBFoxwbheVC5iN';

        function syncLiveTickets() {
          fetch(GHL_API_BASE + '/objects/custom_objects.festival_tickets/records/search', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + GHL_API_KEY,
              'Version': '2021-07-28',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              locationId: GHL_LOCATION_ID,
              page: 1,
              pageLimit: 250,
              filters: [{ field: 'properties.festival_city', operator: 'eq', value: 'den_haag' }],
              searchAfter: []
            })
          })
          .then(function(res) {
            if (!res.ok) return null;
            return res.json();
          })
          .then(function(data) {
            var records = (data && (data.customObjectRecords || data.records)) || [];
            if (records.length === 0) {
              // Fallback to fetch all and filter in memory
              return fetch(GHL_API_BASE + '/objects/custom_objects.festival_tickets/records/search', {
                method: 'POST',
                headers: {
                  'Authorization': 'Bearer ' + GHL_API_KEY,
                  'Version': '2021-07-28',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  locationId: GHL_LOCATION_ID,
                  page: 1,
                  pageLimit: 250,
                  searchAfter: []
                })
              })
              .then(function(fbRes) { return fbRes.ok ? fbRes.json() : null; })
              .then(function(fbData) {
                var allRecs = (fbData && (fbData.customObjectRecords || fbData.records)) || [];
                return allRecs.filter(function(r) {
                  var p = r.properties || r;
                  var c = String(p.festival_city || '').toLowerCase().trim();
                  return c === 'den_haag' || c === 'den haag' || c.indexOf('haag') !== -1;
                });
              });
            }
            return records;
          })
          .then(function(records) {
            if (!Array.isArray(records) || records.length === 0) return;

            window.__LIVE_GHL_TICKETS__ = records;
            var matchedCards = new Set();
            var matchedRows = new Set();

            records.forEach(function(r) {
              var p = r.properties || r;
              var rawTitle = p.title || '';
              var cleanTitle = rawTitle.replace(/\s*(?:1[0-9]|2[0-3]):[0-5][0-9]\s*[-–—]\s*(?:1[0-9]|2[0-3]):[0-5][0-9]\s*(?:uur)?/gi, '').trim();
              var priceNum = typeof p.price === 'number' ? p.price : (parseFloat(p.price) || parseFloat(p.ticket_price) || 0);
              var capacity = parseInt(p.capacity, 10) || 0;
              var sold = parseInt(p.sold, 10) || 0;
              var rawSoldOut = p.is_sold_out === true || p.is_sold_out === 'true' || p.is_sold_out === '1' || p.is_sold_out === 'ja' || p.is_sold_out === 'yes';
              var isSoldOut = rawSoldOut || (capacity > 0 && sold >= capacity);

              var rawDay = (p.day || '').toLowerCase().trim();
              var dateLabel = p.date_label || '';
              var timeLabel = p.time_label || '';
              var day = rawDay;
              if (!day || day === 'all') {
                if (dateLabel.toLowerCase().includes('vrijdag')) day = 'vrijdag';
                else if (dateLabel.toLowerCase().includes('zaterdag')) day = 'zaterdag';
                else if (dateLabel.toLowerCase().includes('zondag')) day = 'zondag';
                else day = 'all';
              }

              var daypart = (p.daypart || '').toLowerCase().trim();
              if (!daypart || daypart === 'all') {
                var hourMatch = timeLabel.match(/(\d{1,2}):\d{2}/);
                if (hourMatch) {
                  var startHour = parseInt(hourMatch[1], 10);
                  if (startHour < 12) daypart = 'ochtend';
                  else if (startHour < 18) daypart = 'middag';
                  else daypart = 'avond';
                } else {
                  daypart = 'all';
                }
              }

              var category = (p.category || '').toLowerCase().trim() || 'masterclass';

              var cleanDate = dateLabel;
              if (day === 'vrijdag' || (cleanDate.toLowerCase().includes('vrijdag') && (cleanDate.includes('13') || cleanDate.toLowerCase().includes('13 nov')))) {
                cleanDate = 'VRIJDAG 13 NOV';
              } else if (day === 'zaterdag' || (cleanDate.toLowerCase().includes('zaterdag') && (cleanDate.includes('14') || cleanDate.toLowerCase().includes('14 nov')))) {
                cleanDate = 'ZATERDAG 14 NOV';
              } else if (day === 'zondag' || (cleanDate.toLowerCase().includes('zondag') && (cleanDate.includes('15') || cleanDate.toLowerCase().includes('15 nov')))) {
                cleanDate = 'ZONDAG 15 NOV';
              } else {
                cleanDate = cleanDate.replace(/ 2026/g, '').toUpperCase();
              }

              var cleanTime = timeLabel;
              if (cleanTime && !cleanTime.toLowerCase().includes('uur')) {
                cleanTime = cleanTime + ' uur';
              }

              var cleanLoc = (p.location || '')
                .replace(/\s*\(Grote Kerk Den Haag\)/gi, '')
                .replace(/\s*Grote Kerk/gi, '')
                .trim();
              if (/melden bij entree-deur/i.test(cleanLoc)) cleanLoc = 'Entree-deur';
              if (/afhalen bij festival slijterij/i.test(cleanLoc)) cleanLoc = 'Festival Slijterij';
              var accessText = category === 'entree' ? '1 PERSOON' :
                category === 'botteling' ? '1 FLES (70CL)' :
                (cleanLoc ? cleanLoc.toUpperCase() : 'GROTE KERK DEN HAAG');

              // Sync in-memory tickets array
              if (Array.isArray(window.denHaagTicketsData)) {
                var existingIdx = window.denHaagTicketsData.findIndex(function(t) { return t.id === r.id; });
                var ticketObj = {
                  id: r.id,
                  title: cleanTitle,
                  price: priceNum,
                  date: dateLabel || cleanDate,
                  time: cleanTime,
                  day: day,
                  daypart: daypart,
                  category: category,
                  location: p.location || 'Grote Kerk Den Haag',
                  isSoldOut: isSoldOut,
                  description: p.ticket_description || p.description || '',
                  extra: p.ticket_description || p.description || '',
                  ambassadorName: p.ambassador_name || '',
                  ambassadorTitle: p.ambassador_title || '',
                  ambassadorBio: p.ambassador_bio || '',
                  tastingLineup: p.tasting_lineup ? (Array.isArray(p.tasting_lineup) ? p.tasting_lineup : String(p.tasting_lineup).split(/[\n,]+/).map(function(s){ return s.trim(); }).filter(Boolean)) : []
                };
                if (existingIdx !== -1) {
                  window.denHaagTicketsData[existingIdx] = Object.assign(window.denHaagTicketsData[existingIdx], ticketObj);
                } else {
                  window.denHaagTicketsData.push(ticketObj);
                }
              }

              // 1. Homepage ticket stubs
              var cardFound = false;
              var allCards = document.querySelectorAll('.ticket-stub');
              allCards.forEach(function(card) {
                var cardId = card.getAttribute('data-ticket-id');
                var cardTitle = (card.getAttribute('data-title') || '').toLowerCase().replace(/[^a-z0-9]/g, '');
                var matchKey = cleanTitle.toLowerCase().replace(/[^a-z0-9]/g, '');
                var isMatch = (cardId && cardId === r.id) || (cardTitle && matchKey && (cardTitle.indexOf(matchKey) !== -1 || matchKey.indexOf(cardTitle) !== -1));

                if (isMatch) {
                  cardFound = true;
                  matchedCards.add(card);
                  card.setAttribute('data-ticket-id', r.id);
                  card.setAttribute('data-title', cleanTitle);
                  card.setAttribute('data-price', String(priceNum));
                  card.setAttribute('data-soldout', isSoldOut ? 'true' : 'false');
                  if (day) card.setAttribute('data-day', day);
                  if (daypart) card.setAttribute('data-daypart', daypart);
                  if (category) card.setAttribute('data-category', category);
                  card.setAttribute('data-date', dateLabel || cleanDate);
                  card.setAttribute('data-time', cleanTime);

                  var titleEl = card.querySelector('.ticket-title');
                  if (titleEl) {
                    titleEl.textContent = cleanTitle;
                    titleEl.setAttribute('title', cleanTitle);
                  }

                  var priceParts = priceNum.toFixed(2).split('.');
                  var priceValEl = card.querySelector('.price-val');
                  var priceCentsEl = card.querySelector('.price-cents');
                  if (priceValEl) priceValEl.textContent = priceParts[0];
                  if (priceCentsEl) priceCentsEl.textContent = ',' + priceParts[1];

                  var metaCols = card.querySelectorAll('.ticket-meta-grid .meta-col');
                  if (metaCols.length >= 1) {
                    var dateVal = metaCols[0].querySelector('.meta-col-val');
                    if (dateVal && cleanDate) dateVal.textContent = cleanDate;
                  }
                  if (metaCols.length >= 2) {
                    var timeVal = metaCols[1].querySelector('.meta-col-val');
                    if (timeVal && cleanTime) timeVal.textContent = cleanTime;
                  }
                  if (metaCols.length >= 3) {
                    var locVal = metaCols[2].querySelector('.meta-col-val');
                    if (locVal && accessText) locVal.textContent = accessText;
                  }

                  if (isSoldOut) {
                    card.classList.add('ticket-sold-out');
                    var qtySel = card.querySelector('.qty-selector');
                    if (qtySel) {
                      var soldBox = card.querySelector('.sold-out-box');
                      if (!soldBox) {
                        var newSold = document.createElement('div');
                        newSold.className = 'sold-out-box';
                        newSold.innerHTML = '<span class="sold-out-text">UITVERKOCHT</span>';
                        qtySel.replaceWith(newSold);
                      }
                    }
                  } else {
                    card.classList.remove('ticket-sold-out');
                  }
                }
              });

              // Dynamically inject brand-new ticket card if not present in DOM
              if (!cardFound && category !== 'standhouder') {
                var ticketsListContainer = document.getElementById('shop-tickets-list');
                if (ticketsListContainer) {
                  var showMoreContainer = document.getElementById('show-more-container');
                  var newCard = document.createElement('div');
                  newCard.className = 'ticket-stub filterable-ticket' + (isSoldOut ? ' ticket-sold-out' : '');
                  newCard.setAttribute('data-ticket-id', r.id);
                  newCard.setAttribute('data-price', String(priceNum));
                  newCard.setAttribute('data-title', cleanTitle);
                  newCard.setAttribute('data-category', category);
                  newCard.setAttribute('data-daypart', daypart);
                  newCard.setAttribute('data-soldout', isSoldOut ? 'true' : 'false');
                  newCard.setAttribute('data-day', day);
                  newCard.setAttribute('data-date', dateLabel || cleanDate);
                  newCard.setAttribute('data-time', cleanTime);

                  var priceParts = priceNum.toFixed(2).split('.');
                  var serialNo = Math.floor(Math.random() * 90000) + 10000;
                  var titleLen = cleanTitle.length;
                  var titleSizeClass = titleLen > 38 ? 'title-sm' : (titleLen > 28 ? 'title-md' : 'title-lg');

                  newCard.innerHTML =
                    '<div class="ticket-inner-border"></div>' +
                    '<div class="ticket-serial">' +
                      '<span class="serial-no">NO. ' + serialNo + '</span>' +
                      '<div class="barcode"></div>' +
                    '</div>' +
                    '<div class="ticket-body">' +
                      '<div class="ticket-top-meta">' +
                        '<span class="ticket-fest-subtitle">INTERNATIONAAL WHISKY FESTIVAL</span>' +
                      '</div>' +
                      '<h3 class="ticket-title ' + titleSizeClass + '" title="' + cleanTitle + '">' + cleanTitle + '</h3>' +
                      '<div class="ticket-meta-grid">' +
                        '<div class="meta-col"><span class="meta-col-label">DATUM</span><strong class="meta-col-val">' + cleanDate + '</strong></div>' +
                        '<div class="meta-col"><span class="meta-col-label">TIJD</span><strong class="meta-col-val">' + cleanTime + '</strong></div>' +
                        '<div class="meta-col"><span class="meta-col-label">LOCATIE</span><strong class="meta-col-val">' + accessText + '</strong></div>' +
                      '</div>' +
                      '<div class="ticket-info-row">' +
                        '<button type="button" class="btn-mc-info-trigger" data-mc-id="' + r.id + '" aria-label="Bekijk meer informatie">' +
                          '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>' +
                          'Meer info &rarr;' +
                        '</button>' +
                      '</div>' +
                    '</div>' +
                    '<div class="ticket-divider"></div>' +
                    '<div class="ticket-stub-end">' +
                      '<span class="stub-label">' + (category === 'botteling' ? 'PRIJS PER FLES' : 'PRIJS P.P.') + '</span>' +
                      '<div class="ticket-price-block">' +
                        '<span class="price-currency">&euro;</span>' +
                        '<span class="price-val">' + priceParts[0] + '</span>' +
                        '<span class="price-cents">,' + priceParts[1] + '</span>' +
                      '</div>' +
                      (isSoldOut ? 
                        '<div class="sold-out-box"><span class="sold-out-text">UITVERKOCHT</span></div>' :
                        '<div class="qty-selector">' +
                          '<button type="button" class="qty-btn minus-btn" data-action="minus" aria-label="Aantal verlagen" disabled>&minus;</button>' +
                          '<span class="qty-val" id="qty-' + r.id + '">0</span>' +
                          '<button type="button" class="qty-btn plus-btn" data-action="plus" aria-label="Aantal verhogen">&plus;</button>' +
                        '</div>'
                      ) +
                    '</div>';

                  if (showMoreContainer) {
                    ticketsListContainer.insertBefore(newCard, showMoreContainer);
                  } else {
                    ticketsListContainer.appendChild(newCard);
                  }
                  matchedCards.add(newCard);
                }
              }

              // 2. Programma timetable rows
              // Non-agenda items (entree tickets, bottelings, standhouders) NEVER belong in the timetable
              if (category === 'entree' || category === 'standhouders' || category === 'standhouder' || category === 'botteling') {
                return;
              }

              var rowFound = false;
              var allRows = document.querySelectorAll('.agenda-row-item');
              allRows.forEach(function(row) {
                var btn = row.querySelector('.btn-table-buy');
                var detailsBtn = row.querySelector('.btn-trigger-details');
                var rowId = row.getAttribute('data-ticket-id') || (btn ? btn.getAttribute('data-ticket-id') : '');
                var rowTitle = (row.querySelector('.item-name')?.textContent || '').toLowerCase().replace(/[^a-z0-9]/g, '');
                var matchKey = cleanTitle.toLowerCase().replace(/[^a-z0-9]/g, '');

                var rowPane = row.closest('.session-agenda-pane');
                var rowPaneId = rowPane ? rowPane.id : '';
                var rowTimeVal = (row.querySelector('.item-time-val')?.textContent || '').trim();
                var rowDaySub = (row.querySelector('.item-day-sub')?.textContent || '').toLowerCase();

                var dayMatches = !day || day === 'all' || rowPaneId.indexOf(day) !== -1 || (rowPaneId === 'pane-belevingen' && (!rowDaySub || rowDaySub.indexOf(day) !== -1));

                var cleanTimeStart = cleanTime ? cleanTime.split(/[-–]/)[0].replace(/[^0-9:]/g, '').trim() : '';
                var rowTimeStart = rowTimeVal ? rowTimeVal.split(/[-–]/)[0].replace(/[^0-9:]/g, '').trim() : '';
                var timeMatches = !cleanTimeStart || !rowTimeStart || cleanTimeStart === rowTimeStart || cleanTime.indexOf(rowTimeStart) !== -1 || rowTimeVal.indexOf(cleanTimeStart) !== -1;

                var isIdMatch = Boolean(rowId && rowId === r.id);
                var isTitleMatch = Boolean(rowTitle && matchKey && (rowTitle === matchKey || rowTitle.indexOf(matchKey) !== -1 || matchKey.indexOf(rowTitle) !== -1));

                var isMatch = isIdMatch || (isTitleMatch && dayMatches && timeMatches);

                if (isMatch) {
                  rowFound = true;
                  matchedRows.add(row);
                  row.setAttribute('data-ticket-id', r.id);
                  var nameEl = row.querySelector('.item-name');
                  if (nameEl) nameEl.textContent = cleanTitle;

                  var timeEl = row.querySelector('.item-time-val');
                  if (timeEl && cleanTime && (isIdMatch || (dayMatches && timeMatches))) {
                    timeEl.textContent = cleanTime;
                  }

                  var priceEl = row.querySelector('.item-price');
                  if (priceEl) priceEl.textContent = '€ ' + priceNum.toFixed(2).replace('.', ',');

                  if (btn) {
                    btn.setAttribute('data-ticket-id', r.id);
                    btn.setAttribute('data-title', cleanTitle);
                    if (isSoldOut) {
                      btn.className = 'btn btn-gold btn-table-buy sold-out';
                      btn.disabled = true;
                      btn.textContent = 'Uitverkocht';
                    } else {
                      btn.className = 'btn btn-gold btn-table-buy';
                      btn.disabled = false;
                      btn.textContent = '+ Bestel';
                    }
                  }

                  if (detailsBtn) {
                    detailsBtn.setAttribute('data-title', cleanTitle);
                    if (cleanTime) detailsBtn.setAttribute('data-time', cleanTime);
                    detailsBtn.setAttribute('data-price', '€ ' + priceNum.toFixed(2).replace('.', ','));
                    if (p.ticket_description || p.description) {
                      detailsBtn.setAttribute('data-desc', p.ticket_description || p.description);
                    }
                    if (p.ambassador_name) {
                      var hostStr = p.ambassador_name + (p.ambassador_title ? ' — ' + p.ambassador_title : '');
                      detailsBtn.setAttribute('data-host', hostStr);
                    }
                  }

                  // NEVER move rows between panes on the client side!
                }
              });

              // Dynamically inject brand-new agenda row ONLY if it is an actual masterclass or workshop
              if (!rowFound && (category === 'masterclass' || category === 'workshop') && day && day !== 'all' && daypart && daypart !== 'all') {
                var targetPaneId = 'pane-' + day + '-' + daypart;
                var targetPane = document.getElementById(targetPaneId);
                if (targetPane) {
                  var targetList = targetPane.querySelector('.pane-rows-list');
                  if (targetList) {
                    var newRow = document.createElement('article');
                    newRow.className = 'agenda-row-item';
                    newRow.setAttribute('data-ticket-id', r.id);
                    newRow.innerHTML = 
                      '<div class="col-time"><span class="item-time-val">' + cleanTime + '</span></div>' +
                      '<div class="col-title"><h3 class="item-name">' + cleanTitle + '</h3></div>' +
                      '<div class="col-type-loc">' +
                        '<span class="cat-pill cat-' + category + '">' + (category.charAt(0).toUpperCase() + category.slice(1)) + '</span>' +
                        '<span class="item-loc-tag">' +
                          '<svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>' +
                          (p.location || 'Grote Kerk') +
                        '</span>' +
                      '</div>' +
                      '<div class="col-speaker"><div class="speaker-block"><strong class="speaker-name">' + (p.ambassador_name || '—') + '</strong>' +
                        (p.ambassador_title ? '<span class="speaker-role">' + p.ambassador_title + '</span>' : '') +
                      '</div></div>' +
                      '<div class="col-action">' +
                        '<strong class="item-price">&euro; ' + priceNum.toFixed(2).replace('.', ',') + '</strong>' +
                        '<div class="action-buttons-group">' +
                          '<button type="button" class="btn-trigger-details" data-title="' + cleanTitle + '" data-loc="' + (p.location || '') + '" data-time="' + cleanTime + '" data-price="&euro; ' + priceNum.toFixed(2).replace('.', ',') + '" data-desc="' + (p.ticket_description || p.description || '') + '" data-host="' + (p.ambassador_name || '') + '">Details</button>' +
                          (isSoldOut ? 
                            '<button type="button" class="btn btn-gold btn-table-buy sold-out" disabled>Uitverkocht</button>' :
                            '<button type="button" class="btn btn-gold btn-table-buy" data-ticket-id="' + r.id + '" data-title="' + cleanTitle + '">+ Bestel</button>'
                          ) +
                        '</div>' +
                      '</div>';
                    targetList.appendChild(newRow);
                    matchedRows.add(newRow);
                  }
                }
              }
            });

            // DELETION SYNC: Prune ticket stubs deleted from GHL
            var allDomCards = document.querySelectorAll('#shop-tickets-list .ticket-stub');
            allDomCards.forEach(function(card) {
              if (!matchedCards.has(card)) {
                var cardId = card.getAttribute('data-ticket-id');
                // Remove from shopping cart if present
                try {
                  var rawCart = localStorage.getItem('whiskyfest_cart');
                  if (rawCart) {
                    var parsedCart = JSON.parse(rawCart);
                    if (cardId && parsedCart[cardId]) {
                      delete parsedCart[cardId];
                      localStorage.setItem('whiskyfest_cart', JSON.stringify(parsedCart));
                      window.dispatchEvent(new CustomEvent('cart-updated', { detail: parsedCart }));
                    }
                  }
                } catch(e) {}

                // Remove from in-memory ticket dataset
                if (Array.isArray(window.denHaagTicketsData)) {
                  window.denHaagTicketsData = window.denHaagTicketsData.filter(function(t) {
                    return t.id !== cardId;
                  });
                }
                card.remove();
              }
            });

            // DELETION SYNC: Prune timetable rows deleted from GHL
            var allDomRows = document.querySelectorAll('.agenda-row-item');
            allDomRows.forEach(function(row) {
              var rowId = row.getAttribute('data-ticket-id') || '';
              var isGhlTicket = rowId && (rowId.length > 15 || rowId.startsWith('ghl-'));
              if (!matchedRows.has(row) && isGhlTicket) {
                row.remove();
              }
            });

            // Re-apply active filters on the homepage
            if (typeof window.__applyTicketFilters === 'function') {
              window.__applyTicketFilters();
            }

            // Dispatch global tickets updated event
            window.dispatchEvent(new CustomEvent('ghl:tickets-updated', { detail: records }));
          })
          .catch(function(err) {
            // Silently fall back to pre-rendered HTML
          });
        }

        function syncLiveStands() {
          fetch(GHL_API_BASE + '/objects/custom_objects.festival_standhouders/records/search', {
            method: 'POST',
            headers: {
              'Authorization': 'Bearer ' + GHL_API_KEY,
              'Version': '2021-07-28',
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({
              locationId: GHL_LOCATION_ID,
              page: 1,
              pageLimit: 250,
              filters: [{ field: 'properties.festival_city', operator: 'eq', value: 'den_haag' }],
              searchAfter: []
            })
          })
          .then(function(res) {
            if (!res.ok) return null;
            return res.json();
          })
          .then(function(data) {
            var records = (data && (data.customObjectRecords || data.records)) || [];
            if (records.length === 0) {
              return fetch(GHL_API_BASE + '/objects/custom_objects.festival_standhouders/records/search', {
                method: 'POST',
                headers: {
                  'Authorization': 'Bearer ' + GHL_API_KEY,
                  'Version': '2021-07-28',
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                  locationId: GHL_LOCATION_ID,
                  page: 1,
                  pageLimit: 250,
                  searchAfter: []
                })
              })
              .then(function(fbRes) { return fbRes.ok ? fbRes.json() : null; })
              .then(function(fbData) {
                var allRecs = (fbData && (fbData.customObjectRecords || fbData.records)) || [];
                return allRecs.filter(function(r) {
                  var p = r.properties || r;
                  var c = String(p.festival_city || '').toLowerCase().trim();
                  return c === 'den_haag' || c === 'den haag' || c.indexOf('haag') !== -1;
                });
              });
            }
            return records;
          })
          .then(function(records) {
            if (!Array.isArray(records) || records.length === 0) return;

            window.__LIVE_GHL_STANDS__ = records;
            window.dispatchEvent(new CustomEvent('ghl:stands-updated', { detail: records }));
          })
          .catch(function(err) {});
        }

        function syncAll() {
          syncLiveTickets();
          syncLiveStands();
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', syncAll);
        } else {
          syncAll();
        }
        window.addEventListener('focus', syncAll);
        setInterval(syncAll, 10000);
      })();
    </script>
  </body>
</html>
