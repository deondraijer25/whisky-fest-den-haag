      /* Authentic Left & Right Semicircle Stans-Notches at the Divider */
      --notch: 12px;
      --stub-h: 68px;
      -webkit-mask:
        radial-gradient(circle var(--notch) at 0 calc(100% - var(--stub-h)),    transparent 98%, #000) left / 51% 100% no-repeat,
        radial-gradient(circle var(--notch) at 100% calc(100% - var(--stub-h)), transparent 98%, #000) right / 51% 100% no-repeat !important;
      mask:
        radial-gradient(circle var(--notch) at 0 calc(100% - var(--stub-h)),    transparent 98%, #000) left / 51% 100% no-repeat,
        radial-gradient(circle var(--notch) at 100% calc(100% - var(--stub-h)), transparent 98%, #000) right / 51% 100% no-repeat !important;
    }

    .ticket-inner-border {
      display: block !important;
      position: absolute !important;
      top: 6px !important;
      bottom: 6px !important;
      left: 6px !important;
      right: 6px !important;
      border: 1.5px solid rgba(160, 140, 110, 0.45) !important;
