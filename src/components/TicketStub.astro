  }

  /* Horizontal 3-Column Metadata Row (STRICT HORIZONTAL 3 COLUMNS) */
  .ticket-meta-grid {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-end !important;
    gap: 2.25rem !important;
    margin-top: 0.15rem !important;
