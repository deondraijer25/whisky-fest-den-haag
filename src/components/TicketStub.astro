  }

  .status-badge {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif) !important;
    font-weight: 800 !important;
    font-size: 0.65rem !important;
    padding: 0.2rem 0.65rem !important;
    border: 1.5px solid #9C8262 !important;
    color: #7A6348 !important;
    text-transform: uppercase !important;
    border-radius: 20px !important;
    letter-spacing: 0.08em !important;
    background: transparent !important;
    line-height: 1 !important;
  }

  /* Calm Clean Sans-Serif Title (Plus Jakarta Sans) */
  .ticket-title {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif) !important;
    font-weight: 800 !important;
    line-height: 1.2 !important;
    color: #171614 !important;
    letter-spacing: -0.015em !important;
    margin: 0.35rem 0 !important;
    cursor: pointer !important;
    transition: color 0.15s ease !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
  }

  .ticket-title.title-lg { font-size: 1.45rem !important; }
