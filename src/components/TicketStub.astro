  /* Vertical Perforation Divider */
  .ticket-divider {
    width: 0 !important;
    flex-shrink: 0 !important;
    border-left: 2px dashed rgba(160, 140, 110, 0.45) !important;
    z-index: 2 !important;
  }

  /* Right Stub: Price & Controls */
  .ticket-stub-end {
    width: 175px !important;
    flex-shrink: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 1.25rem 0.75rem !important;
    gap: 0.65rem !important;
    z-index: 2 !important;
    box-sizing: border-box !important;
    text-align: center !important;
  }

  .stub-label {
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif) !important;
    font-size: 0.68rem !important;
    font-weight: 700 !important;
    letter-spacing: 0.1em !important;
    color: #9C8262 !important;
    text-transform: uppercase !important;
    line-height: 1 !important;
    margin: 0 !important;
  }

  /* Clean Sans-Serif Price (Plus Jakarta Sans) */
  .ticket-price-block {
    display: flex !important;
    align-items: baseline !important;
    justify-content: center !important;
    color: #006448 !important;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif) !important;
    line-height: 1 !important;
    margin: 0 !important;
  }

  .price-currency {
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    margin-right: 2px !important;
    line-height: 1 !important;
  }

