---
// src/components/TicketStub.astro
interface Props {
  id: string;
  title: string;
  price: number;
  date: string;
  time: string;
  status?: 'limited' | 'selling-fast' | 'popular' | 'sold-out';
  statusText?: string;
  included?: string[];
  category?: 'entree' | 'tram' | 'botteling' | 'masterclass' | 'trail' | 'vatenmaken' | 'warehouse';
  description?: string;
  options?: string[];
  extraMeta?: string;
  location?: string;
  bookingType?: string;
  daypart?: 'ochtend' | 'middag' | 'avond' | 'all';
  isSoldOut?: boolean;
}

const { 
  id, 
  title, 
  price, 
  date, 
  time, 
  status, 
  statusText, 
  included = [], 
  category = 'entree',
  description,
  options = [],
  extraMeta,
  location,
  bookingType,
  daypart = 'all',
  isSoldOut = false
} = Astro.props;

const soldOut = isSoldOut || status === 'sold-out';

const festivalSubtitle = "INTERNATIONAAL WHISKY FESTIVAL";

// Clean date display (e.g. "VRIJDAG 13 NOV")
let cleanDate = date;
if (date.toLowerCase().includes('vrijdag') && (date.includes('13') || date.toLowerCase().includes('13 nov'))) {
  cleanDate = 'VRIJDAG 13 NOV';
} else if (date.toLowerCase().includes('zaterdag') && (date.includes('14') || date.toLowerCase().includes('14 nov'))) {
  cleanDate = 'ZATERDAG 14 NOV';
} else if (date.toLowerCase().includes('zondag') && (date.includes('15') || date.toLowerCase().includes('15 nov'))) {
  cleanDate = 'ZONDAG 15 NOV';
} else {
  cleanDate = date.replace(/ 2026/g, '').toUpperCase();
}

// Clean access / location display
const accessText = 
  category === 'entree' ? '1 PERSOON' :
  category === 'botteling' ? '1 FLES (70CL)' :
  (location || (extraMeta ? extraMeta.toUpperCase() : 'GROTE KERK'));

// Clean time format
const cleanTime = time.toLowerCase().includes('uur') ? time : (time + ' uur');

// Clean price parts
const priceParts = price.toFixed(2).split('.');
const priceVal = priceParts[0];
const priceCents = priceParts[1];

// Auto-derive status text if not provided for key tickets
const derivedStatusText = statusText || (
  title.toLowerCase().includes('vip') ? 'EXCLUSIEF' :
  (status === 'selling-fast' ? 'SNEL UITVERKOCHT' :
   status === 'popular' ? 'POPULAIR' :
   status === 'limited' ? 'LAATSTE KAARTEN' : undefined)
);

// Dynamic font size classes for single-line title guarantee
const titleLength = title.length;
const titleSizeClass = 
  titleLength > 38 ? 'title-sm' :
  titleLength > 28 ? 'title-md' : 'title-lg';
---

<!-- Warm Cream Vintage Ticket Stub -->
<div 
  class={"ticket-stub filterable-ticket " + (status || '') + (soldOut ? ' ticket-sold-out' : '')}
  data-ticket-id={id}
  data-price={price}
  data-title={title}
  data-category={category}
  data-daypart={daypart}
  data-soldout={soldOut ? 'true' : 'false'}
  data-day={
    date.toLowerCase().includes('vrijdag') ? 'vrijdag' :
    date.toLowerCase().includes('zaterdag') ? 'zaterdag' :
    date.toLowerCase().includes('zondag') ? 'zondag' : 'all'
  }
>
  <!-- Inner art-deco double border -->
  <div class="ticket-inner-border"></div>
  
  <!-- Left: Fake Barcode / Serial (Vertical) -->
  <div class="ticket-serial">
    <span class="serial-no">NO. {Math.floor(Math.random() * 90000) + 10000}</span>
    <div class="barcode"></div>
  </div>

  <!-- Middle: Main Ticket Body -->
  <div class="ticket-body">
    <!-- Top Bar: Festival Header (left) + Pill Badge if applicable (right) -->
    <div class="ticket-top-meta">
      <span class="ticket-fest-subtitle">{festivalSubtitle}</span>
      {derivedStatusText && !soldOut && (
        <span class={"status-badge " + (status || '')}>{derivedStatusText}</span>
      )}
    </div>
    
    <!-- Clean Calm Display Title in Plus Jakarta Sans -->
    <h3 class={"ticket-title " + titleSizeClass} title={title}>{title}</h3>
    
    <!-- Row 1: 3-Column Horizontal Metadata Strip (Datum | Tijd | Toegang/Locatie) -->
    <div class="ticket-meta-grid">
      <div class="meta-col">
        <span class="meta-col-label">DATUM</span>
        <strong class="meta-col-val">{cleanDate}</strong>
      </div>
      <div class="meta-col">
        <span class="meta-col-label">TIJD</span>
        <strong class="meta-col-val">{cleanTime}</strong>
      </div>
      <div class="meta-col">
        <span class="meta-col-label">{category === 'entree' ? 'TOEGANG' : 'LOCATIE'}</span>
        <strong class="meta-col-val">{accessText}</strong>
      </div>
    </div>

    <!-- Row 2: Next line Meer info link -->
    <div class="ticket-info-row">
      <button type="button" class="btn-mc-info-trigger" data-mc-id={id} aria-label="Bekijk meer informatie">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" style="vertical-align: -1px; margin-right: 4px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        Meer info &rarr;
      </button>
    </div>
  </div>

  <!-- Vertical Perforation Divider with Semicircle Cutouts -->
  <div class="ticket-divider"></div>

  <!-- Right: Stub / Price & Action -->
  <div class="ticket-stub-end">
    <span class="stub-label">{category === 'botteling' ? 'PRIJS PER FLES' : 'PRIJS P.P.'}</span>
    
    <!-- Clean Sans-Serif Price Block in Plus Jakarta Sans -->
    <div class="ticket-price-block">
      <span class="price-currency">&euro;</span>
      <span class="price-val">{priceVal}</span>
      <span class="price-cents">,{priceCents}</span>
    </div>

    {soldOut ? (
      <div class="sold-out-box">
        <span class="sold-out-text">UITVERKOCHT</span>
      </div>
    ) : (
      <!-- Quantity Controls (Clean Soft Cream Stepper) -->
      <div class="qty-selector">
        <button type="button" class="qty-btn minus-btn" aria-label="Aantal verlagen" data-action="minus">&minus;</button>
        <span class="qty-val" id={"qty-" + id}>0</span>
        <button type="button" class="qty-btn plus-btn" aria-label="Aantal verhogen" data-action="plus">&plus;</button>
      </div>
    )}
  </div>
</div>

<style>
  /* Vintage Ticket Stub Layout */
  .ticket-stub {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    width: 100% !important;
    min-height: 155px !important;
    background-color: #E2EAE6 !important;
    color: #171614 !important;
    border: none !important;
    position: relative !important;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.12) !important;
    border-radius: 12px !important;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1) !important;
    box-sizing: border-box !important;

    /* Semicircle notches via CSS mask */
    --notch: 14px;
    --stub-w: 175px;
    -webkit-mask:
      radial-gradient(circle var(--notch) at calc(100% - var(--stub-w)) 0,    transparent 98%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle var(--notch) at calc(100% - var(--stub-w)) 100%, transparent 98%, #000) bottom / 100% 51% no-repeat !important;
    mask:
      radial-gradient(circle var(--notch) at calc(100% - var(--stub-w)) 0,    transparent 98%, #000) top / 100% 51% no-repeat,
