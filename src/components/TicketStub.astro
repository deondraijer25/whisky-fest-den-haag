      transparent 4px,
      #8C9C95 4px,
      #8C9C95 6px,
      transparent 6px,
      transparent 8px,
      #8C9C95 8px,
      #8C9C95 11px,
      transparent 11px,
      transparent 13px,
      #8C9C95 13px,
      #8C9C95 14px,
      transparent 14px,
      transparent 16px
