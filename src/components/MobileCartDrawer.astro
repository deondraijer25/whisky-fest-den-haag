---
// src/components/MobileCartDrawer.astro
// Reusable Mobile Slide-Up Bottom Sheet Cart & Phased Add-ons Drawer (< 990px)
import { getTickets } from '../lib/ghl';

interface Props {
  city?: string;
}

const { city = 'den_haag' } = Astro.props;
const allTickets = await getTickets(city);
const addonsList = allTickets.filter(t => t.category !== 'entree');
---

<!-- ==========================================
     MOBILE SLIDE-UP BOTTOM SHEET (< 990px)
     Unified Cart Overview & In-Drawer Add-ons
     ========================================== -->
<div class="mobile-bottom-sheet-overlay" id="mobile-cart-sheet-overlay" style="display: none;">
  <div class="mobile-bottom-sheet-backdrop" id="mobile-cart-sheet-backdrop"></div>
  <div class="mobile-bottom-sheet" id="mobile-cart-sheet">
    
    <!-- Top Drag Handle -->
    <div class="sheet-drag-handle-wrap" id="mobile-sheet-drag-handle">
      <div class="sheet-drag-handle"></div>
    </div>

    <!-- VIEW 1: CART / TICKETS OVERVIEW -->
    <div class="sheet-view sheet-view-cart is-active" id="sheet-view-cart">
      <div class="sheet-head sheet-head-compact">
        <span class="sheet-step-badge">1. Bestelling</span>
        <h3 class="sheet-title-compact">Jouw Bestelling</h3>
        <button type="button" class="sheet-close-btn" id="sheet-close-btn-cart" aria-label="Sluiten">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Scrollable Cart Items List -->
      <div class="sheet-cart-list" id="sheet-cart-list">
        <!-- Dynamically populated via JS -->
      </div>

      <!-- Empty Cart Notice -->
      <div class="sheet-empty-state" id="sheet-cart-empty" style="display: none;">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#8C7853" stroke-width="1.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
        <p style="font-weight: 800; color: #171614; margin: 0.5rem 0 0.2rem; font-family: var(--font-sans);">Uw winkelmandje is nog leeg</p>
        <span style="font-size: 0.85rem; color: #665C54;">Kies een sessie of masterclass om te beginnen.</span>
      </div>

      <!-- Cart Summary Footer -->
      <div class="sheet-footer" id="sheet-cart-footer">
        <div class="sheet-calc-rows">
          <div class="sheet-calc-row">
            <span>Subtotaal:</span>
            <strong id="sheet-cart-subtotal">&euro;0,00</strong>
          </div>
          <div class="sheet-calc-row">
            <span>Administratiekosten:</span>
            <strong id="sheet-cart-fee">&euro;0,00</strong>
          </div>
          <div class="sheet-calc-row" id="sheet-shipping-row" style="display: none;">
            <span>Verzendkosten Fles:</span>
            <strong id="sheet-cart-shipping">&euro;0,00</strong>
          </div>
          <div class="sheet-calc-row sheet-total-row">
            <span>Totaal:</span>
            <strong id="sheet-cart-total">&euro;0,00</strong>
          </div>
        </div>

        <button type="button" class="btn btn-gold sheet-cta-btn" id="sheet-to-addons-btn">
          <span>Afrekenen &rarr;</span>
        </button>
      </div>
    </div>

    <!-- VIEW 2: ADD-ONS & EXTRA'S -->
    <div class="sheet-view sheet-view-addons" id="sheet-view-addons" style="display: none;">
      <div class="sheet-head sheet-head-compact">
        <button type="button" class="sheet-back-btn" id="sheet-back-to-cart-btn" aria-label="Terug naar overzicht">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"></polyline></svg>
          <span>Terug</span>
        </button>
        <h3 class="sheet-title-compact">Add-ons &amp; Extra's</h3>
        <button type="button" class="sheet-close-btn" id="sheet-close-btn-addons" aria-label="Sluiten">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
      </div>

      <!-- Compact Dual-Filter Row (Day + Category) -->
      <div class="sheet-filter-bar" id="sheet-filter-bar">
        <div class="sheet-select-wrap">
          <svg class="sheet-select-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
          <select class="sheet-filter-select" id="sheet-filter-day" aria-label="Filter op dag">
            <option value="all">Alle festivaldagen</option>
            <option value="vrijdag">Vrijdag</option>
            <option value="zaterdag">Zaterdag</option>
            <option value="zondag">Zondag</option>
          </select>
        </div>
        <div class="sheet-select-wrap">
          <svg class="sheet-select-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"></polygon></svg>
          <select class="sheet-filter-select" id="sheet-filter-cat" aria-label="Filter op categorie">
            <option value="all">Alle extra's</option>
            <option value="masterclass">Masterclasses</option>
            <option value="warehouse">Warehouse Tastings</option>
            <option value="tram">Whiskytram</option>
            <option value="trail">Whiskytrails</option>
            <option value="vatenmaken">Workshops</option>
            <option value="botteling">Festival Botteling</option>
          </select>
        </div>
      </div>

      <!-- Addons Scrollable Card List -->
      <div class="sheet-addons-list" id="sheet-addons-list">
        <!-- Populated dynamically via JS -->
      </div>

      <!-- Addons Footer Action: Side by Side! -->
      <div class="sheet-footer sheet-footer-inline">
        <button type="button" class="sheet-skip-link-btn" id="sheet-skip-addons-btn">Overslaan &rarr;</button>
        <button type="button" class="btn btn-gold sheet-cta-btn sheet-cta-btn-flex" id="sheet-final-checkout-btn">
          <span id="sheet-final-checkout-text">Afrekenen (€ 0,00) &rarr;</span>
        </button>
      </div>
    </div>

  </div>
</div>

<!-- ==========================================
     GLOBAL MOBILE STICKY CHECKOUT BAR (< 990px)
     Always visible when 1+ items in cart, hides when empty
     ========================================== -->
<div class="mobile-sticky-checkout-bar" id="mobile-sticky-checkout-bar">
  <div class="mscb-inner" id="mscb-inner-tap-target">
    <div class="mscb-left">
      <div class="mscb-icon-wrap">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
      </div>
      <div class="mscb-text">
        <span class="mscb-count" id="mscb-cart-count">0 tickets</span>
        <strong class="mscb-total" id="mscb-cart-total">€ 0,00</strong>
      </div>
    </div>
    <button type="button" class="btn btn-gold btn-mscb-checkout" id="mscb-checkout-trigger-btn">
      <span>Afrekenen &rarr;</span>
    </button>
  </div>
</div>

<script define:vars={{ rawTickets: allTickets, rawAddons: addonsList }}>
  // Mobile Slide-Up Bottom Sheet & Global Sticky Bar Controller
  window.GLOBAL_TICKETS = rawTickets || [];
  window.GLOBAL_ADDONS = rawAddons || [];

  (function initMobileDrawer() {
    const overlay = document.getElementById('mobile-cart-sheet-overlay');
    if (!overlay) return;

    const sheetViewCart = document.getElementById('sheet-view-cart');
    const sheetViewAddons = document.getElementById('sheet-view-addons');
    const sheetCartList = document.getElementById('sheet-cart-list');
    const sheetCartEmpty = document.getElementById('sheet-cart-empty');
    const sheetCartFooter = document.getElementById('sheet-cart-footer');
    const sheetCartSubtotal = document.getElementById('sheet-cart-subtotal');
    const sheetCartFee = document.getElementById('sheet-cart-fee');
    const sheetCartShipping = document.getElementById('sheet-cart-shipping');
    const sheetShippingRow = document.getElementById('sheet-shipping-row');
    const sheetCartTotal = document.getElementById('sheet-cart-total');
    const sheetAddonsList = document.getElementById('sheet-addons-list');
    const sheetFilterDay = document.getElementById('sheet-filter-day');
    const sheetFilterCat = document.getElementById('sheet-filter-cat');
    const sheetFinalCheckoutText = document.getElementById('sheet-final-checkout-text');

    let activeSheetAddonCategory = 'all';
    let activeSheetAddonDay = 'all';

    const stickyBar = document.getElementById('mobile-sticky-checkout-bar');
    const stickyCount = document.getElementById('mscb-cart-count');
    const stickyTotal = document.getElementById('mscb-cart-total');

    function updateStickyBar() {
      if (!stickyBar) return;
      const cart = getLocalCart();
      let totalQty = 0;
      let subtotal = 0;
      let shippingActive = false;

      Object.keys(cart).forEach(id => {
        const storedVal = cart[id];
        const qty = typeof storedVal === 'number' ? storedVal : storedVal?.qty || 0;
        const rawItem = (window.GLOBAL_TICKETS || []).find(t => t.id === id);
        const price = (typeof storedVal === 'object' && storedVal.price) ? storedVal.price : (rawItem?.price || 0);

        if (qty > 0) {
          totalQty += qty;
          subtotal += price * qty;
          if (rawItem?.category === 'botteling' || storedVal?.category === 'botteling') {
            if (storedVal?.delivery === 'shipping') shippingActive = true;
          }
        }
      });

      if (totalQty > 0) {
        const fee = 1.50;
        const shipping = shippingActive ? 12.50 : 0;
        const grandTotal = subtotal + fee + shipping;

        if (stickyCount) {
          stickyCount.textContent = `${totalQty} ${totalQty === 1 ? 'ticket' : 'tickets'}`;
        }
        if (stickyTotal) {
          stickyTotal.textContent = `€ ${grandTotal.toFixed(2).replace('.', ',')}`;
        }
        stickyBar.classList.add('active');
      } else {
        stickyBar.classList.remove('active');
      }
    }

    function getLocalCart() {
      try {
        const stored = localStorage.getItem('whiskyfest_cart');
        if (!stored) return {};
        const parsed = JSON.parse(stored);
        if (!parsed || typeof parsed !== 'object') return {};

        const result = {};
        if (parsed.cartRaw && typeof parsed.cartRaw === 'object') {
          Object.keys(parsed.cartRaw).forEach(k => {
            if (k === 'subtotal' || k === 'totalItems' || k === 'items' || k === 'cartRaw') return;
            const item = parsed.cartRaw[k];
            if (item && ((typeof item === 'number' && item > 0) || (item.qty && item.qty > 0))) {
              result[k] = typeof item === 'object' ? { ...item, id: k } : { id: k, qty: item };
            }
          });
          return result;
        }

        if (Array.isArray(parsed.items)) {
          parsed.items.forEach(item => {
            if (item && item.id && item.qty > 0) {
              result[item.id] = item;
            }
          });
          return result;
        }

        Object.keys(parsed).forEach(k => {
          if (k === 'subtotal' || k === 'totalItems' || k === 'items' || k === 'cartRaw') return;
          const val = parsed[k];
          if (val && ((typeof val === 'number' && val > 0) || (val.qty && val.qty > 0))) {
            result[k] = typeof val === 'object' ? { ...val, id: k } : { id: k, qty: val };
          }
        });
        return result;
      } catch (e) {
        console.error('Error reading local cart:', e);
        return {};
      }
    }

    function saveLocalCart(cartObj) {
      try {
        let subtotal = 0;
        let totalItems = 0;
        const itemsArr = [];
        const cartRaw = {};

        Object.keys(cartObj).forEach(id => {
          const val = cartObj[id];
          const qty = typeof val === 'number' ? val : (val && val.qty) || 0;
          if (qty > 0) {
            const raw = (window.GLOBAL_TICKETS || []).find(t => t.id === id);
            const price = (typeof val === 'object' && val.price) ? val.price : (raw?.price || 0);
            const title = (typeof val === 'object' && val.title) ? val.title : (raw?.title || id);
            const itemData = typeof val === 'object' ? { ...val, id, qty, price, title } : { id, qty, price, title };
            itemsArr.push(itemData);
            cartRaw[id] = itemData;
            subtotal += price * qty;
            totalItems += qty;
          }
        });

        const fee = totalItems > 0 ? 1.50 : 0;
        const finalObj = {
          items: itemsArr,
          cartRaw: cartRaw,
          subtotal: subtotal,
          fee: fee,
          total: subtotal + fee,
          totalItems: totalItems
        };

        localStorage.setItem('whiskyfest_cart', JSON.stringify(finalObj));
        window.dispatchEvent(new CustomEvent('cart-updated', { detail: finalObj }));
      } catch (e) {
        console.error('Error saving local cart:', e);
      }
    }

    function renderSheetCart() {
      if (!sheetCartList) return;
      const cart = getLocalCart();
      const itemIds = Object.keys(cart).filter(id => {
        const val = cart[id];
        return typeof val === 'number' ? val > 0 : val && val.qty > 0;
      });

      if (itemIds.length === 0) {
        sheetCartList.innerHTML = '';
        if (sheetCartEmpty) sheetCartEmpty.classList.add('is-visible');
        if (sheetCartFooter) sheetCartFooter.style.display = 'none';
        updateStickyBar();
        return;
      }

      if (sheetCartEmpty) sheetCartEmpty.classList.remove('is-visible');
      if (sheetCartFooter) sheetCartFooter.style.display = 'flex';

      let subtotal = 0;
      let totalQty = 0;
      let shippingActive = false;

      sheetCartList.innerHTML = itemIds.map(id => {
        const storedVal = cart[id];
        const qty = typeof storedVal === 'number' ? storedVal : (storedVal?.qty || 0);
        const rawItem = (window.GLOBAL_TICKETS || []).find(t => t.id === id);
        const price = (typeof storedVal === 'object' && storedVal.price) ? storedVal.price : (rawItem?.price || 0);
        const title = (typeof storedVal === 'object' && storedVal.title) ? storedVal.title : (rawItem?.title || id);
        const date = (typeof storedVal === 'object' && storedVal.date) ? storedVal.date : (rawItem?.date || '');
        const time = (typeof storedVal === 'object' && storedVal.time) ? storedVal.time : (rawItem?.time || '');
        const category = (typeof storedVal === 'object' && storedVal.category) ? storedVal.category : (rawItem?.category || '');
        const delivery = typeof storedVal === 'object' ? storedVal.delivery : undefined;

        const lineTotal = price * qty;
        subtotal += lineTotal;
        totalQty += qty;
        if (category === 'botteling' && delivery === 'shipping') shippingActive = true;

        const metaText = [date, time].filter(Boolean).join(' • ');

        return `
          <div class="sheet-cart-card" data-sheet-item-id="${id}">
            <div class="sheet-cart-card-info">
              <h4 class="sheet-cart-card-title">${title}</h4>
              <div class="sheet-cart-card-meta">${metaText || 'Internationaal Whisky Festival'}</div>
              <div class="sheet-cart-card-price">
                € ${lineTotal.toFixed(2).replace('.', ',')}
              </div>
            </div>
            <div class="sheet-cart-card-right">
              <div class="sheet-stepper-pill">
                <button 
                  type="button" 
                  class="sheet-stepper-btn sheet-drawer-qty-btn sheet-minus" 
                  data-id="${id}" 
                  data-action="minus" 
                  title="Verminderen"
                  aria-label="Kaartje verminderen"
                >&minus;</button>
                <span class="sheet-stepper-val">${qty}</span>
                <button 
                  type="button" 
                  class="sheet-stepper-btn sheet-drawer-qty-btn sheet-plus" 
                  data-id="${id}" 
                  data-action="plus" 
                  title="Toevoegen"
                  aria-label="Kaartje vermeerderen"
                >&plus;</button>
              </div>
            </div>
          </div>
        `;
      }).join('');

      const fee = totalQty > 0 ? 1.50 : 0;
      const shipping = shippingActive ? 12.50 : 0;
      const finalTotal = subtotal + fee + shipping;

      if (sheetCartSubtotal) sheetCartSubtotal.textContent = `€ ${subtotal.toFixed(2).replace('.', ',')}`;
      if (sheetCartFee) sheetCartFee.textContent = `€ ${fee.toFixed(2).replace('.', ',')}`;
      if (sheetShippingRow && sheetCartShipping) {
        if (shippingActive) {
          sheetShippingRow.style.display = 'flex';
          sheetCartShipping.textContent = `€ ${shipping.toFixed(2).replace('.', ',')}`;
        } else {
          sheetShippingRow.style.display = 'none';
        }
      }
      if (sheetCartTotal) sheetCartTotal.textContent = `€ ${finalTotal.toFixed(2).replace('.', ',')}`;
      updateStickyBar();
    }

    function renderSheetAddons() {
      if (!sheetAddonsList) return;
      const cart = getLocalCart();

      const filtered = (window.GLOBAL_ADDONS || []).filter(item => {
        const matchCat = activeSheetAddonCategory === 'all' || item.category === activeSheetAddonCategory;
        const matchDay = activeSheetAddonDay === 'all' || item.day === 'all' || item.day === activeSheetAddonDay;
        return matchCat && matchDay;
      });

      let subtotal = 0;
      let totalItems = 0;
      let shippingActive = false;
      Object.keys(cart).forEach(id => {
        const storedVal = cart[id];
        const qty = typeof storedVal === 'number' ? storedVal : storedVal?.qty || 0;
        const rawItem = (window.GLOBAL_TICKETS || []).find(t => t.id === id);
        const price = (typeof storedVal === 'object' && storedVal.price) ? storedVal.price : (rawItem?.price || 0);
        if (qty > 0) {
          subtotal += price * qty;
          totalItems += qty;
          if (rawItem?.category === 'botteling' || storedVal?.category === 'botteling') {
            if (storedVal?.delivery === 'shipping') shippingActive = true;
          }
        }
      });
      const fee = totalItems > 0 ? 1.50 : 0;
      const shipping = shippingActive ? 12.50 : 0;
      const grandTotal = subtotal + fee + shipping;

      if (sheetFinalCheckoutText) {
        sheetFinalCheckoutText.innerHTML = `Afrekenen (€ ${grandTotal.toFixed(2).replace('.', ',')}) &rarr;`;
      }

      if (filtered.length === 0) {
        sheetAddonsList.innerHTML = '<p style="color:#776B5F; font-size:0.88rem; text-align:center; padding: 2rem 0;">Geen extra\'s gevonden voor deze filtercombinatie.</p>';
        return;
      }

      sheetAddonsList.innerHTML = filtered.map(item => {
        const storedVal = cart[item.id];
        const currentQty = typeof storedVal === 'number' ? storedVal : (storedVal?.qty || 0);
        const isAdded = currentQty > 0;
        const isSoldOut = item.isSoldOut;
        const catLabel = item.category === 'warehouse' ? 'Warehouse' : item.category === 'tram' ? 'Whiskytram' : item.category === 'trail' ? 'Whiskytrail' : item.category === 'vatenmaken' ? 'Workshop' : item.category === 'botteling' ? 'Botteling' : 'Masterclass';

        const dateStr = item.date ? item.date.replace(/ 2026/g, '') : '';
        const metaParts = [dateStr, item.time, item.location || 'Grote Kerk'].filter(Boolean);
        const metaLine = metaParts.join(' • ');

        return `
          <div class="sheet-addon-card" style="${isSoldOut ? 'opacity: 0.6;' : ''}">
            <div class="sheet-addon-info">
              <div class="sheet-addon-badge-row">
                <span class="sheet-addon-tag">${catLabel}</span>
              </div>
              <h4 class="sheet-addon-title">${item.title}</h4>
              <span class="sheet-addon-meta">${metaLine}</span>
            </div>
            <div class="sheet-addon-action">
              <strong class="sheet-addon-price">€ ${item.price.toFixed(2).replace('.', ',')}</strong>
              ${isSoldOut ? `
                <span class="sheet-addon-soldout">UITVERKOCHT</span>
              ` : isAdded ? `
                <div class="sheet-stepper-pill">
                  <button 
                    type="button" 
                    class="sheet-stepper-btn sheet-drawer-addon-qty-btn sheet-minus" 
                    data-id="${item.id}" 
                    data-action="minus" 
                    title="Verminderen"
                    aria-label="Verminderen"
                  >&minus;</button>
                  <span class="sheet-stepper-val">${currentQty}</span>
                  <button 
                    type="button" 
                    class="sheet-stepper-btn sheet-drawer-addon-qty-btn sheet-plus" 
                    data-id="${item.id}" 
                    data-action="plus" 
                    title="Toevoegen"
                    aria-label="Toevoegen"
                  >&plus;</button>
                </div>
              ` : `
                <button 
                  type="button" 
                  class="sheet-addon-add-btn sheet-drawer-addon-add" 
                  data-id="${item.id}"
                  aria-label="Toevoegen aan winkelmand"
                >
                  + Toevoegen
                </button>
              `}
            </div>
          </div>
        `;
      }).join('');
    }

    function openMobileCartDrawer(view = 'cart') {
      if (!overlay) return;

      if (view === 'addons') {
        if (sheetViewCart) {
          sheetViewCart.classList.remove('is-active');
          sheetViewCart.style.display = 'none';
        }
        if (sheetViewAddons) {
          sheetViewAddons.classList.add('is-active');
          sheetViewAddons.style.display = 'flex';
        }

        // Auto-select day if user has ticket for a specific day
        const cart = getLocalCart();
        const cartDays = new Set();
        Object.keys(cart).forEach(id => {
          const matching = (window.GLOBAL_TICKETS || []).find(t => t.id === id);
          if (matching && matching.day && matching.day !== 'all') {
            cartDays.add(matching.day);
          }
        });
        if (sheetFilterDay) {
          if (cartDays.size === 1) {
            sheetFilterDay.value = [...cartDays][0];
            activeSheetAddonDay = [...cartDays][0];
          } else {
            sheetFilterDay.value = 'all';
            activeSheetAddonDay = 'all';
          }
        }
        if (sheetFilterCat) {
          sheetFilterCat.value = 'all';
          activeSheetAddonCategory = 'all';
        }

      renderSheetAddons();
      } else {
        if (sheetViewAddons) {
          sheetViewAddons.classList.remove('is-active');
          sheetViewAddons.style.display = 'none';
        }
        if (sheetViewCart) {
          sheetViewCart.classList.add('is-active');
          sheetViewCart.style.display = 'flex';
        }
        renderSheetCart();
      }

      syncVisualViewport();
      overlay.style.display = 'block';
      requestAnimationFrame(() => {
        overlay.classList.add('active');
        syncVisualViewport();
      });
      document.body.style.overflow = 'hidden';
    }

    const sheetElement = document.getElementById('mobile-cart-sheet');
    function syncVisualViewport() {
      if (window.visualViewport && sheetElement) {
        const bottomInset = Math.max(0, window.innerHeight - window.visualViewport.height - (window.visualViewport.offsetTop || 0));
        sheetElement.style.bottom = `${bottomInset}px`;
      }
    }

    if (window.visualViewport) {
      window.visualViewport.addEventListener('resize', syncVisualViewport);
      window.visualViewport.addEventListener('scroll', syncVisualViewport);
    }

    function closeMobileCartDrawer() {
      if (!overlay) return;
      overlay.classList.remove('active');
      setTimeout(() => {
        overlay.style.display = 'none';
        document.body.style.overflow = '';
      }, 320);
    }

    // Global Event Listener
    window.addEventListener('open-mobile-cart-drawer', (e) => {
      const targetView = (e && e.detail && e.detail.view) || 'cart';
      openMobileCartDrawer(targetView);
    });

    // Close buttons & backdrop
    document.getElementById('sheet-close-btn-cart')?.addEventListener('click', closeMobileCartDrawer);
    document.getElementById('sheet-close-btn-addons')?.addEventListener('click', closeMobileCartDrawer);
    document.getElementById('mobile-cart-sheet-backdrop')?.addEventListener('click', closeMobileCartDrawer);

    // Switch to Addons View
    document.getElementById('sheet-to-addons-btn')?.addEventListener('click', () => {
      const cart = getLocalCart();
      const activeIds = Object.keys(cart).filter(id => {
        const val = cart[id];
        return typeof val === 'number' ? val > 0 : val && val.qty > 0;
      });

      if (activeIds.length === 0) {
        alert('Uw winkelwagen is leeg. Selecteer eerst een ticket.');
        return;
      }
      openMobileCartDrawer('addons');
    });

    // Back to Cart View
    document.getElementById('sheet-back-to-cart-btn')?.addEventListener('click', () => {
      openMobileCartDrawer('cart');
    });

    // Filter Dropdown Listeners
    sheetFilterDay?.addEventListener('change', (e) => {
      activeSheetAddonDay = e.target.value;
      renderSheetAddons();
    });

    sheetFilterCat?.addEventListener('change', (e) => {
      activeSheetAddonCategory = e.target.value;
      renderSheetAddons();
    });

    // Final Checkout
    function handleFinalCheckout() {
      closeMobileCartDrawer();
      if (typeof window.openCheckoutModal === 'function') {
        window.openCheckoutModal();
      } else {
        window.location.href = '/#sessies';
      }
    }

    document.getElementById('sheet-final-checkout-btn')?.addEventListener('click', handleFinalCheckout);
    document.getElementById('sheet-skip-addons-btn')?.addEventListener('click', handleFinalCheckout);

    // Stepper in Cart List
    document.getElementById('sheet-cart-list')?.addEventListener('click', (e) => {
      const btn = e.target.closest('.sheet-drawer-qty-btn');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      const action = btn.getAttribute('data-action');
      if (!id) return;

      const cart = getLocalCart();
      if (!cart[id]) return;

      const isObj = typeof cart[id] === 'object';
      let currentQty = isObj ? cart[id].qty : cart[id];

      if (action === 'plus') {
        currentQty = Math.min(10, currentQty + 1);
        if (isObj) cart[id].qty = currentQty;
        else cart[id] = currentQty;
      } else if (action === 'minus') {
        currentQty = Math.max(0, currentQty - 1);
        if (currentQty === 0) {
          delete cart[id];
        } else {
          if (isObj) cart[id].qty = currentQty;
          else cart[id] = currentQty;
        }
      }

      saveLocalCart(cart);
      renderSheetCart();
    });

    // Add / Stepper in Addons List
    document.getElementById('sheet-addons-list')?.addEventListener('click', (e) => {
      const addBtn = e.target.closest('.sheet-drawer-addon-add');
      const qtyBtn = e.target.closest('.sheet-drawer-addon-qty-btn');
      const cart = getLocalCart();

      if (addBtn) {
        const id = addBtn.getAttribute('data-id');
        if (!id) return;
        const item = window.GLOBAL_ADDONS.find(m => m.id === id);
        if (!item) return;

        if (!cart[id]) {
          cart[id] = {
            title: item.title,
            price: item.price,
            qty: 1,
            category: item.category,
            date: item.date || '',
            time: item.time || ''
          };
        } else {
          const isObj = typeof cart[id] === 'object';
          const qty = isObj ? cart[id].qty : cart[id];
          if (isObj) cart[id].qty = Math.min(10, qty + 1);
          else cart[id] = Math.min(10, qty + 1);
        }

        saveLocalCart(cart);
        renderSheetAddons();
        return;
      }

      if (qtyBtn) {
        const id = qtyBtn.getAttribute('data-id');
        const action = qtyBtn.getAttribute('data-action');
        if (!id || !cart[id]) return;

        const isObj = typeof cart[id] === 'object';
        let qty = isObj ? cart[id].qty : cart[id];

        if (action === 'plus') {
          qty = Math.min(10, qty + 1);
          if (isObj) cart[id].qty = qty;
          else cart[id] = qty;
        } else if (action === 'minus') {
          qty = Math.max(0, qty - 1);
          if (qty === 0) {
            delete cart[id];
          } else {
            if (isObj) cart[id].qty = qty;
            else cart[id] = qty;
          }
        }

        saveLocalCart(cart);
        renderSheetAddons();
      }
    });

    // Click Sticky Checkout Bar to open drawer
    if (stickyBar) {
      stickyBar.addEventListener('click', (e) => {
        e.preventDefault();
        openMobileCartDrawer('cart');
      });
    }

    // Listen to external cart storage changes and custom events
    window.addEventListener('storage', () => {
      updateStickyBar();
      if (overlay.classList.contains('active')) {
        renderSheetCart();
        renderSheetAddons();
      }
    });

    window.addEventListener('cart-updated', () => {
      updateStickyBar();
      if (overlay.classList.contains('active')) {
        renderSheetCart();
        renderSheetAddons();
      }
    });

    // Expose helpers globally
    window.openMobileCartDrawer = openMobileCartDrawer;
    window.closeMobileCartDrawer = closeMobileCartDrawer;
    window.updateMobileStickyBar = updateStickyBar;

    // Run on initial load and DOM ready
    updateStickyBar();
    document.addEventListener('DOMContentLoaded', updateStickyBar);
  })();
</script>
