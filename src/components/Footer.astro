---
// src/components/Footer.astro
// 1-on-1 original vectors direct from folder: Middel 13, 14, 15
import Middel13Svg from '../assets/Logo/Logo wit svg/Middel 13.svg?raw'; // Gent
import Middel14Svg from '../assets/Logo/Logo wit svg/Middel 14.svg?raw'; // Amsterdam
import Middel15Svg from '../assets/Logo/Logo wit svg/Middel 15.svg?raw'; // Den Haag

interface Props {
  currentCity?: string;
}

const { currentCity = 'denhaag' } = Astro.props;

const currentCityLogoSvg = currentCity === 'amsterdam' ? Middel14Svg : currentCity === 'denhaag' ? Middel15Svg : Middel13Svg;
const currentCityTitle = currentCity === 'amsterdam' ? 'Whisky Fest Amsterdam' : currentCity === 'denhaag' ? 'International Whisky Festival Den Haag' : 'Gents Whisky Festival';
---

<!-- Ripped Paper Overlay - Exact replica of ticket section -->
<div class="footer-torn-divider" aria-hidden="true">
  <div class="torn-edge-wrap">
    <img src="/torn-top.svg?v=2" alt="" class="torn-edge-img" />
  </div>
</div>

<footer class="site-footer">
  <div class="footer-inner">

    <!-- 1. TOP SECTION: 3 FREESTANDING WHITE LOGOS + CITY TEXT + BEZOEK EVENT BUTTON -->
    <div class="footer-hero-logos-strip">
      
      <!-- LOGO 1: AMSTERDAM (Middel 14.svg) -->
      <div class="freestanding-logo-item">
        <a 
          href="https://whisky-fest-amsterdam.vercel.app" 
          class="freestanding-logo-link"
          title="Bezoek Whisky Fest Amsterdam"
          target={currentCity === 'amsterdam' ? '_self' : '_blank'}
          rel="noopener noreferrer"
          aria-label="Whisky Fest Amsterdam"
        >
          <div class="freestanding-svg-wrapper">
            <Fragment set:html={Middel14Svg} />
          </div>
        </a>
        <span class="logo-city-title">AMSTERDAM</span>
        <a 
          href="https://whisky-fest-amsterdam.vercel.app" 
          class="btn-bezoek-event"
          target={currentCity === 'amsterdam' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          Bezoek Event &rarr;
        </a>
      </div>

      <!-- LOGO 2: DEN HAAG (Middel 15.svg) -->
      <div class="freestanding-logo-item">
        <a 
          href="https://whisky-fest-den-haag.vercel.app" 
          class="freestanding-logo-link"
          title="Bezoek International Whisky Festival Den Haag"
          target={currentCity === 'denhaag' ? '_self' : '_blank'}
          rel="noopener noreferrer"
          aria-label="International Whisky Festival Den Haag"
        >
          <div class="freestanding-svg-wrapper">
            <Fragment set:html={Middel15Svg} />
          </div>
        </a>
        <span class="logo-city-title">DEN HAAG</span>
        <a 
          href="https://whisky-fest-den-haag.vercel.app" 
          class="btn-bezoek-event"
          target={currentCity === 'denhaag' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          Bezoek Event &rarr;
        </a>
      </div>

      <!-- LOGO 3: GENT (Middel 13.svg) -->
      <div class="freestanding-logo-item">
        <a 
          href="https://whiskyfestival.be" 
          class="freestanding-logo-link"
          title="Bezoek Gents Whisky Festival"
          target={currentCity === 'gent' ? '_self' : '_blank'}
          rel="noopener noreferrer"
          aria-label="Gents Whisky Festival"
        >
          <div class="freestanding-svg-wrapper">
            <Fragment set:html={Middel13Svg} />
          </div>
        </a>
        <span class="logo-city-title">GENT</span>
        <a 
          href="https://whiskyfestival.be" 
          class="btn-bezoek-event"
          target={currentCity === 'gent' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          Bezoek Event &rarr;
        </a>
      </div>

    </div>

    <!-- 2. MAIN FOOTER 4-COLUMN GRID (Info, Nav, Account, Google Map) -->
    <div class="footer-grid">
      
      <!-- COL 1: ORGANISATIE & INFO (Logo links onder ipv vierkant) -->
      <div class="footer-col brand-col">
        <a href="/" class="footer-brand-logo-wrap" aria-label={currentCityTitle}>
          <div class="footer-brand-logo-svg">
            <Fragment set:html={currentCityLogoSvg} />
          </div>
        </a>
        <p class="brand-pitch">Al meer dan 26 jaar het meest toonaangevende en sfeervolle whisky evenement in de historische Grote Kerk van Den Haag.</p>
        <div class="contact-box">
          <p class="contact-line"><strong>Locatie:</strong> Grote Kerk Den Haag</p>
          <p class="contact-line"><strong>Adres:</strong> Rond de Grote Kerk 12, 2513 AM Den Haag</p>
          <p class="contact-line"><strong>E-mail:</strong> <a href="mailto:info@whiskyfestival.nl" class="footer-gold-link">info@whiskyfestival.nl</a></p>
        </div>
      </div>

      <!-- COL 2: FESTIVAL & PROGRAMMA -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Festival & Programma</h4>
        <div class="footer-links-list">
          <a href="/#sessies" class="footer-link">Sessies & Entreetickets</a>
          <a href="/programma" class="footer-link">Masterclasses & Tastings</a>
          <a href="/standhouders" class="footer-link">Plattegrond & Standhouders</a>
          <a href="/#ervaring" class="footer-link">De Festival Beleving</a>
          <a href="/#historie" class="footer-link">Historie & Oprichting</a>
          <a href="/#faq" class="footer-link">Veelgestelde Vragen (FAQ)</a>
        </div>
      </div>

      <!-- COL 3: BEZOEKERS & SERVICE -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Bezoekers & Service</h4>
        <div class="footer-links-list">
          <a href="/account" class="footer-link">Mijn Account & E-Tickets</a>
          <a href="/standhouders" class="footer-link">Aanwezige Merken</a>
          <a href="/#faq" class="footer-link">Praktische Informatie</a>
          <a href="/#faq" class="footer-link">Huisregels & 18+ Beleid</a>
          <a href={currentCity === 'gent' ? 'mailto:info@whiskyfestival.be' : 'mailto:info@whiskyfestival.nl'} class="footer-link">Contact & Klantenservice</a>
        </div>
      </div>

      <!-- COL 4: INTERACTIVE GOOGLE MAPS EMBED -->
      <div class="footer-col map-col">
        <h4 class="footer-col-title">Locatie & Route</h4>
        <div class="footer-map-card">
          <div class="map-iframe-wrapper">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2452.880016462706!2d4.305591976865267!3d52.0773950691501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5b73d9e9e1c31%3A0xc3f6be73bb9024f2!2sGrote%20Kerk%20Den%20Haag!5e0!3m2!1snl!2snl!4v1700000000000!5m2!1snl!2snl" 
              width="100%" 
              height="160" 
              style="border:0; display:block; border-radius:6px;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Locatie Grote Kerk Den Haag"
            ></iframe>
          </div>
          <div class="map-footer-action">
            <span class="map-venue-label">Grote Kerk Den Haag</span>
            <a href="https://maps.google.com/?q=Grote+Kerk+Den+Haag" target="_blank" rel="noopener noreferrer" class="btn-map-route">
              Open Routeplanner →
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- 4. BOTTOM CREDITS & 18+ SAFETY BAR -->
    <div class="footer-bottom">
      <div class="footer-separator"></div>
      <div class="bottom-row">
        <p class="copyright">
          &copy; {new Date().getFullYear()} International Whisky Festival. Alle rechten voorbehouden.
        </p>

        <div class="safety-badges">
          <span class="safety-badge">GEEN 18, GEEN ALCOHOL</span>
          <span class="safety-badge-text">Geniet, maar drink met mate.</span>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  /* Torn Paper Divider above Footer */
  .footer-torn-divider {
    line-height: 0;
    position: relative;
    z-index: 20;
    pointer-events: none;
  }

  /* Ripped Paper Overlay - Exact downward drop-shadow & top clipping */
  .torn-edge-wrap {
    position: relative;
    z-index: 20;
    line-height: 0;
    filter: drop-shadow(0px 18px 18px rgba(0, 0, 0, 0.55));
    clip-path: inset(0 -50px -50px -50px);
    pointer-events: none;
  }

  .torn-edge-img {
    display: block;
    width: 100%;
    height: 60px;
  }

  /* Base Site Footer with City Theme Color - Slides 48px UNDER the torn paper */
  .site-footer {
    background-color: #006448;
    color: #FAF7F2;
    position: relative;
    z-index: 1;
    margin-top: -48px;
    padding-top: 3.5rem;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
  }

  .footer-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 3.5rem 2rem 3rem;
  }

  /* ----------------------------------------------------
     1. 3 FREESTANDING WHITE LOGOS + CITY TEXT + BUTTON
     ---------------------------------------------------- */
  .footer-hero-logos-strip {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 4.5rem;
    margin-bottom: 3.5rem;
    padding: 1.5rem 0 3rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .freestanding-logo-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.65rem;
  }

  .freestanding-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    cursor: pointer;
  }

  .freestanding-svg-wrapper {
    width: 140px;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .freestanding-svg-wrapper :global(svg),
  .freestanding-svg-wrapper svg {
    width: 100% !important;
    height: 100% !important;
    max-width: 140px !important;
    max-height: 190px !important;
    object-fit: contain;
    display: block !important;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.4));
  }

  .freestanding-logo-link:hover {
    transform: translateY(-8px) scale(1.08);
  }

  .freestanding-logo-link:hover .freestanding-svg-wrapper :global(svg),
  .freestanding-svg-wrapper svg {
    width: 100% !important;
    height: 100% !important;
    max-width: 140px !important;
    max-height: 190px !important;
    object-fit: contain;
    display: block !important;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.4));
  }

  .logo-city-title {
    font-family: var(--font-display, 'bourbon-rough', serif);
    font-size: 1.15rem;
    letter-spacing: 0.08em;
    color: #FFFFFF;
    margin-top: 0.25rem;
  }

  .btn-bezoek-event {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: #FFFFFF;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.85rem;
    border-radius: 20px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .btn-bezoek-event:hover {
    background: #caac8e;
    color: #171614;
    border-color: #caac8e;
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
  }

  /* ----------------------------------------------------
     2. 4-COLUMN MAIN FOOTER GRID
     ---------------------------------------------------- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col-title {
    font-size: 1.15rem;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 0.65rem;
    letter-spacing: 0.06em;
    font-family: var(--font-display, 'bourbon-rough', serif);
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background-color: #caac8e;
  }

  /* Column 1: Brand logo (Links onder ipv vierkant) */
  .footer-brand-logo-wrap {
    display: inline-block;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.2s ease;
  }

  .footer-brand-logo-wrap:hover {
    transform: translateY(-3px) scale(1.03);
    opacity: 0.95;
  }

  .footer-brand-logo-svg {
    width: 110px;
    height: 148px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .footer-brand-logo-svg :global(svg),
  .footer-brand-logo-svg svg {
    width: 100% !important;
    height: 100% !important;
    max-width: 110px !important;
    max-height: 148px !important;
    object-fit: contain;
    display: block !important;
    filter: drop-shadow(0 4px 14px rgba(0, 0, 0, 0.35));
  }

  .brand-pitch {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-gold-link {
    color: #caac8e;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .footer-gold-link:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* Link Lists */
  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: #caac8e;
    transform: translateX(4px);
  }

  /* Column 4: Google Maps */
  .footer-map-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .map-iframe-wrapper {
    overflow: hidden;
    border-radius: 6px;
  }

  .map-footer-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.4rem;
  }

  .map-venue-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .btn-map-route {
    font-size: 0.78rem;
    font-weight: 700;
    color: #caac8e;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(213, 194, 138, 0.3);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-map-route:hover {
    background: #caac8e;
    color: #171614;
  }

  /* ----------------------------------------------------
     4. BOTTOM ROW & 18+ BADGE
     ---------------------------------------------------- */
  .footer-separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin-bottom: 2rem;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .safety-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .safety-badge {
    background-color: #A81818;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .safety-badge-text {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ----------------------------------------------------
     RESPONSIVE MEDIA QUERIES
     ---------------------------------------------------- */
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .footer-hero-logos-strip {
      gap: 2.5rem;
    }
    .freestanding-svg-wrapper {
    width: 140px;
    height: 190px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, filter 0.3s ease;
  }
  }

  @media (max-width: 800px) {
    .site-footer {
      padding-top: 1rem;
    }
    .footer-hero-logos-strip {
      display: grid !important;
      grid-template-columns: repeat(3, 1fr) !important;
      align-items: start !important;
      justify-items: center !important;
      gap: 0.5rem !important;
      margin-bottom: 2rem !important;
      padding: 0.5rem 0 !important;
    }
    .freestanding-logo-item {
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      text-align: center !important;
      gap: 0.35rem !important;
      width: 100% !important;
      max-width: 110px !important;
    }
    .freestanding-svg-wrapper {
      width: 72px !important;
      height: 95px !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
    }
    .freestanding-svg-wrapper :global(svg),
    .freestanding-svg-wrapper svg {
      width: 100% !important;
      height: 100% !important;
      max-width: 72px !important;
      max-height: 95px !important;
    }
    .logo-city-title {
      font-size: 0.82rem !important;
      letter-spacing: 0.05em !important;
      margin-top: 0.1rem !important;
    }
    .btn-bezoek-event {
      font-size: 0.62rem !important;
      font-weight: 800 !important;
      padding: 0.22rem 0.5rem !important;
      letter-spacing: 0.04em !important;
      border-radius: 12px !important;
      white-space: nowrap !important;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .footer-brand-logo-svg {
      width: 95px !important;
      height: 128px !important;
    }
    .bottom-row {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
  }

  /* High-contrast, crystal clear footer typography */
  .site-footer,
  .site-footer p,
  .site-footer span,
  .site-footer .brand-pitch,
  .site-footer .contact-box,
  .site-footer .contact-line {
    color: rgba(255, 255, 255, 0.92) !important;
    font-size: 0.92rem;
    line-height: 1.6;
  }
  .site-footer strong,
  .site-footer .contact-line strong,
  .site-footer .contact-box strong {
    color: #FFFFFF !important;
    font-weight: 700 !important;
  }
  .site-footer .footer-gold-link {
    color: #C58B39 !important;
    font-weight: 700 !important;
    text-decoration: underline !important;
    text-underline-offset: 3px;
    transition: color 0.2s ease;
  }
  .site-footer .footer-gold-link:hover {
    color: #FFFFFF !important;
  }
  .site-footer .contact-box {
    margin-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
</style>
