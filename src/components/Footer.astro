---
// src/components/Footer.astro
// 1-on-1 original vectors direct from folder: Middel 13, 14, 15
import Middel13Svg from '../assets/Logo/Logo wit svg/Middel 13.svg?raw'; // Gent
import Middel14Svg from '../assets/Logo/Logo wit svg/Middel 14.svg?raw'; // Amsterdam
import Middel15Svg from '../assets/Logo/Logo wit svg/Middel 15.svg?raw'; // Den Haag

interface Props {
  currentCity?: string;
}

const { currentCity = 'denhaag' } = Astro.props;
---

<footer class="site-footer">
  <!-- Ripped Paper Overlay -->
  <div class="torn-edge-wrap" aria-hidden="true">
    <img src="/torn-top.svg?v=2" alt="" class="torn-edge-img" />
  </div>

  <div class="footer-inner">

    <!-- 1. TOP SECTION: 3 LARGE FREESTANDING WHITE LOGOS IN A ROW (NO CARDS/BOXES) -->
    <div class="footer-hero-logos-strip">
      
      <!-- LOGO 1: AMSTERDAM (Middel 14.svg) -->
      <a 
        href="https://whisky-fest-amsterdam.vercel.app" 
        class="freestanding-logo-link"
        title="Bezoek Whisky Fest Amsterdam"
        target={currentCity === 'amsterdam' ? '_self' : '_blank'}
        rel="noopener noreferrer"
        aria-label="Whisky Fest Amsterdam"
      >
        <div class="freestanding-svg-wrapper">
          <Fragment set:html={Middel14Svg} />
        </div>
      </a>

      <!-- LOGO 2: DEN HAAG (Middel 15.svg) -->
      <a 
        href="https://whisky-fest-den-haag.vercel.app" 
        class="freestanding-logo-link"
        title="Bezoek International Whisky Festival Den Haag"
        target={currentCity === 'denhaag' ? '_self' : '_blank'}
        rel="noopener noreferrer"
        aria-label="International Whisky Festival Den Haag"
      >
        <div class="freestanding-svg-wrapper">
          <Fragment set:html={Middel15Svg} />
        </div>
      </a>

      <!-- LOGO 3: GENT (Middel 13.svg) -->
      <a 
        href="https://whisky-fest-gent.vercel.app" 
        class="freestanding-logo-link"
        title="Bezoek Gents Whisky Festival"
        target={currentCity === 'gent' ? '_self' : '_blank'}
        rel="noopener noreferrer"
        aria-label="Gents Whisky Festival"
      >
        <div class="freestanding-svg-wrapper">
          <Fragment set:html={Middel13Svg} />
        </div>
      </a>

    </div>

    <!-- 2. NEWSLETTER LETTERPRESS CARD -->
    <div class="newsletter-section">
      <div class="newsletter-card">
        <div class="newsletter-border">
          <div class="newsletter-content">
            <span class="newsletter-mini-tag">BLIJF OP DE HOOGTE</span>
            <h3 class="newsletter-title">Schrijf u in voor onze nieuwsbrief</h3>
            <p class="newsletter-desc">
              Ontvang als eerste exclusieve updates over de ticketverkoop, speciale festivalbottelingen en zeldzame masterclasses.
            </p>
            <form class="newsletter-form" onsubmit="event.preventDefault(); const inp = this.querySelector('input'); if(inp && inp.value){ alert('✓ Hartelijk dank! U bent succesvol ingeschreven voor de nieuwsbrief van International Whisky Festival.'); inp.value = ''; }">
              <input type="email" placeholder="Uw e-mailadres invoeren..." required class="newsletter-input" />
              <button type="submit" class="btn-newsletter-submit">Inschrijven</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. MAIN FOOTER 4-COLUMN GRID (Info, Nav, Account, Google Map) -->
    <div class="footer-grid">
      
      <!-- COL 1: ORGANISATIE & INFO -->
      <div class="footer-col brand-col">
        <div class="footer-brand-badge">
          <span class="badge-est">Est. 2000</span>
          <h4 class="badge-name">International Whisky Festival</h4>
          <span class="badge-city">Den Haag</span>
        </div>
        <p class="brand-pitch">Al meer dan 26 jaar het meest toonaangevende en sfeervolle whisky evenement in de historische Grote Kerk van Den Haag.</p>
        <div class="contact-box">
          <p class="contact-line"><strong>Locatie:</strong> Grote Kerk Den Haag</p>
          <p class="contact-line"><strong>Adres:</strong> Rond de Grote Kerk 12, 2513 AM Den Haag</p>
          <p class="contact-line"><strong>E-mail:</strong> <a href="mailto:info@whiskyfestival.nl" class="footer-gold-link">info@whiskyfestival.nl</a></p>
        </div>
      </div>

      <!-- COL 2: FESTIVAL & PROGRAMMA -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Festival & Programma</h4>
        <div class="footer-links-list">
          <a href="/#sessies" class="footer-link">Sessies & Entreetickets</a>
          <a href="/#sessies" class="footer-link">Masterclasses & Tastings</a>
          <a href="/standhouders" class="footer-link">Plattegrond & Stands</a>
          <a href="/kaart" class="footer-link">Interactieve Whisky Kaart</a>
          <a href="/#ervaring" class="footer-link">De Festival Beleving</a>
          <a href="/#historie" class="footer-link">Historie & Oprichting</a>
          <a href="/#faq" class="footer-link">Veelgestelde Vragen (FAQ)</a>
        </div>
      </div>

      <!-- COL 3: BEZOEKERS & TICKETS -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Bezoekers & Account</h4>
        <div class="footer-links-list">
          <a href="/account" class="footer-link">Mijn Account (Portal)</a>
          <a href="/account" class="footer-link">Digitale E-Tickets Downloaden</a>
          <a href="/account" class="footer-link">Tickets Delen (WhatsApp/Mail)</a>
          <a href="/standhouders" class="footer-link">Aanwezige Merken</a>
          <a href="/account" class="footer-link">Praktische Informatie & Bereikbaarheid</a>
          <a href="/#faq" class="footer-link">Huisregels & 18+ Beleid</a>
        </div>
      </div>

      <!-- COL 4: INTERACTIVE GOOGLE MAPS EMBED -->
      <div class="footer-col map-col">
        <h4 class="footer-col-title">Locatie & Route</h4>
        <div class="footer-map-card">
          <div class="map-iframe-wrapper">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2452.880016462706!2d4.305591976865267!3d52.0773950691501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5b73d9e9e1c31%3A0xc3f6be73bb9024f2!2sGrote%20Kerk%20Den%20Haag!5e0!3m2!1snl!2snl!4v1700000000000!5m2!1snl!2snl" 
              width="100%" 
              height="160" 
              style="border:0; display:block; border-radius:6px;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Locatie Grote Kerk Den Haag"
            ></iframe>
          </div>
          <div class="map-footer-action">
            <span class="map-venue-label">Grote Kerk Den Haag</span>
            <a href="https://maps.google.com/?q=Grote+Kerk+Den+Haag" target="_blank" rel="noopener noreferrer" class="btn-map-route">
              Open Routeplanner →
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- 4. BOTTOM CREDITS & 18+ SAFETY BAR -->
    <div class="footer-bottom">
      <div class="footer-separator"></div>
      <div class="bottom-row">
        <p class="copyright">
          &copy; {new Date().getFullYear()} International Whisky Festival. Alle rechten voorbehouden.
        </p>

        <div class="safety-badges">
          <span class="safety-badge">GEEN 18, GEEN ALCOHOL</span>
          <span class="safety-badge-text">Geniet, maar drink met mate.</span>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  /* Base Site Footer with City Theme Color */
  .site-footer {
    background-color: #006448;
    color: #FAF7F2;
    position: relative;
    padding-top: 1rem;
    margin-top: 0;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
  }

  /* Ripped Paper Overlay */
  .torn-edge-wrap {
    position: relative;
    z-index: 20;
    line-height: 0;
    margin-top: -60px;
    margin-bottom: -30px;
    filter: drop-shadow(0px 18px 18px rgba(0, 0, 0, 0.55));
    clip-path: inset(0 -50px -50px -50px);
    pointer-events: none;
  }

  .torn-edge-img {
    display: block;
    width: 100%;
    height: 60px;
  }

  .footer-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 3.5rem 2rem 3rem;
  }

  /* ----------------------------------------------------
     1. 3 LARGE FREESTANDING WHITE LOGOS IN A ROW
     ---------------------------------------------------- */
  .footer-hero-logos-strip {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 4.5rem;
    margin-bottom: 4.5rem;
    padding: 1.5rem 0;
  }

  .freestanding-logo-link {
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), filter 0.3s ease;
    cursor: pointer;
  }

  .freestanding-svg-wrapper {
    width: 135px;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 0.3s ease, filter 0.3s ease;
  }

  .freestanding-svg-wrapper :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 6px 14px rgba(0, 0, 0, 0.35));
  }

  .freestanding-logo-link:hover {
    transform: translateY(-8px) scale(1.08);
  }

  .freestanding-logo-link:hover .freestanding-svg-wrapper :global(svg) {
    filter: drop-shadow(0 12px 24px rgba(0, 0, 0, 0.5));
  }

  /* ----------------------------------------------------
     2. NEWSLETTER CARD
     ---------------------------------------------------- */
  .newsletter-section {
    margin-bottom: 4.5rem;
  }

  .newsletter-card {
    background-color: rgba(0, 0, 0, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  .newsletter-border {
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 2.75rem 2rem;
    border-radius: 8px;
  }

  .newsletter-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-mini-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #D5C28A;
    display: block;
    margin-bottom: 0.35rem;
  }

  .newsletter-title {
    color: #FFFFFF;
    font-size: 1.9rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-display, 'bourbon-rough', serif);
    letter-spacing: 0.04em;
  }

  .newsletter-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: 0.75rem;
    max-width: 540px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    background-color: rgba(0, 0, 0, 0.35);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    border-radius: 6px;
    transition: all 0.3s;
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: #D5C28A;
    background-color: rgba(0, 0, 0, 0.5);
    box-shadow: 0 0 12px rgba(213, 194, 138, 0.35);
  }

  .btn-newsletter-submit {
    padding: 0.85rem 2rem;
    background-color: #D5C28A;
    color: #171614;
    font-family: var(--font-sans, sans-serif);
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-newsletter-submit:hover {
    background-color: #E9DFB7;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
  }

  /* ----------------------------------------------------
     3. 4-COLUMN MAIN FOOTER GRID
     ---------------------------------------------------- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col-title {
    font-size: 1.15rem;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 0.65rem;
    letter-spacing: 0.06em;
    font-family: var(--font-display, 'bourbon-rough', serif);
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background-color: #D5C28A;
  }

  /* Column 1: Brand badge */
  .footer-brand-badge {
    display: inline-flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    max-width: 280px;
  }

  .badge-est {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #D5C28A;
  }

  .badge-name {
    font-family: var(--font-display, 'bourbon-rough', serif);
    font-size: 1.35rem;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    margin: 0.2rem 0;
  }

  .badge-city {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
  }

  .brand-pitch {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-gold-link {
    color: #D5C28A;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .footer-gold-link:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* Link Lists */
  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: #D5C28A;
    transform: translateX(4px);
  }

  /* Column 4: Google Maps */
  .footer-map-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .map-iframe-wrapper {
    overflow: hidden;
    border-radius: 6px;
  }

  .map-footer-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.4rem;
  }

  .map-venue-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .btn-map-route {
    font-size: 0.78rem;
    font-weight: 700;
    color: #D5C28A;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(213, 194, 138, 0.3);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-map-route:hover {
    background: #D5C28A;
    color: #171614;
  }

  /* ----------------------------------------------------
     4. BOTTOM ROW & 18+ BADGE
     ---------------------------------------------------- */
  .footer-separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin-bottom: 2rem;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .safety-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .safety-badge {
    background-color: #A81818;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .safety-badge-text {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ----------------------------------------------------
     RESPONSIVE MEDIA QUERIES
     ---------------------------------------------------- */
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .footer-hero-logos-strip {
      gap: 2.5rem;
    }
    .freestanding-svg-wrapper {
      width: 110px;
      height: 150px;
    }
  }

  @media (max-width: 800px) {
    .site-footer {
      padding-top: 1rem;
    }
    .footer-hero-logos-strip {
      flex-direction: column;
      gap: 2rem;
    }
    .freestanding-svg-wrapper {
      width: 120px;
      height: 160px;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .newsletter-form {
      flex-direction: column;
    }
    .btn-newsletter-submit {
      width: 100%;
    }
    .bottom-row {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
  }
</style>
