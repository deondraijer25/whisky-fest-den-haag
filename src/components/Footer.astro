---
// src/components/Footer.astro
import LogoAmsterdamSvg from '../assets/LogosAll/logo-wit-amsterdam.svg?raw';
import LogoDenHaagSvg from '../assets/LogosAll/logo-wit-denhaag.svg?raw';
import LogoGentSvg from '../assets/LogosAll/logo-wit-gent.svg?raw';

interface Props {
  currentCity?: string;
}

const { currentCity = 'denhaag' } = Astro.props;
---

<footer class="site-footer">
  <!-- Ripped Paper Overlay -->
  <div class="torn-edge-wrap" aria-hidden="true">
    <img src="/torn-top.svg?v=2" alt="" class="torn-edge-img" />
  </div>

  <div class="footer-inner">

    <!-- 1. TOP SECTION: 3 FESTIVAL CROSS-LINK LOGOS IN A ROW -->
    <section class="footer-festivals-crosslink">
      <div class="crosslink-header">
        <span class="crosslink-tag">ONZE DRIE FESTIVAL LOCATIES</span>
        <h3 class="crosslink-title">Ontdek Alle Whisky Festivals</h3>
        <div class="crosslink-gold-line"></div>
        <p class="crosslink-subtitle">
          Bezoek onze zusterfestivals en bestel direct uw tickets voor Den Haag, Amsterdam en Gent.
        </p>
      </div>

      <div class="festivals-logo-row">
        
        <!-- CARD 1: AMSTERDAM -->
        <a 
          href="https://whisky-fest-amsterdam.vercel.app" 
          class={`festival-logo-card ${currentCity === 'amsterdam' ? 'is-current' : ''}`}
          title="Naar Whisky Fest Amsterdam (De Kromhouthal)"
          target={currentCity === 'amsterdam' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          <div class="logo-svg-stage">
            <Fragment set:html={LogoAmsterdamSvg} />
          </div>
          <div class="card-info">
            <strong class="card-city-name">AMSTERDAM</strong>
            <span class="card-venue">De Kromhouthal</span>
            <span class="card-badge">
              {currentCity === 'amsterdam' ? '● Huidige Website' : 'Bezoek Festival →'}
            </span>
          </div>
        </a>

        <!-- CARD 2: DEN HAAG -->
        <a 
          href="https://whisky-fest-den-haag.vercel.app" 
          class={`festival-logo-card ${currentCity === 'denhaag' ? 'is-current' : ''}`}
          title="Naar International Whisky Festival Den Haag (Grote Kerk)"
          target={currentCity === 'denhaag' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          <div class="logo-svg-stage">
            <Fragment set:html={LogoDenHaagSvg} />
          </div>
          <div class="card-info">
            <strong class="card-city-name">DEN HAAG</strong>
            <span class="card-venue">Grote Kerk</span>
            <span class="card-badge">
              {currentCity === 'denhaag' ? '● Huidige Website' : 'Bezoek Festival →'}
            </span>
          </div>
        </a>

        <!-- CARD 3: GENT -->
        <a 
          href="https://whisky-fest-gent.vercel.app" 
          class={`festival-logo-card ${currentCity === 'gent' ? 'is-current' : ''}`}
          title="Naar Gents Whisky Festival (ICC Gent)"
          target={currentCity === 'gent' ? '_self' : '_blank'}
          rel="noopener noreferrer"
        >
          <div class="logo-svg-stage">
            <Fragment set:html={LogoGentSvg} />
          </div>
          <div class="card-info">
            <strong class="card-city-name">GENT</strong>
            <span class="card-venue">ICC Gent</span>
            <span class="card-badge">
              {currentCity === 'gent' ? '● Huidige Website' : 'Bezoek Festival →'}
            </span>
          </div>
        </a>

      </div>
    </section>

    <!-- 2. NEWSLETTER LETTERPRESS CARD -->
    <div class="newsletter-section">
      <div class="newsletter-card">
        <div class="newsletter-border">
          <div class="newsletter-content">
            <span class="newsletter-mini-tag">BLIJF OP DE HOOGTE</span>
            <h3 class="newsletter-title">Schrijf u in voor onze nieuwsbrief</h3>
            <p class="newsletter-desc">
              Ontvang als eerste exclusieve updates over de ticketverkoop, speciale festivalbottelingen en zeldzame masterclasses.
            </p>
            <form class="newsletter-form" onsubmit="event.preventDefault(); const inp = this.querySelector('input'); if(inp && inp.value){ alert('✓ Hartelijk dank! U bent succesvol ingeschreven voor de nieuwsbrief van International Whisky Festival.'); inp.value = ''; }">
              <input type="email" placeholder="Uw e-mailadres invoeren..." required class="newsletter-input" />
              <button type="submit" class="btn-newsletter-submit">Inschrijven</button>
            </form>
          </div>
        </div>
      </div>
    </div>

    <!-- 3. MAIN FOOTER 4-COLUMN GRID (Info, Nav, Account, Google Map) -->
    <div class="footer-grid">
      
      <!-- COL 1: ORGANISATIE & INFO -->
      <div class="footer-col brand-col">
        <div class="footer-brand-badge">
          <span class="badge-est">Est. 2000</span>
          <h4 class="badge-name">International Whisky Festival</h4>
          <span class="badge-city">Den Haag</span>
        </div>
        <p class="brand-pitch">Al meer dan 26 jaar het meest toonaangevende en sfeervolle whisky evenement in de historische Grote Kerk van Den Haag.</p>
        <div class="contact-box">
          <p class="contact-line"><strong>Locatie:</strong> Grote Kerk Den Haag</p>
          <p class="contact-line"><strong>Adres:</strong> Rond de Grote Kerk 12, 2513 AM Den Haag</p>
          <p class="contact-line"><strong>E-mail:</strong> <a href="mailto:info@whiskyfestival.nl" class="footer-gold-link">info@whiskyfestival.nl</a></p>
        </div>
      </div>

      <!-- COL 2: FESTIVAL & PROGRAMMA -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Festival & Programma</h4>
        <div class="footer-links-list">
          <a href="/#sessies" class="footer-link">Sessies & Entreetickets</a>
          <a href="/#sessies" class="footer-link">Masterclasses & Tastings</a>
          <a href="/standhouders" class="footer-link">Plattegrond & Stands</a>
          <a href="/kaart" class="footer-link">Interactieve Whisky Kaart</a>
          <a href="/#ervaring" class="footer-link">De Festival Beleving</a>
          <a href="/#historie" class="footer-link">Historie & Oprichting</a>
          <a href="/#faq" class="footer-link">Veelgestelde Vragen (FAQ)</a>
        </div>
      </div>

      <!-- COL 3: BEZOEKERS & TICKETS -->
      <div class="footer-col links-col">
        <h4 class="footer-col-title">Bezoekers & Account</h4>
        <div class="footer-links-list">
          <a href="/account" class="footer-link">Mijn Account (Portal)</a>
          <a href="/account" class="footer-link">Digitale E-Tickets Downloaden</a>
          <a href="/account" class="footer-link">Tickets Delen (WhatsApp/Mail)</a>
          <a href="/standhouders" class="footer-link">Aanwezige Merken</a>
          <a href="/account" class="footer-link">Praktische Informatie & Bereikbaarheid</a>
          <a href="/#faq" class="footer-link">Huisregels & 18+ Beleid</a>
        </div>
      </div>

      <!-- COL 4: INTERACTIVE GOOGLE MAPS EMBED -->
      <div class="footer-col map-col">
        <h4 class="footer-col-title">Locatie & Route</h4>
        <div class="footer-map-card">
          <div class="map-iframe-wrapper">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2452.880016462706!2d4.305591976865267!3d52.0773950691501!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c5b73d9e9e1c31%3A0xc3f6be73bb9024f2!2sGrote%20Kerk%20Den%20Haag!5e0!3m2!1snl!2snl!4v1700000000000!5m2!1snl!2snl" 
              width="100%" 
              height="160" 
              style="border:0; display:block; border-radius:6px;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Locatie Grote Kerk Den Haag"
            ></iframe>
          </div>
          <div class="map-footer-action">
            <span class="map-venue-label">Grote Kerk Den Haag</span>
            <a href="https://maps.google.com/?q=Grote+Kerk+Den+Haag" target="_blank" rel="noopener noreferrer" class="btn-map-route">
              Open Routeplanner →
            </a>
          </div>
        </div>
      </div>

    </div>

    <!-- 4. BOTTOM CREDITS & 18+ SAFETY BAR -->
    <div class="footer-bottom">
      <div class="footer-separator"></div>
      <div class="bottom-row">
        <p class="copyright">
          &copy; {new Date().getFullYear()} International Whisky Festival. Alle rechten voorbehouden.
        </p>

        <div class="safety-badges">
          <span class="safety-badge">GEEN 18, GEEN ALCOHOL</span>
          <span class="safety-badge-text">Geniet, maar drink met mate.</span>
        </div>
      </div>
    </div>

  </div>
</footer>

<style>
  /* Base Site Footer with City Theme Color */
  .site-footer {
    background-color: #006448;
    color: #FAF7F2;
    position: relative;
    padding-top: 3.5rem;
    margin-top: 0;
    font-family: var(--font-sans, 'Plus Jakarta Sans', sans-serif);
    overflow: hidden;
  }

  /* Paper Rip Transition on top */
  .torn-edge-wrap {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 20;
    line-height: 0;
    transform: translateY(-98%);
    filter: drop-shadow(0px 8px 12px rgba(0, 0, 0, 0.45));
    pointer-events: none;
  }

  .torn-edge-img {
    display: block;
    width: 100%;
    height: 48px;
    object-fit: cover;
  }

  .footer-inner {
    max-width: 1380px;
    margin: 0 auto;
    padding: 2rem 2rem 3rem;
  }

  /* ----------------------------------------------------
     1. 3 FESTIVALS CROSS-LINK LOGO STRIP
     ---------------------------------------------------- */
  .footer-festivals-crosslink {
    margin-bottom: 4rem;
    background: rgba(0, 0, 0, 0.18);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 2.5rem 2rem;
    backdrop-filter: blur(8px);
  }

  .crosslink-header {
    text-align: center;
    max-width: 700px;
    margin: 0 auto 2.25rem;
  }

  .crosslink-tag {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #D5C28A;
    display: block;
    margin-bottom: 0.4rem;
  }

  .crosslink-title {
    font-family: var(--font-display, 'bourbon-rough', serif);
    font-size: 1.85rem;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    margin-bottom: 0.5rem;
  }

  .crosslink-gold-line {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, transparent, #D5C28A, transparent);
    margin: 0.75rem auto 1rem;
  }

  .crosslink-subtitle {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
  }

  .festivals-logo-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .festival-logo-card {
    background: rgba(255, 255, 255, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: #FFFFFF;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
    overflow: hidden;
  }

  .festival-logo-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(213, 194, 138, 0.12) 0%, transparent 70%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .festival-logo-card:hover {
    transform: translateY(-4px);
    border-color: #D5C28A;
    background: rgba(255, 255, 255, 0.12);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.35);
  }

  .festival-logo-card:hover::before {
    opacity: 1;
  }

  .festival-logo-card.is-current {
    border-color: #D5C28A;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 16px rgba(213, 194, 138, 0.15);
  }

  .logo-svg-stage {
    width: 80px;
    height: 105px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
    transition: transform 0.3s ease;
  }

  .festival-logo-card:hover .logo-svg-stage {
    transform: scale(1.06);
  }

  .logo-svg-stage :global(svg) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 4px 10px rgba(0, 0, 0, 0.3));
  }

  .card-info {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
  }

  .card-city-name {
    font-family: var(--font-display, 'bourbon-rough', serif);
    font-size: 1.25rem;
    letter-spacing: 0.08em;
    color: #FFFFFF;
  }

  .card-venue {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.75);
    font-weight: 500;
  }

  .card-badge {
    margin-top: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #D5C28A;
    padding: 0.3rem 0.85rem;
    border-radius: 20px;
    background: rgba(0, 0, 0, 0.25);
    border: 1px solid rgba(213, 194, 138, 0.3);
    transition: all 0.2s ease;
  }

  .festival-logo-card:hover .card-badge {
    background: #D5C28A;
    color: #171614;
    border-color: #D5C28A;
  }

  /* ----------------------------------------------------
     2. NEWSLETTER CARD
     ---------------------------------------------------- */
  .newsletter-section {
    margin-bottom: 4.5rem;
  }

  .newsletter-card {
    background-color: rgba(0, 0, 0, 0.24);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 10px;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
  }

  .newsletter-border {
    border: 1px dashed rgba(255, 255, 255, 0.25);
    padding: 2.75rem 2rem;
    border-radius: 8px;
  }

  .newsletter-content {
    max-width: 720px;
    margin: 0 auto;
    text-align: center;
  }

  .newsletter-mini-tag {
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #D5C28A;
    display: block;
    margin-bottom: 0.35rem;
  }

  .newsletter-title {
    color: #FFFFFF;
    font-size: 1.9rem;
    margin-bottom: 0.65rem;
    font-family: var(--font-display, 'bourbon-rough', serif);
    letter-spacing: 0.04em;
  }

  .newsletter-desc {
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.95rem;
    margin-bottom: 1.75rem;
    line-height: 1.6;
  }

  .newsletter-form {
    display: flex;
    gap: 0.75rem;
    max-width: 540px;
    margin: 0 auto;
  }

  .newsletter-input {
    flex: 1;
    background-color: rgba(0, 0, 0, 0.35);
    border: 1.5px solid rgba(255, 255, 255, 0.25);
    color: #FFFFFF;
    padding: 0.85rem 1.25rem;
    font-family: var(--font-sans, sans-serif);
    font-size: 0.95rem;
    border-radius: 6px;
    transition: all 0.3s;
  }

  .newsletter-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: #D5C28A;
    background-color: rgba(0, 0, 0, 0.5);
    box-shadow: 0 0 12px rgba(213, 194, 138, 0.35);
  }

  .btn-newsletter-submit {
    padding: 0.85rem 2rem;
    background-color: #D5C28A;
    color: #171614;
    font-family: var(--font-sans, sans-serif);
    font-weight: 800;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-newsletter-submit:hover {
    background-color: #E9DFB7;
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.3);
  }

  /* ----------------------------------------------------
     3. 4-COLUMN MAIN FOOTER GRID
     ---------------------------------------------------- */
  .footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.3fr;
    gap: 3.5rem;
    margin-bottom: 4rem;
  }

  .footer-col {
    display: flex;
    flex-direction: column;
  }

  .footer-col-title {
    font-size: 1.15rem;
    color: #FFFFFF;
    margin-bottom: 1.5rem;
    position: relative;
    padding-bottom: 0.65rem;
    letter-spacing: 0.06em;
    font-family: var(--font-display, 'bourbon-rough', serif);
  }

  .footer-col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 40px;
    height: 2px;
    background-color: #D5C28A;
  }

  /* Column 1: Brand badge */
  .footer-brand-badge {
    display: inline-flex;
    flex-direction: column;
    border: 1px solid rgba(255, 255, 255, 0.2);
    padding: 0.75rem 1.25rem;
    margin-bottom: 1.25rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 6px;
    max-width: 280px;
  }

  .badge-est {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #D5C28A;
  }

  .badge-name {
    font-family: var(--font-display, 'bourbon-rough', serif);
    font-size: 1.35rem;
    color: #FFFFFF;
    letter-spacing: 0.04em;
    margin: 0.2rem 0;
  }

  .badge-city {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.7);
  }

  .brand-pitch {
    font-size: 0.92rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.7;
    margin-bottom: 1.5rem;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.85);
  }

  .footer-gold-link {
    color: #D5C28A;
    text-decoration: none;
    font-weight: 600;
    transition: color 0.2s;
  }

  .footer-gold-link:hover {
    color: #FFFFFF;
    text-decoration: underline;
  }

  /* Link Lists */
  .footer-links-list {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .footer-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.78);
    text-decoration: none;
    transition: all 0.2s ease;
    display: inline-block;
  }

  .footer-link:hover {
    color: #D5C28A;
    transform: translateX(4px);
  }

  /* Column 4: Google Maps */
  .footer-map-card {
    background: rgba(0, 0, 0, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 8px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .map-iframe-wrapper {
    overflow: hidden;
    border-radius: 6px;
  }

  .map-footer-action {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.25rem 0.4rem;
  }

  .map-venue-label {
    font-size: 0.82rem;
    font-weight: 700;
    color: #FFFFFF;
  }

  .btn-map-route {
    font-size: 0.78rem;
    font-weight: 700;
    color: #D5C28A;
    text-decoration: none;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid rgba(213, 194, 138, 0.3);
    transition: all 0.2s;
    white-space: nowrap;
  }

  .btn-map-route:hover {
    background: #D5C28A;
    color: #171614;
  }

  /* ----------------------------------------------------
     4. BOTTOM ROW & 18+ BADGE
     ---------------------------------------------------- */
  .footer-separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
    margin-bottom: 2rem;
  }

  .bottom-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.5rem;
  }

  .copyright {
    font-size: 0.84rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .safety-badges {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .safety-badge {
    background-color: #A81818;
    color: #FFFFFF;
    font-weight: 800;
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: 3px;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.3);
  }

  .safety-badge-text {
    font-family: var(--font-serif, serif);
    font-style: italic;
    font-size: 0.88rem;
    color: rgba(255, 255, 255, 0.7);
  }

  /* ----------------------------------------------------
     RESPONSIVE MEDIA QUERIES
     ---------------------------------------------------- */
  @media (max-width: 1100px) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
    .festivals-logo-row {
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (max-width: 800px) {
    .site-footer {
      padding-top: 3rem;
    }
    .festivals-logo-row {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .newsletter-form {
      flex-direction: column;
    }
    .btn-newsletter-submit {
      width: 100%;
    }
    .bottom-row {
      flex-direction: column;
      text-align: center;
      gap: 1rem;
    }
  }
</style>
