<script>
  (function initContactChoiceModal() {
    const modal = document.getElementById('contact-choice-modal');
    const closeBtn = document.getElementById('close-contact-modal-btn');
    const copyBtn = document.getElementById('copy-contact-email-btn');
    const copyTitle = document.getElementById('copy-contact-email-title');
    const copyBadge = document.getElementById('copy-contact-email-badge');

    function openContactModal(e?: Event) {
      if (e) e.preventDefault();
      if (!modal) return;
      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');
    }

    function closeContactModal() {
      if (!modal) return;
      modal.classList.remove('is-open');
      modal.setAttribute('aria-hidden', 'true');
    }

    document.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const trigger = target.closest('.js-open-contact-modal');
      if (trigger) {
        openContactModal(e);
        return;
      }
      if (modal && target === modal) {
        closeContactModal();
      }
    });

    if (closeBtn) {
      closeBtn.addEventListener('click', closeContactModal);
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('is-open')) {
        closeContactModal();
      }
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        const email = copyBtn.getAttribute('data-email') || 'info@whiskyfestival.nl';
        try {
          await navigator.clipboard.writeText(email);
          if (copyTitle) copyTitle.textContent = 'E-mailadres gekopieerd!';
          if (copyBadge) copyBadge.textContent = 'Gekopieerd';
          setTimeout(() => {
            if (copyTitle) copyTitle.textContent = 'Kopieer E-mailadres';
            if (copyBadge) copyBadge.textContent = 'Kopieer';
          }, 2500);
        } catch (err) {
          window.location.href = `mailto:${email}`;
        }
      });
    }
  })();
</script>
