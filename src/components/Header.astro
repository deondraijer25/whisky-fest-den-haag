    .header-cart-btn,
    .mobile-menu-toggle-btn {
      width: 44px !important;
      height: 44px !important;
      min-width: 44px !important;
      min-height: 44px !important;
      max-width: 44px !important;
      max-height: 44px !important;
      border-radius: 6px !important;
      border: 2px solid var(--text-charcoal, #1D1C1A) !important;
      box-shadow: 2px 2px 0px var(--text-charcoal, #1D1C1A) !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 !important;
      margin: 0 !important;
      box-sizing: border-box !important;
      cursor: pointer !important;
      flex-shrink: 0 !important;
    }
    .header-cart-btn {
      background: #006448 !important;
      color: #FFFFFF !important;
    }
    .header-cart-btn svg {
      width: 22px !important;
      height: 22px !important;
      stroke: #FFFFFF !important;
      stroke-width: 2.2 !important;
      display: block !important;
    }
    .mobile-menu-toggle-btn {
      background: #FFFFFF !important;
      color: var(--text-charcoal, #1D1C1A) !important;
    }
    .mobile-menu-toggle-btn svg {
      width: 22px !important;
      height: 22px !important;
      stroke: var(--text-charcoal, #1D1C1A) !important;
      stroke-width: 2.5 !important;
      display: block !important;
    .header-cart-dropdown {
      display: none !important;
    }
  }
</style>

<script>
  // Dynamic header transitions based on page scroll
  const header = document.querySelector('.main-header');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 40) {
        header.classList.add('sticky-header');
      } else {
        header.classList.remove('sticky-header');
      }
    }
  });

  // Global Header Cart Synchronization with LocalStorage
  const cartBtn = document.getElementById('header-cart-btn');
  const cartDropdown = document.getElementById('header-cart-dropdown');
  const cartBadge = document.getElementById('header-cart-badge');
  const cartCount = document.getElementById('header-cart-count');
  const cartList = document.getElementById('header-cart-list');
  const cartBottom = document.getElementById('header-cart-bottom');
  const cartSubtotal = document.getElementById('header-cart-subtotal');
  const dropdownCheckoutBtn = document.getElementById('header-dropdown-checkout-btn');

  function getStoredCart() {
    try {
      const raw = localStorage.getItem('whiskyfest_cart');
      if (!raw) return { items: [], subtotal: 0, totalItems: 0, cartRaw: {} };
      const parsed = JSON.parse(raw);
      if (!parsed || typeof parsed !== 'object') return { items: [], subtotal: 0, totalItems: 0, cartRaw: {} };

      const cartRaw: Record<string, any> = {};
      const itemsList: any[] = [];

      if (parsed.cartRaw && typeof parsed.cartRaw === 'object') {
        Object.keys(parsed.cartRaw).forEach(id => {
          if (id === 'subtotal' || id === 'totalItems' || id === 'items' || id === 'cartRaw') return;
          const it = parsed.cartRaw[id];
          if (!it) return;
          const qty = typeof it === 'number' ? it : it.qty;
          if (qty > 0) {
            const itemObj = typeof it === 'object' ? { ...it, id } : { id, title: id, price: 0, qty };
            cartRaw[id] = itemObj;
            itemsList.push(itemObj);
          }
        });
      } else if (Array.isArray(parsed.items)) {
        parsed.items.forEach(it => {
          if (it && it.id && it.qty > 0) {
            cartRaw[it.id] = { ...it };
            itemsList.push({ ...it });
          }
        });
      } else {
        Object.keys(parsed).forEach(id => {
          if (id === 'subtotal' || id === 'totalItems' || id === 'items' || id === 'cartRaw') return;
          const it = parsed[id];
          if (!it) return;
          const qty = typeof it === 'number' ? it : it.qty;
          if (qty > 0) {
            const itemObj = typeof it === 'object' ? { ...it, id } : { id, title: id, price: 0, qty };
            cartRaw[id] = itemObj;
            itemsList.push(itemObj);
          }
        });
      }

      const totalItems = itemsList.reduce((acc: number, item: any) => acc + (item.qty || 0), 0);
      const subtotal = itemsList.reduce((acc: number, item: any) => acc + ((item.price || 0) * (item.qty || 0)), 0);

      return {
        items: itemsList,
        subtotal: subtotal,
        totalItems: totalItems,
        cartRaw: cartRaw
      };
    } catch(e) {
      return { items: [], subtotal: 0, totalItems: 0, cartRaw: {} };
    }
  }

  function updateHeaderCartUI() {
    const cart = getStoredCart();
    const items = cart.items || [];
    const totalCount = items.reduce((acc: number, item: any) => acc + (item.qty || 0), 0);
    const subtotal = items.reduce((acc: number, item: any) => acc + (item.price * item.qty), 0);

    if (cartBadge) {
      if (totalCount > 0) {
        cartBadge.textContent = totalCount.toString();
        cartBadge.style.display = 'flex';
      } else {
        cartBadge.style.display = 'none';
      }
    }

    if (cartBtn) {
      cartBtn.classList.remove('cart-bump');
      void cartBtn.offsetWidth; // Trigger reflow
      if (totalCount > 0) cartBtn.classList.add('cart-bump');
    }

    if (cartCount) {
      cartCount.textContent = `${totalCount} ${totalCount === 1 ? 'item' : 'items'}`;
    }

    if (cartSubtotal) {
      cartSubtotal.innerHTML = `&euro; ${subtotal.toFixed(2).replace('.', ',')}`;
    }

    if (cartList) {
      if (items.length === 0) {
        cartList.innerHTML = '<p class="empty-dropdown-msg">Uw winkelwagen is leeg.</p>';
        if (cartBottom) cartBottom.style.display = 'none';
      } else {
        let html = '';
        items.forEach((item: any) => {
          const totalVal = (item.price * item.qty).toFixed(2).replace('.', ',');
          html += `
            <div class="cart-dropdown-row" data-id="${item.id}">
              <div class="hdr-cart-stepper">
                <button type="button" class="hdr-cart-btn-qty hdr-minus" data-id="${item.id}" aria-label="Kaartje verminderen" title="${item.qty === 1 ? 'Verwijderen uit winkelwagen' : 'Kaartje verminderen'}">&minus;</button>
                <span class="hdr-cart-qty-text">${item.qty}x</span>
                <button type="button" class="hdr-cart-btn-qty hdr-plus" data-id="${item.id}" aria-label="Kaartje toevoegen" title="Kaartje toevoegen">+</button>
              </div>
              <span class="cart-row-title" title="${item.title}">${item.title}</span>
              <span class="cart-row-price">&euro; ${totalVal}</span>
            </div>
          `;
        });
        cartList.innerHTML = html;
        if (cartBottom) cartBottom.style.display = 'flex';
      }
    }
  }

  // Delegated click listener for direct quantity adjustments in header cart dropdown
  if (cartList) {
    cartList.addEventListener('click', (e) => {
      const target = e.target as HTMLElement;
      const btn = target.closest('.hdr-cart-btn-qty') as HTMLButtonElement;
      if (!btn) return;

      e.preventDefault();
      e.stopPropagation();

      const id = btn.getAttribute('data-id');
      if (!id) return;
      const isPlus = btn.classList.contains('hdr-plus');

      try {
        const raw = localStorage.getItem('whiskyfest_cart');
        if (!raw) return;
        const parsed = JSON.parse(raw);
        const cartRaw = parsed.cartRaw || {};
        let items = parsed.items || [];

        let currentItem = cartRaw[id];
        if (!currentItem) {
          const found = items.find((x: any) => x.id === id);
          if (found) {
            cartRaw[id] = { ...found };
            currentItem = cartRaw[id];
          }
        }

        if (!currentItem) return;

        if (isPlus) {
          currentItem.qty = Math.min(10, (currentItem.qty || 0) + 1);
        } else {
          currentItem.qty = (currentItem.qty || 0) - 1;
        }

        if (currentItem.qty <= 0) {
          currentItem.qty = 0;
          delete cartRaw[id];
          items = items.filter((x: any) => x.id !== id);
        } else {
          const it = items.find((x: any) => x.id === id);
          if (it) it.qty = currentItem.qty;
        }

        const activeItems = Object.keys(cartRaw)
          .filter(k => cartRaw[k] && cartRaw[k].qty > 0)
          .map(k => {
            const it = cartRaw[k];
            return {
              id: k,
              title: it.title,
              price: it.price,
              qty: it.qty,
              category: it.category || 'entree',
              date: it.date || '',
              time: it.time || ''
            };
          });

        const newSubtotal = activeItems.reduce((sum: number, it: any) => sum + (it.price * it.qty), 0);
        const newTotalItems = activeItems.reduce((sum: number, it: any) => sum + it.qty, 0);

        localStorage.setItem('whiskyfest_cart', JSON.stringify({
          subtotal: newSubtotal,
          totalItems: newTotalItems,
          items: activeItems,
          cartRaw
        }));

        updateHeaderCartUI();

        // Dispatch cart-updated with source: 'header'
        window.dispatchEvent(new CustomEvent('cart-updated', {
          detail: { id, source: 'header' }
        }));
      } catch(err) {
        console.error('Error modifying header cart item:', err);
      }
    });
  }

  if (cartBtn) {
    cartBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (window.innerWidth <= 990) {
        if (cartDropdown) cartDropdown.classList.remove('active');
        window.dispatchEvent(new CustomEvent('open-mobile-cart-drawer'));
        return;
      }
      if (cartDropdown) {
        cartDropdown.classList.toggle('active');
      }
    });

    if (cartDropdown) {
      document.addEventListener('click', (e) => {
        if (!cartDropdown.contains(e.target as Node) && e.target !== cartBtn) {
          cartDropdown.classList.remove('active');
        }
      });
    }
  }

  // Handle Checkout Click from Dropdown
  if (dropdownCheckoutBtn) {
    dropdownCheckoutBtn.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        const cart = getStoredCart();
        if (cart.items && cart.items.length > 0) {
          const checkoutTrigger = document.getElementById('checkout-trigger-btn');
          if (checkoutTrigger) {
            e.preventDefault();
            cartDropdown?.classList.remove('active');
            checkoutTrigger.click();
          }
        }
      }
    });
  }

  window.addEventListener('storage', updateHeaderCartUI);
  window.addEventListener('cart-updated', updateHeaderCartUI);
  document.addEventListener('DOMContentLoaded', updateHeaderCartUI);
  updateHeaderCartUI();

  // Header Account Dropdown Logic
  const accountBtn = document.getElementById('header-account-btn');
  const accountDropdown = document.getElementById('header-account-dropdown');
  const accountUserName = document.getElementById('header-account-user-name');
  const loggedInView = document.getElementById('header-account-logged-in');
  const loggedOutView = document.getElementById('header-account-logged-out');
  const navLogoutBtn = document.getElementById('header-nav-logout-btn');
  const navLoginBtn = document.querySelector('.btn-drop-login');

  function updateHeaderAccountState() {
    const isLoggedOut = localStorage.getItem('wf_user_logged_out') === 'true';
    const storedOrder = localStorage.getItem('wf_last_order');
    const storedAuth = sessionStorage.getItem('wf_auth_session') || localStorage.getItem('wf_auth_session');

    let userName = 'Deon Draijer';

    if (storedOrder) {
      try {
        const p = JSON.parse(storedOrder);
        if (p.name) userName = p.name;
      } catch(e) {}
    } else if (storedAuth) {
      try {
        const s = JSON.parse(storedAuth);
        if (s.name) userName = s.name;
        else if (s.email) userName = s.email.split('@')[0];
      } catch(e) {}
    }

    if (accountUserName) {
      accountUserName.textContent = userName;
    }

    if (isLoggedOut) {
      if (loggedInView) loggedInView.style.display = 'none';
      if (loggedOutView) loggedOutView.style.display = 'block';
    } else {
      if (loggedInView) loggedInView.style.display = 'block';
      if (loggedOutView) loggedOutView.style.display = 'none';
    }
  }

  if (accountBtn && accountDropdown) {
    accountBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close cart if open
      if (cartDropdown) cartDropdown.classList.remove('active');
      accountDropdown.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      if (!accountDropdown.contains(e.target as Node) && e.target !== accountBtn) {
        accountDropdown.classList.remove('active');
      }
    });
  }

  if (navLogoutBtn) {
    navLogoutBtn.addEventListener('click', (e) => {
      e.preventDefault();
      localStorage.setItem('wf_user_logged_out', 'true');
      sessionStorage.removeItem('wf_auth_session');
      localStorage.removeItem('wf_auth_session');
      if (accountDropdown) accountDropdown.classList.remove('active');
      updateHeaderAccountState();
      
      // If on account page, reload or redirect
      if (window.location.pathname.startsWith('/account')) {
        window.location.href = '/account';
      }
    });
  }

  if (navLoginBtn) {
    navLoginBtn.addEventListener('click', () => {
      localStorage.removeItem('wf_user_logged_out');
    });
  }

  window.addEventListener('storage', updateHeaderAccountState);
  document.addEventListener('DOMContentLoaded', updateHeaderAccountState);
  updateHeaderAccountState();

  // Mobile Nav Drawer Toggle
  const mobileToggleBtn = document.getElementById('mobile-menu-toggle-btn');
  const mobileNavDrawer = document.getElementById('mobile-nav-drawer');
  const mobileCloseBtn = document.getElementById('mobile-nav-close-btn');
  const mobileBackdrop = document.getElementById('mobile-nav-backdrop');

  function openMobileNav() {
    if (mobileNavDrawer) {
      mobileNavDrawer.classList.add('active');
      mobileNavDrawer.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeMobileNav() {
    if (mobileNavDrawer) {
      mobileNavDrawer.classList.remove('active');
      mobileNavDrawer.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    }
  }

  if (mobileToggleBtn) {
    mobileToggleBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      openMobileNav();
    });
  }

  if (mobileCloseBtn) {
    mobileCloseBtn.addEventListener('click', closeMobileNav);
  }

  if (mobileBackdrop) {
    mobileBackdrop.addEventListener('click', closeMobileNav);
  }

  // Close drawer on ESC key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeMobileNav();
  });

  // Close drawer on link click
  document.querySelectorAll('.mobile-nav-item, .btn-mobile-drawer-cta').forEach(link => {
    link.addEventListener('click', closeMobileNav);
  });
</script>
