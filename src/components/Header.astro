  }

  /* Cart Wrapper & Button */
  .header-cart-wrapper {
    position: relative;
  }

  .header-cart-btn {
    position: relative;
    background-color: var(--whisky-gold-dark);
    border: 2px solid var(--text-charcoal);
    color: var(--bg-parchment, #FAF7F2);
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 4px 4px 0px rgba(29, 28, 26, 0.9);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    padding: 0;
  }

  .header-cart-btn:hover {
    background-color: var(--text-charcoal);
    color: var(--whisky-gold-light);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px rgba(29, 28, 26, 0.9);
  }

  .header-cart-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px rgba(29, 28, 26, 0.9);
  }.header-cart-btn.cart-bump {
    animation: cartBump 0.3s ease;
  }

  @keyframes cartBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.18); color: var(--whisky-gold-dark); }
    100% { transform: scale(1); }
  }

  .header-cart-badge {
    position: absolute;
    top: -7px;
    right: -7px;
    background-color: var(--brand-red, #E30613);
    color: #FFF;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg-paper-card);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    z-index: 10;
  }

  /* Dropdown Menu (Centered under cart icon with caret pointer) */
  .header-cart-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    width: 440px;
    max-width: min(440px, calc(100vw - 2rem));
