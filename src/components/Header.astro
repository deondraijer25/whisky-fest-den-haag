  .btn-dropdown-checkout {
    width: 100%;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1.25rem;
    text-decoration: none;
