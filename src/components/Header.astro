    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--whisky-gold-dark);
  }

  .user-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-charcoal);
  }

  .account-dropdown-menu {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .account-drop-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-charcoal);
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.15s ease;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  .account-drop-item:hover {
    background: rgba(197, 139, 57, 0.12);
    color: var(--whisky-gold-dark);
  }

  .account-dropdown-divider {
    height: 1px;
    background: var(--border-color, #E2D9CC);
    margin: 0.2rem 0;
  }

  .account-drop-item.logout-btn {
    color: var(--brand-red, #E30613);
  }

  .account-drop-item.logout-btn:hover {
    background: rgba(227, 6, 19, 0.08);
