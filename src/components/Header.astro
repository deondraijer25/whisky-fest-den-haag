---
// src/components/Header.astro
import LogoSvg from '../assets/Logo/Logo.svg?raw';

const pathname = Astro.url.pathname;
const isStandhouders = pathname.startsWith("/standhouders");
const isProgramma = pathname.startsWith("/programma");
const isAccount = pathname.startsWith("/account");
---

<header class="main-header animate-fade-in">
  <div class="top-announcement-bar">
    Sluit je aan bij duizenden whiskyliefhebbers in Den Haag – Bestel vandaag nog je tickets!
  </div>
  <div class="header-container">
    <!-- Overlapping Logo Image (links to Home) -->
    <a href="/" class="logo-image-container" aria-label="Whisky Fest Den Haag Home">
      <Fragment set:html={LogoSvg} />
    </a>

    <!-- Navigation links -->
    <nav class="nav-menu">
      <!-- 1. TICKETS DROPDOWN -->
      <div class="header-nav-dropdown-wrapper" id="header-tickets-wrapper">
        <a href="/#sessies" class="nav-link nav-dropdown-trigger" id="nav-tickets-trigger">
          <span>Tickets</span>
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="header-nav-dropdown" id="header-tickets-dropdown">
          <a href="/?cat=all#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Alle Tickets</span>
            <span class="nav-drop-sub">Overzicht van alle beschikbare festivaltickets</span>
          </a>
          <a href="/?cat=entree#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Sessie Entreetickets</span>
            <span class="nav-drop-sub">VIP, vrijdag-, zaterdag- &amp; zondagsessies</span>
          </a>
          <a href="/?cat=masterclass#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Masterclasses</span>
            <span class="nav-drop-sub">Exclusieve proeverijen in Nutshuis &amp; Toren</span>
          </a>
          <a href="/?cat=tram#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Haagsche Whiskytram</span>
            <span class="nav-drop-sub">4 drams tijdens een historische tramrit</span>
          </a>
          <a href="/?cat=trail#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Whisky Trails (Gidsen)</span>
            <span class="nav-drop-sub">Rondleidingen met onze 5 gidsen</span>
          </a>
          <a href="/?cat=warehouse#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Warehouse Tastings</span>
            <span class="nav-drop-sub">Intieme proeverijen direct aan de stands</span>
          </a>
          <a href="/?cat=botteling#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Festival Bottelingen</span>
            <span class="nav-drop-sub">Gelimiteerde single cask flessen</span>
          </a>
        </div>
      </div>

      <!-- 2. PLATTEGROND & STANDS -->
      <a href="/standhouders" class={`nav-link ${isStandhouders ? 'active' : ''}`}>Plattegrond &amp; Stands</a>

      <!-- 3. PROGRAMMA DROPDOWN -->
      <div class="header-nav-dropdown-wrapper" id="header-programma-wrapper">
        <a href="/programma" class={`nav-link nav-dropdown-trigger ${isProgramma ? 'active' : ''}`} id="nav-programma-trigger">
          <span>Programma</span>
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="header-nav-dropdown" id="header-programma-dropdown">
          <a href="/programma" class="nav-dropdown-item">
            <span class="nav-drop-title">Festival Programma</span>
            <span class="nav-drop-sub">Masterclasses, tram &amp; proeverijen</span>
          </a>
          <a href="/programma?view=gidsen" class="nav-dropdown-item">
            <span class="nav-drop-title">Gidsen Planning</span>
            <span class="nav-drop-sub">Whisky trails &amp; tijdsloten</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Header Actions: 1. Cart Icon > 2. Bestel Tickets > 3. Mijn Account (Text link) -->
    <div class="header-actions">
      <!-- 1. Header Cart Trigger & Dropdown -->
      <div class="header-cart-wrapper" id="header-cart-wrapper">
        <button type="button" class="header-cart-btn" id="header-cart-btn" aria-label="Winkelwagen openen" title="Winkelwagen">
          <svg class="cart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="header-cart-badge" id="header-cart-badge" style="display: none;">0</span>
        </button>

        <!-- Dropdown Menu (Generous width & clean structured table) -->
        <div class="header-cart-dropdown" id="header-cart-dropdown">
          <div class="cart-dropdown-head">
            <div class="cart-dropdown-title-wrap">
              <h4 class="cart-dropdown-title">Uw Winkelwagen</h4>
            </div>
            <span class="cart-dropdown-badge-count" id="header-cart-count">0 items</span>
          </div>

          <div class="cart-dropdown-list" id="header-cart-list">
            <p class="empty-dropdown-msg">Uw winkelwagen is leeg.</p>
          </div>

          <div class="cart-dropdown-bottom" id="header-cart-bottom" style="display: none;">
            <div class="cart-dropdown-subtotal-row">
              <span class="subtotal-label">Subtotaal:</span>
              <strong class="subtotal-val" id="header-cart-subtotal">€ 0,00</strong>
            </div>
            <a href="/#sessies" class="btn btn-gold btn-dropdown-checkout" id="header-dropdown-checkout-btn">
              Naar Kassa & Afrekenen →
            </a>
          </div>
        </div>
      </div>

      <!-- 2. Bestel Tickets Button -->
      <a href="/#sessies" class="btn btn-gold btn-header">Bestel Tickets</a>

      <!-- 3. Mijn Account (Dropdown Menu) -->
      <div class="header-account-wrapper" id="header-account-wrapper">
        <button type="button" class={`header-account-btn ${isAccount ? 'active' : ''}`} id="header-account-btn" aria-label="Mijn Account menu openen">
          <span>Mijn Account</span>
          <svg class="account-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="header-account-dropdown" id="header-account-dropdown">
          <div id="header-account-logged-in">
            <div class="account-dropdown-user">
              <span class="user-greeting">Bezoekers Portaal</span>
              <strong class="user-name" id="header-account-user-name">Mijn Account</strong>
            </div>

            <div class="account-dropdown-menu">
              <a href="/account" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Mijn Tickets</span>
              </a>
              <a href="/account?tab=tab-profile" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>Persoonsgegevens</span>
              </a>
              <a href="/account?tab=tab-info" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                <span>Plattegrond &amp; Info</span>
              </a>
            </div>

            <div class="account-dropdown-divider"></div>

            <button type="button" class="account-drop-item logout-btn" id="header-nav-logout-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Uitloggen</span>
            </button>
          </div>

          <div id="header-account-logged-out" style="display: none;">
            <p class="account-drop-intro">Bekijk uw festivaltickets en beheer uw bestelling.</p>
            <a href="/account" class="btn btn-gold btn-drop-login">
              Inloggen bij Portaal →
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .main-header {
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(222, 214, 201, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg-paper-card);
  }

  .top-announcement-bar {
    background-color: var(--text-charcoal);
    color: var(--whisky-gold-light);
    text-align: center;
    padding: 0.65rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Sticky transition states */
  :global(.sticky-header) {
    position: sticky;
    top: 0;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--border-color);
    box-shadow: 0 4px 20px rgba(29, 28, 26, 0.04);
  }

  /* Overlapping Logo Styling */
  .logo-image-container {
    position: relative;
    display: inline-block;
    z-index: 110;
    height: 60px;
    width: 120px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .logo-image-container svg {
    position: absolute;
    top: -48px;
    left: 0;
    width: 120px;
    height: auto;
    filter: drop-shadow(0 5px 16px rgba(29, 28, 26, 0.2));
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center;
  }
  .logo-image-container:hover svg {
    transform: scale(1.05) rotate(-2deg);
    filter: drop-shadow(0 6px 20px rgba(197, 139, 57, 0.3));
  }

  /* Nav Links styling (Shifted to the right near cart & actions) */
  .nav-menu {
    display: flex;
    gap: 2.25rem;
    align-items: center;
    margin-left: auto;
    margin-right: 3rem;
  }
  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--whisky-gold-dark);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
  .nav-link.active {
    color: var(--whisky-gold-dark);
  }

  /* Header Actions Group */
  .header-actions {
    display: flex;
    gap: 1.35rem;
    align-items: center;
  }

  .btn-header {
    height: 48px;
    padding: 0 1.6rem;
    font-size: 1.12rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  
  
  /* Navigation Dropdowns with Rock-Solid Hover Bridge */
  .header-nav-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  /* Invisible hover bridge connecting trigger to menu */
  .header-nav-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -10px;
    right: -10px;
    height: 14px;
    background: transparent;
    z-index: 999;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .nav-chevron {
    transition: transform 0.2s ease;
  }

  .header-nav-dropdown-wrapper:hover .nav-chevron,
  .header-nav-dropdown-wrapper.open .nav-chevron {
    transform: rotate(180deg);
  }

  .header-nav-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 290px;
    background-color: #FFFFFF;
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 5px 5px 0px var(--text-charcoal);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 1000;
    animation: dropdownFade 0.15s ease-out;
  }

  .header-nav-dropdown-wrapper:hover .header-nav-dropdown,
  .header-nav-dropdown-wrapper.open .header-nav-dropdown {
    display: flex;
  }

  .nav-dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 3px;
    text-decoration: none;
    transition: all 0.15s ease;
    border-bottom: 1px dashed rgba(226, 217, 204, 0.6);
  }

  .nav-dropdown-item:last-child {
    border-bottom: none;
  }

  .nav-dropdown-item:hover {
    background: rgba(197, 139, 57, 0.12);
    transform: translateX(2px);
  }

  .nav-drop-title {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-charcoal);
  }

  .nav-drop-sub {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.25;
  }

  /* Mijn Account Clean Text Link */
  .header-account-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .header-account-link:hover {
    color: var(--whisky-gold-dark);
  }

  .header-account-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .header-account-link:hover::after,
  .header-account-link.active::after {
    width: 100%;
  }

  .header-account-link.active {
    color: var(--whisky-gold-dark);
  }

  
  /* Account Dropdown Styling */
  .header-account-wrapper {
    position: relative;
  }

  .header-account-btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    padding: 0.5rem 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.3s ease;
    white-space: nowrap;
    position: relative;
  }

  .header-account-btn:hover,
  .header-account-btn.active {
    color: var(--whisky-gold-dark);
  }

  .header-account-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .header-account-btn:hover::after,
  .header-account-btn.active::after {
    width: 100%;
  }

  .account-chevron {
    transition: transform 0.2s ease;
  }

  .header-account-dropdown.active ~ .header-account-btn .account-chevron,
  .header-account-wrapper.open .account-chevron {
    transform: rotate(180deg);
  }

  .header-account-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 250px;
    background-color: var(--bg-paper-card, #FAF7F2);
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 6px 6px 0px var(--text-charcoal);
    padding: 1.15rem 1rem;
    z-index: 1000;
    display: none;
    flex-direction: column;
    gap: 0.65rem;
    animation: dropdownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .header-account-dropdown.active {
    display: flex;
  }

  .account-dropdown-user {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-bottom: 1px solid var(--border-color, #E2D9CC);
    padding-bottom: 0.65rem;
  }

  .user-greeting {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 800;
    color: var(--whisky-gold-dark);
  }

  .user-name {
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--text-charcoal);
  }

  .account-dropdown-menu {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .account-drop-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.65rem;
    font-family: var(--font-sans);
    font-size: 0.84rem;
    font-weight: 700;
    color: var(--text-charcoal);
    text-decoration: none;
    border-radius: 3px;
    transition: all 0.15s ease;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
  }

  .account-drop-item:hover {
    background: rgba(197, 139, 57, 0.12);
    color: var(--whisky-gold-dark);
  }

  .account-dropdown-divider {
    height: 1px;
    background: var(--border-color, #E2D9CC);
    margin: 0.2rem 0;
  }

  .account-drop-item.logout-btn {
    color: var(--brand-red, #E30613);
  }

  .account-drop-item.logout-btn:hover {
    background: rgba(227, 6, 19, 0.08);
    color: #A8040E;
  }

  .account-drop-intro {
    font-family: var(--font-serif);
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.4;
    margin: 0 0 0.75rem 0;
  }

  .btn-drop-login {
    width: 100%;
    text-align: center;
    font-size: 0.82rem;
    font-weight: 800;
    padding: 0.6rem 0.85rem;
    text-decoration: none;
    display: block;
    border-radius: 3px;
  }

  /* Cart Wrapper & Button */
  .header-cart-wrapper {
    position: relative;
  }

  .header-cart-btn {
    position: relative;
    background-color: var(--whisky-gold-dark);
    border: 2px solid var(--text-charcoal);
    color: var(--bg-parchment, #FAF7F2);
    width: 48px;
    height: 48px;
    min-width: 48px;
    min-height: 48px;
    border-radius: 4px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 4px 4px 0px rgba(29, 28, 26, 0.9);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
    padding: 0;
  }

  .header-cart-btn:hover {
    background-color: var(--text-charcoal);
    color: var(--whisky-gold-light);
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0px rgba(29, 28, 26, 0.9);
  }

  .header-cart-btn:active {
    transform: translate(2px, 2px);
    box-shadow: 0px 0px 0px rgba(29, 28, 26, 0.9);
  }.header-cart-btn.cart-bump {
    animation: cartBump 0.3s ease;
  }

  @keyframes cartBump {
    0% { transform: scale(1); }
    50% { transform: scale(1.18); color: var(--whisky-gold-dark); }
    100% { transform: scale(1); }
  }

  .header-cart-badge {
    position: absolute;
    top: -7px;
    right: -7px;
    background-color: var(--brand-red, #E30613);
    color: #FFF;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    font-weight: 800;
    line-height: 1;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--bg-paper-card);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2);
    z-index: 10;
  }

  /* Dropdown Menu (Centered under cart icon with caret pointer) */
  .header-cart-dropdown {
    position: absolute;
    top: calc(100% + 14px);
    left: 50%;
    transform: translateX(-50%);
    width: 440px;
    max-width: min(440px, calc(100vw - 2rem));
    background-color: var(--bg-paper-card, #FAF7F2);
    border: 1.5px solid var(--border-color, #E2D9CC);
    border-radius: 10px;
    box-shadow: 0 16px 45px rgba(29, 28, 26, 0.14);
    padding: 1.35rem 1.35rem 1.15rem 1.35rem;
    z-index: 1000;
    display: none;
    flex-direction: column;
    gap: 0.95rem;
    animation: dropdownFade 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    box-sizing: border-box;
  }

  .header-cart-dropdown::before {
    content: '';
    position: absolute;
    top: -7px;
    left: 50%;
    transform: translateX(-50%) rotate(45deg);
    width: 12px;
    height: 12px;
    background-color: var(--bg-paper-card, #FAF7F2);
    border-top: 1.5px solid var(--border-color, #E2D9CC);
    border-left: 1.5px solid var(--border-color, #E2D9CC);
    z-index: 1;
  }

  .header-cart-dropdown.active {
    display: flex;
  }

  @keyframes dropdownFade {
    from { opacity: 0; transform: translate(-50%, -8px); }
    to { opacity: 1; transform: translate(-50%, 0); }
  }

  .cart-dropdown-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1.5px solid var(--border-color, #E2D9CC);
    padding-bottom: 0.75rem;
  }

  .cart-dropdown-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--text-charcoal, #1D1C1A);
    margin: 0;
    letter-spacing: 0.04em;
    line-height: 1;
    text-transform: uppercase;
  }

  .cart-dropdown-badge-count {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--brand-green, #006448);
    text-transform: uppercase;
    background: rgba(0, 100, 72, 0.08);
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    border: 1px solid rgba(0, 100, 72, 0.2);
    letter-spacing: 0.06em;
  }

  .cart-dropdown-list {
    max-height: 290px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 0;
    padding-right: 0.25rem;
  }

  .empty-dropdown-msg {
    font-family: var(--font-sans);
    font-size: 0.92rem;
    color: var(--text-muted);
    text-align: center;
    padding: 1.5rem 0;
    margin: 0;
  }

  /* Single-line item row with horizontal divider */
  :global(.cart-dropdown-row) {
    display: flex !important;
    align-items: center !important;
    justify-content: space-between !important;
    gap: 0.75rem !important;
    padding: 0.7rem 0 !important;
    border-bottom: 1px solid #E5DFD5 !important;
    width: 100% !important;
    box-sizing: border-box !important;
  }

  :global(.cart-dropdown-row:last-child) {
    border-bottom: none !important;
  }

  :global(.cart-row-qty) {
    font-family: var(--font-sans) !important;
    font-weight: 800 !important;
    font-size: 0.85rem !important;
    color: var(--brand-green, #006448) !important;
    background: rgba(0, 100, 72, 0.08) !important;
    padding: 0.2rem 0.45rem !important;
    border-radius: 4px !important;
    border: 1px solid rgba(0, 100, 72, 0.18) !important;
    flex-shrink: 0 !important;
    min-width: 28px !important;
    text-align: center !important;
    display: inline-block !important;
  }

  :global(.cart-row-title) {
    font-family: var(--font-sans) !important;
    font-weight: 700 !important;
    font-size: 0.88rem !important;
    color: var(--text-charcoal, #1D1C1A) !important;
    white-space: nowrap !important;
    overflow: hidden !important;
    text-overflow: ellipsis !important;
    flex: 1 !important;
    min-width: 0 !important;
    text-align: left !important;
  }

  :global(.cart-row-price) {
    font-family: var(--font-sans) !important;
    font-weight: 800 !important;
    font-size: 0.95rem !important;
    color: var(--text-charcoal, #1D1C1A) !important;
    white-space: nowrap !important;
    flex-shrink: 0 !important;
    text-align: right !important;
  }

  .cart-dropdown-bottom {
    border-top: 1.5px solid var(--border-color, #E2D9CC);
    padding-top: 0.95rem;
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .cart-dropdown-subtotal-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text-muted, #555);
  }

  .subtotal-val {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text-charcoal, #1D1C1A);
  }

  .btn-dropdown-checkout {
    width: 100%;
    text-align: center;
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding: 0.85rem 1.25rem;
    text-decoration: none;
    display: block;
    border-radius: 4px;
    background-color: var(--brand-green, #006448);
    color: #FFFFFF;
    border: none;
    box-shadow: 0 4px 14px rgba(0, 100, 72, 0.25);
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-dropdown-checkout:hover {
    background-color: #004D37;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(0, 100, 72, 0.35);
  }

  /* Responsive styling */
  @media (max-width: 990px) {
    .nav-menu {
      display: none;
    }
  }

  @media (max-width: 480px) {
    .header-cart-dropdown {
      width: calc(100vw - 2rem);
      right: -1rem;
    }
  }
</style>

<script>
  // Dynamic header transitions based on page scroll
  const header = document.querySelector('.main-header');
  window.addEventListener('scroll', () => {
    if (header) {
      if (window.scrollY > 40) {
        header.classList.add('sticky-header');
      } else {
        header.classList.remove('sticky-header');
      }
    }
  });

  // Global Header Cart Synchronization with LocalStorage
  const cartBtn = document.getElementById('header-cart-btn');
  const cartDropdown = document.getElementById('header-cart-dropdown');
  const cartBadge = document.getElementById('header-cart-badge');
  const cartCount = document.getElementById('header-cart-count');
  const cartList = document.getElementById('header-cart-list');
  const cartBottom = document.getElementById('header-cart-bottom');
  const cartSubtotal = document.getElementById('header-cart-subtotal');
  const dropdownCheckoutBtn = document.getElementById('header-dropdown-checkout-btn');

  function getStoredCart() {
    try {
      const raw = localStorage.getItem('whiskyfest_cart');
      if (!raw) return { items: [], subtotal: 0, totalItems: 0 };
      const parsed = JSON.parse(raw);
      let items = parsed.items;
      if (!items && parsed.cartRaw) {
        items = Object.keys(parsed.cartRaw)
          .filter(id => parsed.cartRaw[id] && parsed.cartRaw[id].qty > 0)
          .map(id => parsed.cartRaw[id]);
      }
      return { 
        items: items || [], 
        subtotal: parsed.subtotal || (items ? items.reduce((a: number, b: any) => a + (b.price * b.qty), 0) : 0), 
        totalItems: parsed.totalItems || (items ? items.reduce((a: number, b: any) => a + (b.qty || 0), 0) : 0),
        cartRaw: parsed.cartRaw || {}
      };
    } catch(e) {
      return { items: [], subtotal: 0, totalItems: 0 };
    }
  }

  function updateHeaderCartUI() {
    const cart = getStoredCart();
    const items = cart.items || [];
    const totalCount = items.reduce((acc: number, item: any) => acc + (item.qty || 0), 0);
    const subtotal = items.reduce((acc: number, item: any) => acc + (item.price * item.qty), 0);

    if (cartBadge) {
      if (totalCount > 0) {
        cartBadge.textContent = totalCount.toString();
        cartBadge.style.display = 'flex';
      } else {
        cartBadge.style.display = 'none';
      }
    }

    if (cartBtn) {
      cartBtn.classList.remove('cart-bump');
      void cartBtn.offsetWidth; // Trigger reflow
      if (totalCount > 0) cartBtn.classList.add('cart-bump');
    }

    if (cartCount) {
      cartCount.textContent = `${totalCount} ${totalCount === 1 ? 'item' : 'items'}`;
    }

    if (cartSubtotal) {
      cartSubtotal.innerHTML = `&euro; ${subtotal.toFixed(2).replace('.', ',')}`;
    }

    if (cartList) {
      if (items.length === 0) {
        cartList.innerHTML = '<p class="empty-dropdown-msg">Uw winkelwagen is leeg.</p>';
        if (cartBottom) cartBottom.style.display = 'none';
      } else {
        let html = '';
        items.forEach((item: any) => {
          const totalVal = (item.price * item.qty).toFixed(2).replace('.', ',');
          html += `
            <div class="cart-dropdown-row">
              <span class="cart-row-qty">${item.qty}&times;</span>
              <span class="cart-row-title" title="${item.title}">${item.title}</span>
              <span class="cart-row-price">&euro; ${totalVal}</span>
            </div>
          `;
        });
        cartList.innerHTML = html;
        if (cartBottom) cartBottom.style.display = 'flex';
      }
    }
  }

  if (cartBtn && cartDropdown) {
    cartBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      cartDropdown.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      if (!cartDropdown.contains(e.target as Node) && e.target !== cartBtn) {
        cartDropdown.classList.remove('active');
      }
    });
  }

  // Handle Checkout Click from Dropdown
  if (dropdownCheckoutBtn) {
    dropdownCheckoutBtn.addEventListener('click', (e) => {
      if (window.location.pathname === '/' || window.location.pathname === '') {
        const cart = getStoredCart();
        if (cart.items && cart.items.length > 0) {
          const checkoutTrigger = document.getElementById('checkout-trigger-btn');
          if (checkoutTrigger) {
            e.preventDefault();
            cartDropdown?.classList.remove('active');
            checkoutTrigger.click();
          }
        }
      }
    });
  }

  window.addEventListener('storage', updateHeaderCartUI);
  window.addEventListener('cart-updated', updateHeaderCartUI);
  document.addEventListener('DOMContentLoaded', updateHeaderCartUI);
  updateHeaderCartUI();

  // Header Account Dropdown Logic
  const accountBtn = document.getElementById('header-account-btn');
  const accountDropdown = document.getElementById('header-account-dropdown');
  const accountUserName = document.getElementById('header-account-user-name');
  const loggedInView = document.getElementById('header-account-logged-in');
  const loggedOutView = document.getElementById('header-account-logged-out');
  const navLogoutBtn = document.getElementById('header-nav-logout-btn');
  const navLoginBtn = document.querySelector('.btn-drop-login');

  function updateHeaderAccountState() {
    const isLoggedOut = localStorage.getItem('wf_user_logged_out') === 'true';
    const storedOrder = localStorage.getItem('wf_last_order');
    const storedAuth = sessionStorage.getItem('wf_auth_session') || localStorage.getItem('wf_auth_session');

    let userName = 'Deon Draijer';

    if (storedOrder) {
      try {
        const p = JSON.parse(storedOrder);
        if (p.name) userName = p.name;
      } catch(e) {}
    } else if (storedAuth) {
      try {
        const s = JSON.parse(storedAuth);
        if (s.name) userName = s.name;
        else if (s.email) userName = s.email.split('@')[0];
      } catch(e) {}
    }

    if (accountUserName) {
      accountUserName.textContent = userName;
    }

    if (isLoggedOut) {
      if (loggedInView) loggedInView.style.display = 'none';
      if (loggedOutView) loggedOutView.style.display = 'block';
    } else {
      if (loggedInView) loggedInView.style.display = 'block';
      if (loggedOutView) loggedOutView.style.display = 'none';
    }
  }

  if (accountBtn && accountDropdown) {
    accountBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      // Close cart if open
      if (cartDropdown) cartDropdown.classList.remove('active');
      accountDropdown.classList.toggle('active');
    });

    document.addEventListener('click', (e) => {
      if (!accountDropdown.contains(e.target as Node) && e.target !== accountBtn) {
        accountDropdown.classList.remove('active');
      }
    });
  }

  if (navLogoutBtn) {
    navLogoutBtn.addEventListener('click', (e) => {
      e.preventDefault();
      localStorage.setItem('wf_user_logged_out', 'true');
      sessionStorage.removeItem('wf_auth_session');
      localStorage.removeItem('wf_auth_session');
      if (accountDropdown) accountDropdown.classList.remove('active');
      updateHeaderAccountState();
      
      // If on account page, reload or redirect
      if (window.location.pathname.startsWith('/account')) {
        window.location.href = '/account';
      }
    });
  }

  if (navLoginBtn) {
    navLoginBtn.addEventListener('click', () => {
      localStorage.removeItem('wf_user_logged_out');
    });
  }

  window.addEventListener('storage', updateHeaderAccountState);
  document.addEventListener('DOMContentLoaded', updateHeaderAccountState);
  updateHeaderAccountState();

</script>
