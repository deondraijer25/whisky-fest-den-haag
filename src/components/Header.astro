---
// src/components/Header.astro
import LogoSvg from '../assets/Logo/Logo.svg?raw';

const pathname = Astro.url.pathname;
const isStandhouders = pathname.startsWith("/standhouders");
const isProgramma = pathname.startsWith("/programma");
const isAccount = pathname.startsWith("/account");
---

<header class="main-header animate-fade-in">
  <div class="top-announcement-bar">
    Sluit je aan bij duizenden whiskyliefhebbers in Den Haag – Bestel vandaag nog je tickets!
  </div>
  <div class="header-container">
    <!-- Overlapping Logo Image (links to Home) -->
    <a href="/" class="logo-image-container" aria-label="Whisky Fest Den Haag Home">
      <Fragment set:html={LogoSvg} />
    </a>

    <!-- Navigation links -->
    <nav class="nav-menu">
      <!-- 1. TICKETS DROPDOWN -->
      <div class="header-nav-dropdown-wrapper" id="header-tickets-wrapper">
        <a href="/#sessies" class="nav-link nav-dropdown-trigger" id="nav-tickets-trigger">
          <span>Tickets</span>
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="header-nav-dropdown" id="header-tickets-dropdown">
          <a href="/?cat=all#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Alle Tickets</span>
            <span class="nav-drop-sub">Overzicht van alle beschikbare festivaltickets</span>
          </a>
          <a href="/?cat=entree#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Sessie Entreetickets</span>
            <span class="nav-drop-sub">VIP, vrijdag-, zaterdag- &amp; zondagsessies</span>
          </a>
          <a href="/?cat=masterclass#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Masterclasses</span>
            <span class="nav-drop-sub">Exclusieve proeverijen in Nutshuis &amp; Toren</span>
          </a>
          <a href="/?cat=tram#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Haagsche Whiskytram</span>
            <span class="nav-drop-sub">4 drams tijdens een historische tramrit</span>
          </a>
          <a href="/?cat=trail#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Whisky Trails (Gidsen)</span>
            <span class="nav-drop-sub">Rondleidingen met onze 5 gidsen</span>
          </a>
          <a href="/?cat=warehouse#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Warehouse Tastings</span>
            <span class="nav-drop-sub">Intieme proeverijen direct aan de stands</span>
          </a>
          <a href="/?cat=botteling#sessies" class="nav-dropdown-item">
            <span class="nav-drop-title">Festival Bottelingen</span>
            <span class="nav-drop-sub">Gelimiteerde single cask flessen</span>
          </a>
        </div>
      </div>

      <!-- 2. PLATTEGROND & STANDS -->
      <a href="/standhouders" class={`nav-link ${isStandhouders ? 'active' : ''}`}>Plattegrond &amp; Stands</a>

      <!-- 3. PROGRAMMA DROPDOWN -->
      <div class="header-nav-dropdown-wrapper" id="header-programma-wrapper">
        <a href="/programma" class={`nav-link nav-dropdown-trigger ${isProgramma ? 'active' : ''}`} id="nav-programma-trigger">
          <span>Programma</span>
          <svg class="nav-chevron" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
        <div class="header-nav-dropdown" id="header-programma-dropdown">
          <a href="/programma" class="nav-dropdown-item">
            <span class="nav-drop-title">Festival Programma</span>
            <span class="nav-drop-sub">Masterclasses, tram &amp; proeverijen</span>
          </a>
          <a href="/programma?view=gidsen" class="nav-dropdown-item">
            <span class="nav-drop-title">Gidsen Planning</span>
            <span class="nav-drop-sub">Whisky trails &amp; tijdsloten</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Header Actions: 1. Cart Icon > 2. Bestel Tickets > 3. Mijn Account (Text link) -->
    <div class="header-actions">
      <!-- 1. Header Cart Trigger & Dropdown -->
      <div class="header-cart-wrapper" id="header-cart-wrapper">
        <button type="button" class="header-cart-btn" id="header-cart-btn" aria-label="Winkelwagen openen" title="Winkelwagen">
          <svg class="cart-icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"></circle>
            <circle cx="20" cy="21" r="1"></circle>
            <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
          </svg>
          <span class="header-cart-badge" id="header-cart-badge" style="display: none;">0</span>
        </button>

        <!-- Dropdown Menu (Generous width & clean structured table) -->
        <div class="header-cart-dropdown" id="header-cart-dropdown">
          <div class="cart-dropdown-head">
            <div class="cart-dropdown-title-wrap">
              <h4 class="cart-dropdown-title">Uw Winkelwagen</h4>
            </div>
            <span class="cart-dropdown-badge-count" id="header-cart-count">0 items</span>
          </div>

          <div class="cart-dropdown-list" id="header-cart-list">
            <p class="empty-dropdown-msg">Uw winkelwagen is leeg.</p>
          </div>

          <div class="cart-dropdown-bottom" id="header-cart-bottom" style="display: none;">
            <div class="cart-dropdown-subtotal-row">
              <span class="subtotal-label">Subtotaal:</span>
              <strong class="subtotal-val" id="header-cart-subtotal">€ 0,00</strong>
            </div>
            <a href="/#sessies" class="btn btn-gold btn-dropdown-checkout" id="header-dropdown-checkout-btn">
              Naar Kassa & Afrekenen →
            </a>
          </div>
        </div>
      </div>

      <!-- 2. Bestel Tickets Button -->
      <a href="/#sessies" class="btn btn-gold btn-header">Bestel Tickets</a>

      <!-- 3. Mijn Account (Dropdown Menu) -->
      <div class="header-account-wrapper" id="header-account-wrapper">
        <button type="button" class={`header-account-btn ${isAccount ? 'active' : ''}`} id="header-account-btn" aria-label="Mijn Account menu openen">
          <span>Mijn Account</span>
          <svg class="account-chevron" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </button>

        <div class="header-account-dropdown" id="header-account-dropdown">
          <div id="header-account-logged-in">
            <div class="account-dropdown-user">
              <span class="user-greeting">Bezoekers Portaal</span>
              <strong class="user-name" id="header-account-user-name">Mijn Account</strong>
            </div>

            <div class="account-dropdown-menu">
              <a href="/account" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                <span>Mijn Tickets</span>
              </a>
              <a href="/account?tab=tab-profile" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                <span>Persoonsgegevens</span>
              </a>
              <a href="/account?tab=tab-info" class="account-drop-item">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon><line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line></svg>
                <span>Plattegrond &amp; Info</span>
              </a>
            </div>

            <div class="account-dropdown-divider"></div>

            <button type="button" class="account-drop-item logout-btn" id="header-nav-logout-btn">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
              <span>Uitloggen</span>
            </button>
          </div>

          <div id="header-account-logged-out" style="display: none;">
            <p class="account-drop-intro">Bekijk uw festivaltickets en beheer uw bestelling.</p>
            <a href="/account" class="btn btn-gold btn-drop-login">
              Inloggen bij Portaal →
            </a>
          </div>
        </div>
      </div>

      <!-- 4. Mobile Hamburger Button -->
      <button 
        type="button" 
        class="mobile-menu-toggle-btn" 
        id="mobile-menu-toggle-btn" 
        aria-label="Menu openen"
        onclick="var d=document.getElementById('mobile-nav-drawer'); if(d){ d.classList.add('active'); d.setAttribute('aria-hidden','false'); document.body.style.overflow='hidden'; }"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Drawer -->
  <div class="mobile-nav-drawer" id="mobile-nav-drawer" aria-hidden="true">
    <div 
      class="mobile-nav-backdrop" 
      id="mobile-nav-backdrop"
      onclick="var d=document.getElementById('mobile-nav-drawer'); if(d){ d.classList.remove('active'); d.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }"
    ></div>
    <div class="mobile-nav-panel">
      <!-- Drawer Top Bar -->
      <div class="mobile-nav-top">
        <div class="mobile-nav-brand">
          <span class="mn-brand-est">Est. 2000 &bull; 25e Editie</span>
          <h3 class="mn-brand-title">Whisky Fest</h3>
          <span class="mn-brand-city">Grote Kerk Den Haag</span>
        </div>
        <button 
          type="button" 
          class="mobile-nav-close-btn" 
          id="mobile-nav-close-btn" 
          aria-label="Sluit menu"
          onclick="var d=document.getElementById('mobile-nav-drawer'); if(d){ d.classList.remove('active'); d.setAttribute('aria-hidden','true'); document.body.style.overflow=''; }"
        >
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <!-- Drawer Nav List -->
      <nav class="mobile-nav-menu-list">
        <a href="/#sessies" class="mobile-nav-item">
          <span class="mn-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"></path>
              <path d="M13 5v2"></path><path d="M13 17v2"></path><path d="M13 11v2"></path>
            </svg>
          </span>
          <div class="mn-item-text">
            <strong class="mn-item-title">Tickets Bestellen</strong>
            <span class="mn-item-desc">Sessies, Masterclasses &amp; Whiskytram</span>
          </div>
          <span class="mn-item-arrow">&rarr;</span>
        </a>
        <a href="/programma" class={`mobile-nav-item ${isProgramma ? 'active' : ''}`}>
          <span class="mn-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
          </span>
          <div class="mn-item-text">
            <strong class="mn-item-title">Programma</strong>
            <span class="mn-item-desc">Timetable, Masterclasses &amp; Gidsen</span>
          </div>
          <span class="mn-item-arrow">&rarr;</span>
        </a>
        <a href="/standhouders" class={`mobile-nav-item ${isStandhouders ? 'active' : ''}`}>
          <span class="mn-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
              <line x1="8" y1="2" x2="8" y2="18"></line><line x1="16" y1="6" x2="16" y2="22"></line>
            </svg>
          </span>
          <div class="mn-item-text">
            <strong class="mn-item-title">Plattegrond &amp; Stands</strong>
            <span class="mn-item-desc">Kerkvloer &amp; Aanwezige Standhouders</span>
          </div>
          <span class="mn-item-arrow">&rarr;</span>
        </a>
        <a href="/account" class={`mobile-nav-item ${isAccount ? 'active' : ''}`}>
          <span class="mn-item-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path>
              <circle cx="12" cy="7" r="4"></circle>
            </svg>
          </span>
          <div class="mn-item-text">
            <strong class="mn-item-title">Mijn Account</strong>
            <span class="mn-item-desc">Mijn tickets, badges &amp; bestellingen</span>
          </div>
          <span class="mn-item-arrow">&rarr;</span>
        </a>
      </nav>

      <!-- Multi-City Navigation Switcher -->
      <div class="mobile-nav-cities-section">
        <span class="mn-cities-label">Andere Steden:</span>
        <div class="mn-cities-grid">
          <a href="http://localhost:4332" class="mn-city-card">
            <span class="mn-city-badge">BE</span>
            <span>Gent</span>
            <span class="mn-city-ext">&nearr;</span>
          </a>
          <a href="http://localhost:4331" class="mn-city-card">
            <span class="mn-city-badge">NL</span>
            <span>Amsterdam</span>
            <span class="mn-city-ext">&nearr;</span>
          </a>
        </div>
      </div>

      <!-- Drawer Bottom CTA -->
      <div class="mobile-nav-bottom-cta">
        <a href="/#sessies" class="btn btn-gold btn-mobile-drawer-cta">
          Direct Tickets Bestellen &rarr;
        </a>
      </div>
    </div>
  </div>

  <!-- Inline Fast-Binding Script for Mobile Drawer -->
  <script is:inline>
    (function() {
      function bindDrawer() {
        var btn = document.getElementById('mobile-menu-toggle-btn');
        var drawer = document.getElementById('mobile-nav-drawer');
        var closeBtn = document.getElementById('mobile-nav-close-btn');
        var backdrop = document.getElementById('mobile-nav-backdrop');

        if (!btn || !drawer) return;

        // Portal drawer to body so it takes full viewport height and cannot be clipped by header
        if (drawer.parentNode !== document.body) {
          document.body.appendChild(drawer);
        }

        btn.onclick = function(e) {
          e.preventDefault();
          e.stopPropagation();
          drawer.classList.add('active');
          drawer.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
        };

        function closeNav(e) {
          if (e) {
            e.preventDefault();
            e.stopPropagation();
          }
          drawer.classList.remove('active');
          drawer.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
        }

        if (closeBtn) closeBtn.onclick = closeNav;
        if (backdrop) backdrop.onclick = closeNav;

        var navLinks = drawer.querySelectorAll('a, button:not(#mobile-nav-close-btn)');
        for (var i = 0; i < navLinks.length; i++) {
          navLinks[i].addEventListener('click', function() {
            setTimeout(closeNav, 150);
          });
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', bindDrawer);
      } else {
        bindDrawer();
      }
    })();
  </script>
</header>

<style>
  .main-header {
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    z-index: 100;
    border-bottom: 1px solid rgba(222, 214, 201, 0.2);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    background-color: var(--bg-paper-card);
  }

  .top-announcement-bar {
    background-color: var(--text-charcoal);
    color: var(--whisky-gold-light);
    text-align: center;
    padding: 0.65rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.05em;
  }

  .header-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 1.25rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  /* Sticky transition states */
  :global(.sticky-header) {
    position: sticky;
    top: 0;
    background-color: rgba(250, 247, 242, 0.96);
    backdrop-filter: blur(10px);
    border-bottom: 2px solid var(--border-color);
    box-shadow: 0 4px 20px rgba(29, 28, 26, 0.04);
  }

  /* Overlapping Logo Styling */
  .logo-image-container {
    position: relative;
    display: inline-block;
    z-index: 110;
    height: 60px;
    width: 120px;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .logo-image-container svg {
    position: absolute;
    top: -48px;
    left: 0;
    width: 120px;
    height: auto;
    filter: drop-shadow(0 5px 16px rgba(29, 28, 26, 0.2));
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: center;
  }
  .logo-image-container:hover svg {
    transform: scale(1.05) rotate(-2deg);
    filter: drop-shadow(0 6px 20px rgba(197, 139, 57, 0.3));
  }

  /* Nav Links styling (Shifted to the right near cart & actions) */
  .nav-menu {
    display: flex;
    gap: 2.25rem;
    align-items: center;
    margin-left: auto;
    margin-right: 3rem;
  }
  .nav-link {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    white-space: nowrap;
  }
  .nav-link:hover {
    color: var(--whisky-gold-dark);
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }
  .nav-link:hover::after,
  .nav-link.active::after {
    width: 100%;
  }
  .nav-link.active {
    color: var(--whisky-gold-dark);
  }

  /* Header Actions Group */
  .header-actions {
    display: flex;
    gap: 1.35rem;
    align-items: center;
  }

  .btn-header {
    height: 48px;
    padding: 0 1.6rem;
    font-size: 1.12rem;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
  }

  
  
  /* Navigation Dropdowns with Rock-Solid Hover Bridge */
  .header-nav-dropdown-wrapper {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0;
  }

  /* Invisible hover bridge connecting trigger to menu */
  .header-nav-dropdown-wrapper::after {
    content: '';
    position: absolute;
    top: 100%;
    left: -10px;
    right: -10px;
    height: 14px;
    background: transparent;
    z-index: 999;
  }

  .nav-dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    cursor: pointer;
  }

  .nav-chevron {
    transition: transform 0.2s ease;
  }

  .header-nav-dropdown-wrapper:hover .nav-chevron,
  .header-nav-dropdown-wrapper.open .nav-chevron {
    transform: rotate(180deg);
  }

  .header-nav-dropdown {
    position: absolute;
    top: calc(100% + 4px);
    left: 0;
    width: 290px;
    background-color: #FFFFFF;
    border: 2px solid var(--text-charcoal);
    border-radius: 4px;
    box-shadow: 5px 5px 0px var(--text-charcoal);
    padding: 0.5rem;
    display: none;
    flex-direction: column;
    gap: 0.25rem;
    z-index: 1000;
    animation: dropdownFade 0.15s ease-out;
  }

  .header-nav-dropdown-wrapper:hover .header-nav-dropdown,
  .header-nav-dropdown-wrapper.open .header-nav-dropdown {
    display: flex;
  }

  .nav-dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 3px;
    text-decoration: none;
    transition: all 0.15s ease;
    border-bottom: 1px dashed rgba(226, 217, 204, 0.6);
  }

  .nav-dropdown-item:last-child {
    border-bottom: none;
  }

  .nav-dropdown-item:hover {
    background: rgba(197, 139, 57, 0.12);
    transform: translateX(2px);
  }

  .nav-drop-title {
    font-family: var(--font-sans);
    font-size: 0.88rem;
    font-weight: 800;
    color: var(--text-charcoal);
  }

  .nav-drop-sub {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.25;
  }

  /* Mijn Account Clean Text Link */
  .header-account-link {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    text-decoration: none;
    position: relative;
    padding: 0.5rem 0;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .header-account-link:hover {
    color: var(--whisky-gold-dark);
  }

  .header-account-link::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .header-account-link:hover::after,
  .header-account-link.active::after {
    width: 100%;
  }

  .header-account-link.active {
    color: var(--whisky-gold-dark);
  }

  
  /* Account Dropdown Styling */
  .header-account-wrapper {
    position: relative;
  }

  .header-account-btn {
    background: transparent;
    border: none;
    font-family: var(--font-sans);
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-charcoal);
    padding: 0.5rem 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    transition: color 0.3s ease;
    white-space: nowrap;
    position: relative;
  }

  .header-account-btn:hover,
  .header-account-btn.active {
    color: var(--whisky-gold-dark);
  }

  .header-account-btn::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 50%;
    width: 0;
    height: 2px;
    background-color: var(--whisky-gold-dark);
    transition: all 0.3s ease;
    transform: translateX(-50%);
  }

  .header-account-btn:hover::after,
  .header-account-btn.active::after {
    width: 100%;
  }

  .account-chevron {
    transition: transform 0.2s ease;
  }

  .header-account-dropdown.active ~ .header-account-btn .account-chevron,
  .header-account-wrapper.open .account-chevron {
    transform: rotate(180deg);
  }

  .header-account-dropdown {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    width: 250px;
    background-color: var(--bg-paper-card, #FAF7F2);
    border: 2px solid var(--text-charcoal);
