# GoHighLevel (GHL) API Koppeling
# Verkrijg je Private Integration Token via GHL Settings -> Developers -> Private Integrations
GHL_API_KEY=pit-your-private-integration-token-here
GHL_LOCATION_ID=your-location-id-here

# Custom Object Schema Identifiers (standaard: festival_tickets & festival_standhouders)
GHL_TICKETS_SCHEMA_ID=festival_tickets
GHL_STANDS_SCHEMA_ID=festival_standhouders
